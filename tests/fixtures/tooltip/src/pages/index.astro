---
import InfoPopover from "../../../../../src/components/base-components/tooltip/InfoPopover.astro";
import Tooltip from "../../../../../src/components/base-components/tooltip/Tooltip.astro";
import "../../../../../src/styles/tokens/tokens.css";
import "../../../../../src/styles/global.css";

const placements = ["top", "bottom", "left", "right"] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tooltip family contract fixture</title>
  </head>
  <body>
    <main>
      <section aria-label="Tooltip sizes">
        <Tooltip id="tooltip-small" size="small" text="Short response window" label="Explain the short response window" />
        <Tooltip id="tooltip-medium" size="medium" text="Standard response window" label="Explain the standard response window" />
      </section>

      <section aria-label="Tooltip placements">
        {placements.map((placement) => (
          <Tooltip
            id={`tooltip-${placement}`}
            placement={placement}
            text={`${placement} placement`}
            label={`Explain ${placement} placement`}
          />
        ))}
      </section>

      <Tooltip
        id="tooltip-responsive-placement"
        placement="bottom"
        narrowPlacement="right"
        text="Responsive placement"
        label="Explain responsive placement"
      />

      <section aria-label="Info popover placements">
        {placements.map((placement) => (
          <InfoPopover
            id={`info-popover-${placement}`}
            placement={placement}
            label={`Explain ${placement} response time`}
            closeLabel={`Close ${placement} response time information`}
            title={`${placement} response time`}
            description="Measured during standard business hours and updated after completed requests."
          />
        ))}
      </section>

      <Tooltip text="Generated relationship" label="Explain generated relationship" />
      <InfoPopover
        title="Generated relationship"
        description="This instance verifies generated identifiers and complete dialog relationships."
        label="Explain the generated relationship"
        closeLabel="Close generated relationship information"
      />
    </main>
  </body>
</html>
