---
import BulletPoint from "../../../../../src/components/website-patterns/bullet-points/BulletPoint.astro";
import LogoAsset from "../../../../../src/components/assets/logos/LogoAsset.astro";
import Feature5050 from "../../../../../src/components/website-patterns/features/Feature5050.astro";
import "../../../../../src/styles/tokens/tokens.css";

const invalidCase = process.env.FEATURE_5050_INVALID_CASE ?? "heading";
const invalidProps: Record<string, Record<string, unknown>> = {
  heading: { heading: "   " },
  optionalString: { heading: "Feature", eyebrow: " " },
  visualPosition: { heading: "Feature", visualPosition: "center" },
  headingLevel: { heading: "Feature", headingLevel: 1 },
  visual: { heading: "Feature" },
  logosWithoutTitle: { heading: "Feature" },
  detailBulletsWithoutTitle: { heading: "Feature" },
};
const props = (invalidProps[invalidCase] ?? invalidProps.heading) as any;
---

{invalidCase === "visual" ? (
  <Feature5050 {...props} />
) : invalidCase === "logosWithoutTitle" ? (
  <Feature5050 {...props}>
    <LogoAsset slot="logos" slug="github" variant="full" alt="GitHub" />
    <img slot="visual" src="/images/project-placeholder.svg" alt="Valid visual" />
  </Feature5050>
) : invalidCase === "detailBulletsWithoutTitle" ? (
  <Feature5050 {...props}>
    <BulletPoint slot="detailBullets" text="Detail" />
    <img slot="visual" src="/images/project-placeholder.svg" alt="Valid visual" />
  </Feature5050>
) : (
  <Feature5050 {...props}>
    <img slot="visual" src="/images/project-placeholder.svg" alt="Valid visual" />
  </Feature5050>
)}
