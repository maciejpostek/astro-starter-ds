---
import Button from "../../../../../src/components/base-components/buttons/Button.astro";
import BulletPoint from "../../../../../src/components/website-patterns/bullet-points/BulletPoint.astro";
import Feature5050Centered from "../../../../../src/components/website-patterns/features/Feature5050Centered.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Feature5050Centered contract fixture</title>
  </head>
  <body>
    <main>
      <Feature5050Centered
        id="feature-50-50-centered-right"
        class="feature-50-50-centered-contract-fixture"
        data-forwarded="yes"
        heading="A centered feature with a right visual"
        eyebrow="Feature"
        paragraph="The complete fixture exercises benefits, actions and meaningful media."
        visualPosition="right"
        headingLevel={3}
      >
        <BulletPoint text="First included benefit" status="included" tone="status" />
        <BulletPoint text="Second included benefit" status="included" tone="status" />
        <BulletPoint text="Third included benefit" status="included" tone="status" />
        <Button slot="actions">Primary action</Button>
        <Button slot="actions" variant="secondary">Secondary action</Button>
        <img slot="visual" src="/images/project-placeholder.svg" alt="Abstract feature visual" />
      </Feature5050Centered>

      <Feature5050Centered
        id="feature-50-50-centered-left"
        heading="A minimal feature with a left visual"
        visualPosition="left"
      >
        <img slot="visual" src="/images/project-placeholder.svg" alt="Minimal feature visual" />
      </Feature5050Centered>

      <Feature5050Centered
        id="feature-50-50-centered-localized"
        heading="Wyraźna historia funkcji pozostaje czytelna także przy dłuższym tłumaczeniu"
        eyebrow="Możliwość"
        paragraph="Dłuższa treść weryfikuje naturalne zawijanie, pionowe centrowanie i brak poziomego przepełnienia."
        visualPosition="right"
        headingLevel={4}
      >
        <BulletPoint text="Korzyść pozostaje konkretna i łatwa do przeskanowania." status="included" tone="status" />
        <img slot="visual" src="/images/project-placeholder.svg" alt="Abstrakcyjna kompozycja produktu" />
      </Feature5050Centered>

      <div data-theme="dark" dir="rtl">
        <Feature5050Centered
          id="feature-50-50-centered-rtl"
          heading="ميزة واضحة بقصة بصرية غامرة"
          eyebrow="الميزة"
          paragraph="يتحقق هذا المثال من اتجاه النص وترتيب القراءة والتفاف المحتوى."
          visualPosition="left"
          headingLevel={4}
        >
          <BulletPoint text="تظل الفائدة واضحة وسهلة القراءة." status="included" tone="status" />
          <Button slot="actions">اكتشف الميزة</Button>
          <img slot="visual" src="/images/project-placeholder.svg" alt="تكوين هندسي تجريدي" />
        </Feature5050Centered>
      </div>
    </main>
  </body>
</html>
