---
import Hero5050 from "../../../../../src/components/website-patterns/hero/Hero5050.astro";
import "../../../../../src/styles/tokens/tokens.css";

const invalidCase = process.env.HERO_50_50_INVALID_CASE ?? "heading";
const invalidProps: Record<string, Record<string, unknown>> = {
  heading: { heading: "   " },
  eyebrow: { heading: "Hero", eyebrow: "" },
  paragraph: { heading: "Hero", paragraph: "   " },
  caption: { heading: "Hero", caption: "" },
  visual: { heading: "Hero" },
};
const props = (invalidProps[invalidCase] ?? invalidProps.heading) as any;
---

{invalidCase === "visual" ? (
  <Hero5050 {...props} />
) : (
  <Hero5050 {...props}>
    <div slot="visual">Valid visual</div>
  </Hero5050>
)}
