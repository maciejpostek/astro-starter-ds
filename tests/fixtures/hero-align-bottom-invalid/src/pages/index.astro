---
import HeroAlignBottom from "../../../../../src/components/website-patterns/hero/HeroAlignBottom.astro";
import "../../../../../src/styles/tokens/tokens.css";

const invalidCase = process.env.HERO_ALIGN_BOTTOM_INVALID_CASE ?? "heading";
const invalidProps: Record<string, Record<string, unknown>> = {
  heading: { heading: "   " },
  eyebrow: { heading: "Hero", eyebrow: "" },
  paragraph: { heading: "Hero", paragraph: "   " },
  headingLevel: { heading: "Hero", headingLevel: 1 },
  visual: { heading: "Hero" },
};
const props = (invalidProps[invalidCase] ?? invalidProps.heading) as any;
---

{invalidCase === "visual" ? (
  <HeroAlignBottom {...props} />
) : (
  <HeroAlignBottom {...props}>
    <div slot="visual">Valid visual</div>
  </HeroAlignBottom>
)}
