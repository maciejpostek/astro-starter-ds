---
import Accordion from "../../../../../src/components/base-components/accordion/Accordion.astro";
import AccordionList from "../../../../../src/components/base-components/accordion/AccordionList.astro";
import "../../../../../src/styles/tokens/tokens.css";
import "../../../../../src/styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Accordion contract fixture</title>
  </head>
  <body>
    <main>
      <section data-theme="light">
        <AccordionList id="primary-list" mode="single">
          <Accordion
            id="delivery"
            title="When will it arrive?"
            content="Most orders arrive within three business days."
            helpText="Delivery windows begin after dispatch."
            helpLabel="Explain the delivery window"
            initialOpen
            headingLevel={4}
          />
          <Accordion
            id="returns"
            title="Can I return it?"
            content="Unused products can be returned within thirty days."
            headingLevel={4}
          />
          <Accordion
            id="unavailable"
            title="Is same-day delivery available?"
            content="Same-day delivery is not available."
            disabled
            headingLevel={4}
          />
        </AccordionList>
      </section>
      <section data-theme="dark">
        <AccordionList mode="multiple">
          <Accordion title="Alpha" content="Alpha answer" initialOpen />
          <Accordion title="Beta" content="Beta answer" initialOpen />
        </AccordionList>
      </section>
    </main>
  </body>
</html>

<style>
  main {
    display: grid;
    gap: var(--space-large);
    padding: var(--content-padding-medium);
  }

  section {
    min-inline-size: 0;
    background: var(--color-background-canvas);
    padding: var(--content-padding-medium);
  }
</style>
