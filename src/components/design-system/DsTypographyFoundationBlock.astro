---
import DsTableCell from "./DsTableCell.astro";
import DsTableCopyCell from "./DsTableCopyCell.astro";
import DsTableFrame from "./DsTableFrame.astro";
import DsTableRow from "./DsTableRow.astro";

interface Row {
  token: string;
  value: string;
  minValue?: string;
  maxValue?: string;
  minMax?: string;
  role: string;
  sample?: string;
  sampleStyle?: string;
}

interface Props {
  name: string;
  description: string;
  rows: Row[];
  showHeader?: boolean;
  showMinMax?: boolean;
  size?: "tiny";
}

const {
  name,
  description,
  rows,
  showHeader = true,
  showMinMax = false,
  size = "tiny",
} = Astro.props as Props;
const id = `typography-foundation-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const showFluidControls = rows.some((row) => row.minValue && row.maxValue);
const columns = showMinMax
  ? showFluidControls
    ? "minmax(18rem, 0.18fr) minmax(24rem, 0.24fr) minmax(10rem, 0.1fr) minmax(10rem, 0.1fr) minmax(12rem, 0.12fr) minmax(24rem, 0.26fr) minmax(16rem, 0.16fr)"
    : "minmax(18rem, 0.26fr) minmax(18rem, 0.24fr) minmax(14rem, 0.18fr) minmax(22rem, 0.32fr) minmax(16rem, 0.24fr)"
  : "minmax(18rem, 0.3fr) minmax(18rem, 0.26fr) minmax(24rem, 0.34fr) minmax(16rem, 0.22fr)";
---

<section
  class="ds-typography-foundation-block"
  aria-label={showHeader ? undefined : `${name} typography foundation tokens`}
  aria-labelledby={showHeader ? `${id}-title` : undefined}
  data-component-name="DsTypographyFoundationBlock"
  data-ds-doc-table-size={size}
>
  {showHeader && (
    <div class="ds-typography-foundation-block__header">
      <h3 id={`${id}-title`}>{name}</h3>
      <p>{description}</p>
    </div>
  )}

  <DsTableFrame
    label={`${name} typography foundation tokens`}
    minWidth="86rem"
    columns={columns}
    size={size}
  >
    <DsTableRow variant="header">
      <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
      <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
      {showFluidControls && <DsTableCell role="columnheader" variant="header">Min (REM)</DsTableCell>}
      {showFluidControls && <DsTableCell role="columnheader" variant="header">Max (REM)</DsTableCell>}
      {showMinMax && <DsTableCell role="columnheader" variant="header">Min-max (PX)</DsTableCell>}
      <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
      <DsTableCell role="columnheader" variant="header">Sample</DsTableCell>
    </DsTableRow>

    {
      rows.map((row) => (
        <DsTableRow>
          <DsTableCopyCell role="cell" value={row.token} />
          <DsTableCell role="cell" tone="secondary">
            <code>{row.value}</code>
          </DsTableCell>
          {showFluidControls && (
            <DsTableCell role="cell" tone="secondary">
              <code>{row.minValue}</code>
            </DsTableCell>
          )}
          {showFluidControls && (
            <DsTableCell role="cell" tone="secondary">
              <code>{row.maxValue}</code>
            </DsTableCell>
          )}
          {showMinMax && (
            <DsTableCell role="cell" tone="secondary">
              <code>{row.minMax}</code>
            </DsTableCell>
          )}
          <DsTableCell role="cell" tone="secondary">
            <span>{row.role}</span>
          </DsTableCell>
          <DsTableCell class="ds-typography-foundation-block__sample-cell" role="cell">
            <span
              class="ds-typography-foundation-block__sample"
              style={row.sampleStyle || undefined}
            >
              {row.sample ?? "Ag"}
            </span>
          </DsTableCell>
        </DsTableRow>
      ))
    }
  </DsTableFrame>
</section>

<style>
  .ds-typography-foundation-block {
    display: grid;
    gap: var(--gap-medium);
  }

  .ds-typography-foundation-block__header {
    display: grid;
    gap: var(--gap-regular);
  }

  .ds-typography-foundation-block__header h3 {
    color: var(--color-text-primary);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-ultra-tight);
    line-height: var(--line-height-compact);
  }

  .ds-typography-foundation-block__header p {
    max-width: 48rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  :global(.ds-typography-foundation-block__sample-cell.ds-table-cell) {
    overflow: hidden;
    align-items: center;
  }

  .ds-typography-foundation-block__sample {
    display: block;
    overflow: hidden;
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
