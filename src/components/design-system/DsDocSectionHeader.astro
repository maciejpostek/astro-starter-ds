---
interface Props {
  number?: string;
  title: string;
  description?: string;
  id?: string;
}

const { number, title, description, id } = Astro.props;
const resolvedId =
  id ??
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<header class="ds-doc-section-header" data-component-name="DsDocSectionHeader">
  {number && <span class="ds-doc-section-header__number">{number}</span>}
  <div class="ds-doc-section-header__copy">
    <h2 id={resolvedId}>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</header>

<style>
  .ds-doc-section-header {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    gap: var(--gap-medium);
    margin-bottom: var(--space-section-header-bottom);
  }

  .ds-doc-section-header__number {
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
  }

  .ds-doc-section-header__copy {
    display: grid;
    gap: var(--gap-regular);
    max-width: 56rem;
  }

  .ds-doc-section-header h2 {
    color: var(--color-text-primary);
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-ultra-tight);
    line-height: var(--line-height-compact);
  }

  .ds-doc-section-header p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  @media (width < 48rem) {
    .ds-doc-section-header {
      grid-template-columns: 1fr;
      gap: var(--gap-small);
    }
  }
</style>
