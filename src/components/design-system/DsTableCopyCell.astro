---
import DsCopyButton from "./DsCopyButton.astro";
import DsTableCell from "./DsTableCell.astro";

interface Props {
  value: string;
  label?: string;
  as?: "div" | "td" | "th";
  role?: "cell" | "rowheader";
  scope?: string;
  rowspan?: number | string;
  gridRowSpan?: number | string;
  gridColumn?: number | string;
  gridRow?: number | string;
  class?: string;
}

const {
  value,
  label = `Copy ${value}`,
  as = "div",
  role,
  scope,
  rowspan,
  gridRowSpan,
  gridColumn,
  gridRow,
  class: className,
} = Astro.props as Props;
---

<DsTableCell
  as={as}
  class={className}
  componentName="DsTableCopyCell"
  justify="between"
  gridColumn={gridColumn}
  gridRow={gridRow}
  gridRowSpan={gridRowSpan}
  role={role}
  rowspan={rowspan}
  scope={scope}
>
  <code>{value}</code>
  <DsCopyButton label={label} value={value} />
</DsTableCell>
