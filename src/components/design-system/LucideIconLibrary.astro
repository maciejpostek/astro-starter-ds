---
import { icons } from "@lucide/astro";

const iconEntries = Object.entries(icons).sort(([nameA], [nameB]) =>
  nameA.localeCompare(nameB)
);
---

<section
  class="lucide-library"
  data-component-name="LucideIconLibrary"
  data-lucide-library
>
  <header class="lucide-library__header">
    <label>
      <span>Search Lucide icons</span>
      <input
        type="search"
        placeholder="Search by icon name"
        autocomplete="off"
        data-lucide-search
      />
    </label>
    <output data-lucide-count>{iconEntries.length} icons</output>
  </header>

  <div class="lucide-library__grid" data-lucide-grid>
    {
      iconEntries.map(([name, Icon]) => (
        <article class="lucide-library__item" data-icon-name={name.toLowerCase()}>
          <Icon size="var(--size-24)" aria-hidden="true" />
          <span>{name}</span>
        </article>
      ))
    }
  </div>

  <p class="lucide-library__empty" data-lucide-empty hidden>
    No icons match this search.
  </p>
</section>

<script>
  type LucideLibraryWindow = Window & { __astroDsLucideLibraryReady?: boolean };
  const lucideLibraryWindow = window as LucideLibraryWindow;

  if (!lucideLibraryWindow.__astroDsLucideLibraryReady) {
    lucideLibraryWindow.__astroDsLucideLibraryReady = true;
    document.addEventListener("input", (event) => {
      const input = event.target instanceof HTMLInputElement && event.target.matches("[data-lucide-search]")
        ? event.target
        : null;
      const library = input?.closest<HTMLElement>("[data-lucide-library]");
      if (!input || !library) return;

      const query = input.value.trim().toLowerCase();
      const items = Array.from(library.querySelectorAll<HTMLElement>("[data-icon-name]"));
      let visibleCount = 0;

      items.forEach((item) => {
        const isVisible = item.dataset.iconName?.includes(query) ?? false;
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      const count = library.querySelector<HTMLOutputElement>("[data-lucide-count]");
      const empty = library.querySelector<HTMLElement>("[data-lucide-empty]");
      if (count) count.value = `${visibleCount} ${visibleCount === 1 ? "icon" : "icons"}`;
      if (empty) empty.hidden = visibleCount !== 0;
    });
  }
</script>

<style>
  .lucide-library {
    display: grid;
    width: 100%;
    gap: var(--gap-medium);
  }

  .lucide-library__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--gap-medium);
  }

  label {
    display: grid;
    width: min(24rem, 100%);
    gap: var(--gap-small);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-tiny);
  }

  input {
    min-height: var(--component-size-small-min-height);
    border: var(--border-width-default) solid var(--input-border-default);
    border-radius: var(--radius-input);
    color: var(--input-text-default);
    background: var(--input-background-default);
    padding-inline: var(--component-padding-small);
    font: inherit;
  }

  input:focus-visible {
    border-color: var(--input-border-focus);
    outline: var(--border-width-strong) solid var(--component-focus-ring);
  }

  output {
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
  }

  .lucide-library__grid {
    display: grid;
    max-height: 48rem;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--gap-small);
    overflow: auto;
  }

  .lucide-library__item {
    display: grid;
    min-height: var(--size-96);
    place-items: center;
    gap: var(--gap-small);
    border: var(--border-width-default) solid var(--color-border-subtle);
    color: var(--color-text-accent);
    padding: var(--component-padding-small);
    text-align: center;
  }

  .lucide-library__item span,
  .lucide-library__empty {
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
  }

  @media (max-width: 40rem) {
    .lucide-library__header { align-items: stretch; flex-direction: column; }
  }
</style>
