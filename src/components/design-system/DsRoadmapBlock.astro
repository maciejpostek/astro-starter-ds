---
import { ChevronUp } from "@lucide/astro";

export type RoadmapStatus = "not-started" | "in-progress" | "done" | "blocked" | "later";
export type RoadmapPriority = "critical" | "high" | "medium" | "low";

export interface RoadmapItem {
  id: string;
  title: string;
  type: string;
  priority: RoadmapPriority;
  status: RoadmapStatus;
  description?: string;
  area?: string;
  layer?: string;
  children?: RoadmapItem[];
}

interface Props {
  items: RoadmapItem[];
}

const { items } = Astro.props;

interface RoadmapRow {
  item: RoadmapItem;
  depth: number;
}

const flattenRoadmapChildren = (children: RoadmapItem[] = [], depth = 1): RoadmapRow[] =>
  children.flatMap((item) => [
    { item, depth },
    ...flattenRoadmapChildren(item.children, depth + 1)
  ]);

const countRoadmapChildren = (children: RoadmapItem[] = []) =>
  flattenRoadmapChildren(children).length;

const statusLabels: Record<RoadmapStatus, string> = {
  "not-started": "Not started",
  "in-progress": "In progress",
  done: "done",
  blocked: "Blocked",
  later: "Later"
};

const priorityLabels: Record<RoadmapPriority, string> = {
  critical: "Critical",
  high: "High",
  medium: "Medium",
  low: "Low"
};

const getItemCountLabel = (count: number) => `${count} ${count === 1 ? "item" : "items"}`;
---

<div
  class="ds-roadmap"
  data-component-name="DsRoadmapBlock"
  data-roadmap-accordion
>
  {
    items.map((item) => {
      const rows = flattenRoadmapChildren(item.children);
      const childrenCount = countRoadmapChildren(item.children);
      const panelId = `${item.id}-roadmap-panel`;
      const triggerId = `${item.id}-roadmap-trigger`;
      const hasChildren = rows.length > 0;

      return (
        <article
          class="ds-roadmap__group"
          id={item.id}
          data-roadmap-status={item.status}
          data-roadmap-accordion-item
          data-roadmap-accordion-status="not-active"
        >
          <header class="ds-roadmap__row ds-roadmap__row--parent">
            <span class="ds-roadmap__priority" data-roadmap-priority={item.priority}>
              {priorityLabels[item.priority]}
            </span>
            <div class="ds-roadmap__name">
              <h3>
                <button
                  id={triggerId}
                  class="ds-roadmap__toggle"
                  type="button"
                  data-roadmap-accordion-toggle
                  aria-expanded="false"
                  aria-controls={panelId}
                  disabled={!hasChildren}
                >
                  <span class="ds-roadmap__toggle-title">{item.title}</span>
                  <span class="ds-roadmap__count">{getItemCountLabel(childrenCount)}</span>
                  {hasChildren && (
                    <span class="ds-roadmap__toggle-icon" aria-hidden="true">
                      <ChevronUp />
                    </span>
                  )}
                </button>
              </h3>
              {item.description && <p>{item.description}</p>}
            </div>
            <span class="ds-roadmap__status" data-roadmap-status={item.status}>
              {statusLabels[item.status]}
            </span>
          </header>

          {hasChildren && (
            <div
              id={panelId}
              class="ds-roadmap__panel"
              role="region"
              aria-labelledby={triggerId}
            >
              <div class="ds-roadmap__panel-wrap">
                <div class="ds-roadmap__children">
                  {rows.map((row) => (
                    <div
                      class="ds-roadmap__row ds-roadmap__row--child"
                      id={row.item.id}
                      data-roadmap-depth={row.depth}
                      style={`--roadmap-depth: ${row.depth};`}
                    >
                      <span class="ds-roadmap__priority" data-roadmap-priority={row.item.priority}>
                        {priorityLabels[row.item.priority]}
                      </span>
                      <div class="ds-roadmap__name">
                        <h4>{row.item.title}</h4>
                        {
                          (row.item.area || row.item.layer) && (
                            <span>
                              {[row.item.area, row.item.layer].filter(Boolean).join(" / ")}
                            </span>
                          )
                        }
                      </div>
                      <span class="ds-roadmap__status" data-roadmap-status={row.item.status}>
                        {statusLabels[row.item.status]}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </article>
      );
    })
  }
</div>

<script>
  type WindowWithRoadmapAccordion = Window & {
    __astroDsRoadmapAccordionsInitialized?: boolean;
  };

  const win = window as WindowWithRoadmapAccordion;

  if (!win.__astroDsRoadmapAccordionsInitialized) {
    win.__astroDsRoadmapAccordionsInitialized = true;

    const syncRoadmapAccordionItem = (item: HTMLElement) => {
      const isActive = item.getAttribute("data-roadmap-accordion-status") === "active";
      const toggle = item.querySelector<HTMLElement>("[data-roadmap-accordion-toggle]");
      toggle?.setAttribute("aria-expanded", String(isActive));
    };

    const openRoadmapGroupForHash = (roadmap: HTMLElement) => {
      const hash = window.location.hash.replace("#", "");
      if (!hash) return;

      const target = document.getElementById(hash);
      const group = target?.closest<HTMLElement>("[data-roadmap-accordion-item]");

      if (!group || !roadmap.contains(group)) return;

      group.setAttribute("data-roadmap-accordion-status", "active");
      syncRoadmapAccordionItem(group);
    };

    const initRoadmapAccordions = () => {
      document
        .querySelectorAll<HTMLElement>("[data-roadmap-accordion]")
        .forEach((roadmap) => {
          if (roadmap.dataset.roadmapAccordionReady === "true") {
            openRoadmapGroupForHash(roadmap);
            return;
          }

          roadmap.dataset.roadmapAccordionReady = "true";

          roadmap
            .querySelectorAll<HTMLElement>("[data-roadmap-accordion-item]")
            .forEach(syncRoadmapAccordionItem);

          openRoadmapGroupForHash(roadmap);

          roadmap.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const toggle = target.closest<HTMLElement>("[data-roadmap-accordion-toggle]");
            if (!toggle || !roadmap.contains(toggle)) return;
            if (toggle instanceof HTMLButtonElement && toggle.disabled) return;

            const item = toggle.closest<HTMLElement>("[data-roadmap-accordion-item]");
            if (!item) return;

            const isActive = item.getAttribute("data-roadmap-accordion-status") === "active";
            item.setAttribute("data-roadmap-accordion-status", isActive ? "not-active" : "active");
            syncRoadmapAccordionItem(item);
          });
        });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRoadmapAccordions, {
        once: true
      });
    } else {
      initRoadmapAccordions();
    }

    document.addEventListener("astro:page-load", initRoadmapAccordions);
    window.addEventListener("hashchange", initRoadmapAccordions);
  }
</script>

<style>
  .ds-roadmap {
    display: grid;
    border-top: var(--size-1) solid var(--color-border-subtle);
    border-left: var(--size-1) solid var(--color-border-subtle);
  }

  .ds-roadmap__group {
    display: grid;
    border-right: var(--size-1) solid var(--color-border-subtle);
    border-bottom: var(--size-1) solid var(--color-border-subtle);
    background: var(--color-background-canvas);
  }

  .ds-roadmap__row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.32fr) minmax(0, 1fr) minmax(9rem, 0.28fr);
    min-height: var(--app-nav-row-size);
    align-items: stretch;
  }

  .ds-roadmap__row > * {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: var(--component-padding-medium);
  }

  .ds-roadmap__row > * + * {
    border-left: var(--size-1) solid var(--color-border-subtle);
  }

  .ds-roadmap__row--parent {
    background: var(--color-background-surface);
  }

  .ds-roadmap__row--child {
    border-top: var(--size-1) solid var(--color-border-subtle);
  }

  .ds-roadmap__row--child .ds-roadmap__name {
    padding-left: calc(var(--component-padding-medium) + ((var(--roadmap-depth, 1) - 1) * var(--size-24)));
  }

  .ds-roadmap__row--child[data-roadmap-depth="2"] .ds-roadmap__name h4::before {
    color: var(--color-text-tertiary);
    content: "/ ";
  }

  .ds-roadmap__name {
    display: grid;
    align-content: center;
    gap: var(--gap-small);
  }

  .ds-roadmap__name h3,
  .ds-roadmap__name h4,
  .ds-roadmap__name p {
    margin: 0;
  }

  .ds-roadmap__name h3 {
    color: var(--color-text-primary);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-ultra-tight);
    line-height: var(--line-height-compact);
  }

  .ds-roadmap__name h4 {
    color: var(--color-text-primary);
    font-size: var(--font-size-body-base);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
  }

  .ds-roadmap__name p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  .ds-roadmap__name span {
    color: var(--color-text-tertiary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
    text-transform: uppercase;
  }

  .ds-roadmap__toggle {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--gap-regular);
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-align: left;
  }

  .ds-roadmap__toggle:disabled {
    cursor: default;
  }

  .ds-roadmap__toggle-title {
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-transform: none;
  }

  .ds-roadmap__count {
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .ds-roadmap__toggle-icon {
    display: inline-flex;
    width: var(--size-24);
    height: var(--size-24);
    align-items: center;
    justify-content: center;
    color: var(--color-icon-primary);
    transform: rotate(180deg);
    transition:
      transform var(--motion-duration-disclosure) var(--motion-ease-premium-out),
      color var(--motion-transition);
  }

  .ds-roadmap__toggle-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  [data-roadmap-accordion-status="active"] .ds-roadmap__toggle-icon {
    color: var(--color-text-accent);
    transform: rotate(0.001deg);
  }

  .ds-roadmap__panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition:
      grid-template-rows
      var(--motion-duration-disclosure)
      var(--motion-ease-premium-out);
  }

  [data-roadmap-accordion-status="active"] .ds-roadmap__panel {
    grid-template-rows: 1fr;
  }

  .ds-roadmap__panel-wrap {
    min-height: 0;
    overflow: hidden;
  }

  .ds-roadmap__priority,
  .ds-roadmap__status {
    justify-content: flex-start;
    color: var(--color-text-primary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
    text-transform: uppercase;
  }

  .ds-roadmap__priority::before,
  .ds-roadmap__status::before {
    width: var(--size-8);
    height: var(--size-8);
    flex: 0 0 auto;
    margin-right: var(--size-8);
    background: currentColor;
    content: "";
  }

  .ds-roadmap__priority[data-roadmap-priority="critical"] {
    color: var(--color-text-accent);
  }

  .ds-roadmap__priority[data-roadmap-priority="high"] {
    color: var(--color-text-primary);
  }

  .ds-roadmap__priority[data-roadmap-priority="medium"] {
    color: var(--color-text-secondary);
  }

  .ds-roadmap__priority[data-roadmap-priority="low"] {
    color: var(--color-text-tertiary);
  }

  .ds-roadmap__status[data-roadmap-status="not-started"] {
    color: var(--color-text-tertiary);
  }

  .ds-roadmap__status[data-roadmap-status="in-progress"] {
    color: var(--color-text-accent);
  }

  .ds-roadmap__status[data-roadmap-status="done"] {
    color: var(--color-status-success-text);
  }

  @media (width < 64rem) {
    .ds-roadmap__row {
      grid-template-columns: 1fr;
    }

    .ds-roadmap__row > * + * {
      border-top: var(--size-1) solid var(--color-border-subtle);
      border-left: 0;
    }
  }
</style>
