---
import MediaRatio from "../../atoms/media/MediaRatio.astro";
import type { MediaRatioValue } from "../../atoms/media/types";

interface Props {
  id: string;
  beforeSrc?: string;
  afterSrc?: string;
  beforeAlt?: string;
  afterAlt?: string;
  ratio?: MediaRatioValue;
  initial?: number;
  componentName?: string;
}

const {
  id,
  beforeSrc,
  afterSrc,
  beforeAlt = "Before",
  afterAlt = "After",
  ratio = "16:9",
  initial = 50,
  componentName = "BeforeAfterSlider"
} = Astro.props;

const position = Number.isFinite(initial)
  ? Math.min(100, Math.max(0, initial))
  : 50;
---

<figure
  class="before-after"
  data-component-name={componentName}
  data-component-family="media"
  data-before-after
  style={`--before-after-position:${position}%`}
  data-preview-target
>
  <MediaRatio ratio={ratio}>
    <div class="before-after__layer before-after__before">
      {
        beforeSrc ? (
          <img src={beforeSrc} alt={beforeAlt} />
        ) : (
          <span>{beforeAlt}</span>
        )
      }
    </div>
    <div class="before-after__layer before-after__after">
      {
        afterSrc ? (
          <img src={afterSrc} alt={afterAlt} />
        ) : (
          <span>{afterAlt}</span>
        )
      }
    </div>
    <span class="before-after__handle" aria-hidden="true"></span>
  </MediaRatio>
  <label for={id}>Comparison position</label>
  <input
    id={id}
    type="range"
    min="0"
    max="100"
    value={position}
    aria-valuetext={`${position}% toward ${afterAlt}`}
    data-before-after-range
    data-after-label={afterAlt}
  />
</figure>

<script>
  type BeforeAfterWindow = Window & {
    __astroDsBeforeAfterReady?: boolean;
  };

  const beforeAfterWindow = window as BeforeAfterWindow;

  if (!beforeAfterWindow.__astroDsBeforeAfterReady) {
    beforeAfterWindow.__astroDsBeforeAfterReady = true;

    document.addEventListener("input", (event) => {
      const range =
        event.target instanceof HTMLInputElement &&
        event.target.matches("[data-before-after-range]")
          ? event.target
          : null;
      const root = range?.closest<HTMLElement>("[data-before-after]");

      if (root && range) {
        root.style.setProperty("--before-after-position", `${range.value}%`);
        range.setAttribute(
          "aria-valuetext",
          `${range.value}% toward ${range.dataset.afterLabel ?? "the after image"}`
        );
      }
    });
  }
</script>

<style>
  .before-after {
    display: grid;
    width: 100%;
    gap: var(--gap-small);
    margin: 0;
  }

  .before-after :global(.media-ratio) {
    background: var(--color-background-muted);
  }

  .before-after__layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .before-after__layer span {
    color: var(--color-text-primary);
  }

  .before-after__after {
    clip-path: inset(0 0 0 var(--before-after-position));
  }

  .before-after__handle {
    position: absolute;
    z-index: 3;
    inset: 0 auto 0 var(--before-after-position);
    width: var(--border-width-strong);
    background: var(--color-background-canvas);
    transform: translateX(-50%);
    box-shadow:
      0 0 0 var(--border-width-default) var(--color-border-strong);
  }

  .before-after label {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    font-weight: var(--text-style-body-tiny-font-weight);
    font-style: var(--text-style-body-tiny-font-style);
    line-height: var(--text-style-body-tiny-line-height);
    letter-spacing: var(--text-style-body-tiny-letter-spacing);
    text-transform: var(--text-style-body-tiny-text-transform);
    text-wrap: var(--text-style-body-tiny-text-wrap);
    overflow-wrap: var(--text-style-body-tiny-overflow-wrap);
    word-break: var(--text-style-body-tiny-word-break);
    white-space: var(--text-style-body-tiny-white-space);
  }

  .before-after input {
    width: 100%;
    accent-color: var(--color-background-accent);
  }

  .before-after input:focus-visible,
  .before-after[data-preview-state="focus"] input {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }
</style>
