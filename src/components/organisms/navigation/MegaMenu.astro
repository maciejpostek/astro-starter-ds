---
import type { HTMLAttributes } from "astro/types";
import Button from "../../atoms/actions/Button.astro";
import Eyebrow from "../../atoms/text/Eyebrow.astro";

export type MegaMenuVariant = "columns" | "featured";

export interface MegaMenuItem {
  href: string;
  label: string;
  description?: string;
  isCurrent?: boolean;
}

export interface MegaMenuGroup {
  label: string;
  items: MegaMenuItem[];
}

export interface MegaMenuFeaturedItem {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  actionLabel: string;
}

type Props = {
  id: string;
  groups: MegaMenuGroup[];
  label?: string;
  variant?: MegaMenuVariant;
  featured?: MegaMenuFeaturedItem;
  open?: boolean;
  preview?: boolean;
  componentName?: string;
  class?: string;
} & Omit<
  HTMLAttributes<"div">,
  "class" | "id" | "aria-label" | "aria-hidden"
>;

const {
  id,
  groups,
  label = "Explore",
  variant = "columns",
  featured,
  open = false,
  preview = false,
  componentName = "MegaMenu",
  class: className,
  ...attributes
} = Astro.props;

const variants: MegaMenuVariant[] = ["columns", "featured"];
const normalize = (value: string) => value.trim();
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);

const normalizedId = normalize(id);
const normalizedLabel = normalize(label);
const normalizedComponentName = normalize(componentName);
const normalizedGroups = groups.map((group) => ({
  label: normalize(group.label),
  items: group.items.map((item) => ({
    href: normalize(item.href),
    label: normalize(item.label),
    description: item.description ? normalize(item.description) : undefined,
    isCurrent: item.isCurrent === true,
  })),
}));
const normalizedFeatured = featured
  ? {
      eyebrow: normalize(featured.eyebrow),
      title: normalize(featured.title),
      description: normalize(featured.description),
      href: normalize(featured.href),
      actionLabel: normalize(featured.actionLabel),
    }
  : undefined;

if (!/^[A-Za-z][A-Za-z0-9:_-]*$/.test(normalizedId)) {
  throw new Error(
    "MegaMenu id must start with a letter and contain only letters, numbers, colon, underscore, or hyphen.",
  );
}
if (!normalizedLabel || !normalizedComponentName) {
  throw new Error("MegaMenu requires non-empty label and componentName values.");
}
if (!variants.includes(variant)) {
  throw new Error(`MegaMenu received unsupported variant "${String(variant)}".`);
}
if (normalizedGroups.length === 0) {
  throw new Error("MegaMenu requires at least one navigation group.");
}
if (
  normalizedGroups.some(
    (group) =>
      !group.label ||
      group.items.length === 0 ||
      group.items.some(
        (item) =>
          !item.label ||
          !isRealHref(item.href) ||
          item.description === "",
      ),
  )
) {
  throw new Error(
    "MegaMenu groups require non-empty labels and at least one complete item with a real non-placeholder href.",
  );
}
if (
  new Set(normalizedGroups.map((group) => group.label.toLocaleLowerCase())).size !==
  normalizedGroups.length
) {
  throw new Error("MegaMenu group labels must be unique.");
}
const normalizedItems = normalizedGroups.flatMap((group) => group.items);
if (
  new Set(normalizedItems.map((item) => item.href)).size !==
  normalizedItems.length
) {
  throw new Error("MegaMenu item href values must be unique.");
}
if (normalizedItems.filter((item) => item.isCurrent).length > 1) {
  throw new Error("MegaMenu accepts at most one current navigation item.");
}
if (variant === "featured" && !normalizedFeatured) {
  throw new Error(
    'MegaMenu variant="featured" requires a complete featured item.',
  );
}
if (variant === "columns" && normalizedFeatured) {
  throw new Error(
    'MegaMenu variant="columns" does not accept hidden featured content.',
  );
}
if (
  normalizedFeatured &&
  (!normalizedFeatured.eyebrow ||
    !normalizedFeatured.title ||
    !normalizedFeatured.description ||
    !normalizedFeatured.actionLabel ||
    !isRealHref(normalizedFeatured.href))
) {
  throw new Error(
    "MegaMenu featured content requires complete copy and a real non-placeholder href.",
  );
}
---

<div
  {...attributes}
  id={normalizedId}
  class:list={["mega-menu", preview && "mega-menu--preview", className]}
  data-component-name={normalizedComponentName}
  data-component-family="navigation"
  data-mega-menu
  data-mega-menu-preview={preview ? true : undefined}
  data-mega-menu-variant={variant}
  data-mega-menu-state={open ? "open" : "closed"}
  data-preview-target
  aria-label={normalizedLabel}
  aria-hidden={open ? "false" : "true"}
  hidden={!open}
>
  <nav class="mega-menu__inner" aria-label={normalizedLabel}>
    <div class="mega-menu__groups">
      {
        normalizedGroups.map((group, groupIndex) => {
          const groupId = `${normalizedId}-group-${groupIndex + 1}`;
          return (
            <section class="mega-menu__group" aria-labelledby={groupId}>
              <h3 id={groupId}>{group.label}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a
                      class="mega-menu__link"
                      href={item.href}
                      aria-current={item.isCurrent ? "page" : undefined}
                      data-navigation-state={
                        item.isCurrent ? "current" : "default"
                      }
                      data-mega-menu-link
                    >
                      <strong>{item.label}</strong>
                      {item.description && <span>{item.description}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
    {
      variant === "featured" && normalizedFeatured && (
        <aside class="mega-menu__featured" aria-labelledby={`${normalizedId}-featured`}>
          <Eyebrow text={normalizedFeatured.eyebrow} />
          <h3 id={`${normalizedId}-featured`}>{normalizedFeatured.title}</h3>
          <p>{normalizedFeatured.description}</p>
          <Button
            href={normalizedFeatured.href}
            variant="secondary"
            size="medium"
            data-mega-menu-link
          >
            {normalizedFeatured.actionLabel}
          </Button>
        </aside>
      )
    }
  </nav>
</div>

<script>
  interface MegaMenuRuntime {
    abortController: AbortController;
    triggerByPanel: WeakMap<HTMLElement, HTMLElement>;
  }

  const megaMenuWindow = window as Window & {
    __astroDsMegaMenuRuntime?: MegaMenuRuntime;
  };
  megaMenuWindow.__astroDsMegaMenuRuntime?.abortController.abort();

  const megaMenuAbortController = new AbortController();
  const megaMenuSignal = megaMenuAbortController.signal;
  const megaMenuTriggerByPanel = new WeakMap<HTMLElement, HTMLElement>();
  megaMenuWindow.__astroDsMegaMenuRuntime = {
    abortController: megaMenuAbortController,
    triggerByPanel: megaMenuTriggerByPanel,
  };

  const getMegaMenuPanel = (id: string | null) => {
    if (!id) return null;
    const panel = document.getElementById(id);
    return panel?.matches("[data-mega-menu]") ? panel : null;
  };

  const getMegaMenuTriggers = (panel: HTMLElement) =>
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-mega-menu-trigger][aria-controls]",
      ),
    ).filter((trigger) => trigger.getAttribute("aria-controls") === panel.id);

  const closeMegaMenu = (panel: HTMLElement, restoreFocus = true) => {
    panel.dataset.megaMenuState = "closed";
    panel.setAttribute("aria-hidden", "true");
    panel.hidden = true;
    getMegaMenuTriggers(panel).forEach((trigger) =>
      trigger.setAttribute("aria-expanded", "false"),
    );
    if (restoreFocus) megaMenuTriggerByPanel.get(panel)?.focus();
  };

  const openMegaMenu = (panel: HTMLElement, trigger?: HTMLElement) => {
    document
      .querySelectorAll<HTMLElement>(
        '[data-mega-menu][data-mega-menu-state="open"]',
      )
      .forEach((openPanel) => {
        if (openPanel !== panel) closeMegaMenu(openPanel, false);
      });

    if (trigger) megaMenuTriggerByPanel.set(panel, trigger);
    panel.hidden = false;
    panel.dataset.megaMenuState = "open";
    panel.setAttribute("aria-hidden", "false");
    getMegaMenuTriggers(panel).forEach((candidate) =>
      candidate.setAttribute("aria-expanded", "true"),
    );
    requestAnimationFrame(() =>
      panel.querySelector<HTMLElement>("[data-mega-menu-link]")?.focus(),
    );
  };

  document
    .querySelectorAll<HTMLElement>("[data-mega-menu]")
    .forEach((panel) => {
      const shouldOpen =
        panel.dataset.megaMenuState === "open" && !panel.hidden;
      panel.hidden = !shouldOpen;
      panel.setAttribute("aria-hidden", shouldOpen ? "false" : "true");
      getMegaMenuTriggers(panel).forEach((trigger) =>
        trigger.setAttribute("aria-expanded", String(shouldOpen)),
      );
    });

  document.addEventListener(
    "click",
    (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest<HTMLElement>("[data-mega-menu-trigger]");
      if (trigger) {
        const panel = getMegaMenuPanel(trigger.getAttribute("aria-controls"));
        if (!panel) return;
        panel.dataset.megaMenuState === "open"
          ? closeMegaMenu(panel)
          : openMegaMenu(panel, trigger);
        return;
      }

      const panel = target?.closest<HTMLElement>("[data-mega-menu]");
      if (panel && target?.closest("[data-mega-menu-link]")) {
        closeMegaMenu(panel, false);
        return;
      }
      if (panel) return;

      document
        .querySelectorAll<HTMLElement>(
          '[data-mega-menu][data-mega-menu-state="open"]',
        )
        .forEach((openPanel) => closeMegaMenu(openPanel, false));
    },
    { signal: megaMenuSignal },
  );

  document.addEventListener(
    "keydown",
    (event) => {
      if (event.key !== "Escape") return;
      const panel = document.querySelector<HTMLElement>(
        '[data-mega-menu][data-mega-menu-state="open"]:not([hidden])',
      );
      if (!panel) return;
      event.preventDefault();
      closeMegaMenu(panel);
    },
    { signal: megaMenuSignal },
  );
</script>

<style>
  .mega-menu {
    position: absolute;
    z-index: 40;
    inset-inline: 0;
    top: 100%;
    min-width: 0;
    border-block:
      var(--border-width-default) solid
      var(--color-border-subtle);
    background: var(--color-background-canvas);
    box-shadow: var(--elevation-dropdown-menu);
    animation:
      mega-menu-enter
      var(--motion-duration-surface-enter)
      var(--motion-ease-premium-out)
      both;
  }

  .mega-menu[hidden] {
    display: none;
  }

  .mega-menu--preview {
    position: relative;
    top: auto;
    width: 100%;
    box-shadow: none;
  }

  .mega-menu__inner {
    display: grid;
    width: min(var(--container-content), calc(100% - 2 * var(--site-padding-inline)));
    margin-inline: auto;
    padding-block: var(--component-padding-xlarge);
  }

  .mega-menu[data-mega-menu-variant="featured"] .mega-menu__inner {
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: var(--gap-xlarge);
  }

  .mega-menu__groups {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, var(--grid-auto-min-width-small)), 1fr));
    gap: var(--gap-large);
    min-width: 0;
  }

  .mega-menu__group {
    min-width: 0;
  }

  .mega-menu__group h3 {
    margin: 0 0 var(--gap-small);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-compact);
    text-transform: var(--text-transform-uppercase);
  }

  .mega-menu__group ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega-menu__link {
    display: grid;
    gap: var(--gap-tiny);
    border-inline-start:
      var(--border-width-strong) solid
      transparent;
    padding:
      var(--component-padding-small)
      var(--component-padding-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    transition:
      background var(--motion-transition),
      border-color var(--motion-transition),
      color var(--motion-transition);
  }

  .mega-menu__link strong {
    font-size: var(--font-size-body-regular);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
  }

  .mega-menu__link span {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-regular);
  }

  .mega-menu__link:hover,
  .mega-menu__link:focus-visible {
    background: var(--color-background-surface);
  }

  .mega-menu__link:focus-visible {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  .mega-menu__link[aria-current="page"] {
    border-inline-start-color: var(--color-border-accent);
    background: var(--color-background-surface);
  }

  .mega-menu__featured {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    border-inline-start:
      var(--border-width-default) solid
      var(--color-border-subtle);
    padding-inline-start: var(--component-padding-xlarge);
  }

  .mega-menu__featured h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-style-heading-h4-font-size);
    line-height: var(--text-style-heading-h4-line-height);
  }

  .mega-menu__featured p {
    margin:
      var(--gap-small)
      0
      var(--gap-large);
    color: var(--color-text-secondary);
    line-height: var(--line-height-regular);
  }

  @keyframes mega-menu-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--size-8) * -1));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (width < 64rem) {
    .mega-menu[data-mega-menu-variant="featured"] .mega-menu__inner {
      grid-template-columns: 1fr;
    }

    .mega-menu__featured {
      border-block-start:
        var(--border-width-default) solid
        var(--color-border-subtle);
      border-inline-start: 0;
      padding-block-start: var(--component-padding-large);
      padding-inline-start: 0;
    }
  }

  @media (width < 40rem) {
    .mega-menu__inner {
      width: min(var(--container-content), calc(100% - 2 * var(--size-16)));
      padding-block: var(--component-padding-large);
    }

    .mega-menu__groups {
      grid-template-columns: 1fr;
      gap: var(--gap-medium);
    }
  }
</style>
