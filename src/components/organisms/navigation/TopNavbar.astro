---
import { MessageCircle, Menu, X } from "@lucide/astro";
import Button from "../../atoms/actions/Button.astro";
import AvailableLabel from "../../atoms/data-display/AvailableLabel.astro";
import TimezoneLabel from "../../atoms/data-display/TimezoneLabel.astro";
import MenuLink from "../../molecules/navigation/MenuLink.astro";
import { isCurrentPath, publicNavigation } from "../../../data/navigation";

interface Props {
  activePath: string;
  preview?: boolean;
  brandLabel?: string;
  availabilityLabel?: string;
  locationLabel?: string;
  timeZone?: string;
  workspaceLabel?: string;
  contactLabel?: string;
  contactHref?: string;
}

const {
  activePath,
  preview = false,
  brandLabel = "Home",
  availabilityLabel = "Available",
  locationLabel = "Local",
  timeZone = "UTC",
  workspaceLabel = "Workspace",
  contactLabel = "Components",
  contactHref = "/design-system/components"
} = Astro.props;

const resolvedActivePath = activePath.trim();
const resolvedBrandLabel = brandLabel.trim();
const resolvedAvailabilityLabel = availabilityLabel.trim();
const resolvedLocationLabel = locationLabel.trim();
const resolvedTimeZone = timeZone.trim();
const resolvedWorkspaceLabel = workspaceLabel.trim();
const resolvedContactLabel = contactLabel.trim();
const resolvedContactHref = contactHref.trim();

if (!resolvedActivePath.startsWith("/")) {
  throw new Error("TopNavbar requires activePath to be an absolute pathname.");
}

for (const [name, value] of [
  ["brandLabel", resolvedBrandLabel],
  ["availabilityLabel", resolvedAvailabilityLabel],
  ["locationLabel", resolvedLocationLabel],
  ["timeZone", resolvedTimeZone],
  ["workspaceLabel", resolvedWorkspaceLabel],
  ["contactLabel", resolvedContactLabel]
]) {
  if (!value) throw new Error(`TopNavbar requires a non-empty ${name}.`);
}

if (!resolvedContactHref || resolvedContactHref === "#") {
  throw new Error("TopNavbar requires a real non-placeholder contactHref.");
}

try {
  new Intl.DateTimeFormat("en-GB", { timeZone: resolvedTimeZone }).format(
    new Date(0)
  );
} catch {
  throw new Error(`TopNavbar received an invalid timeZone: ${resolvedTimeZone}.`);
}
---

<header
  class:list={["topbar", preview && "topbar--preview"]}
  data-component-name="TopNavbar"
  data-component-family="navigation"
  data-component-size="large"
  data-navigation-state="default"
  data-top-navbar={preview ? undefined : true}
>
  <div class="topbar__cluster">
    <a class="topbar__mobile-brand" href="/" aria-label={resolvedBrandLabel}>
      <span class="brand__mark" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </a>
    <div class="utility-item utility-item--availability">
      <AvailableLabel label={resolvedAvailabilityLabel} />
    </div>
    <div class="utility-item utility-item--time">
      <TimezoneLabel label={resolvedLocationLabel} timezone={resolvedTimeZone}>
        <span slot="time" data-local-time data-timezone={resolvedTimeZone}>--:--:--</span>
      </TimezoneLabel>
    </div>
  </div>
  <div class="topbar__actions">
    <span class="topbar__note">{resolvedWorkspaceLabel}</span>
    <Button class="topbar__contact-button" href={resolvedContactHref} aria-label={resolvedContactLabel} showIcon={false}>{resolvedContactLabel}</Button>
    <button
      class="topbar__menu-button"
      type="button"
      data-component-name="MobileMenu.Trigger"
      aria-label="Open mobile menu"
      aria-expanded={preview ? undefined : "false"}
      aria-controls={preview ? undefined : "mobile-menu"}
      data-mobile-menu-toggle={preview ? undefined : true}
      disabled={preview}
    >
      <Menu class="topbar__menu-icon topbar__menu-icon--open" aria-hidden="true" />
      <X class="topbar__menu-icon topbar__menu-icon--close" aria-hidden="true" />
    </button>
  </div>
</header>

{
  !preview && (
    <div
      class="mobile-menu"
      id="mobile-menu"
      data-component-name="MobileMenu"
      data-mobile-menu
      hidden
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >
      <nav class="mobile-menu__nav" aria-label="Mobile navigation">
        {publicNavigation.map((item) => (
          <MenuLink
            class="mobile-menu__link"
            href={item.href}
            label={item.label}
            isCurrent={isCurrentPath(resolvedActivePath, item.href)}
          />
        ))}
      </nav>
      <div class="mobile-menu__footer">
        <Button class="mobile-menu__contact-button" href={resolvedContactHref} full>{resolvedContactLabel}<MessageCircle slot="icon" /></Button>
      </div>
    </div>
  )
}

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto var(--app-sidebar-width);
    z-index: 30;
    display: flex;
    height: var(--app-topbar-height);
    align-items: stretch;
    justify-content: space-between;
    background: var(--app-topbar-surface);
    isolation: isolate;
    padding: 0;
    backdrop-filter: blur(var(--size-8));
    transition: inset-inline-start var(--motion-transition);
  }

  .topbar--preview {
    position: relative;
    inset: auto;
    width: 100%;
  }

  .topbar::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 2;
    height: var(--border-width-default);
    background: var(--color-border-subtle);
    content: "";
    pointer-events: none;
  }

  .topbar__cluster,
  .topbar__actions,
  .utility-item {
    display: flex;
    align-items: center;
  }

  .topbar__cluster {
    min-height: 100%;
    align-items: stretch;
    gap: 0;
  }

  .topbar__cluster,
  .topbar__actions {
    position: relative;
    z-index: 1;
  }

  .topbar__mobile-brand {
    display: none;
    width: var(--app-topbar-height);
    height: var(--app-topbar-height);
    flex: 0 0 var(--app-topbar-height);
  }

  .topbar__mobile-brand .brand__mark {
    width: 100%;
    height: 100%;
  }

  .topbar__actions {
    min-height: 100%;
    align-items: stretch;
    gap: 0;
    border-left: var(--border-width-default) solid var(--color-border-subtle);
  }

  .utility-item {
    gap: var(--gap-small);
    min-height: var(--app-topbar-height);
    border-right: var(--border-width-default) solid var(--color-border-subtle);
    padding: 0 var(--size-20);
    color: var(--color-text-accent);
    font-size: var(--font-size-body-tiny);
  }

  .utility-item--time {
    font-variant-numeric: tabular-nums;
  }

  .topbar__note {
    display: flex;
    min-height: var(--app-topbar-height);
    align-items: center;
    border-right: var(--border-width-default) solid var(--color-border-subtle);
    padding: 0 var(--size-20);
    color: var(--color-text-accent);
  }

  .utility-item--availability,
  .utility-item--time,
  .topbar__note {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-compact);
    letter-spacing: var(--letter-spacing-none);
    text-transform: var(--text-transform-uppercase);
  }

  .topbar__actions :global(.topbar__contact-button.button) {
    min-height: var(--app-topbar-height);
    height: 100%;
    border-block: 0;
    border-inline-end: 0;
    border-radius: 0;
    padding: 0 var(--size-24);
  }

  .topbar__menu-button {
    display: inline-flex;
    width: var(--app-topbar-height);
    min-height: var(--app-topbar-height);
    height: 100%;
    align-items: center;
    justify-content: center;
    border: 0;
    border-inline-start: var(--border-width-default) solid var(--color-border-subtle);
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    color: var(--color-text-primary);
    background: var(--color-background-canvas);
    transition:
      background var(--motion-transition),
      color var(--motion-transition);
  }

  .topbar__menu-button:hover {
    background: var(--color-background-subtle);
  }

  .topbar__menu-icon {
    width: var(--size-16);
    height: var(--size-16);
  }

  .topbar__menu-icon--close {
    display: none;
  }

  :global(html[data-mobile-menu="open"]) .topbar__menu-icon--open {
    display: none;
  }

  :global(html[data-mobile-menu="open"]) .topbar__menu-icon--close {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset-block-start: var(--app-topbar-height);
    inset-inline-end: 0;
    inset-block-end: 0;
    inset-inline-start: var(--app-sidebar-width);
    z-index: 29;
    display: none;
    height: calc(100dvh - var(--app-topbar-height));
    flex-direction: column;
    overflow: auto;
    background: var(--color-background-canvas);
    transform-origin: top;
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu {
    display: flex;
    animation:
      mobile-menu-reveal
      var(--motion-duration-mobile-menu-reveal)
      var(--motion-ease-premium-out)
      both;
  }

  :global(html[data-mobile-menu="closing"]) .mobile-menu {
    display: flex;
    animation:
      mobile-menu-close
      var(--motion-duration-mobile-menu-close)
      var(--motion-ease-premium-in)
      both;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__link {
    --menu-link-padding-inline: var(--size-20);

    opacity: 0;
    transform: translateY(calc(var(--size-8) * -1));
  }

  .mobile-menu__footer {
    margin-top: auto;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--site-padding-inline);
    opacity: 0;
    transform: translateY(var(--size-16));
  }

  .mobile-menu__footer :global(.mobile-menu__contact-button.button) {
    width: 100%;
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link {
    animation:
      mobile-menu-link-in
      var(--motion-duration-mobile-menu-link)
      var(--motion-ease-premium-out)
      both;
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(1) {
    animation-delay: var(--motion-delay-mobile-menu-link-1);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(2) {
    animation-delay: var(--motion-delay-mobile-menu-link-2);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(3) {
    animation-delay: var(--motion-delay-mobile-menu-link-3);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(4) {
    animation-delay: var(--motion-delay-mobile-menu-link-4);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(5) {
    animation-delay: var(--motion-delay-mobile-menu-link-5);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__link:nth-child(6) {
    animation-delay: var(--motion-delay-mobile-menu-link-6);
  }

  :global(html[data-mobile-menu="open"]) .mobile-menu__footer {
    animation:
      mobile-menu-footer-in
      var(--motion-duration-mobile-menu-footer)
      var(--motion-ease-premium-out)
      var(--motion-delay-mobile-menu-footer)
      both;
  }

  :global(html[data-mobile-menu="closing"]) .mobile-menu__link,
  :global(html[data-mobile-menu="closing"]) .mobile-menu__footer {
    opacity: 1;
    transform: none;
  }

  @keyframes mobile-menu-reveal {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0.96;
    }

    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes mobile-menu-close {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0.98;
      transform: translateY(-100%);
    }
  }

  @keyframes mobile-menu-link-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--size-8) * -1));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes mobile-menu-footer-in {
    from {
      opacity: 0;
      transform: translateY(var(--size-16));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-mobile-menu="open"]) .mobile-menu,
    :global(html[data-mobile-menu="open"]) .mobile-menu__link,
    :global(html[data-mobile-menu="open"]) .mobile-menu__footer {
      animation: none;
    }

    .mobile-menu__link,
    .mobile-menu__footer {
      opacity: 1;
      transform: none;
    }
  }

  @media (width < 64rem) {
    .topbar {
      inset-inline-start: 0;
      padding-inline: 0;
    }

    .mobile-menu {
      inset-inline-start: 0;
    }

    .mobile-menu__link {
      --menu-link-padding-inline: var(--site-padding-inline);
    }

    .topbar__mobile-brand {
      display: block;
    }

    .topbar__mobile-brand .brand__mark {
      background: var(--color-background-canvas);
    }

    .topbar__mobile-brand .brand__mark i {
      background: var(--color-background-accent);
    }

    .topbar__note {
      display: none;
    }

    .utility-item--time {
      border-right: 0;
    }

    .topbar__menu-button {
      border-inline-start: 0;
    }

    .topbar__actions :global(.topbar__contact-button.button) {
      display: none;
    }
  }

  @media (width < 32.5rem) {
    .utility-item--availability {
      border-right: 0;
    }

    .utility-item--time {
      display: none;
    }
  }

  @media (width < 48rem) {
    .topbar__actions {
      justify-content: flex-end;
    }
  }
</style>
