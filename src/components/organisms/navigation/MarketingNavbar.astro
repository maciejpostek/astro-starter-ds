---
import { ChevronDown, Menu } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import Button from "../../atoms/actions/Button.astro";
import IconButton from "../../atoms/actions/IconButton.astro";
import MegaMenu from "./MegaMenu.astro";
import type {
  MegaMenuFeaturedItem,
  MegaMenuGroup,
  MegaMenuVariant,
} from "./MegaMenu.astro";
import MobileNavigation from "./MobileNavigation.astro";
import type { MobileNavigationVariant } from "./MobileNavigation.astro";

export type MarketingNavbarVariant = "simple" | "centered" | "mega-menu";

export interface MarketingNavbarItem {
  href: string;
  label: string;
  isCurrent?: boolean;
}

export interface MarketingNavbarAction {
  href: string;
  label: string;
}

export interface MarketingNavbarMegaMenu {
  triggerLabel: string;
  label?: string;
  variant?: MegaMenuVariant;
  groups: MegaMenuGroup[];
  featured?: MegaMenuFeaturedItem;
}

type Props = {
  id: string;
  items: MarketingNavbarItem[];
  brandLabel?: string;
  brandHref?: string;
  navigationLabel?: string;
  variant?: MarketingNavbarVariant;
  action?: MarketingNavbarAction;
  megaMenu?: MarketingNavbarMegaMenu;
  mobileVariant?: MobileNavigationVariant;
  megaMenuOpen?: boolean;
  mobileOpen?: boolean;
  sticky?: boolean;
  preview?: boolean;
  componentName?: string;
  class?: string;
} & Omit<
  HTMLAttributes<"header">,
  "class" | "id" | "aria-label"
>;

const {
  id,
  items,
  brandLabel = "Home",
  brandHref = "/",
  navigationLabel = "Primary navigation",
  variant = "simple",
  action,
  megaMenu,
  mobileVariant = "drawer",
  megaMenuOpen = false,
  mobileOpen = false,
  sticky = false,
  preview = false,
  componentName = "MarketingNavbar",
  class: className,
  ...attributes
} = Astro.props;

const variants: MarketingNavbarVariant[] = [
  "simple",
  "centered",
  "mega-menu",
];
const mobileVariants: MobileNavigationVariant[] = ["drawer", "fullscreen"];
const normalize = (value: string) => value.trim();
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);

const normalizedId = normalize(id);
const normalizedBrandLabel = normalize(brandLabel);
const normalizedBrandHref = normalize(brandHref);
const normalizedNavigationLabel = normalize(navigationLabel);
const normalizedComponentName = normalize(componentName);
const normalizedItems = items.map((item) => ({
  href: normalize(item.href),
  label: normalize(item.label),
  isCurrent: item.isCurrent === true,
}));
const normalizedAction = action
  ? {
      href: normalize(action.href),
      label: normalize(action.label),
    }
  : undefined;
const normalizedMegaMenu = megaMenu
  ? {
      triggerLabel: normalize(megaMenu.triggerLabel),
      label: normalize(megaMenu.label ?? `${megaMenu.triggerLabel} navigation`),
      variant: megaMenu.variant ?? "columns",
      groups: megaMenu.groups.map((group) => ({
        label: normalize(group.label),
        items: group.items.map((item) => ({
          href: normalize(item.href),
          label: normalize(item.label),
          description: item.description
            ? normalize(item.description)
            : undefined,
          isCurrent: item.isCurrent === true,
        })),
      })),
      featured: megaMenu.featured
        ? {
            eyebrow: normalize(megaMenu.featured.eyebrow),
            title: normalize(megaMenu.featured.title),
            description: normalize(megaMenu.featured.description),
            href: normalize(megaMenu.featured.href),
            actionLabel: normalize(megaMenu.featured.actionLabel),
          }
        : undefined,
    }
  : undefined;

if (!/^[A-Za-z][A-Za-z0-9:_-]*$/.test(normalizedId)) {
  throw new Error(
    "MarketingNavbar id must start with a letter and contain only letters, numbers, colon, underscore, or hyphen.",
  );
}
if (
  !normalizedBrandLabel ||
  !normalizedNavigationLabel ||
  !normalizedComponentName
) {
  throw new Error(
    "MarketingNavbar requires non-empty brandLabel, navigationLabel, and componentName values.",
  );
}
if (!isRealHref(normalizedBrandHref)) {
  throw new Error(
    "MarketingNavbar requires a real non-placeholder brandHref.",
  );
}
if (!variants.includes(variant)) {
  throw new Error(
    `MarketingNavbar received unsupported variant "${String(variant)}".`,
  );
}
if (!mobileVariants.includes(mobileVariant)) {
  throw new Error(
    `MarketingNavbar received unsupported mobileVariant "${String(mobileVariant)}".`,
  );
}
if (
  normalizedItems.some(
    (item) => !item.label || !isRealHref(item.href),
  )
) {
  throw new Error(
    "MarketingNavbar items require non-empty labels and real non-placeholder href values.",
  );
}
if (variant === "mega-menu" && !normalizedMegaMenu) {
  throw new Error(
    'MarketingNavbar variant="mega-menu" requires a complete megaMenu configuration.',
  );
}
if (variant !== "mega-menu" && normalizedMegaMenu) {
  throw new Error(
    "MarketingNavbar accepts megaMenu content only for the mega-menu variant.",
  );
}
if (
  normalizedMegaMenu &&
  (!normalizedMegaMenu.triggerLabel || !normalizedMegaMenu.label)
) {
  throw new Error(
    "MarketingNavbar megaMenu requires non-empty triggerLabel and label values.",
  );
}
if (
  normalizedAction &&
  (!normalizedAction.label || !isRealHref(normalizedAction.href))
) {
  throw new Error(
    "MarketingNavbar action requires a non-empty label and a real non-placeholder href.",
  );
}

const megaMenuItems =
  normalizedMegaMenu?.groups.flatMap((group) => group.items) ?? [];
const allNavigationItems = [...normalizedItems, ...megaMenuItems];

if (allNavigationItems.length === 0) {
  throw new Error(
    "MarketingNavbar requires at least one navigable destination.",
  );
}
if (
  new Set(allNavigationItems.map((item) => item.href)).size !==
  allNavigationItems.length
) {
  throw new Error(
    "MarketingNavbar destination href values must be unique across direct and mega-menu items.",
  );
}
if (allNavigationItems.filter((item) => item.isCurrent).length > 1) {
  throw new Error(
    "MarketingNavbar accepts at most one current navigation destination.",
  );
}

const megaMenuId = `${normalizedId}-mega-menu`;
const mobileNavigationId = `${normalizedId}-mobile-navigation`;
const megaMenuContainsCurrent = megaMenuItems.some((item) => item.isCurrent);
const state = mobileOpen ? "mobile-open" : sticky ? "sticky" : "default";
const hasBrandArtwork = Astro.slots.has("brand");
---

<header
  {...attributes}
  id={normalizedId}
  class:list={[
    "marketing-navbar",
    sticky && "marketing-navbar--sticky",
    preview && "marketing-navbar--preview",
    className,
  ]}
  data-component-name={normalizedComponentName}
  data-component-family="navigation"
  data-marketing-navbar
  data-marketing-navbar-variant={variant}
  data-marketing-navbar-state={state}
  data-marketing-navbar-sticky={sticky ? true : undefined}
  data-preview-target
>
  <div class="marketing-navbar__inner">
    <a
      class="marketing-navbar__brand"
      href={normalizedBrandHref}
      aria-label={normalizedBrandLabel}
    >
      {
        hasBrandArtwork ? (
          <span class="marketing-navbar__brand-artwork" aria-hidden="true">
            <slot name="brand" />
          </span>
        ) : (
          <span>{normalizedBrandLabel}</span>
        )
      }
    </a>

    <nav
      class="marketing-navbar__desktop-navigation"
      aria-label={normalizedNavigationLabel}
    >
      <ul>
        {
          normalizedItems.map((item) => (
            <li>
              <a
                class="marketing-navbar__link"
                href={item.href}
                aria-current={item.isCurrent ? "page" : undefined}
                data-navigation-state={item.isCurrent ? "current" : "default"}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          variant === "mega-menu" && normalizedMegaMenu && (
            <li>
              <Button
                class="marketing-navbar__mega-trigger"
                variant="link"
                size="small"
                data-mega-menu-trigger
                data-navigation-state={
                  megaMenuContainsCurrent ? "current" : "default"
                }
                aria-controls={megaMenuId}
                aria-expanded={megaMenuOpen}
                aria-haspopup="true"
              >
                {normalizedMegaMenu.triggerLabel}
                <ChevronDown slot="icon" aria-hidden="true" />
              </Button>
            </li>
          )
        }
      </ul>
    </nav>

    <div class="marketing-navbar__actions">
      {
        normalizedAction && (
          <Button
            class="marketing-navbar__primary-action"
            href={normalizedAction.href}
            size="medium"
            showIcon={false}
          >
            {normalizedAction.label}
          </Button>
        )
      }
      <IconButton
        class="marketing-navbar__mobile-trigger"
        label={`Open ${normalizedNavigationLabel.toLocaleLowerCase()}`}
        size="medium"
        data-mobile-navigation-trigger
        aria-controls={mobileNavigationId}
        aria-expanded={mobileOpen}
      >
        <Menu aria-hidden="true" />
      </IconButton>
    </div>
  </div>

  {
    variant === "mega-menu" && normalizedMegaMenu && (
      <MegaMenu
        id={megaMenuId}
        groups={normalizedMegaMenu.groups}
        label={normalizedMegaMenu.label}
        variant={normalizedMegaMenu.variant}
        featured={normalizedMegaMenu.featured}
        open={megaMenuOpen}
        preview={preview}
      />
    )
  }

  <MobileNavigation
    id={mobileNavigationId}
    items={allNavigationItems}
    label={normalizedNavigationLabel}
    variant={mobileVariant}
    open={mobileOpen}
    preview={preview}
  >
    {
      normalizedAction && (
        <Button
          slot="footer"
          href={normalizedAction.href}
          size="medium"
          full
        >
          {normalizedAction.label}
        </Button>
      )
    }
  </MobileNavigation>
</header>

<style>
  .marketing-navbar {
    position: relative;
    z-index: 35;
    width: 100%;
    min-width: 0;
    border-block-end:
      var(--border-width-default) solid
      var(--color-border-subtle);
    background: var(--color-background-canvas);
    color: var(--color-text-primary);
  }

  .marketing-navbar--sticky {
    position: sticky;
    top: 0;
  }

  .marketing-navbar--preview {
    position: relative;
    top: auto;
  }

  .marketing-navbar__inner {
    display: grid;
    width:
      min(
        var(--container-content),
        calc(100% - 2 * var(--site-padding-inline))
      );
    min-width: 0;
    min-height: var(--app-topbar-height);
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-large);
    margin-inline: auto;
  }

  .marketing-navbar[data-marketing-navbar-variant="centered"]
    .marketing-navbar__inner {
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  .marketing-navbar__brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    justify-self: start;
    color: var(--color-text-primary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
    text-decoration: none;
    text-transform: var(--text-transform-uppercase);
  }

  .marketing-navbar__brand:focus-visible,
  .marketing-navbar__link:focus-visible {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-4);
  }

  .marketing-navbar__brand-artwork {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
  }

  .marketing-navbar__brand-artwork :global(svg),
  .marketing-navbar__brand-artwork :global(img),
  .marketing-navbar__brand-artwork :global(picture) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .marketing-navbar__desktop-navigation {
    min-width: 0;
    justify-self: end;
  }

  .marketing-navbar[data-marketing-navbar-variant="centered"]
    .marketing-navbar__desktop-navigation {
    justify-self: center;
  }

  .marketing-navbar__desktop-navigation ul {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--gap-large);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marketing-navbar__link {
    display: inline-flex;
    min-height: var(--app-topbar-height);
    align-items: center;
    border-block-end:
      var(--border-width-strong) solid
      transparent;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
    text-decoration: none;
    transition:
      border-color var(--motion-transition),
      color var(--motion-transition);
  }

  .marketing-navbar__link:hover,
  .marketing-navbar__link[aria-current="page"] {
    border-block-end-color: var(--color-border-accent);
    color: var(--color-text-primary);
  }

  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button) {
    min-height: var(--app-topbar-height);
    border-block-end:
      var(--border-width-strong) solid
      transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-emphasis);
    text-transform: none;
  }

  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button:hover),
  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button[aria-expanded="true"]),
  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button[data-navigation-state="current"]) {
    border-block-end-color: var(--color-border-accent);
    color: var(--color-text-primary);
  }

  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button .button__icon) {
    transition: transform var(--motion-transition);
  }

  .marketing-navbar__desktop-navigation
    :global(.marketing-navbar__mega-trigger.button[aria-expanded="true"] .button__icon) {
    transform: rotate(180deg);
  }

  .marketing-navbar__actions {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-self: end;
    gap: var(--gap-small);
  }

  .marketing-navbar__mobile-trigger {
    display: none;
  }

  @media (width < 64rem) {
    .marketing-navbar__inner,
    .marketing-navbar[data-marketing-navbar-variant="centered"]
      .marketing-navbar__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--gap-medium);
    }

    .marketing-navbar__desktop-navigation {
      display: none;
    }

    .marketing-navbar__mobile-trigger {
      display: inline-grid;
    }
  }

  @media (width < 40rem) {
    .marketing-navbar__inner {
      width: min(100%, calc(100% - 2 * var(--size-16)));
      gap: var(--gap-small);
    }

    .marketing-navbar__primary-action {
      display: none;
    }
  }
</style>
