---
import type { HTMLAttributes } from "astro/types";
import Logo from "../../atoms/media/Logo.astro";
import ContentBlock from "../../molecules/content/ContentBlock.astro";

export type FooterVariant = "simple" | "columns" | "cta" | "legal";

export interface FooterLink {
  href: string;
  label: string;
}

export interface FooterGroup {
  label: string;
  links: FooterLink[];
}

export interface FooterCta {
  title: string;
  body: string;
  actionLabel: string;
  actionHref: string;
  eyebrow?: string;
}

export interface FooterContent {
  brandLabel: string;
  brandHref?: string;
  description?: string;
  primaryLinks?: FooterLink[];
  groups?: FooterGroup[];
  legalLinks?: FooterLink[];
  legalText: string;
  cta?: FooterCta;
}

type Props = {
  content: FooterContent;
  variant?: FooterVariant;
  navigationLabel?: string;
  legalNavigationLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"footer">, "class">;

const {
  content,
  variant = "columns",
  navigationLabel = "Footer navigation",
  legalNavigationLabel = "Legal navigation",
  componentName = "Footer",
  class: className,
  ...attributes
} = Astro.props;

const variants: FooterVariant[] = ["simple", "columns", "cta", "legal"];
const normalize = (value: string) => value.trim();
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);
const normalizeLink = (link: FooterLink) => ({
  href: normalize(link.href),
  label: normalize(link.label),
});

if (!content || typeof content !== "object") {
  throw new Error("Footer requires a structured content object.");
}

const normalizedBrandLabel = normalize(content.brandLabel);
const normalizedBrandHref = content.brandHref?.trim();
const normalizedDescription = content.description?.trim();
const normalizedLegalText = normalize(content.legalText);
const normalizedNavigationLabel = normalize(navigationLabel);
const normalizedLegalNavigationLabel = normalize(legalNavigationLabel);
const normalizedComponentName = normalize(componentName);
const primaryLinks = (content.primaryLinks ?? []).map(normalizeLink);
const groups = (content.groups ?? []).map((group) => ({
  label: normalize(group.label),
  links: group.links.map(normalizeLink),
}));
const legalLinks = (content.legalLinks ?? []).map(normalizeLink);
const cta = content.cta
  ? {
      title: normalize(content.cta.title),
      body: normalize(content.cta.body),
      actionLabel: normalize(content.cta.actionLabel),
      actionHref: normalize(content.cta.actionHref),
      eyebrow: content.cta.eyebrow?.trim(),
    }
  : undefined;
const hasBrandArtwork = Astro.slots.has("brand");

if (!variants.includes(variant)) {
  throw new Error(`Footer received unsupported variant "${String(variant)}".`);
}
if (
  !normalizedBrandLabel ||
  !normalizedLegalText ||
  !normalizedNavigationLabel ||
  !normalizedLegalNavigationLabel ||
  !normalizedComponentName
) {
  throw new Error(
    "Footer requires non-empty brandLabel, legalText, navigation labels, and componentName values.",
  );
}
if (
  normalizedBrandHref !== undefined &&
  !isRealHref(normalizedBrandHref)
) {
  throw new Error("Footer brandHref must be a real non-placeholder URL.");
}

const allNavigationLinks = [
  ...primaryLinks,
  ...groups.flatMap((group) => group.links),
  ...legalLinks,
];
if (
  allNavigationLinks.some(
    (link) => !link.label || !isRealHref(link.href),
  )
) {
  throw new Error(
    "Footer links require non-empty labels and real non-placeholder href values.",
  );
}
if (
  new Set(allNavigationLinks.map((link) => link.href)).size !==
  allNavigationLinks.length
) {
  throw new Error("Footer destination href values must be unique.");
}
if (
  groups.some((group) => !group.label || group.links.length === 0) ||
  new Set(groups.map((group) => group.label)).size !== groups.length
) {
  throw new Error(
    "Footer groups require unique non-empty labels and at least one destination.",
  );
}
if (
  cta &&
  (!cta.title ||
    !cta.body ||
    !cta.actionLabel ||
    !isRealHref(cta.actionHref))
) {
  throw new Error(
    "Footer CTA requires a title, body, action label, and real destination.",
  );
}

if (
  variant === "simple" &&
  (primaryLinks.length === 0 || groups.length > 0 || cta)
) {
  throw new Error(
    "Footer variant simple requires primaryLinks and does not accept groups or CTA content.",
  );
}
if (
  variant === "columns" &&
  (groups.length === 0 || primaryLinks.length > 0 || cta)
) {
  throw new Error(
    "Footer variant columns requires groups and does not accept primaryLinks or CTA content.",
  );
}
if (
  variant === "cta" &&
  (!cta || groups.length === 0 || primaryLinks.length > 0)
) {
  throw new Error(
    "Footer variant cta requires CTA content and groups and does not accept primaryLinks.",
  );
}
if (
  variant === "legal" &&
  (legalLinks.length === 0 ||
    primaryLinks.length > 0 ||
    groups.length > 0 ||
    cta ||
    normalizedDescription)
) {
  throw new Error(
    "Footer variant legal requires legalLinks and does not accept description, primaryLinks, groups, or CTA content.",
  );
}
---

<footer
  {...attributes}
  class:list={["footer", className]}
  data-component-name={normalizedComponentName}
  data-component-family="navigation"
  data-footer
  data-footer-variant={variant}
  data-preview-target
>
  <div class="l-container footer__container" data-container="main">
    {
      cta && (
        <div class="footer__cta">
          <ContentBlock
            title={cta.title}
            body={cta.body}
            eyebrow={cta.eyebrow}
            actionLabel={cta.actionLabel}
            actionHref={cta.actionHref}
            headingLevel={2}
            componentName={`${normalizedComponentName}.ContentBlock`}
          />
        </div>
      )
    }

    <div class="footer__main">
      <div class="footer__brand">
        {
          hasBrandArtwork ? (
            normalizedBrandHref ? (
              <a
                class="footer__brand-link"
                href={normalizedBrandHref}
                aria-label={normalizedBrandLabel}
              >
                <Logo
                  label={normalizedBrandLabel}
                  componentName={`${normalizedComponentName}.Logo`}
                >
                  <slot name="brand" />
                </Logo>
              </a>
            ) : (
              <Logo
                label={normalizedBrandLabel}
                componentName={`${normalizedComponentName}.Logo`}
              >
                <slot name="brand" />
              </Logo>
            )
          ) : normalizedBrandHref ? (
            <a class="footer__brand-link" href={normalizedBrandHref}>
              {normalizedBrandLabel}
            </a>
          ) : (
            <span class="footer__brand-label">{normalizedBrandLabel}</span>
          )
        }
        {
          normalizedDescription && (
            <p class="footer__description">{normalizedDescription}</p>
          )
        }
      </div>

      {
        primaryLinks.length > 0 && (
          <nav class="footer__navigation" aria-label={normalizedNavigationLabel}>
            <ul class="footer__link-row">
              {primaryLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        groups.length > 0 && (
          <nav class="footer__navigation" aria-label={normalizedNavigationLabel}>
            <div class="footer__groups">
              {groups.map((group) => (
                <section class="footer__group">
                  <h2>{group.label}</h2>
                  <ul>
                    {group.links.map((link) => (
                      <li><a href={link.href}>{link.label}</a></li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </nav>
        )
      }
    </div>

    <div class="footer__legal">
      <p>{normalizedLegalText}</p>
      {
        legalLinks.length > 0 && (
          <nav aria-label={normalizedLegalNavigationLabel}>
            <ul>
              {legalLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    min-width: 0;
    border-block-start:
      var(--border-width-default) solid
      var(--color-border-subtle);
    background: var(--color-background-surface);
    color: var(--color-text-primary);
  }

  .footer__container {
    display: grid;
    min-width: 0;
    gap: var(--gap-xlarge);
    padding-block: var(--section-padding-small);
  }

  .footer__cta {
    border-block-end:
      var(--border-width-default) solid
      var(--color-border-subtle);
    padding-block-end: var(--gap-xlarge);
  }

  .footer__main {
    display: grid;
    min-width: 0;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 2fr);
    gap: var(--gap-xlarge);
  }

  .footer[data-footer-variant="legal"] .footer__main {
    grid-template-columns: minmax(0, 1fr);
  }

  .footer__brand {
    display: grid;
    min-width: 0;
    align-content: start;
    justify-items: start;
    gap: var(--gap-medium);
  }

  .footer__brand-link,
  .footer__brand-label {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    text-decoration: none;
  }

  .footer__description {
    max-width: var(--grid-auto-min-width-panel);
    margin: 0;
    color: var(--color-text-secondary);
  }

  .footer__navigation,
  .footer__groups,
  .footer__group,
  .footer__group ul,
  .footer__link-row,
  .footer__legal,
  .footer__legal ul {
    min-width: 0;
  }

  .footer__groups {
    display: grid;
    grid-template-columns:
      repeat(
        auto-fit,
        minmax(min(100%, var(--grid-auto-min-width-small)), 1fr)
      );
    gap: var(--gap-large);
  }

  .footer__group {
    display: grid;
    align-content: start;
    gap: var(--gap-regular);
  }

  .footer__group h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--text-style-body-small-line-height);
  }

  .footer__group ul,
  .footer__link-row,
  .footer__legal ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__group ul {
    flex-direction: column;
    gap: var(--gap-small);
  }

  .footer__link-row,
  .footer__legal ul {
    flex-wrap: wrap;
    gap: var(--gap-regular) var(--gap-large);
  }

  .footer a:not(.footer__brand-link) {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: var(--size-4);
  }

  .footer a:focus-visible {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }

  .footer__legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-medium);
    border-block-start:
      var(--border-width-default) solid
      var(--color-border-subtle);
    padding-block-start: var(--gap-large);
    color: var(--color-text-tertiary);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    line-height: var(--text-style-body-small-line-height);
  }

  .footer__legal p {
    margin: 0;
  }

  @media (width < 48rem) {
    .footer__main {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer__legal {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
