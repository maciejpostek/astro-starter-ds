---
import { X } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import IconButton from "../../atoms/actions/IconButton.astro";
import MenuLink from "../../molecules/navigation/MenuLink.astro";

export type MobileNavigationVariant = "drawer" | "fullscreen";

export interface MobileNavigationItem {
  href: string;
  label: string;
  isCurrent?: boolean;
}

type Props = {
  id: string;
  items: MobileNavigationItem[];
  label?: string;
  closeLabel?: string;
  variant?: MobileNavigationVariant;
  open?: boolean;
  preview?: boolean;
  componentName?: string;
  class?: string;
} & Omit<
  HTMLAttributes<"div">,
  "class" | "id" | "role" | "aria-label" | "aria-hidden" | "aria-modal"
>;

const {
  id,
  items,
  label = "Mobile navigation",
  closeLabel = "Close navigation",
  variant = "drawer",
  open = false,
  preview = false,
  componentName = "MobileNavigation",
  class: className,
  ...attributes
} = Astro.props;

const variants: MobileNavigationVariant[] = ["drawer", "fullscreen"];
const normalizedId = id.trim();
const normalizedLabel = label.trim();
const normalizedCloseLabel = closeLabel.trim();
const normalizedComponentName = componentName.trim();
const normalizedItems = items.map((item) => ({
  href: item.href.trim(),
  label: item.label.trim(),
  isCurrent: item.isCurrent === true,
}));

if (!/^[A-Za-z][A-Za-z0-9:_-]*$/.test(normalizedId)) {
  throw new Error(
    "MobileNavigation id must start with a letter and contain only letters, numbers, colon, underscore, or hyphen.",
  );
}
if (
  !normalizedLabel ||
  !normalizedCloseLabel ||
  !normalizedComponentName
) {
  throw new Error(
    "MobileNavigation requires non-empty label, closeLabel, and componentName values.",
  );
}
if (!variants.includes(variant)) {
  throw new Error(
    `MobileNavigation received unsupported variant "${String(variant)}".`,
  );
}
if (normalizedItems.length === 0) {
  throw new Error("MobileNavigation requires at least one navigation item.");
}
if (
  normalizedItems.some(
    (item) => !item.label || !item.href || item.href === "#",
  )
) {
  throw new Error(
    "MobileNavigation items require non-empty labels and real non-placeholder href values.",
  );
}
if (
  new Set(normalizedItems.map((item) => item.href)).size !==
  normalizedItems.length
) {
  throw new Error("MobileNavigation item href values must be unique.");
}
if (normalizedItems.filter((item) => item.isCurrent).length > 1) {
  throw new Error(
    "MobileNavigation accepts at most one current navigation item.",
  );
}

const hasFooter = Astro.slots.has("footer");
---

<div
  {...attributes}
  id={normalizedId}
  class:list={["mobile-navigation", preview && "mobile-navigation--preview", className]}
  data-component-name={normalizedComponentName}
  data-component-family="navigation"
  data-mobile-navigation
  data-mobile-navigation-preview={preview ? true : undefined}
  data-mobile-navigation-variant={variant}
  data-mobile-navigation-state={open ? "open" : "closed"}
  data-preview-target
  role="dialog"
  aria-modal="true"
  aria-label={normalizedLabel}
  aria-hidden={open ? "false" : "true"}
  hidden={!open}
>
  <button
    class="mobile-navigation__backdrop"
    type="button"
    aria-label={normalizedCloseLabel}
    data-mobile-navigation-close
  ></button>
  <div class="mobile-navigation__panel" data-mobile-navigation-panel tabindex="-1">
    <header class="mobile-navigation__header">
      <strong>{normalizedLabel}</strong>
      <IconButton
        label={normalizedCloseLabel}
        size="medium"
        data-mobile-navigation-close
      >
        <X aria-hidden="true" />
      </IconButton>
    </header>
    <nav class="mobile-navigation__nav" aria-label={normalizedLabel}>
      {
        normalizedItems.map((item) => (
          <MenuLink
            href={item.href}
            label={item.label}
            isCurrent={item.isCurrent}
            data-mobile-navigation-link
          />
        ))
      }
    </nav>
    {
      hasFooter && (
        <footer class="mobile-navigation__footer">
          <slot name="footer" />
        </footer>
      )
    }
  </div>
</div>

<script>
  interface MobileNavigationRuntime {
    abortController: AbortController;
    triggerByPanel: WeakMap<HTMLElement, HTMLElement>;
  }

  const mobileNavigationWindow = window as Window & {
    __astroDsMobileNavigationRuntime?: MobileNavigationRuntime;
  };
  mobileNavigationWindow.__astroDsMobileNavigationRuntime?.abortController.abort();

  const mobileNavigationAbortController = new AbortController();
  const mobileNavigationSignal = mobileNavigationAbortController.signal;
  const mobileNavigationTriggerByPanel = new WeakMap<HTMLElement, HTMLElement>();
  mobileNavigationWindow.__astroDsMobileNavigationRuntime = {
    abortController: mobileNavigationAbortController,
    triggerByPanel: mobileNavigationTriggerByPanel,
  };

  const getMobileNavigationPanel = (id: string | null) => {
    if (!id) return null;
    const panel = document.getElementById(id);
    return panel?.matches("[data-mobile-navigation]") ? panel : null;
  };

  const getMobileNavigationTriggers = (panel: HTMLElement) =>
    Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-mobile-navigation-trigger][aria-controls]",
      ),
    ).filter((trigger) => trigger.getAttribute("aria-controls") === panel.id);

  const getMobileNavigationFocusables = (panel: HTMLElement) =>
    Array.from(
      panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter(
      (element) =>
        !element.hasAttribute("hidden") &&
        element.getAttribute("aria-hidden") !== "true",
    );

  const syncMobileNavigationBodyState = () => {
    document.body.classList.toggle(
      "has-mobile-navigation",
      Boolean(
        document.querySelector(
          '[data-mobile-navigation][data-mobile-navigation-state="open"]:not([data-mobile-navigation-preview]):not([hidden])',
        ),
      ),
    );
  };

  const closeMobileNavigation = (
    panel: HTMLElement,
    restoreFocus = true,
  ) => {
    panel.dataset.mobileNavigationState = "closed";
    panel.setAttribute("aria-hidden", "true");
    panel.hidden = true;
    getMobileNavigationTriggers(panel).forEach((trigger) =>
      trigger.setAttribute("aria-expanded", "false"),
    );
    syncMobileNavigationBodyState();
    if (restoreFocus) {
      mobileNavigationTriggerByPanel.get(panel)?.focus();
    }
  };

  const openMobileNavigation = (
    panel: HTMLElement,
    trigger?: HTMLElement,
  ) => {
    document
      .querySelectorAll<HTMLElement>(
        '[data-mobile-navigation][data-mobile-navigation-state="open"]',
      )
      .forEach((openPanel) => {
        if (openPanel !== panel) closeMobileNavigation(openPanel, false);
      });

    if (trigger) mobileNavigationTriggerByPanel.set(panel, trigger);
    panel.hidden = false;
    panel.dataset.mobileNavigationState = "open";
    panel.setAttribute("aria-hidden", "false");
    getMobileNavigationTriggers(panel).forEach((candidate) =>
      candidate.setAttribute("aria-expanded", "true"),
    );
    syncMobileNavigationBodyState();
    requestAnimationFrame(() => {
      const focusTarget =
        panel.querySelector<HTMLElement>("[data-mobile-navigation-panel]") ??
        getMobileNavigationFocusables(panel)[0];
      focusTarget?.focus();
    });
  };

  document
    .querySelectorAll<HTMLElement>("[data-mobile-navigation]")
    .forEach((panel) => {
      const shouldOpen =
        panel.dataset.mobileNavigationState === "open" && !panel.hidden;
      panel.hidden = !shouldOpen;
      panel.setAttribute("aria-hidden", shouldOpen ? "false" : "true");
      getMobileNavigationTriggers(panel).forEach((trigger) =>
        trigger.setAttribute("aria-expanded", String(shouldOpen)),
      );
    });
  syncMobileNavigationBodyState();

  document.addEventListener(
    "click",
    (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest<HTMLElement>(
        "[data-mobile-navigation-trigger]",
      );
      if (trigger) {
        const panel = getMobileNavigationPanel(
          trigger.getAttribute("aria-controls"),
        );
        if (!panel) return;
        panel.dataset.mobileNavigationState === "open"
          ? closeMobileNavigation(panel)
          : openMobileNavigation(panel, trigger);
        return;
      }

      const panel = target?.closest<HTMLElement>("[data-mobile-navigation]");
      if (!panel) return;
      if (target?.closest("[data-mobile-navigation-close]")) {
        closeMobileNavigation(panel);
        return;
      }
      if (target?.closest("[data-mobile-navigation-link]")) {
        closeMobileNavigation(panel, false);
      }
    },
    { signal: mobileNavigationSignal },
  );

  document.addEventListener(
    "keydown",
    (event) => {
      const panel = document.querySelector<HTMLElement>(
        '[data-mobile-navigation][data-mobile-navigation-state="open"]:not([hidden])',
      );
      if (!panel) return;

      if (event.key === "Escape") {
        event.preventDefault();
        closeMobileNavigation(panel);
        return;
      }
      if (event.key !== "Tab") return;

      const focusables = getMobileNavigationFocusables(panel);
      if (focusables.length === 0) {
        event.preventDefault();
        panel.querySelector<HTMLElement>("[data-mobile-navigation-panel]")?.focus();
        return;
      }

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    },
    { signal: mobileNavigationSignal },
  );
</script>

<style>
  .mobile-navigation {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    min-width: 0;
    justify-items: end;
  }

  .mobile-navigation[hidden] {
    display: none;
  }

  .mobile-navigation--preview {
    position: relative;
    height: calc(var(--sidebar-icon-column) * 6);
    overflow: hidden;
  }

  .mobile-navigation--preview .mobile-navigation__panel {
    height: 100%;
  }

  .mobile-navigation__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: var(--color-background-overlay);
  }

  .mobile-navigation__panel {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, var(--grid-auto-min-width-wide));
    min-width: 0;
    height: 100dvh;
    flex-direction: column;
    overflow: auto;
    border-inline-start: var(--border-width-default) solid
      var(--color-border-subtle);
    background: var(--color-background-canvas);
    animation:
      mobile-navigation-enter
      var(--motion-duration-mobile-menu-reveal)
      var(--motion-ease-premium-out)
      both;
    outline: 0;
  }

  .mobile-navigation[data-mobile-navigation-variant="fullscreen"]
    .mobile-navigation__panel {
    width: 100%;
    border-inline-start: 0;
  }

  .mobile-navigation__header {
    display: flex;
    min-height: var(--app-topbar-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-regular);
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-small) var(--site-padding-inline);
  }

  .mobile-navigation__header strong {
    color: var(--color-text-primary);
    font-size: var(--text-style-heading-h6-font-size);
  }

  .mobile-navigation__nav {
    display: grid;
  }

  .mobile-navigation__nav :global(.menu-link) {
    --menu-link-padding-inline: var(--site-padding-inline);
  }

  .mobile-navigation__footer {
    margin-top: auto;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--site-padding-inline);
  }

  :global(body.has-mobile-navigation) {
    overflow: hidden;
  }

  @keyframes mobile-navigation-enter {
    from {
      opacity: 0;
      transform: translateX(var(--size-24));
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .mobile-navigation[data-mobile-navigation-variant="fullscreen"]
    .mobile-navigation__panel {
    animation-name: mobile-navigation-fullscreen-enter;
  }

  @keyframes mobile-navigation-fullscreen-enter {
    from {
      opacity: 0;
      transform: translateY(calc(var(--size-16) * -1));
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

</style>
