---
import { ArrowLeft, ArrowRight, FileText, X } from "@lucide/astro";
import Button from "../../atoms/actions/Button.astro";
import IconButton from "../../atoms/actions/IconButton.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import Avatar from "../../atoms/media/Avatar.astro";
import BulletPoint from "../../atoms/content/BulletPoint.astro";

interface StageDrawerData {
  id: string;
  number: string;
  name: string;
  category: string;
  detailedDescription: string;
  estimatedDays: number;
  owner?: string;
  ownerImage?: string;
  ownerImageAlt?: string;
  substeps: string[];
  goals: string[];
  activities: string[];
  deliverables: string[];
}
interface Props {
  id?: string;
  stages: StageDrawerData[];
  preview?: boolean;
}

const { id = "stage-drawer", stages, preview = false } = Astro.props;
---

<div id={id} class:list={["drawer-layer", preview && "drawer-layer--preview"]} data-component-name="StageDrawer" data-sidepanel-state={preview ? "open" : "closed"} data-stage-drawer data-sidepanel-runtime={preview ? undefined : "true"} hidden={!preview}>
  <button class="drawer-backdrop" type="button" data-close-drawer aria-label="Close panel"></button>
  <aside class="drawer" role="dialog" aria-modal="true" aria-label="Process stage details">
    <div class="drawer__topbar">
      <Tag data-stage-category>Process stage</Tag>
      <IconButton type="button" data-close-drawer label="Close panel">
        <X />
      </IconButton>
    </div>
    <div class="drawer__content" data-stage-content></div>
    <div class="drawer__footer">
      <Button variant="secondary" size="small" type="button" showIcon data-stage-previous>
        Previous
        <ArrowLeft slot="icon" />
      </Button>
      <span data-stage-counter>1 of {stages.length}</span>
      <Button variant="secondary" size="small" type="button" showIcon data-stage-next>
        Next
        <ArrowRight slot="icon" />
      </Button>
    </div>
  </aside>
</div>

<style>
  .drawer-layer--preview { position: relative; inset: auto; z-index: auto; display: block; width: 100%; min-height: 32rem; }
  .drawer-layer--preview :global(.drawer-backdrop) { display: none; }
  .drawer-layer--preview :global(.drawer) { position: relative; inset: auto; width: 100%; height: 32rem; }
</style>

{
  stages.map((stage) => (
    <template data-stage-drawer-owner={id} data-stage-template={stage.id} data-stage-category-value={stage.category}>
      <div class="drawer__title">
        <span>{stage.number}</span>
        <h2>{stage.name}</h2>
        <p>{stage.detailedDescription}</p>
      </div>
      <div class="drawer__meta">
        <div>
          <span>Estimated effort</span>
          <strong>{stage.estimatedDays} days</strong>
        </div>
        <div>
          <span>Assignee</span>
          <span class="assignee-stack">
            <Avatar src={stage.ownerImage} alt={stage.ownerImageAlt ?? ""} name={stage.owner ?? "Unassigned"} size="small" />
            <span class="assignee-stack__label">{stage.owner ?? "Unassigned"}</span>
          </span>
        </div>
      </div>
      <section class="drawer-section">
        <h3>Substeps</h3>
        <ol class="number-list">
          {stage.substeps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
      <section class="drawer-section">
        <h3>Goals</h3>
        <ul class="check-list">
          {stage.goals.map((goal) => (
            <li><BulletPoint text={goal} componentSize="small" /></li>
          ))}
        </ul>
      </section>
      <section class="drawer-section">
        <h3>Activities</h3>
        <div class="tag-list tag-list--compact">
          {stage.activities.map((activity) => <Tag>{activity}</Tag>)}
        </div>
      </section>
      <section class="drawer-section">
        <h3>Outputs & deliverables</h3>
        <div class="output-list">
          {stage.deliverables.map((deliverable) => (
            <div>
              <FileText />
              <span>{deliverable}</span>
            </div>
          ))}
        </div>
      </section>
    </template>
  ))
}

{!preview && <script>
  type StageDrawerWindow = Window & { __astroDsStageDrawerReady?: boolean };
  const stageDrawerWindow = window as StageDrawerWindow;
  if (!stageDrawerWindow.__astroDsStageDrawerReady) {
    stageDrawerWindow.__astroDsStageDrawerReady = true;
    let currentStageIndex = 0;
    let restoreStageFocus: HTMLElement | null = null;

    const runtimeDrawer = (drawerId?: string) => {
      const selected = drawerId ? document.getElementById(drawerId) : null;
      if (selected?.matches("[data-stage-drawer][data-sidepanel-runtime]")) return selected;
      return document.querySelector<HTMLElement>("[data-stage-drawer][data-sidepanel-runtime]");
    };

    const stageTemplates = (drawer: HTMLElement) =>
      Array.from(document.querySelectorAll<HTMLTemplateElement>(
        `[data-stage-drawer-owner="${CSS.escape(drawer.id)}"][data-stage-template]`
      ));

    const renderStage = (drawer: HTMLElement, index: number) => {
      const templates = stageTemplates(drawer);
      const template = templates[index];
      const content = drawer.querySelector<HTMLElement>("[data-stage-content]");
      if (!template || !content) return;
      currentStageIndex = index;
      content.replaceChildren(template.content.cloneNode(true));
      const category = drawer.querySelector<HTMLElement>("[data-stage-category]");
      if (category) category.textContent = template.dataset.stageCategoryValue ?? "Process stage";
      const counter = drawer.querySelector<HTMLElement>("[data-stage-counter]");
      if (counter) counter.textContent = `${index + 1} of ${templates.length}`;
      const previous = drawer.querySelector<HTMLButtonElement>("[data-stage-previous]");
      const next = drawer.querySelector<HTMLButtonElement>("[data-stage-next]");
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === templates.length - 1;
    };

    const closeStageDrawer = (drawer = runtimeDrawer()) => {
      if (!drawer || drawer.hidden) return;
      drawer.hidden = true;
      drawer.dataset.sidepanelState = "closed";
      document.body.classList.remove("has-overlay");
      restoreStageFocus?.focus();
      restoreStageFocus = null;
    };

    const openStageDrawer = (stageId: string, opener?: HTMLElement | null, drawerId?: string) => {
      const drawer = runtimeDrawer(drawerId);
      if (!drawer) return;
      const index = stageTemplates(drawer).findIndex(
        (template) => template.dataset.stageTemplate === stageId
      );
      if (index < 0) return;
      restoreStageFocus = opener ?? document.activeElement as HTMLElement | null;
      renderStage(drawer, index);
      drawer.hidden = false;
      drawer.dataset.sidepanelState = "open";
      document.body.classList.add("has-overlay");
      drawer.querySelector<HTMLElement>("[data-close-drawer]")?.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const opener = target?.closest<HTMLElement>("[data-open-stage-drawer]");
      const stageId = opener?.dataset.openStageDrawer;
      if (stageId) {
        openStageDrawer(stageId, opener, opener.dataset.stageDrawerTarget);
        return;
      }
      const drawer = target?.closest<HTMLElement>("[data-stage-drawer]");
      if (target?.closest("[data-close-drawer]")) {
        closeStageDrawer(drawer);
      } else if (drawer && target?.closest("[data-stage-previous]")) {
        renderStage(drawer, Math.max(0, currentStageIndex - 1));
      } else if (drawer && target?.closest("[data-stage-next]")) {
        renderStage(drawer, Math.min(stageTemplates(drawer).length - 1, currentStageIndex + 1));
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeStageDrawer();
    });
  }
</script>}
