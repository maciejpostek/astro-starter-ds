---
import { Link2, X } from "@lucide/astro";
import Button from "../../atoms/actions/Button.astro";
import IconButton from "../../atoms/actions/IconButton.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import BulletPoint from "../../atoms/content/BulletPoint.astro";

interface ProjectDrawerData { slug: string; title: string; type: "case-study" | "project"; industry: string; summary: string; date: string; scope: string; problem: string; solution: string; architecture: string[]; outputs: string[]; stack: string[]; image: string; imageAlt: string; }
interface Props {
  id?: string;
  projects: ProjectDrawerData[];
  preview?: boolean;
}

const { id = "project-drawer", projects, preview = false } = Astro.props;
---

<div id={id} class:list={["drawer-layer", preview && "drawer-layer--preview"]} data-component-name="ProjectDrawer" data-sidepanel-state={preview ? "open" : "closed"} data-project-drawer data-case-drawer data-sidepanel-runtime={preview ? undefined : "true"} hidden={!preview}>
  <button class="drawer-backdrop" type="button" data-close-case aria-label="Close panel"></button>
  <aside class="drawer drawer--case" role="dialog" aria-modal="true" aria-label="Project details">
    <div class="drawer__topbar">
      <Tag variant="accent" data-project-drawer-type>Case Study</Tag>
      <IconButton type="button" data-close-case label="Close panel">
        <X />
      </IconButton>
    </div>
    <div class="drawer__content" data-case-content></div>
    <div class="drawer__footer drawer__footer--case">
      <span>Shareable project context</span>
      <Button
        variant="link"
        size="small"
        showIcon
        type="button"
        data-clipboard-copy
        data-clipboard-source="current-url"
        data-clipboard-copied-label="Copied"
      >
        <span data-clipboard-label>Copy link</span>
        <Link2 slot="icon" />
      </Button>
    </div>
  </aside>
</div>

<style>
  .drawer-layer--preview { position: relative; inset: auto; z-index: auto; display: block; width: 100%; min-height: 32rem; }
  .drawer-layer--preview :global(.drawer-backdrop) { display: none; }
  .drawer-layer--preview :global(.drawer) { position: relative; inset: auto; width: 100%; height: 32rem; }
</style>

{
  projects.map((project) => (
    <template data-project-drawer-owner={id} data-case-template={project.slug} data-project-type-label={project.type === "case-study" ? "Case Study" : "Project"}>
      <div class="case-drawer-image">
        <img src={project.image} alt={project.imageAlt} />
      </div>
      <div class="drawer__title">
        <span>{project.industry}</span>
        <h2>{project.title}</h2>
        <p>{project.summary}</p>
      </div>
      <div class="drawer__meta">
        <div>
          <span>Date</span>
          <strong>{project.date}</strong>
        </div>
        <div>
          <span>Scope</span>
          <strong>{project.scope}</strong>
        </div>
      </div>
      <section class="drawer-section">
        <h3>Problem</h3>
        <p class="drawer-copy">{project.problem}</p>
      </section>
      <section class="drawer-section">
        <h3>Solution</h3>
        <p class="drawer-copy">{project.solution}</p>
      </section>
      <section class="drawer-section">
        <h3>System architecture</h3>
        <div class="architecture-list">
          {project.architecture.map((layer, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{layer}</strong>
            </div>
          ))}
        </div>
      </section>
      <section class="drawer-section">
        <h3>Outputs</h3>
        <ul class="check-list">
          {project.outputs.map((output) => (
            <li><BulletPoint text={output} componentSize="small" /></li>
          ))}
        </ul>
      </section>
      <section class="drawer-section">
        <h3>Stack</h3>
        <div class="tag-list tag-list--compact">
          {project.stack.map((item) => <Tag>{item}</Tag>)}
        </div>
      </section>
    </template>
  ))
}

{!preview && <script>
  type ProjectDrawerWindow = Window & { __astroDsProjectDrawerReady?: boolean };
  const projectDrawerWindow = window as ProjectDrawerWindow;
  if (!projectDrawerWindow.__astroDsProjectDrawerReady) {
    projectDrawerWindow.__astroDsProjectDrawerReady = true;
    let restoreFocus: HTMLElement | null = null;

    const runtimeDrawer = (drawerId?: string) => {
      const selected = drawerId ? document.getElementById(drawerId) : null;
      if (selected?.matches("[data-project-drawer][data-sidepanel-runtime]")) return selected;
      return document.querySelector<HTMLElement>("[data-project-drawer][data-sidepanel-runtime]");
    };

    const closeProjectDrawer = (drawer = runtimeDrawer()) => {
      if (!drawer || drawer.hidden) return;
      drawer.hidden = true;
      drawer.dataset.sidepanelState = "closed";
      document.body.classList.remove("has-overlay");
      const url = new URL(window.location.href);
      url.searchParams.delete("case");
      history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
      restoreFocus?.focus();
      restoreFocus = null;
    };

    const openProjectDrawer = (slug: string, updateUrl = true, opener?: HTMLElement | null, drawerId?: string) => {
      const drawer = runtimeDrawer(drawerId);
      if (!drawer) return;
      const template = document.querySelector<HTMLTemplateElement>(
        `[data-project-drawer-owner="${CSS.escape(drawer.id)}"][data-case-template="${CSS.escape(slug)}"]`
      );
      const content = drawer.querySelector<HTMLElement>("[data-case-content]");
      if (!template || !content) return;
      content.replaceChildren(template.content.cloneNode(true));
      const type = drawer.querySelector<HTMLElement>("[data-project-drawer-type]");
      if (type) type.textContent = template.dataset.projectTypeLabel ?? "Project";
      restoreFocus = opener ?? document.activeElement as HTMLElement | null;
      drawer.hidden = false;
      drawer.dataset.sidepanelState = "open";
      document.body.classList.add("has-overlay");
      drawer.querySelector<HTMLElement>("[data-close-case]")?.focus();
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("case", slug);
        history.replaceState({}, "", url);
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const opener = target?.closest<HTMLElement>("[data-open-case]");
      const slug = opener?.dataset.openCase;
      if (slug) {
        openProjectDrawer(slug, true, opener, opener.dataset.projectDrawerTarget);
        return;
      }
      const close = target?.closest("[data-close-case]");
      if (close) closeProjectDrawer(close.closest<HTMLElement>("[data-project-drawer]"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeProjectDrawer();
    });

    const initialProject = new URLSearchParams(window.location.search).get("case");
    if (initialProject) openProjectDrawer(initialProject, false);
  }
</script>}
