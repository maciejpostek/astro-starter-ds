---
import { X } from "@lucide/astro";
import IconButton from "../../atoms/actions/IconButton.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import type { TimelineStageData } from "../../molecules/timeline/types";

interface Props {
  id: string;
  stages: Pick<TimelineStageData, "id" | "number" | "name" | "category" | "detailedDescription" | "deliverables">[];
  preview?: boolean;
}
const { id, stages, preview = false } = Astro.props;
---
<dialog id={id} class:list={["timeline-modal", preview && "timeline-modal--preview"]} data-component-name="TimelineModal" data-timeline-modal data-overlay-state={preview ? "open" : "closed"} open={preview || undefined} aria-label="Timeline stage details">
  <div class="timeline-modal__top"><Tag data-timeline-modal-category>{stages[0]?.category ?? "Stage"}</Tag><IconButton type="button" data-close-timeline-modal label="Close stage details"><X /></IconButton></div>
  <div class="timeline-modal__content" data-timeline-modal-content>
    {preview && stages[0] && <><span>{stages[0].number}</span><h2>{stages[0].name}</h2><p>{stages[0].detailedDescription}</p></>}
  </div>
</dialog>
{stages.map((stage) => <template data-timeline-modal-owner={id} data-timeline-stage-template={stage.id} data-timeline-stage-category={stage.category}><span>{stage.number}</span><h2>{stage.name}</h2><p>{stage.detailedDescription}</p><ul>{stage.deliverables.map((item) => <li>{item}</li>)}</ul></template>)}
{!preview && <script>
  type TimelineWindow = Window & { __astroDsTimelineModalReady?: boolean };
  const timelineWindow = window as TimelineWindow;
  if (!timelineWindow.__astroDsTimelineModalReady) {
    timelineWindow.__astroDsTimelineModalReady = true;
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const opener = target?.closest<HTMLElement>("[data-open-timeline-stage]");
      const stageId = opener?.dataset.openTimelineStage;
      const modalId = opener?.dataset.timelineModalTarget;
      const modal = modalId ? document.getElementById(modalId) : null;
      if (stageId && modalId && modal instanceof HTMLDialogElement) {
        const content = modal.querySelector<HTMLElement>("[data-timeline-modal-content]");
        const category = modal.querySelector<HTMLElement>("[data-timeline-modal-category]");
        const template = document.querySelector<HTMLTemplateElement>(
          `[data-timeline-modal-owner="${CSS.escape(modalId)}"][data-timeline-stage-template="${CSS.escape(stageId)}"]`
        );
        if (content && template) content.replaceChildren(template.content.cloneNode(true));
        if (category && template) category.textContent = template.dataset.timelineStageCategory ?? "Stage";
        if (!modal.open) modal.showModal();
        modal.dataset.overlayState = "open";
      }
      const close = target?.closest("[data-close-timeline-modal]");
      const closeModal = close?.closest<HTMLDialogElement>("dialog[data-timeline-modal]");
      closeModal?.close();
    });
    document.addEventListener("close", (event) => {
      const modal = event.target;
      if (modal instanceof HTMLDialogElement && modal.matches("[data-timeline-modal]")) {
        modal.dataset.overlayState = "closed";
      }
    }, true);
  }
</script>}
<style>
  .timeline-modal { width: min(calc(100% - 2 * var(--site-padding-inline)), 40rem); border: var(--border-width-default) solid var(--color-border-subtle); border-radius: var(--radius-small); background: var(--color-background-canvas); color: var(--color-text-primary); padding: 0; }
  .timeline-modal::backdrop { background: var(--color-background-overlay); }
  .timeline-modal--preview { position: relative; inset: auto; margin: 0; }
  .timeline-modal__top { display: flex; min-height: var(--size-56); align-items: center; justify-content: space-between; border-bottom: var(--border-width-default) solid var(--color-border-subtle); padding: var(--component-padding-medium); }
  .timeline-modal__content { padding: var(--component-padding-large); }
  .timeline-modal__content h2 { margin-top: var(--space-small); font-size: var(--font-size-h5); }
  .timeline-modal__content p, .timeline-modal__content ul { margin-top: var(--space-medium); color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
</style>
