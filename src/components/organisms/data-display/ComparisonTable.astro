---
import { CircleCheck, CircleMinus } from "@lucide/astro";
interface Column { key:string; label:string; highlighted?:boolean; }
interface Row { label:string; values:Record<string,string|boolean>; }
interface Props { caption:string; columns:Column[]; rows:Row[]; componentName?:string; }
const {caption,columns,rows,componentName="ComparisonTable"}=Astro.props;
---
<div class="comparison-table" data-component-name={componentName} data-component-family="data-display"><table><caption>{caption}</caption><thead><tr><th scope="col">Feature</th>{columns.map(column=><th scope="col" data-highlighted={column.highlighted||undefined}>{column.label}</th>)}</tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row.label}</th>{columns.map(column=><td data-highlighted={column.highlighted||undefined}>{typeof row.values[column.key]==="boolean"?(row.values[column.key]?<span class="comparison-table__boolean" aria-label="Included"><CircleCheck aria-hidden="true" /></span>:<span class="comparison-table__boolean" aria-label="Not included"><CircleMinus aria-hidden="true" /></span>):row.values[column.key]}</td>)}</tr>)}</tbody></table></div>
<style>
  .comparison-table{width:100%;overflow-x:auto;border:var(--border-width-default) solid var(--color-border-default)}table{width:100%;border-collapse:collapse;min-width:36rem}caption{padding:var(--component-padding-small);text-align:left;font-weight:var(--font-weight-emphasis)}th,td{border-top:var(--border-width-default) solid var(--color-border-subtle);padding:var(--component-padding-small);text-align:left;font-size:var(--font-size-body-small)}thead th{background:var(--color-background-subtle)}[data-highlighted="true"]{background:color-mix(in oklab,var(--color-background-accent) 8%,var(--color-background-canvas))}tbody th{font-weight:var(--font-weight-normal)}.comparison-table__boolean{display:inline-flex}.comparison-table__boolean :global(svg){width:var(--size-18);height:var(--size-18)}
</style>
