---
import type { HTMLAttributes } from "astro/types";
import NavBanner from "../../navigation/NavBanner.astro";

export type AnnouncementBarSectionVariant = "neutral" | "accent";

type Props = {
  title: string;
  description?: string;
  href?: string;
  actionLabel?: string;
  dismissible?: boolean;
  variant?: AnnouncementBarSectionVariant;
  sectionId?: string;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "class" | "id" | "aria-label">;

const {
  title,
  description,
  href,
  actionLabel = "Learn more",
  dismissible = true,
  variant = "accent",
  sectionId,
  ariaLabel = "Site announcement",
  componentName = "AnnouncementBarSection",
  class: className,
  ...attributes
} = Astro.props;

const variants: AnnouncementBarSectionVariant[] = ["neutral", "accent"];
const normalizedTitle = title.trim();
const normalizedDescription = description?.trim();
const normalizedHref = href?.trim();
const normalizedActionLabel = actionLabel.trim();
const normalizedSectionId = sectionId?.trim();
const normalizedAriaLabel = ariaLabel.trim();
const normalizedComponentName = componentName.trim();

if (!variants.includes(variant)) {
  throw new Error(
    `AnnouncementBarSection received unsupported variant "${String(variant)}".`,
  );
}
if (!normalizedTitle || !normalizedAriaLabel || !normalizedComponentName) {
  throw new Error(
    "AnnouncementBarSection requires non-empty title, ariaLabel, and componentName values.",
  );
}
if (sectionId !== undefined && !normalizedSectionId) {
  throw new Error(
    "AnnouncementBarSection sectionId must be non-empty when provided.",
  );
}
if (href !== undefined && (!normalizedHref || normalizedHref === "#")) {
  throw new Error(
    "AnnouncementBarSection href must be a real non-placeholder URL.",
  );
}
if (normalizedHref && !normalizedActionLabel) {
  throw new Error(
    "AnnouncementBarSection requires a non-empty actionLabel when href is set.",
  );
}
---

<section
  {...attributes}
  id={normalizedSectionId}
  class:list={["l-section", "announcement-bar-section", className]}
  data-padding="none"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="global-shell"
  data-section-type="announcement-bar"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel}
>
  <div class="l-container" data-container="full">
    <NavBanner
      title={normalizedTitle}
      description={normalizedDescription}
      href={normalizedHref}
      actionLabel={normalizedActionLabel}
      dismissible={dismissible}
      tone={variant}
      componentName={`${normalizedComponentName}.Banner`}
    />
  </div>
</section>

<style>
  .announcement-bar-section {
    min-width: 0;
  }
</style>
