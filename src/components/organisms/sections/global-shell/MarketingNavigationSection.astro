---
import type { HTMLAttributes } from "astro/types";
import MarketingNavbar from "../../navigation/MarketingNavbar.astro";
import type {
  MarketingNavbarAction,
  MarketingNavbarItem,
  MarketingNavbarMegaMenu,
  MarketingNavbarVariant,
} from "../../navigation/MarketingNavbar.astro";
import type { MobileNavigationVariant } from "../../navigation/MobileNavigation.astro";

export type MarketingNavigationSectionVariant = "simple" | "centered" | "mega-enabled";

export interface MarketingNavigationSectionContent {
  id: string;
  items: MarketingNavbarItem[];
  brandLabel?: string;
  brandHref?: string;
  navigationLabel?: string;
  action?: MarketingNavbarAction;
  megaMenu?: MarketingNavbarMegaMenu;
  mobileVariant?: MobileNavigationVariant;
}

type Props = {
  content: MarketingNavigationSectionContent;
  variant?: MarketingNavigationSectionVariant;
  sectionId?: string;
  ariaLabel?: string;
  componentName?: string;
  preview?: boolean;
  class?: string;
} & Omit<HTMLAttributes<"section">, "class" | "id" | "aria-label">;

const {
  content,
  variant = "simple",
  sectionId,
  ariaLabel = "Marketing navigation",
  componentName = "MarketingNavigationSection",
  preview = false,
  class: className,
  ...attributes
} = Astro.props;

const variants: MarketingNavigationSectionVariant[] = [
  "simple",
  "centered",
  "mega-enabled",
];
const normalizedSectionId = sectionId?.trim();
const normalizedAriaLabel = ariaLabel.trim();
const normalizedComponentName = componentName.trim();
const navbarVariant: MarketingNavbarVariant =
  variant === "mega-enabled" ? "mega-menu" : variant;
const hasBrandArtwork = Astro.slots.has("brand");

if (!variants.includes(variant)) {
  throw new Error(
    `MarketingNavigationSection received unsupported variant "${String(variant)}".`,
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "MarketingNavigationSection requires a structured content object.",
  );
}
if (!normalizedAriaLabel || !normalizedComponentName) {
  throw new Error(
    "MarketingNavigationSection requires non-empty ariaLabel and componentName values.",
  );
}
if (sectionId !== undefined && !normalizedSectionId) {
  throw new Error(
    "MarketingNavigationSection sectionId must be non-empty when provided.",
  );
}

const navbarProps = {
  id: content.id,
  items: content.items,
  brandLabel: content.brandLabel,
  brandHref: content.brandHref,
  navigationLabel: content.navigationLabel,
  variant: navbarVariant,
  action: content.action,
  megaMenu: content.megaMenu,
  mobileVariant: content.mobileVariant,
  preview,
  componentName: `${normalizedComponentName}.Navbar`,
};
---

<section
  {...attributes}
  id={normalizedSectionId}
  class:list={["l-section", "marketing-navigation-section", className]}
  data-padding="none"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="global-shell"
  data-section-type="marketing-navigation"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel}
>
  {
    hasBrandArtwork ? (
      <MarketingNavbar {...navbarProps}>
        <Fragment slot="brand">
          <slot name="brand" />
        </Fragment>
      </MarketingNavbar>
    ) : (
      <MarketingNavbar {...navbarProps} />
    )
  }
</section>

<style>
  .marketing-navigation-section {
    min-width: 0;
  }
</style>
