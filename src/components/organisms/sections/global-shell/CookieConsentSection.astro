---
import type { HTMLAttributes } from "astro/types";
import Button from "../../../atoms/actions/Button.astro";
import ButtonGroup from "../../../molecules/actions/ButtonGroup.astro";

export type CookieConsentSectionVariant = "banner" | "modal";
export type CookieConsentChoice = "accept-all" | "reject-nonessential";

export interface CookieConsentSectionContent {
  title: string;
  description: string;
  acceptLabel: string;
  rejectLabel: string;
  policyLabel?: string;
  policyHref?: string;
  preferencesLabel?: string;
  preferencesHref?: string;
}

type Props = {
  id: string;
  content: CookieConsentSectionContent;
  variant?: CookieConsentSectionVariant;
  open?: boolean;
  preview?: boolean;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "class" | "id" | "aria-label">;

const {
  id,
  content,
  variant = "banner",
  open = true,
  preview = false,
  ariaLabel = "Cookie consent",
  componentName = "CookieConsentSection",
  class: className,
  ...attributes
} = Astro.props;

const variants: CookieConsentSectionVariant[] = ["banner", "modal"];
const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);
const normalizedId = id.trim();
const normalizedAriaLabel = ariaLabel.trim();
const normalizedComponentName = componentName.trim();

if (!variants.includes(variant)) {
  throw new Error(
    `CookieConsentSection received unsupported variant "${String(variant)}".`,
  );
}
if (!selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "CookieConsentSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("CookieConsentSection requires a structured content object.");
}
if (!normalizedAriaLabel || !normalizedComponentName) {
  throw new Error(
    "CookieConsentSection requires non-empty ariaLabel and componentName values.",
  );
}

const normalizedContent = {
  title: content.title.trim(),
  description: content.description.trim(),
  acceptLabel: content.acceptLabel.trim(),
  rejectLabel: content.rejectLabel.trim(),
  policyLabel: content.policyLabel?.trim(),
  policyHref: content.policyHref?.trim(),
  preferencesLabel: content.preferencesLabel?.trim(),
  preferencesHref: content.preferencesHref?.trim(),
};

if (
  !normalizedContent.title ||
  !normalizedContent.description ||
  !normalizedContent.acceptLabel ||
  !normalizedContent.rejectLabel
) {
  throw new Error(
    "CookieConsentSection requires non-empty title, description, acceptLabel, and rejectLabel values.",
  );
}
if (
  Boolean(normalizedContent.policyLabel) !==
  Boolean(normalizedContent.policyHref)
) {
  throw new Error(
    "CookieConsentSection policyLabel and policyHref must be provided together.",
  );
}
if (
  normalizedContent.policyHref &&
  !isRealHref(normalizedContent.policyHref)
) {
  throw new Error(
    "CookieConsentSection policyHref must be a real non-placeholder URL.",
  );
}
if (
  Boolean(normalizedContent.preferencesLabel) !==
  Boolean(normalizedContent.preferencesHref)
) {
  throw new Error(
    "CookieConsentSection preferencesLabel and preferencesHref must be provided together.",
  );
}
if (
  normalizedContent.preferencesHref &&
  !isRealHref(normalizedContent.preferencesHref)
) {
  throw new Error(
    "CookieConsentSection preferencesHref must be a real non-placeholder URL.",
  );
}

const titleId = `${normalizedId}-title`;
const descriptionId = `${normalizedId}-description`;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "cookie-consent-section", className]}
  data-padding="none"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="global-shell"
  data-section-type="cookie-consent"
  data-section-variant={variant}
  data-cookie-consent
  data-cookie-consent-preview={preview ? "" : undefined}
  data-cookie-consent-state={open ? "visible" : "hidden"}
  data-preview-target
  role={variant === "modal" ? "dialog" : undefined}
  aria-modal={variant === "modal" && !preview ? "true" : undefined}
  aria-label={normalizedAriaLabel}
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
  aria-hidden={open ? "false" : "true"}
  hidden={!open}
>
  <div class="l-container cookie-consent-section__container" data-container="main">
    <div class="cookie-consent-section__surface">
      <div class="cookie-consent-section__content">
        <h2 id={titleId}>{normalizedContent.title}</h2>
        <p id={descriptionId}>
          {normalizedContent.description}
          {
            normalizedContent.policyHref && (
              <>
                {" "}
                <a href={normalizedContent.policyHref}>
                  {normalizedContent.policyLabel}
                </a>
              </>
            )
          }
        </p>
      </div>

      <ButtonGroup class="cookie-consent-section__actions">
        <Button
          type="button"
          size="small"
          variant="primary"
          showIcon={false}
          data-cookie-consent-choice="accept-all"
          componentName={`${normalizedComponentName}.Accept`}
        >
          {normalizedContent.acceptLabel}
        </Button>
        <Button
          type="button"
          size="small"
          variant="secondary"
          showIcon={false}
          data-cookie-consent-choice="reject-nonessential"
          componentName={`${normalizedComponentName}.Reject`}
        >
          {normalizedContent.rejectLabel}
        </Button>
        {
          normalizedContent.preferencesHref && (
            <Button
              href={normalizedContent.preferencesHref}
              size="small"
              variant="link"
              showIcon={false}
              componentName={`${normalizedComponentName}.Preferences`}
            >
              {normalizedContent.preferencesLabel}
            </Button>
          )
        }
      </ButtonGroup>
    </div>
  </div>
</section>

<script>
  type CookieConsentChoice = "accept-all" | "reject-nonessential";

  interface CookieConsentRuntimeWindow extends Window {
    __astroDsCookieConsentRuntime?: AbortController;
  }

  const runtimeWindow = window as CookieConsentRuntimeWindow;
  runtimeWindow.__astroDsCookieConsentRuntime?.abort();
  const cookieConsentController = new AbortController();
  runtimeWindow.__astroDsCookieConsentRuntime = cookieConsentController;
  const cookieConsentSignal = cookieConsentController.signal;

  const getVisibleModal = () =>
    document.querySelector<HTMLElement>(
      '[data-cookie-consent][data-section-variant="modal"]:not([hidden]):not([data-cookie-consent-preview])',
    );

  const getFocusableControls = (root: HTMLElement) =>
    Array.from(
      root.querySelectorAll<HTMLElement>(
        'button:not([disabled]), a[href]:not([aria-disabled="true"])',
      ),
    );

  const synchronizeModal = () => {
    const modal = getVisibleModal();
    document.body.toggleAttribute("data-cookie-consent-modal-open", Boolean(modal));
    if (modal && !modal.contains(document.activeElement)) {
      getFocusableControls(modal)[0]?.focus();
    }
  };

  document.addEventListener(
    "click",
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const control = target.closest<HTMLElement>("[data-cookie-consent-choice]");
      const root = control?.closest<HTMLElement>("[data-cookie-consent]");
      if (!control || !root) return;

      const choice = control.dataset.cookieConsentChoice as
        | CookieConsentChoice
        | undefined;
      if (
        choice !== "accept-all" &&
        choice !== "reject-nonessential"
      ) {
        return;
      }

      root.dataset.cookieConsentState = choice;
      root.dispatchEvent(
        new CustomEvent("cookie-consent-choice", {
          bubbles: true,
          detail: { choice },
        }),
      );

      if (!root.hasAttribute("data-cookie-consent-preview")) {
        root.hidden = true;
        root.setAttribute("aria-hidden", "true");
        synchronizeModal();
      }
    },
    { signal: cookieConsentSignal },
  );

  document.addEventListener(
    "keydown",
    (event) => {
      const modal = getVisibleModal();
      if (!modal || event.key !== "Tab") return;
      const controls = getFocusableControls(modal);
      if (controls.length === 0) return;
      const first = controls[0];
      const last = controls[controls.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    },
    { signal: cookieConsentSignal },
  );

  document.addEventListener(
    "focusin",
    () => {
      const modal = getVisibleModal();
      if (modal && !modal.contains(document.activeElement)) {
        getFocusableControls(modal)[0]?.focus();
      }
    },
    { signal: cookieConsentSignal },
  );

  document.addEventListener(
    "astro:page-load",
    synchronizeModal,
    { signal: cookieConsentSignal },
  );

  synchronizeModal();
</script>

<style>
  .cookie-consent-section {
    min-width: 0;
    color: var(--color-text-primary);
  }

  .cookie-consent-section__container {
    min-width: 0;
  }

  .cookie-consent-section__surface {
    display: grid;
    min-width: 0;
    align-items: center;
    gap: var(--gap-large);
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
    box-shadow: var(--elevation-surface-raised);
  }

  .cookie-consent-section[data-section-variant="banner"]
    .cookie-consent-section__surface {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .cookie-consent-section[data-section-variant="modal"]
    .cookie-consent-section__container {
    display: grid;
    place-items: center;
  }

  .cookie-consent-section[data-section-variant="modal"]
    .cookie-consent-section__surface {
    width: min(100%, var(--grid-auto-min-width-wide));
  }

  .cookie-consent-section:not([data-cookie-consent-preview]) {
    position: fixed;
    z-index: 60;
    inset-inline: 0;
    inset-block-end: 0;
  }

  .cookie-consent-section[data-section-variant="modal"]:not(
      [data-cookie-consent-preview]
    ) {
    display: grid;
    min-height: 100dvh;
    place-items: center;
    inset: 0;
    background: var(--color-background-overlay);
  }

  .cookie-consent-section__content {
    display: grid;
    min-width: 0;
    gap: var(--gap-small);
  }

  .cookie-consent-section h2,
  .cookie-consent-section p {
    margin: 0;
  }

  .cookie-consent-section h2 {
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
  }

  .cookie-consent-section p {
    max-width: var(--grid-auto-min-width-wide);
    color: var(--color-text-secondary);
  }

  .cookie-consent-section a:not(.button) {
    color: var(--color-text-primary);
    text-underline-offset: var(--size-4);
  }

  :global(body[data-cookie-consent-modal-open]) {
    overflow: hidden;
  }

  @media (width < 64rem) {
    .cookie-consent-section[data-section-variant="banner"]
      .cookie-consent-section__surface {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .cookie-consent-section__surface {
      padding: var(--component-padding-medium);
    }

    .cookie-consent-section__actions {
      width: 100%;
    }

    .cookie-consent-section__actions :global(.button) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
