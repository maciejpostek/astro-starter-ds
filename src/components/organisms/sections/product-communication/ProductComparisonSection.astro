---
import type { HTMLAttributes } from "astro/types";
import Button from "../../../atoms/actions/Button.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";
import ComparisonTable from "../../data-display/ComparisonTable.astro";

export type ProductComparisonSectionVariant =
  "comparison" | "alternatives";

export interface ProductComparisonColumn {
  key: string;
  label: string;
  highlighted?: boolean;
}

export interface ProductComparisonRow {
  label: string;
  values: Record<string, string | boolean>;
}

export interface ProductComparisonAction {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "link";
}

export interface ProductComparisonSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  caption: string;
  columns: ProductComparisonColumn[];
  rows: ProductComparisonRow[];
  action?: ProductComparisonAction;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: ProductComparisonSectionContent;
  variant: ProductComparisonSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "ProductComparisonSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/\S+|\/(?!\/)\S*)$/i;
const supportedVariants: ProductComparisonSectionVariant[] = [
  "comparison",
  "alternatives",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const supportedActionVariants = ["primary", "secondary", "link"] as const;
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedCaption = content?.caption?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "ProductComparisonSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "ProductComparisonSection requires a structured content object.",
  );
}
if (!normalizedTitle || !normalizedDescription || !normalizedCaption) {
  throw new Error(
    "ProductComparisonSection requires non-empty title, description, and caption values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "ProductComparisonSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `ProductComparisonSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `ProductComparisonSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "ProductComparisonSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "ProductComparisonSection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("ProductComparisonSection does not expose public slots.");
}
if (
  !Array.isArray(content.columns) ||
  content.columns.length < 2 ||
  content.columns.length > 4
) {
  throw new Error(
    "ProductComparisonSection requires two to four comparison columns.",
  );
}
if (
  !Array.isArray(content.rows) ||
  content.rows.length < 2 ||
  content.rows.length > 12
) {
  throw new Error(
    "ProductComparisonSection requires two to twelve comparison rows.",
  );
}

const columnKeys = new Set<string>();
let highlightedColumns = 0;
const normalizedColumns = content.columns.map((column, index) => {
  const key = column?.key?.trim();
  const label = column?.label?.trim();
  if (!key || !selectorSafePattern.test(key) || !label) {
    throw new Error(
      `ProductComparisonSection column ${index + 1} requires a selector-safe key and non-empty label.`,
    );
  }
  if (columnKeys.has(key)) {
    throw new Error(
      `ProductComparisonSection contains duplicate column key "${key}".`,
    );
  }
  columnKeys.add(key);
  if (column.highlighted) highlightedColumns += 1;
  return {
    key,
    label,
    highlighted: column.highlighted ?? false,
  };
});

if (highlightedColumns > 1) {
  throw new Error(
    "ProductComparisonSection supports at most one highlighted column.",
  );
}

const rowLabels = new Set<string>();
const normalizedRows = content.rows.map((row, rowIndex) => {
  const label = row?.label?.trim();
  if (!label) {
    throw new Error(
      `ProductComparisonSection row ${rowIndex + 1} requires a non-empty label.`,
    );
  }
  if (rowLabels.has(label)) {
    throw new Error(
      `ProductComparisonSection contains duplicate row label "${label}".`,
    );
  }
  rowLabels.add(label);
  if (!row.values || typeof row.values !== "object") {
    throw new Error(
      `ProductComparisonSection row "${label}" requires a complete values object.`,
    );
  }

  const valueKeys = Object.keys(row.values);
  if (
    valueKeys.length !== normalizedColumns.length ||
    valueKeys.some((key) => !columnKeys.has(key))
  ) {
    throw new Error(
      `ProductComparisonSection row "${label}" must define exactly one value for every column.`,
    );
  }

  const values = Object.fromEntries(
    normalizedColumns.map((column) => {
      const value = row.values[column.key];
      if (typeof value !== "boolean") {
        const normalizedValue = value?.trim();
        if (!normalizedValue) {
          throw new Error(
            `ProductComparisonSection row "${label}" contains an empty text value.`,
          );
        }
        return [column.key, normalizedValue];
      }
      return [column.key, value];
    }),
  );

  return { label, values };
});

const action = content.action
  ? {
      label: content.action.label?.trim(),
      href: content.action.href?.trim(),
      variant: content.action.variant ?? "primary",
    }
  : undefined;

if (
  action &&
  (
    !action.label ||
    action.label.length > 18 ||
    !action.href ||
    !safeHrefPattern.test(action.href) ||
    !supportedActionVariants.includes(action.variant)
  )
) {
  throw new Error(
    "ProductComparisonSection action requires a one-to-eighteen-character label, safe supplied href, and supported variant.",
  );
}
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "product-comparison-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="product-communication"
  data-section-type="product-comparison"
  data-section-variant={variant}
  data-comparison-columns={normalizedColumns.length}
  data-comparison-rows={normalizedRows.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div
    class="l-container product-comparison-section__container"
    data-container="main"
  >
    <div class="product-comparison-section__introduction">
      <ContentBlock
        eyebrow={normalizedEyebrow}
        title={normalizedTitle}
        body={normalizedDescription}
        headingLevel={headingLevel}
        componentName={`${normalizedComponentName}.Header`}
      />

      {
        action && (
          <div class="product-comparison-section__action">
            <Button href={action.href} variant={action.variant}>
              {action.label}
            </Button>
          </div>
        )
      }
    </div>

    <div class="product-comparison-section__table">
      <ComparisonTable
        caption={normalizedCaption}
        columns={normalizedColumns}
        rows={normalizedRows}
        componentName={`${normalizedComponentName}.Table`}
      />
    </div>
  </div>
</section>

<style>
  .product-comparison-section,
  .product-comparison-section__container,
  .product-comparison-section__introduction,
  .product-comparison-section__table {
    min-width: 0;
  }

  .product-comparison-section {
    background: var(--color-background-canvas);
  }

  .product-comparison-section__container,
  .product-comparison-section__introduction {
    display: grid;
  }

  .product-comparison-section__container {
    max-width: var(--content-width-large);
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-xlarge);
  }

  .product-comparison-section__introduction {
    gap: var(--gap-large);
  }

  .product-comparison-section[data-section-variant="comparison"]
    .product-comparison-section__introduction {
    max-width: var(--content-width-medium);
  }

  .product-comparison-section[data-section-variant="alternatives"]
    .product-comparison-section__container {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    align-items: start;
  }

  .product-comparison-section__action {
    display: flex;
  }

  @media (width < 64rem) {
    .product-comparison-section[data-section-variant="alternatives"]
      .product-comparison-section__container {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .product-comparison-section__action :global(.button) {
      width: 100%;
    }
  }
</style>
