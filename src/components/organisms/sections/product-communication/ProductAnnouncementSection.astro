---
import type { HTMLAttributes } from "astro/types";
import type { MediaRatioValue } from "../../../atoms/media/types";
import Alert from "../../../molecules/data-display/Alert.astro";
import CalloutCard from "../../cards/CalloutCard.astro";
import NavBanner from "../../navigation/NavBanner.astro";
import type { PanelPatternVariant } from "../../../../data/panel-patterns";

export type ProductAnnouncementSectionVariant =
  "launch" | "promotion" | "status";

export interface ProductAnnouncementAction {
  label: string;
  href: string;
}

export interface ProductAnnouncementVisual {
  label?: string;
  ratio?: MediaRatioValue;
  variant?: PanelPatternVariant;
}

export interface ProductAnnouncementSectionContent {
  title: string;
  description?: string;
  eyebrow?: string;
  action?: ProductAnnouncementAction;
  visual?: ProductAnnouncementVisual;
  dismissible?: boolean;
  statusTone?: "info" | "success" | "warning" | "error";
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: ProductAnnouncementSectionContent;
  variant: ProductAnnouncementSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "ProductAnnouncementSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/\S+|\/(?!\/)\S*)$/i;
const supportedVariants: ProductAnnouncementSectionVariant[] = [
  "launch",
  "promotion",
  "status",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const supportedStatusTones = [
  "info",
  "success",
  "warning",
  "error",
] as const;
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "ProductAnnouncementSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "ProductAnnouncementSection requires a structured content object.",
  );
}
if (!normalizedTitle) {
  throw new Error(
    "ProductAnnouncementSection requires a non-empty title.",
  );
}
if (content.description !== undefined && !normalizedDescription) {
  throw new Error(
    "ProductAnnouncementSection description must be non-empty when provided.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "ProductAnnouncementSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `ProductAnnouncementSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `ProductAnnouncementSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "ProductAnnouncementSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "ProductAnnouncementSection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error(
    "ProductAnnouncementSection does not expose public slots.",
  );
}

const normalizedAction = content.action
  ? {
      label: content.action.label?.trim(),
      href: content.action.href?.trim(),
    }
  : undefined;
if (
  normalizedAction &&
  (
    !normalizedAction.label ||
    normalizedAction.label.length > 18 ||
    !normalizedAction.href ||
    !safeHrefPattern.test(normalizedAction.href)
  )
) {
  throw new Error(
    "ProductAnnouncementSection action requires a one-to-eighteen-character label and safe supplied href.",
  );
}

const normalizedVisualLabel = content.visual?.label?.trim();
if (content.visual?.label !== undefined && !normalizedVisualLabel) {
  throw new Error(
    "ProductAnnouncementSection visual label must be non-empty when provided.",
  );
}

if (variant === "launch") {
  if (!normalizedEyebrow || !normalizedAction) {
    throw new Error(
      "ProductAnnouncementSection Launch requires a non-empty eyebrow and one action.",
    );
  }
  if (
    content.description !== undefined ||
    content.dismissible !== undefined ||
    content.statusTone !== undefined
  ) {
    throw new Error(
      "ProductAnnouncementSection Launch rejects description, dismissible, and statusTone content.",
    );
  }
}

if (variant === "promotion") {
  if (
    content.eyebrow !== undefined ||
    content.visual !== undefined ||
    content.statusTone !== undefined
  ) {
    throw new Error(
      "ProductAnnouncementSection Promotion rejects eyebrow, visual, and statusTone content.",
    );
  }
}

if (variant === "status") {
  if (!normalizedDescription) {
    throw new Error(
      "ProductAnnouncementSection Status requires a non-empty description.",
    );
  }
  if (
    content.eyebrow !== undefined ||
    content.action !== undefined ||
    content.visual !== undefined
  ) {
    throw new Error(
      "ProductAnnouncementSection Status rejects eyebrow, action, and visual content.",
    );
  }
  if (
    content.statusTone !== undefined &&
    !supportedStatusTones.includes(content.statusTone)
  ) {
    throw new Error(
      "ProductAnnouncementSection Status received an unsupported statusTone.",
    );
  }
}

const calloutHeadingLevel = `h${headingLevel}` as "h2" | "h3";
const isDismissible =
  content.dismissible ?? (variant === "promotion");
const statusTone = content.statusTone ?? "info";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "product-announcement-section", className]}
  data-padding={variant === "promotion" ? "small" : "medium"}
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="product-communication"
  data-section-type="product-announcement"
  data-section-variant={variant}
  data-announcement-dismissible={isDismissible ? "true" : "false"}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div
    class="l-container product-announcement-section__container"
    data-container="main"
  >
    {
      variant === "launch" ? (
        <CalloutCard
          eyebrow={normalizedEyebrow!}
          title={normalizedTitle}
          action={normalizedAction!.label}
          href={normalizedAction!.href}
          visualLabel={normalizedVisualLabel}
          visualRatio={content.visual?.ratio}
          visualVariant={content.visual?.variant}
          headingLevel={calloutHeadingLevel}
          componentName={`${normalizedComponentName}.CalloutCard`}
        />
      ) : variant === "promotion" ? (
        <NavBanner
          title={normalizedTitle}
          description={normalizedDescription}
          href={normalizedAction?.href}
          actionLabel={normalizedAction?.label}
          dismissible={isDismissible}
          tone="accent"
          componentName={`${normalizedComponentName}.NavBanner`}
        />
      ) : (
        <Alert
          title={normalizedTitle}
          description={normalizedDescription}
          variant="notification"
          tone={statusTone}
          dismissible={isDismissible}
          componentName={`${normalizedComponentName}.Alert`}
        />
      )
    }
  </div>
</section>

<style>
  .product-announcement-section,
  .product-announcement-section__container {
    min-width: 0;
  }

  .product-announcement-section__container {
    display: grid;
  }

  .product-announcement-section :global(.nav-banner),
  .product-announcement-section :global(.alert) {
    min-width: 0;
  }
</style>
