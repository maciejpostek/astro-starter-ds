---
import type { HTMLAttributes } from "astro/types";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type DeveloperSectionVariant = "api" | "developer";
export type DeveloperSectionMethod =
  "GET" | "POST" | "PUT" | "PATCH" | "DELETE";

export interface DeveloperSectionAction {
  label: string;
  href: string;
}

export interface DeveloperSectionCode {
  label: string;
  language: string;
  value: string;
}

export interface DeveloperSectionEndpoint {
  method: DeveloperSectionMethod;
  path: string;
}

export interface DeveloperSectionStep {
  id: string;
  title: string;
  description: string;
  code?: DeveloperSectionCode;
}

export interface DeveloperSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  action?: DeveloperSectionAction;
  endpoint?: DeveloperSectionEndpoint;
  code?: DeveloperSectionCode;
  steps?: DeveloperSectionStep[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: DeveloperSectionContent;
  variant: DeveloperSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "DeveloperSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/)|#|mailto:|tel:)/i;
const supportedVariants: DeveloperSectionVariant[] = ["api", "developer"];
const supportedMethods: DeveloperSectionMethod[] = [
  "GET",
  "POST",
  "PUT",
  "PATCH",
  "DELETE",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "DeveloperSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("DeveloperSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "DeveloperSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "DeveloperSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `DeveloperSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `DeveloperSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("DeveloperSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("DeveloperSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("DeveloperSection does not expose public slots.");
}

const normalizedAction = content.action
  ? {
      label: content.action.label?.trim(),
      href: content.action.href?.trim(),
    }
  : undefined;
if (
  normalizedAction &&
  (!normalizedAction.label ||
    !normalizedAction.href ||
    !safeHrefPattern.test(normalizedAction.href))
) {
  throw new Error(
    "DeveloperSection action requires a non-empty label and safe supplied href.",
  );
}

const normalizeCode = (
  code: DeveloperSectionCode | undefined,
  context: string,
) => {
  if (!code) return undefined;
  const label = code.label?.trim();
  const language = code.language?.trim();
  const value = code.value?.trim();
  if (!label || !language || !value) {
    throw new Error(
      `DeveloperSection ${context} code requires non-empty label, language, and value strings.`,
    );
  }
  return { label, language, value };
};

const normalizedEndpoint = content.endpoint
  ? {
      method: content.endpoint.method,
      path: content.endpoint.path?.trim(),
    }
  : undefined;
if (
  variant === "api" &&
  (!normalizedEndpoint ||
    !supportedMethods.includes(normalizedEndpoint.method) ||
    !normalizedEndpoint.path)
) {
  throw new Error(
    "DeveloperSection API requires a supported method and non-empty endpoint path.",
  );
}
if (variant !== "api" && content.endpoint !== undefined) {
  throw new Error(
    "DeveloperSection endpoint content is supported only by API.",
  );
}

const normalizedCode = normalizeCode(content.code, "API");
if (variant === "api" && !normalizedCode) {
  throw new Error("DeveloperSection API requires one complete code example.");
}
if (variant !== "api" && content.code !== undefined) {
  throw new Error(
    "DeveloperSection root code content is supported only by API.",
  );
}

if (variant === "api" && content.steps !== undefined) {
  throw new Error("DeveloperSection API does not accept developer steps.");
}
if (
  variant === "developer" &&
  (!Array.isArray(content.steps) || content.steps.length < 2)
) {
  throw new Error("DeveloperSection Developer requires at least two steps.");
}
if (variant === "developer" && content.steps!.length > 4) {
  throw new Error("DeveloperSection Developer supports at most four steps.");
}

const stepIds = new Set<string>();
const normalizedSteps =
  variant === "developer"
    ? content.steps!.map((step, index) => {
        const stepId = step?.id?.trim();
        const title = step?.title?.trim();
        const description = step?.description?.trim();
        if (!stepId || !selectorSafeIdPattern.test(stepId)) {
          throw new Error(
            `DeveloperSection step ${index + 1} requires a selector-safe id that starts with a letter.`,
          );
        }
        if (stepIds.has(stepId)) {
          throw new Error(
            `DeveloperSection contains duplicate step id "${stepId}".`,
          );
        }
        if (!title || !description) {
          throw new Error(
            `DeveloperSection step "${stepId}" requires non-empty title and description values.`,
          );
        }
        stepIds.add(stepId);
        return {
          id: stepId,
          title,
          description,
          code: normalizeCode(step.code, `step "${stepId}"`),
        };
      })
    : [];

const contentHeadingLevel = headingLevel;
const stepHeadingLevel = (headingLevel + 1) as 3 | 4;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "developer-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="integrations-security"
  data-section-type="developer"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container developer-section__container" data-container="main">
    {
      variant === "api" && normalizedEndpoint && normalizedCode ? (
        <div class="developer-section__api">
          <ContentBlock
            eyebrow={normalizedEyebrow}
            title={normalizedTitle}
            body={normalizedDescription}
            headingLevel={contentHeadingLevel}
            actionLabel={normalizedAction?.label}
            actionHref={normalizedAction?.href}
            componentName={`${normalizedComponentName}.Content`}
          />
          <div class="developer-section__code-panel">
            <div class="developer-section__endpoint">
              <span>{normalizedEndpoint.method}</span>
              <code>{normalizedEndpoint.path}</code>
            </div>
            <pre
              aria-label={normalizedCode.label}
              data-code-language={normalizedCode.language}
            ><code>{normalizedCode.value}</code></pre>
          </div>
        </div>
      ) : (
        <>
          <ContentBlock
            eyebrow={normalizedEyebrow}
            title={normalizedTitle}
            body={normalizedDescription}
            headingLevel={contentHeadingLevel}
            actionLabel={normalizedAction?.label}
            actionHref={normalizedAction?.href}
            componentName={`${normalizedComponentName}.Content`}
          />
          <ol class="developer-section__steps">
            {normalizedSteps.map((step) => (
              <li data-developer-step={step.id}>
                <span class="developer-section__step-number" aria-hidden="true">
                  {String(normalizedSteps.indexOf(step) + 1).padStart(2, "0")}
                </span>
                <ContentBlock
                  title={step.title}
                  body={step.description}
                  headingLevel={stepHeadingLevel}
                  componentName={`${normalizedComponentName}.Step`}
                >
                  {step.code && (
                    <pre
                      aria-label={step.code.label}
                      data-code-language={step.code.language}
                    ><code>{step.code.value}</code></pre>
                  )}
                </ContentBlock>
              </li>
            ))}
          </ol>
        </>
      )
    }
  </div>
</section>

<style>
  .developer-section,
  .developer-section__container,
  .developer-section__api,
  .developer-section__code-panel,
  .developer-section__steps,
  .developer-section__steps > li {
    min-width: 0;
  }

  .developer-section__container,
  .developer-section__api,
  .developer-section__code-panel,
  .developer-section__steps,
  .developer-section__steps > li {
    display: grid;
  }

  .developer-section__container {
    gap: var(--gap-extra-large);
  }

  .developer-section__api {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--gap-extra-large);
  }

  .developer-section__code-panel {
    gap: var(--gap-small);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
    padding: var(--component-padding-large);
  }

  .developer-section__endpoint {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--gap-regular);
    border-bottom: var(--border-width-default) solid var(--color-border-inverse);
    padding-bottom: var(--component-padding-small);
  }

  .developer-section__endpoint span {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-strong);
  }

  .developer-section__endpoint code,
  .developer-section pre,
  .developer-section code {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .developer-section pre {
    max-width: 100%;
    margin: 0;
    overflow: auto;
    font: inherit;
    white-space: pre-wrap;
  }

  .developer-section__steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    gap: var(--gap-large);
    list-style: none;
  }

  .developer-section__steps > li {
    align-content: start;
    gap: var(--gap-regular);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
    padding: var(--component-padding-large);
  }

  .developer-section__step-number {
    color: var(--color-text-tertiary);
    font-size: var(--text-style-body-small-font-size);
  }

  .developer-section__steps pre {
    border: var(--border-width-default) solid var(--color-border-subtle);
    background: var(--color-background-subtle);
    padding: var(--component-padding-medium);
  }

  @media (width < 64rem) {
    .developer-section__api {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .developer-section__container {
      gap: var(--gap-xlarge);
    }

    .developer-section__steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .developer-section__code-panel,
    .developer-section__steps > li {
      padding: var(--component-padding-medium);
    }
  }
</style>
