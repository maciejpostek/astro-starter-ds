---
import type { HTMLAttributes } from "astro/types";
import TrustBadge from "../../../atoms/data-display/TrustBadge.astro";
import ComparisonTable from "../../data-display/ComparisonTable.astro";

export type TrustSectionVariant =
  "security" | "compliance" | "trust-center" | "architecture";

export interface TrustSectionClaim {
  id: string;
  label: string;
  description: string;
}

export interface TrustSectionColumn {
  key: string;
  label: string;
  highlighted?: boolean;
}

export interface TrustSectionRow {
  id: string;
  label: string;
  values: Record<string, string | boolean>;
}

export interface TrustSectionComparison {
  caption: string;
  columns: TrustSectionColumn[];
  rows: TrustSectionRow[];
}

export interface TrustSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  evidenceNote: string;
  claims?: TrustSectionClaim[];
  comparison?: TrustSectionComparison;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: TrustSectionContent;
  variant: TrustSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "TrustSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const selectorSafeKeyPattern = /^[a-z][a-z0-9_-]*$/;
const supportedVariants: TrustSectionVariant[] = [
  "security",
  "compliance",
  "trust-center",
  "architecture",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedEvidenceNote = content?.evidenceNote?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "TrustSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("TrustSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "TrustSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error("TrustSection eyebrow must be non-empty when provided.");
}
if (!normalizedEvidenceNote) {
  throw new Error(
    "TrustSection requires a non-empty evidenceNote that identifies the project-owned verification boundary.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `TrustSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `TrustSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("TrustSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("TrustSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("TrustSection does not expose public slots.");
}

const usesClaims = variant === "security" || variant === "compliance";
const usesComparison =
  variant === "trust-center" || variant === "architecture";

let normalizedClaims: TrustSectionClaim[] = [];
if (usesClaims) {
  if (!Array.isArray(content.claims) || content.claims.length < 2) {
    throw new Error(
      "TrustSection Security and Compliance require at least two evidence-backed claims.",
    );
  }
  if (content.claims.length > 6) {
    throw new Error(
      "TrustSection Security and Compliance support at most six claims.",
    );
  }
  if (content.comparison !== undefined) {
    throw new Error(
      "TrustSection Security and Compliance reject comparison content.",
    );
  }

  const claimIds = new Set<string>();
  normalizedClaims = content.claims.map((claim, index) => {
    const claimId = claim?.id?.trim();
    const label = claim?.label?.trim();
    const description = claim?.description?.trim();
    if (!claimId || !selectorSafeIdPattern.test(claimId)) {
      throw new Error(
        `TrustSection claim ${index + 1} requires a selector-safe id that starts with a letter.`,
      );
    }
    if (claimIds.has(claimId)) {
      throw new Error(`TrustSection contains duplicate claim id "${claimId}".`);
    }
    if (!label || !description) {
      throw new Error(
        `TrustSection claim "${claimId}" requires non-empty label and description values.`,
      );
    }
    claimIds.add(claimId);
    return { id: claimId, label, description };
  });
}

type NormalizedComparison = {
  caption: string;
  columns: Array<{
    key: string;
    label: string;
    highlighted: boolean;
  }>;
  rows: Array<{
    id: string;
    label: string;
    values: Record<string, string | boolean>;
  }>;
};

let normalizedComparison: NormalizedComparison | undefined;
if (usesComparison) {
  if (!content.comparison) {
    throw new Error(
      "TrustSection Trust Center and Architecture require comparison content.",
    );
  }
  if (content.claims !== undefined) {
    throw new Error(
      "TrustSection Trust Center and Architecture reject claim-list content.",
    );
  }

  const caption = content.comparison.caption?.trim();
  if (!caption) {
    throw new Error(
      "TrustSection comparison requires a non-empty caption.",
    );
  }
  const minimumColumns = variant === "architecture" ? 2 : 1;
  if (
    !Array.isArray(content.comparison.columns) ||
    content.comparison.columns.length < minimumColumns ||
    content.comparison.columns.length > 4
  ) {
    throw new Error(
      variant === "architecture"
        ? "TrustSection Architecture requires two to four comparison columns."
        : "TrustSection Trust Center requires one to four comparison columns.",
    );
  }

  const columnKeys = new Set<string>();
  const columns = content.comparison.columns.map((column, index) => {
    const key = column?.key?.trim();
    const label = column?.label?.trim();
    if (!key || !selectorSafeKeyPattern.test(key)) {
      throw new Error(
        `TrustSection comparison column ${index + 1} requires a lowercase selector-safe key.`,
      );
    }
    if (columnKeys.has(key)) {
      throw new Error(
        `TrustSection comparison contains duplicate column key "${key}".`,
      );
    }
    if (!label) {
      throw new Error(
        `TrustSection comparison column "${key}" requires a non-empty label.`,
      );
    }
    columnKeys.add(key);
    return {
      key,
      label,
      highlighted: column.highlighted ?? false,
    };
  });

  if (columns.filter((column) => column.highlighted).length > 1) {
    throw new Error(
      "TrustSection comparison supports at most one highlighted column.",
    );
  }
  if (
    !Array.isArray(content.comparison.rows) ||
    content.comparison.rows.length < 2 ||
    content.comparison.rows.length > 10
  ) {
    throw new Error(
      "TrustSection comparison requires two to ten rows.",
    );
  }

  const rowIds = new Set<string>();
  const rows = content.comparison.rows.map((row, index) => {
    const rowId = row?.id?.trim();
    const label = row?.label?.trim();
    if (!rowId || !selectorSafeIdPattern.test(rowId)) {
      throw new Error(
        `TrustSection comparison row ${index + 1} requires a selector-safe id that starts with a letter.`,
      );
    }
    if (rowIds.has(rowId)) {
      throw new Error(
        `TrustSection comparison contains duplicate row id "${rowId}".`,
      );
    }
    if (!label) {
      throw new Error(
        `TrustSection comparison row "${rowId}" requires a non-empty label.`,
      );
    }

    const valueKeys = Object.keys(row.values ?? {});
    if (
      valueKeys.length !== columns.length ||
      columns.some((column) => !valueKeys.includes(column.key))
    ) {
      throw new Error(
        `TrustSection comparison row "${rowId}" must define exactly one value for every column.`,
      );
    }
    for (const column of columns) {
      const value = row.values[column.key];
      if (
        typeof value !== "boolean" &&
        (typeof value !== "string" || !value.trim())
      ) {
        throw new Error(
          `TrustSection comparison row "${rowId}" contains an invalid value for "${column.key}".`,
        );
      }
    }

    rowIds.add(rowId);
    return {
      id: rowId,
      label,
      values: row.values,
    };
  });

  normalizedComparison = { caption, columns, rows };
}

const Heading = `h${headingLevel}` as "h2" | "h3";
const badgeVariant = variant === "security" ? "security" : "compliance";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "trust-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="integrations-security"
  data-section-type="trust"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container trust-section__container" data-container="main">
    <header class="trust-section__header">
      {normalizedEyebrow && <p class="trust-section__eyebrow">{normalizedEyebrow}</p>}
      <Heading>{normalizedTitle}</Heading>
      <p>{normalizedDescription}</p>
    </header>

    {
      usesClaims ? (
        <ul class="trust-section__claims">
          {normalizedClaims.map((claim) => (
            <li data-trust-claim={claim.id}>
              <TrustBadge variant={badgeVariant}>{claim.label}</TrustBadge>
              <p>{claim.description}</p>
            </li>
          ))}
        </ul>
      ) : (
        normalizedComparison && (
          <div class="trust-section__comparison" data-trust-comparison>
            <ComparisonTable
              caption={normalizedComparison.caption}
              columns={normalizedComparison.columns}
              rows={normalizedComparison.rows}
            />
          </div>
        )
      )
    }

    <p class="trust-section__evidence-note">{normalizedEvidenceNote}</p>
  </div>
</section>

<style>
  .trust-section,
  .trust-section__container,
  .trust-section__header,
  .trust-section__claims,
  .trust-section__claims > li,
  .trust-section__comparison {
    min-width: 0;
  }

  .trust-section__container,
  .trust-section__header,
  .trust-section__claims,
  .trust-section__claims > li {
    display: grid;
  }

  .trust-section__container {
    gap: var(--gap-extra-large);
  }

  .trust-section__header {
    max-width: 48rem;
    gap: var(--gap-medium);
  }

  .trust-section__header :is(h2, h3),
  .trust-section__header p,
  .trust-section__claims p,
  .trust-section__evidence-note {
    margin: 0;
  }

  .trust-section__header > p:not(.trust-section__eyebrow),
  .trust-section__claims p,
  .trust-section__evidence-note {
    color: var(--color-text-secondary);
  }

  .trust-section__eyebrow {
    color: var(--color-text-accent);
    font-family: var(--font-family-mono);
    font-size: var(--text-style-body-small-font-size);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-none);
    line-height: var(--line-height-compact);
    text-transform: uppercase;
  }

  .trust-section__claims {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    gap: var(--gap-large);
    list-style: none;
  }

  .trust-section__claims > li {
    align-content: start;
    gap: var(--gap-medium);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
    padding: var(--component-padding-large);
  }

  .trust-section__claims :global(.trust-badge) {
    max-width: 100%;
  }

  .trust-section__claims :global(.trust-badge__label) {
    overflow-wrap: anywhere;
  }

  .trust-section__comparison {
    width: 100%;
    overflow: hidden;
  }

  .trust-section__evidence-note {
    max-width: 68rem;
    border-left: var(--border-width-emphasis) solid var(--color-border-accent);
    padding-left: var(--component-padding-medium);
    font-size: var(--text-style-body-small-font-size);
  }

  .trust-section[data-section-variant="architecture"]
    .trust-section__container {
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.5fr);
    align-items: start;
  }

  .trust-section[data-section-variant="architecture"]
    .trust-section__comparison {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .trust-section[data-section-variant="architecture"]
    .trust-section__evidence-note {
    grid-column: 1;
  }

  @media (width < 64rem) {
    .trust-section__claims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-section[data-section-variant="architecture"]
      .trust-section__container {
      grid-template-columns: minmax(0, 1fr);
    }

    .trust-section[data-section-variant="architecture"]
      :is(
        .trust-section__comparison,
        .trust-section__evidence-note
      ) {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (width < 40rem) {
    .trust-section__container {
      gap: var(--gap-xlarge);
    }

    .trust-section__claims {
      grid-template-columns: minmax(0, 1fr);
    }

    .trust-section__claims > li {
      padding: var(--component-padding-medium);
    }
  }
</style>
