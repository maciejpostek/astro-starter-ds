---
import type { HTMLAttributes } from "astro/types";
import Button from "../../../atoms/actions/Button.astro";
import Eyebrow from "../../../atoms/text/Eyebrow.astro";
import MediaRatio from "../../../atoms/media/MediaRatio.astro";
import ButtonGroup from "../../../molecules/actions/ButtonGroup.astro";
import type { MediaRatioValue } from "../../../atoms/media/types";

export type HeroSectionVariant = "centered" | "split" | "product-mockup" | "media" | "lead-capture" | "launch-event";

export interface HeroSectionAction {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "link";
}

export interface HeroSectionEventDetail {
  label: string;
  value: string;
}

export interface HeroSectionContent {
  eyebrow?: string;
  title: string;
  description: string;
  actions?: HeroSectionAction[];
  eventDetails?: HeroSectionEventDetail[];
}

type Props = {
  id: string;
  content: HeroSectionContent;
  variant?: HeroSectionVariant;
  mediaRatio?: MediaRatioValue;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "class" | "id" | "aria-label">;

const {
  id,
  content,
  variant = "centered",
  mediaRatio = "16:9",
  ariaLabel,
  componentName = "HeroSection",
  class: className,
  ...attributes
} = Astro.props;

const variants: HeroSectionVariant[] = [
  "centered",
  "split",
  "product-mockup",
  "media",
  "lead-capture",
  "launch-event",
];
const mediaVariants: HeroSectionVariant[] = [
  "split",
  "product-mockup",
  "media",
];
const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);
const normalizedId = id.trim();
const normalizedComponentName = componentName.trim();
const normalizedAriaLabel = ariaLabel?.trim();

if (!variants.includes(variant)) {
  throw new Error(
    `HeroSection received unsupported variant "${String(variant)}".`,
  );
}
if (!selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "HeroSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("HeroSection requires a structured content object.");
}
if (!normalizedComponentName) {
  throw new Error("HeroSection requires a non-empty componentName value.");
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("HeroSection ariaLabel must be non-empty when provided.");
}

const normalizedContent = {
  eyebrow: content.eyebrow?.trim(),
  title: content.title.trim(),
  description: content.description.trim(),
  actions: (content.actions ?? []).map((action) => ({
    label: action.label.trim(),
    href: action.href.trim(),
    variant: action.variant ?? "primary",
  })),
  eventDetails: (content.eventDetails ?? []).map((detail) => ({
    label: detail.label.trim(),
    value: detail.value.trim(),
  })),
};

if (!normalizedContent.title || !normalizedContent.description) {
  throw new Error(
    "HeroSection requires non-empty title and description values.",
  );
}
if (normalizedContent.actions.length > 2) {
  throw new Error("HeroSection supports at most two actions.");
}
if (
  normalizedContent.actions.some(
    (action) =>
      !action.label ||
      !isRealHref(action.href) ||
      !["primary", "secondary", "link"].includes(action.variant),
  )
) {
  throw new Error(
    "HeroSection actions require non-empty labels, real URLs, and supported variants.",
  );
}
if (
  new Set(normalizedContent.actions.map((action) => action.href)).size !==
  normalizedContent.actions.length
) {
  throw new Error("HeroSection action URLs must be unique.");
}
if (
  normalizedContent.actions.filter((action) => action.variant === "primary")
    .length > 1
) {
  throw new Error("HeroSection supports at most one primary action.");
}
if (
  normalizedContent.eventDetails.some(
    (detail) => !detail.label || !detail.value,
  )
) {
  throw new Error(
    "HeroSection event details require non-empty label and value fields.",
  );
}

const hasMedia = Astro.slots.has("media");
const hasForm = Astro.slots.has("form");
const requiresMedia = mediaVariants.includes(variant);

if (requiresMedia !== hasMedia) {
  throw new Error(
    `HeroSection variant "${variant}" ${requiresMedia ? "requires" : "does not accept"} the media slot.`,
  );
}
if ((variant === "lead-capture") !== hasForm) {
  throw new Error(
    `HeroSection variant "${variant}" ${variant === "lead-capture" ? "requires" : "does not accept"} the form slot.`,
  );
}
if (variant === "lead-capture" && normalizedContent.actions.length > 0) {
  throw new Error(
    "HeroSection lead-capture delegates conversion actions to its form and does not accept content actions.",
  );
}
if (
  (variant === "launch-event") !==
  (normalizedContent.eventDetails.length > 0)
) {
  throw new Error(
    `HeroSection variant "${variant}" ${variant === "launch-event" ? "requires" : "does not accept"} event details.`,
  );
}
if (
  variant === "launch-event" &&
  normalizedContent.eventDetails.length > 3
) {
  throw new Error("HeroSection launch-event supports at most three details.");
}

const titleId = `${normalizedId}-title`;
const descriptionId = `${normalizedId}-description`;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "hero-section", className]}
  data-padding="hero-top"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="hero-headers"
  data-section-type="hero"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel}
  aria-labelledby={normalizedAriaLabel ? undefined : titleId}
  aria-describedby={descriptionId}
>
  <div class="l-container hero-section__container" data-container="main">
    <div class="hero-section__layout">
      <div class="hero-section__content">
        {normalizedContent.eyebrow && <Eyebrow text={normalizedContent.eyebrow} />}
        <h1 id={titleId}>{normalizedContent.title}</h1>
        <p id={descriptionId}>{normalizedContent.description}</p>

        {
          normalizedContent.eventDetails.length > 0 && (
            <dl class="hero-section__event-details">
              {normalizedContent.eventDetails.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          normalizedContent.actions.length > 0 && (
            <ButtonGroup class="hero-section__actions">
              {normalizedContent.actions.map((action) => (
                <Button
                  href={action.href}
                  variant={action.variant}
                  size="large"
                  componentName={`${normalizedComponentName}.Action`}
                >
                  {action.label}
                </Button>
              ))}
            </ButtonGroup>
          )
        }
      </div>

      {
        hasMedia && (
          <div class="hero-section__media">
            <MediaRatio
              ratio={mediaRatio}
              label="Hero media"
              componentName={`${normalizedComponentName}.Media`}
            >
              <slot name="media" />
            </MediaRatio>
          </div>
        )
      }

      {
        hasForm && (
          <div class="hero-section__form">
            <slot name="form" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-width: 0;
    color: var(--color-text-primary);
  }

  .hero-section__container,
  .hero-section__layout,
  .hero-section__content,
  .hero-section__media,
  .hero-section__form {
    min-width: 0;
  }

  .hero-section__layout,
  .hero-section__content {
    display: grid;
  }

  .hero-section__layout {
    gap: var(--gap-xlarge);
  }

  .hero-section__content {
    max-width: var(--container-small-max);
    align-content: center;
    justify-items: start;
    gap: var(--gap-medium);
  }

  .hero-section__content h1,
  .hero-section__content p,
  .hero-section__event-details,
  .hero-section__event-details dt,
  .hero-section__event-details dd {
    margin: 0;
  }

  .hero-section__content h1 {
    max-width: 18ch;
    font-family: var(--text-style-heading-h1-font-family);
    font-size: var(--text-style-heading-h1-font-size);
    font-weight: var(--text-style-heading-h1-font-weight);
    font-style: var(--text-style-heading-h1-font-style);
    line-height: var(--text-style-heading-h1-line-height);
    letter-spacing: var(--text-style-heading-h1-letter-spacing);
    text-transform: var(--text-style-heading-h1-text-transform);
    text-wrap: var(--text-style-heading-h1-text-wrap);
    overflow-wrap: var(--text-style-heading-h1-overflow-wrap);
    word-break: var(--text-style-heading-h1-word-break);
    white-space: var(--text-style-heading-h1-white-space);
  }

  .hero-section__content > p {
    max-width: 60ch;
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-large-font-family);
    font-size: var(--text-style-body-large-font-size);
    font-weight: var(--text-style-body-large-font-weight);
    font-style: var(--text-style-body-large-font-style);
    line-height: var(--text-style-body-large-line-height);
    letter-spacing: var(--text-style-body-large-letter-spacing);
    text-transform: var(--text-style-body-large-text-transform);
    text-wrap: var(--text-style-body-large-text-wrap);
    overflow-wrap: var(--text-style-body-large-overflow-wrap);
    word-break: var(--text-style-body-large-word-break);
    white-space: var(--text-style-body-large-white-space);
  }

  .hero-section__event-details {
    display: flex;
    max-width: 100%;
    flex-wrap: wrap;
    gap: var(--gap-large);
  }

  .hero-section__event-details > div {
    display: grid;
    min-width: var(--grid-auto-min-width-small);
    gap: var(--gap-tiny);
  }

  .hero-section__event-details dt {
    color: var(--color-text-tertiary);
    font-size: var(--text-style-body-tiny-font-size);
    text-transform: uppercase;
  }

  .hero-section__event-details dd {
    font-weight: var(--font-weight-emphasis);
  }

  .hero-section__media,
  .hero-section__form {
    align-self: center;
  }

  .hero-section__form {
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
    box-shadow: var(--elevation-surface-raised);
  }

  .hero-section[data-section-variant="centered"] .hero-section__content,
  .hero-section[data-section-variant="product-mockup"] .hero-section__content,
  .hero-section[data-section-variant="launch-event"] .hero-section__content {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .hero-section[data-section-variant="centered"] .hero-section__content > h1,
  .hero-section[data-section-variant="centered"] .hero-section__content > p,
  .hero-section[data-section-variant="centered"] .hero-section__actions,
  .hero-section[data-section-variant="product-mockup"]
    .hero-section__content
    > h1,
  .hero-section[data-section-variant="product-mockup"]
    .hero-section__content
    > p,
  .hero-section[data-section-variant="product-mockup"] .hero-section__actions,
  .hero-section[data-section-variant="launch-event"]
    .hero-section__content
    > h1,
  .hero-section[data-section-variant="launch-event"]
    .hero-section__content
    > p,
  .hero-section[data-section-variant="launch-event"]
    .hero-section__event-details,
  .hero-section[data-section-variant="launch-event"] .hero-section__actions {
    justify-self: stretch;
  }

  .hero-section[data-section-variant="product-mockup"]
    .hero-section__media {
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-small);
    background: var(--color-background-surface);
    box-shadow: var(--elevation-surface-raised);
  }

  .hero-section[data-section-variant="split"] .hero-section__layout,
  .hero-section[data-section-variant="lead-capture"] .hero-section__layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }

  .hero-section[data-section-variant="media"] .hero-section__media {
    grid-row: 1;
  }

  @media (width < 64rem) {
    .hero-section[data-section-variant="split"] .hero-section__layout,
    .hero-section[data-section-variant="lead-capture"] .hero-section__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-section[data-section-variant="media"] .hero-section__media {
      grid-row: auto;
    }
  }

  @media (width < 40rem) {
    .hero-section__actions,
    .hero-section__actions :global(.button) {
      width: 100%;
    }

    .hero-section__actions :global(.button) {
      justify-content: space-between;
    }

    .hero-section__event-details {
      display: grid;
      width: 100%;
    }

    .hero-section__event-details > div {
      min-width: 0;
    }

    .hero-section__form {
      padding: var(--component-padding-medium);
    }
  }
</style>
