---
import type { HTMLAttributes } from "astro/types";
import Breadcrumbs from "../../../molecules/navigation/Breadcrumbs.astro";
import PageHeader from "../../../molecules/text/PageHeader.astro";

export interface PageHeaderSectionBreadcrumb {
  label: string;
  href?: string;
}

export interface PageHeaderSectionContent {
  eyebrow: string;
  title: string;
  description: string;
  breadcrumbs?: PageHeaderSectionBreadcrumb[];
  breadcrumbsLabel?: string;
  breadcrumbsMaxItems?: number;
}

type Props = {
  content: PageHeaderSectionContent;
  sectionId?: string;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "class" | "id" | "aria-label">;

const {
  content,
  sectionId,
  ariaLabel,
  componentName = "PageHeaderSection",
  class: className,
  ...attributes
} = Astro.props;

const normalizedSectionId = sectionId?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName.trim();
const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;

if (!content || typeof content !== "object") {
  throw new Error("PageHeaderSection requires a structured content object.");
}
if (
  !content.eyebrow?.trim() ||
  !content.title?.trim() ||
  !content.description?.trim()
) {
  throw new Error(
    "PageHeaderSection requires non-empty eyebrow, title, and description values.",
  );
}
if (
  sectionId !== undefined &&
  (!normalizedSectionId || !selectorSafeIdPattern.test(normalizedSectionId))
) {
  throw new Error(
    "PageHeaderSection sectionId must be selector-safe and start with a letter when provided.",
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "PageHeaderSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "PageHeaderSection requires a non-empty componentName value.",
  );
}
if (
  content.breadcrumbs !== undefined &&
  (!Array.isArray(content.breadcrumbs) || content.breadcrumbs.length === 0)
) {
  throw new Error(
    "PageHeaderSection breadcrumbs must contain at least one item when provided.",
  );
}
if (
  content.breadcrumbsLabel !== undefined &&
  !content.breadcrumbsLabel.trim()
) {
  throw new Error(
    "PageHeaderSection breadcrumbsLabel must be non-empty when provided.",
  );
}

const hasBreadcrumbs = Boolean(content.breadcrumbs?.length);
const hasSupport = Astro.slots.has("support");
---

<section
  {...attributes}
  id={normalizedSectionId}
  class:list={["l-section", "page-header-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="hero-headers"
  data-section-type="page-header"
  data-section-variant={hasBreadcrumbs ? "breadcrumbs" : "standard"}
  data-preview-target
  aria-label={normalizedAriaLabel ?? content.title.trim()}
>
  <div class="l-container page-header-section__container" data-container="main">
    {
      hasBreadcrumbs && (
        <Breadcrumbs
          items={content.breadcrumbs!}
          maxItems={content.breadcrumbsMaxItems}
          label={content.breadcrumbsLabel ?? "Breadcrumb"}
          componentName={`${normalizedComponentName}.Breadcrumbs`}
        />
      )
    }
    <PageHeader
      eyebrow={content.eyebrow.trim()}
      title={content.title.trim()}
      description={content.description.trim()}
    >
      {hasSupport && <slot name="support" />}
    </PageHeader>
  </div>
</section>

<style>
  .page-header-section,
  .page-header-section__container {
    min-width: 0;
  }

  .page-header-section__container {
    display: grid;
    gap: var(--gap-medium);
  }
</style>
