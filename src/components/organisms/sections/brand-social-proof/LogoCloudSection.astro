---
import type { HTMLAttributes } from "astro/types";
import Logo from "../../../atoms/media/Logo.astro";
import Carousel from "../../media/Carousel.astro";

export type LogoCloudSectionVariant = "static" | "carousel";

export interface LogoCloudSectionItem {
  id: string;
  label: string;
  image: string;
  href?: string;
}

export interface LogoCloudSectionContent {
  title: string;
  items: LogoCloudSectionItem[];
}

type HeadingLevel = 2 | 3 | 4 | 5 | 6;

type Props = {
  id: string;
  content: LogoCloudSectionContent;
  variant?: LogoCloudSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant = "static",
  headingLevel = 2,
  ariaLabel,
  componentName = "LogoCloudSection",
  class: className,
  ...attributes
} = Astro.props;

const normalizedId = id?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();
const supportedVariants: LogoCloudSectionVariant[] = ["static", "carousel"];
const supportedHeadingLevels: HeadingLevel[] = [2, 3, 4, 5, 6];
const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const placeholderHrefPattern =
  /^(?:#|javascript:|https?:\/\/(?:www\.)?example\.(?:com|org|net)(?:\/|$))/i;

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "LogoCloudSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("LogoCloudSection requires a structured content object.");
}
if (!content.title?.trim()) {
  throw new Error("LogoCloudSection requires a non-empty title.");
}
if (!Array.isArray(content.items) || content.items.length < 2) {
  throw new Error(
    "LogoCloudSection requires at least two approved logo items; use Logo directly for one item.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `LogoCloudSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `LogoCloudSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("LogoCloudSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error(
    "LogoCloudSection requires a non-empty componentName value.",
  );
}

const itemIds = new Set<string>();
content.items.forEach((item, index) => {
  const itemNumber = index + 1;
  const itemId = item.id?.trim();
  const itemLabel = item.label?.trim();
  const itemImage = item.image?.trim();

  if (!itemId || !selectorSafeIdPattern.test(itemId)) {
    throw new Error(
      `LogoCloudSection item ${itemNumber} requires a selector-safe id that starts with a letter.`,
    );
  }
  if (itemIds.has(itemId)) {
    throw new Error(
      `LogoCloudSection contains duplicate item id "${itemId}".`,
    );
  }
  itemIds.add(itemId);
  if (!itemLabel) {
    throw new Error(
      `LogoCloudSection item "${itemId}" requires a non-empty accessible label.`,
    );
  }
  if (!itemImage) {
    throw new Error(
      `LogoCloudSection item "${itemId}" requires approved image artwork.`,
    );
  }
  if (
    item.href !== undefined &&
    (!item.href.trim() || placeholderHrefPattern.test(item.href.trim()))
  ) {
    throw new Error(
      `LogoCloudSection item "${itemId}" requires a real non-placeholder href.`,
    );
  }
});

const Heading = `h${headingLevel}` as
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";
const normalizedTitle = content.title.trim();
const carouselItems = content.items.map((item) => ({
  id: item.id.trim(),
  title: item.label.trim(),
  image: item.image.trim(),
  href: item.href?.trim(),
}));
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "logo-cloud-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="brand-social-proof"
  data-section-type="logo-cloud"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container logo-cloud-section__container" data-container="main">
    {
      variant === "static" ? (
        <div class="logo-cloud-section__static">
          <Heading class="logo-cloud-section__title">{normalizedTitle}</Heading>
          <ul class="logo-cloud-section__list">
            {content.items.map((item) => (
              <li class="logo-cloud-section__item">
                {item.href ? (
                  <a
                    class="logo-cloud-section__link"
                    href={item.href.trim()}
                    aria-label={`Visit ${item.label.trim()}`}
                  >
                    <Logo
                      label={item.label.trim()}
                      componentName={`${normalizedComponentName}.Logo`}
                    >
                      <img src={item.image.trim()} alt="" loading="lazy" />
                    </Logo>
                  </a>
                ) : (
                  <Logo
                    label={item.label.trim()}
                    componentName={`${normalizedComponentName}.Logo`}
                  >
                    <img src={item.image.trim()} alt="" loading="lazy" />
                  </Logo>
                )}
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <Carousel
          id={`${normalizedId}-carousel`}
          class="logo-cloud-section__carousel"
          label={normalizedTitle}
          items={carouselItems}
          variant="logos"
          headingLevel={headingLevel}
          componentName={`${normalizedComponentName}.Carousel`}
        />
      )
    }
  </div>
</section>

<style>
  .logo-cloud-section,
  .logo-cloud-section__container,
  .logo-cloud-section__static,
  .logo-cloud-section__list,
  .logo-cloud-section__item {
    min-width: 0;
  }

  .logo-cloud-section__static {
    display: grid;
    gap: var(--gap-large);
  }

  .logo-cloud-section__title {
    margin: 0;
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  .logo-cloud-section__list {
    display: grid;
    grid-template-columns:
      repeat(
        auto-fit,
        minmax(min(100%, var(--grid-auto-min-width-small)), 1fr)
      );
    gap: var(--gap-large);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo-cloud-section__item,
  .logo-cloud-section__link {
    display: flex;
    min-height: var(--size-96);
    align-items: center;
    justify-content: center;
  }

  .logo-cloud-section__item {
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-medium);
    background: var(--color-background-surface);
  }

  .logo-cloud-section__link {
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .logo-cloud-section__link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .logo-cloud-section__item :global(.logo),
  :global(.logo-cloud-section__carousel [data-logo-variant]) {
    width: 100%;
    justify-content: center;
  }

  .logo-cloud-section__item :global(.logo img),
  :global(.logo-cloud-section__carousel [data-logo-variant] img) {
    width: auto;
    max-height: var(--size-48);
    object-fit: contain;
  }

  @media (width < 40rem) {
    .logo-cloud-section__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap-medium);
    }
  }
</style>
