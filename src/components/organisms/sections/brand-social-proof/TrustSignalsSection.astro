---
import type { HTMLAttributes } from "astro/types";
import TrustBadge from "../../../atoms/data-display/TrustBadge.astro";
import Rating from "../../../molecules/data-display/Rating.astro";

export type TrustSignalsSectionVariant = "ratings" | "badges" | "awards";
export type TrustSignalsRatingPresentation = "stars" | "score";
export type TrustSignalsBadgeKind = "security" | "compliance";

export interface TrustSignalsRatingItem {
  id: string;
  value: number;
  label?: string;
  supportingText?: string;
  presentation?: TrustSignalsRatingPresentation;
}

export interface TrustSignalsBadgeItem {
  id: string;
  label: string;
  supportingText?: string;
  kind?: TrustSignalsBadgeKind;
}

export interface TrustSignalsSectionContent {
  title: string;
  description?: string;
  items: Array<TrustSignalsRatingItem | TrustSignalsBadgeItem>;
}

type HeadingLevel = 2 | 3 | 4 | 5 | 6;

type Props = {
  id: string;
  content: TrustSignalsSectionContent;
  variant: TrustSignalsSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "TrustSignalsSection",
  class: className,
  ...attributes
} = Astro.props;

const normalizedId = id?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();
const supportedVariants: TrustSignalsSectionVariant[] = [
  "ratings",
  "badges",
  "awards",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3, 4, 5, 6];
const supportedRatingPresentations: TrustSignalsRatingPresentation[] = [
  "stars",
  "score",
];
const supportedBadgeKinds: TrustSignalsBadgeKind[] = [
  "security",
  "compliance",
];
const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "TrustSignalsSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("TrustSignalsSection requires a structured content object.");
}
if (!content.title?.trim()) {
  throw new Error("TrustSignalsSection requires a non-empty title.");
}
if (
  content.description !== undefined &&
  !content.description.trim()
) {
  throw new Error(
    "TrustSignalsSection description must be non-empty when provided.",
  );
}
if (!Array.isArray(content.items) || content.items.length < 2) {
  throw new Error(
    "TrustSignalsSection requires at least two verified items; use Rating or TrustBadge directly for one item.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `TrustSignalsSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `TrustSignalsSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "TrustSignalsSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "TrustSignalsSection requires a non-empty componentName value.",
  );
}

const itemIds = new Set<string>();
content.items.forEach((item, index) => {
  const itemNumber = index + 1;
  const itemId = item.id?.trim();
  const supportingText = item.supportingText?.trim();

  if (!itemId || !selectorSafeIdPattern.test(itemId)) {
    throw new Error(
      `TrustSignalsSection item ${itemNumber} requires a selector-safe id that starts with a letter.`,
    );
  }
  if (itemIds.has(itemId)) {
    throw new Error(
      `TrustSignalsSection contains duplicate item id "${itemId}".`,
    );
  }
  itemIds.add(itemId);
  if (item.supportingText !== undefined && !supportingText) {
    throw new Error(
      `TrustSignalsSection item "${itemId}" supportingText must be non-empty when provided.`,
    );
  }

  if (variant === "ratings") {
    if (!("value" in item) || !Number.isFinite(item.value)) {
      throw new Error(
        `TrustSignalsSection rating item "${itemId}" requires a finite value.`,
      );
    }
    if (item.value < 0 || item.value > 5) {
      throw new Error(
        `TrustSignalsSection rating item "${itemId}" value must be between zero and five.`,
      );
    }
    if (item.label !== undefined && !item.label.trim()) {
      throw new Error(
        `TrustSignalsSection rating item "${itemId}" label must be non-empty when provided.`,
      );
    }
    if (
      item.presentation !== undefined &&
      !supportedRatingPresentations.includes(item.presentation)
    ) {
      throw new Error(
        `TrustSignalsSection rating item "${itemId}" received an unsupported presentation.`,
      );
    }
    return;
  }

  if ("value" in item || "presentation" in item) {
    throw new Error(
      `TrustSignalsSection ${variant} item "${itemId}" must not define rating value or presentation.`,
    );
  }
  if (!item.label?.trim()) {
    throw new Error(
      `TrustSignalsSection ${variant} item "${itemId}" requires a non-empty claim label.`,
    );
  }
  if (
    variant === "badges" &&
    (!item.kind || !supportedBadgeKinds.includes(item.kind))
  ) {
    throw new Error(
      `TrustSignalsSection badge item "${itemId}" requires kind="security|compliance".`,
    );
  }
  if (variant === "awards" && item.kind !== undefined) {
    throw new Error(
      `TrustSignalsSection award item "${itemId}" must not define a security or compliance kind.`,
    );
  }
});

const Heading = `h${headingLevel}` as
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";
const normalizedTitle = content.title.trim();
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "trust-signals-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="brand-social-proof"
  data-section-type="trust-signals"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container trust-signals-section__container" data-container="main">
    <header class="trust-signals-section__header">
      <Heading>{normalizedTitle}</Heading>
      {content.description && <p>{content.description.trim()}</p>}
    </header>

    <ul class="trust-signals-section__list">
      {
        content.items.map((item) => (
          <li class="trust-signals-section__item">
            {variant === "ratings" && "value" in item ? (
              <Rating
                value={item.value}
                variant={item.presentation ?? "stars"}
                label={item.label?.trim() ?? "Verified rating"}
                supportingText={item.supportingText?.trim()}
                componentName={`${normalizedComponentName}.Rating`}
                class="trust-signals-section__rating"
              />
            ) : (
              <>
                <TrustBadge
                  variant={
                    variant === "awards"
                      ? "award"
                      : "kind" in item
                        ? item.kind
                        : "security"
                  }
                  componentName={`${normalizedComponentName}.TrustBadge`}
                >
                  {item.label?.trim() ?? ""}
                </TrustBadge>
                {item.supportingText && (
                  <p class="trust-signals-section__supporting">
                    {item.supportingText.trim()}
                  </p>
                )}
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust-signals-section,
  .trust-signals-section__container,
  .trust-signals-section__header,
  .trust-signals-section__list,
  .trust-signals-section__item {
    min-width: 0;
  }

  .trust-signals-section__container,
  .trust-signals-section__header,
  .trust-signals-section__item {
    display: grid;
  }

  .trust-signals-section__container {
    gap: var(--gap-large);
  }

  .trust-signals-section__header {
    max-width: var(--container-small-max);
    gap: var(--gap-regular);
  }

  .trust-signals-section__header :is(h2, h3, h4, h5, h6),
  .trust-signals-section__header p,
  .trust-signals-section__supporting {
    margin: 0;
  }

  :global(.trust-signals-section__rating) {
    max-width: 100%;
    flex-wrap: wrap;
  }

  .trust-signals-section__header :is(h2, h3, h4, h5, h6) {
    font-family: var(--text-style-heading-h3-font-family);
    font-size: var(--text-style-heading-h3-font-size);
    font-weight: var(--text-style-heading-h3-font-weight);
    line-height: var(--text-style-heading-h3-line-height);
    letter-spacing: var(--text-style-heading-h3-letter-spacing);
  }

  .trust-signals-section__header p,
  .trust-signals-section__supporting {
    color: var(--color-text-secondary);
  }

  .trust-signals-section__header p {
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    line-height: var(--text-style-body-base-line-height);
  }

  .trust-signals-section__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-large);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-signals-section__item {
    align-content: start;
    gap: var(--gap-regular);
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
  }

  .trust-signals-section__supporting {
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    line-height: var(--text-style-body-small-line-height);
  }

  @media (width < 64rem) {
    .trust-signals-section__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .trust-signals-section__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
