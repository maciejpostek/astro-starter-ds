---
import type { HTMLAttributes } from "astro/types";
import Button from "../../../atoms/actions/Button.astro";
import PricingCard from "../../cards/PricingCard.astro";
import ComparisonTable from "../../data-display/ComparisonTable.astro";

export type PricingComparisonSectionVariant =
  "feature-matrix" | "add-ons" | "enterprise-cta";

export interface PricingComparisonColumn {
  key: string;
  label: string;
  highlighted?: boolean;
}

export interface PricingComparisonRow {
  id: string;
  label: string;
  values: Record<string, string | boolean>;
}

export interface PricingComparisonMatrix {
  caption: string;
  columns: PricingComparisonColumn[];
  rows: PricingComparisonRow[];
}

export interface PricingComparisonPlan {
  id: string;
  name: string;
  bestFor: string;
  description: string;
  points: string[];
  price: string;
  priceSuffix?: string;
  featured?: boolean;
  featuredLabel?: string;
}

export interface PricingComparisonEnterprise {
  name: string;
  bestFor: string;
  description: string;
  points: string[];
  price: string;
  priceSuffix?: string;
  cta: {
    label: string;
    href: string;
  };
}

export interface PricingComparisonSectionContent {
  title: string;
  description?: string;
  note?: string;
  comparison?: PricingComparisonMatrix;
  plans?: PricingComparisonPlan[];
  enterprise?: PricingComparisonEnterprise;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: PricingComparisonSectionContent;
  variant: PricingComparisonSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "PricingComparisonSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const selectorSafeKeyPattern = /^[a-z][a-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/)|#|mailto:|tel:)/i;
const supportedVariants: PricingComparisonSectionVariant[] = [
  "feature-matrix",
  "add-ons",
  "enterprise-cta",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedNote = content?.note?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "PricingComparisonSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "PricingComparisonSection requires a structured content object.",
  );
}
if (!normalizedTitle) {
  throw new Error("PricingComparisonSection requires a non-empty title.");
}
if (content.description !== undefined && !normalizedDescription) {
  throw new Error(
    "PricingComparisonSection description must be non-empty when provided.",
  );
}
if (content.note !== undefined && !normalizedNote) {
  throw new Error(
    "PricingComparisonSection note must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `PricingComparisonSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `PricingComparisonSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "PricingComparisonSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "PricingComparisonSection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error(
    "PricingComparisonSection does not expose public slots.",
  );
}

const normalizePlan = (plan: PricingComparisonPlan, index: number) => {
  const planId = plan?.id?.trim();
  const name = plan?.name?.trim();
  const bestFor = plan?.bestFor?.trim();
  const description = plan?.description?.trim();
  const points = Array.isArray(plan?.points)
    ? plan.points.map((point) => point?.trim())
    : [];
  const price = plan?.price?.trim();
  const priceSuffix = plan?.priceSuffix?.trim();
  const featuredLabel = plan?.featuredLabel?.trim();

  if (!planId || !selectorSafeIdPattern.test(planId)) {
    throw new Error(
      `PricingComparisonSection plan ${index + 1} requires a selector-safe id that starts with a letter.`,
    );
  }
  if (!name || !bestFor || !description || !price) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" requires non-empty name, bestFor, description, and price strings.`,
    );
  }
  if (points.length < 1 || points.some((point) => !point)) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" requires at least one non-empty point.`,
    );
  }
  if (points.length > 8) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" supports at most eight points.`,
    );
  }
  if (plan.priceSuffix !== undefined && !priceSuffix) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" priceSuffix must be non-empty when provided.`,
    );
  }
  if (plan.featured && plan.featuredLabel !== undefined && !featuredLabel) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" featuredLabel must be non-empty when provided.`,
    );
  }
  if (!plan.featured && plan.featuredLabel !== undefined) {
    throw new Error(
      `PricingComparisonSection plan "${planId}" featuredLabel requires featured=true.`,
    );
  }

  return {
    id: planId,
    name,
    bestFor,
    description,
    points,
    price,
    priceSuffix,
    featured: plan.featured ?? false,
    featuredLabel,
  };
};

type NormalizedComparison = {
  caption: string;
  columns: PricingComparisonColumn[];
  rows: PricingComparisonRow[];
};

type NormalizedEnterprise = {
  name: string;
  bestFor: string;
  description: string;
  points: string[];
  price: string;
  priceSuffix?: string;
  cta: { label: string; href: string };
};

let normalizedComparison: NormalizedComparison | undefined;
let normalizedPlans: ReturnType<typeof normalizePlan>[] = [];
let normalizedEnterprise: NormalizedEnterprise | undefined;

if (variant === "feature-matrix") {
  if (!content.comparison) {
    throw new Error(
      "PricingComparisonSection Feature Matrix requires comparison content.",
    );
  }
  if (content.plans !== undefined || content.enterprise !== undefined) {
    throw new Error(
      "PricingComparisonSection Feature Matrix rejects plans and enterprise content.",
    );
  }

  const caption = content.comparison.caption?.trim();
  if (!caption) {
    throw new Error(
      "PricingComparisonSection Feature Matrix requires a non-empty caption.",
    );
  }
  if (
    !Array.isArray(content.comparison.columns) ||
    content.comparison.columns.length < 2 ||
    content.comparison.columns.length > 4
  ) {
    throw new Error(
      "PricingComparisonSection Feature Matrix requires two to four columns.",
    );
  }

  const columnKeys = new Set<string>();
  const columns = content.comparison.columns.map((column, index) => {
    const key = column?.key?.trim();
    const label = column?.label?.trim();
    if (!key || !selectorSafeKeyPattern.test(key)) {
      throw new Error(
        `PricingComparisonSection comparison column ${index + 1} requires a lowercase selector-safe key.`,
      );
    }
    if (columnKeys.has(key)) {
      throw new Error(
        `PricingComparisonSection comparison contains duplicate column key "${key}".`,
      );
    }
    if (!label) {
      throw new Error(
        `PricingComparisonSection comparison column "${key}" requires a non-empty label.`,
      );
    }
    columnKeys.add(key);
    return {
      key,
      label,
      highlighted: column.highlighted ?? false,
    };
  });

  if (columns.filter((column) => column.highlighted).length > 1) {
    throw new Error(
      "PricingComparisonSection Feature Matrix supports at most one highlighted column.",
    );
  }
  if (
    !Array.isArray(content.comparison.rows) ||
    content.comparison.rows.length < 1 ||
    content.comparison.rows.length > 12
  ) {
    throw new Error(
      "PricingComparisonSection Feature Matrix requires one to twelve rows.",
    );
  }

  const rowIds = new Set<string>();
  const rows = content.comparison.rows.map((row, index) => {
    const rowId = row?.id?.trim();
    const label = row?.label?.trim();
    if (!rowId || !selectorSafeIdPattern.test(rowId)) {
      throw new Error(
        `PricingComparisonSection comparison row ${index + 1} requires a selector-safe id that starts with a letter.`,
      );
    }
    if (rowIds.has(rowId)) {
      throw new Error(
        `PricingComparisonSection comparison contains duplicate row id "${rowId}".`,
      );
    }
    if (!label) {
      throw new Error(
        `PricingComparisonSection comparison row "${rowId}" requires a non-empty label.`,
      );
    }

    const valueKeys = Object.keys(row.values ?? {});
    if (
      valueKeys.length !== columns.length ||
      columns.some((column) => !valueKeys.includes(column.key))
    ) {
      throw new Error(
        `PricingComparisonSection comparison row "${rowId}" must define exactly one value for every column.`,
      );
    }
    for (const column of columns) {
      const value = row.values[column.key];
      if (
        typeof value !== "boolean" &&
        (typeof value !== "string" || !value.trim())
      ) {
        throw new Error(
          `PricingComparisonSection comparison row "${rowId}" contains an invalid value for "${column.key}".`,
        );
      }
    }

    rowIds.add(rowId);
    return {
      id: rowId,
      label,
      values: row.values,
    };
  });

  normalizedComparison = { caption, columns, rows };
}

if (variant === "add-ons") {
  if (content.comparison !== undefined || content.enterprise !== undefined) {
    throw new Error(
      "PricingComparisonSection Add Ons rejects comparison and enterprise content.",
    );
  }
  if (!Array.isArray(content.plans) || content.plans.length < 2) {
    throw new Error(
      "PricingComparisonSection Add Ons requires at least two plans.",
    );
  }
  if (content.plans.length > 4) {
    throw new Error(
      "PricingComparisonSection Add Ons supports at most four plans.",
    );
  }
  normalizedPlans = content.plans.map(normalizePlan);
  if (new Set(normalizedPlans.map((plan) => plan.id)).size !== normalizedPlans.length) {
    throw new Error(
      "PricingComparisonSection Add Ons requires unique plan ids.",
    );
  }
  if (normalizedPlans.filter((plan) => plan.featured).length > 1) {
    throw new Error(
      "PricingComparisonSection Add Ons supports at most one featured plan.",
    );
  }
}

if (variant === "enterprise-cta") {
  if (content.comparison !== undefined || content.plans !== undefined) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA rejects comparison and plans content.",
    );
  }
  if (!content.enterprise) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA requires enterprise content.",
    );
  }
  const name = content.enterprise.name?.trim();
  const bestFor = content.enterprise.bestFor?.trim();
  const description = content.enterprise.description?.trim();
  const points = Array.isArray(content.enterprise.points)
    ? content.enterprise.points.map((point) => point?.trim())
    : [];
  const price = content.enterprise.price?.trim();
  const priceSuffix = content.enterprise.priceSuffix?.trim();
  const label = content.enterprise.cta?.label?.trim();
  const href = content.enterprise.cta?.href?.trim();

  if (!name || !bestFor || !description || !price) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA requires non-empty name, bestFor, description, and price strings.",
    );
  }
  if (points.length < 1 || points.some((point) => !point)) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA requires at least one non-empty point.",
    );
  }
  if (points.length > 8) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA supports at most eight points.",
    );
  }
  if (
    content.enterprise.priceSuffix !== undefined &&
    !priceSuffix
  ) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA priceSuffix must be non-empty when provided.",
    );
  }
  if (!label || !href || !safeHrefPattern.test(href)) {
    throw new Error(
      "PricingComparisonSection Enterprise CTA requires a non-empty action label and a safe supplied href.",
    );
  }

  normalizedEnterprise = {
    name,
    bestFor,
    description,
    points,
    price,
    priceSuffix,
    cta: { label, href },
  };
}

const Heading = `h${headingLevel}` as "h2" | "h3";
const cardHeadingLevel = `h${headingLevel + 1}` as "h3" | "h4";
const EnterpriseHeading = cardHeadingLevel;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "pricing-comparison-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="pricing-comparison"
  data-section-type="pricing-comparison"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div
    class="l-container pricing-comparison-section__container"
    data-container="main"
  >
    <header class="pricing-comparison-section__header">
      <Heading>{normalizedTitle}</Heading>
      {normalizedDescription && <p>{normalizedDescription}</p>}
    </header>

    {
      variant === "feature-matrix" && normalizedComparison && (
        <ComparisonTable
          caption={normalizedComparison.caption}
          columns={normalizedComparison.columns}
          rows={normalizedComparison.rows}
        />
      )
    }

    {
      variant === "add-ons" && (
        <ul class="pricing-comparison-section__plans">
          {normalizedPlans.map((plan) => (
            <li data-pricing-comparison-plan={plan.id}>
              <PricingCard
                name={plan.name}
                bestFor={plan.bestFor}
                description={plan.description}
                points={plan.points}
                price={plan.price}
                priceSuffix={plan.priceSuffix}
                featured={plan.featured}
                featuredLabel={plan.featuredLabel}
                headingLevel={cardHeadingLevel}
              />
            </li>
          ))}
        </ul>
      )
    }

    {
      variant === "enterprise-cta" && normalizedEnterprise && (
        <div class="pricing-comparison-section__enterprise">
          <PricingCard
            name={normalizedEnterprise.name}
            bestFor={normalizedEnterprise.bestFor}
            description={normalizedEnterprise.description}
            points={normalizedEnterprise.points}
            price={normalizedEnterprise.price}
            priceSuffix={normalizedEnterprise.priceSuffix}
            headingLevel={cardHeadingLevel}
          />
          <div class="pricing-comparison-section__enterprise-copy">
            <hgroup>
              <p>Approved enterprise path</p>
              <EnterpriseHeading>
                Continue with supplied commercial context
              </EnterpriseHeading>
            </hgroup>
            <p>
              The destination, response process, qualification rules, commercial
              terms, and follow-up remain application-owned.
            </p>
            <Button
              href={normalizedEnterprise.cta.href}
              variant="primary"
              size="large"
            >
              {normalizedEnterprise.cta.label}
            </Button>
          </div>
        </div>
      )
    }

    {
      normalizedNote && (
        <p class="pricing-comparison-section__note">{normalizedNote}</p>
      )
    }
  </div>
</section>

<style>
  .pricing-comparison-section,
  .pricing-comparison-section__container,
  .pricing-comparison-section__header,
  .pricing-comparison-section__plans,
  .pricing-comparison-section__plans > li,
  .pricing-comparison-section__enterprise,
  .pricing-comparison-section__enterprise-copy {
    min-width: 0;
  }

  .pricing-comparison-section {
    background: var(--color-background-canvas);
  }

  .pricing-comparison-section__container {
    display: grid;
    gap: var(--gap-large);
  }

  .pricing-comparison-section__header {
    display: grid;
    max-width: var(--content-width-medium);
    gap: var(--gap-small);
  }

  .pricing-comparison-section__header :is(h2, h3),
  .pricing-comparison-section__header p,
  .pricing-comparison-section__enterprise-copy :is(h3, p),
  .pricing-comparison-section__note {
    margin: 0;
  }

  .pricing-comparison-section__header p,
  .pricing-comparison-section__enterprise-copy > p,
  .pricing-comparison-section__note {
    color: var(--color-text-secondary);
  }

  .pricing-comparison-section__plans {
    display: grid;
    margin: 0;
    gap: var(--gap-regular);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
  }

  .pricing-comparison-section__plans > li,
  .pricing-comparison-section__plans :global([data-component-name="PricingCard"]) {
    height: 100%;
  }

  .pricing-comparison-section__enterprise {
    display: grid;
    align-items: stretch;
    gap: var(--gap-large);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .pricing-comparison-section__enterprise-copy {
    display: grid;
    align-content: center;
    gap: var(--gap-regular);
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-card);
    background: var(--color-background-subtle);
    padding: var(--component-padding-large);
  }

  .pricing-comparison-section__enterprise-copy hgroup {
    display: grid;
    gap: var(--gap-small);
  }

  .pricing-comparison-section__enterprise-copy hgroup > p {
    color: var(--color-text-accent);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-small);
    text-transform: uppercase;
  }

  .pricing-comparison-section__enterprise-copy :global(.button) {
    justify-self: start;
  }

  .pricing-comparison-section__note {
    max-width: var(--content-width-large);
    font-size: var(--font-size-body-small);
  }

  @media (width < 64rem) {
    .pricing-comparison-section__plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pricing-comparison-section__enterprise {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .pricing-comparison-section__plans {
      grid-template-columns: minmax(0, 1fr);
    }

    .pricing-comparison-section__enterprise-copy {
      padding: var(--component-padding-medium);
    }

    .pricing-comparison-section__enterprise-copy :global(.button) {
      min-width: 0;
      width: 100%;
      inline-size: 100%;
      justify-content: space-between;
    }

    .pricing-comparison-section__enterprise-copy :global(.button__label) {
      min-width: 0;
      white-space: normal;
    }
  }
</style>
