---
import type { HTMLAttributes } from "astro/types";
import SwitchButton from "../../../atoms/actions/SwitchButton.astro";
import PricingCard from "../../cards/PricingCard.astro";

export type PricingSectionVariant = "tiers" | "toggle" | "usage-based";

export interface PricingSectionPlan {
  id: string;
  name: string;
  bestFor: string;
  description: string;
  points: string[];
  price: string;
  priceSuffix?: string;
  alternatePrice?: string;
  alternatePriceSuffix?: string;
  featured?: boolean;
  featuredLabel?: string;
}

export interface PricingSectionToggle {
  label: string;
  primaryLabel: string;
  alternateLabel: string;
  defaultPeriod?: "primary" | "alternate";
}

export interface PricingSectionContent {
  title: string;
  description?: string;
  plans: PricingSectionPlan[];
  toggle?: PricingSectionToggle;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: PricingSectionContent;
  variant: PricingSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "PricingSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafeIdPattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const supportedVariants: PricingSectionVariant[] = [
  "tiers",
  "toggle",
  "usage-based",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafeIdPattern.test(normalizedId)) {
  throw new Error(
    "PricingSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("PricingSection requires a structured content object.");
}
if (!normalizedTitle) {
  throw new Error("PricingSection requires a non-empty title.");
}
if (content.description !== undefined && !normalizedDescription) {
  throw new Error(
    "PricingSection description must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `PricingSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `PricingSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("PricingSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("PricingSection requires a non-empty componentName.");
}
if (!Array.isArray(content.plans) || content.plans.length < 2) {
  throw new Error("PricingSection requires at least two plans.");
}
if (content.plans.length > 4) {
  throw new Error("PricingSection supports at most four plans.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("PricingSection does not expose public slots.");
}

const planIds = new Set<string>();
const normalizedPlans = content.plans.map((plan, index) => {
  const planId = plan?.id?.trim();
  const name = plan?.name?.trim();
  const bestFor = plan?.bestFor?.trim();
  const description = plan?.description?.trim();
  const points = Array.isArray(plan?.points)
    ? plan.points.map((point) => point?.trim())
    : [];
  const price = plan?.price?.trim();
  const priceSuffix = plan?.priceSuffix?.trim();
  const alternatePrice = plan?.alternatePrice?.trim();
  const alternatePriceSuffix = plan?.alternatePriceSuffix?.trim();
  const featuredLabel = plan?.featuredLabel?.trim();

  if (!planId || !selectorSafeIdPattern.test(planId)) {
    throw new Error(
      `PricingSection plan ${index + 1} requires a selector-safe id that starts with a letter.`,
    );
  }
  if (planIds.has(planId)) {
    throw new Error(`PricingSection contains duplicate plan id "${planId}".`);
  }
  if (!name || !bestFor || !description || !price) {
    throw new Error(
      `PricingSection plan "${planId}" requires non-empty name, bestFor, description, and price strings.`,
    );
  }
  if (points.length < 1 || points.some((point) => !point)) {
    throw new Error(
      `PricingSection plan "${planId}" requires at least one non-empty point.`,
    );
  }
  if (points.length > 8) {
    throw new Error(
      `PricingSection plan "${planId}" supports at most eight points.`,
    );
  }
  if (plan.priceSuffix !== undefined && !priceSuffix) {
    throw new Error(
      `PricingSection plan "${planId}" priceSuffix must be non-empty when provided.`,
    );
  }
  if (plan.alternatePrice !== undefined && !alternatePrice) {
    throw new Error(
      `PricingSection plan "${planId}" alternatePrice must be non-empty when provided.`,
    );
  }
  if (plan.alternatePriceSuffix !== undefined && !alternatePriceSuffix) {
    throw new Error(
      `PricingSection plan "${planId}" alternatePriceSuffix must be non-empty when provided.`,
    );
  }
  if (alternatePriceSuffix && !alternatePrice) {
    throw new Error(
      `PricingSection plan "${planId}" alternatePriceSuffix requires alternatePrice.`,
    );
  }
  if (plan.featured && plan.featuredLabel !== undefined && !featuredLabel) {
    throw new Error(
      `PricingSection plan "${planId}" featuredLabel must be non-empty when provided.`,
    );
  }
  if (!plan.featured && plan.featuredLabel !== undefined) {
    throw new Error(
      `PricingSection plan "${planId}" featuredLabel requires featured=true.`,
    );
  }

  planIds.add(planId);
  return {
    id: planId,
    name,
    bestFor,
    description,
    points,
    price,
    priceSuffix,
    alternatePrice,
    alternatePriceSuffix,
    featured: plan.featured ?? false,
    featuredLabel,
  };
});

if (normalizedPlans.filter((plan) => plan.featured).length > 1) {
  throw new Error("PricingSection supports at most one featured plan.");
}
if (
  variant === "usage-based" &&
  normalizedPlans.some((plan) => !plan.priceSuffix)
) {
  throw new Error(
    "PricingSection Usage Based requires priceSuffix for every plan.",
  );
}
if (variant !== "toggle" && content.toggle !== undefined) {
  throw new Error("PricingSection toggle content is supported only by Toggle.");
}
if (
  variant !== "toggle" &&
  normalizedPlans.some(
    (plan) => plan.alternatePrice || plan.alternatePriceSuffix,
  )
) {
  throw new Error(
    `PricingSection ${variant} does not accept alternate pricing fields.`,
  );
}

const normalizedToggle = content.toggle
  ? {
      label: content.toggle.label?.trim(),
      primaryLabel: content.toggle.primaryLabel?.trim(),
      alternateLabel: content.toggle.alternateLabel?.trim(),
      defaultPeriod: content.toggle.defaultPeriod ?? "primary",
    }
  : undefined;

if (
  variant === "toggle" &&
  (!normalizedToggle?.label ||
    !normalizedToggle.primaryLabel ||
    !normalizedToggle.alternateLabel)
) {
  throw new Error(
    "PricingSection Toggle requires non-empty label, primaryLabel, and alternateLabel strings.",
  );
}
if (
  normalizedToggle &&
  !["primary", "alternate"].includes(normalizedToggle.defaultPeriod)
) {
  throw new Error(
    "PricingSection Toggle defaultPeriod must be primary or alternate.",
  );
}
if (
  variant === "toggle" &&
  normalizedPlans.some((plan) => !plan.alternatePrice)
) {
  throw new Error(
    "PricingSection Toggle requires alternatePrice for every plan.",
  );
}

const Heading = `h${headingLevel}` as "h2" | "h3";
const cardHeadingLevel = `h${headingLevel + 1}` as "h3" | "h4";
const defaultAlternate = normalizedToggle?.defaultPeriod === "alternate";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "pricing-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="pricing-comparison"
  data-section-type="pricing"
  data-section-variant={variant}
  data-pricing-period-active={defaultAlternate ? "alternate" : "primary"}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container pricing-section__container" data-container="main">
    <header class="pricing-section__header">
      <div>
        <Heading>{normalizedTitle}</Heading>
        {normalizedDescription && <p>{normalizedDescription}</p>}
      </div>
      {
        variant === "toggle" && normalizedToggle && (
          <div class="pricing-section__toggle" data-pricing-toggle>
            <SwitchButton
              label={normalizedToggle.label}
              checked={defaultAlternate}
              aria-controls={`${normalizedId}-primary ${normalizedId}-alternate`}
            />
            <span class="pricing-section__period-status" aria-live="polite">
              Current:{" "}
              <span data-pricing-period-status>
                {defaultAlternate
                  ? normalizedToggle.alternateLabel
                  : normalizedToggle.primaryLabel}
              </span>
            </span>
          </div>
        )
      }
    </header>

    {
      variant === "toggle" && normalizedToggle ? (
        <div class="pricing-section__periods">
          <ul
            id={`${normalizedId}-primary`}
            class="pricing-section__plans"
            data-pricing-period="primary"
            data-pricing-period-label={normalizedToggle.primaryLabel}
            hidden={defaultAlternate}
          >
            {normalizedPlans.map((plan) => (
              <li data-pricing-plan={plan.id}>
                <PricingCard
                  name={plan.name}
                  bestFor={plan.bestFor}
                  description={plan.description}
                  points={plan.points}
                  price={plan.price}
                  priceSuffix={plan.priceSuffix}
                  featured={plan.featured}
                  featuredLabel={plan.featuredLabel}
                  headingLevel={cardHeadingLevel}
                />
              </li>
            ))}
          </ul>
          <ul
            id={`${normalizedId}-alternate`}
            class="pricing-section__plans"
            data-pricing-period="alternate"
            data-pricing-period-label={normalizedToggle.alternateLabel}
            hidden={!defaultAlternate}
          >
            {normalizedPlans.map((plan) => (
              <li data-pricing-plan={plan.id}>
                <PricingCard
                  name={plan.name}
                  bestFor={plan.bestFor}
                  description={plan.description}
                  points={plan.points}
                  price={plan.alternatePrice!}
                  priceSuffix={plan.alternatePriceSuffix}
                  featured={plan.featured}
                  featuredLabel={plan.featuredLabel}
                  headingLevel={cardHeadingLevel}
                />
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <ul class="pricing-section__plans">
          {normalizedPlans.map((plan) => (
            <li data-pricing-plan={plan.id}>
              <PricingCard
                name={plan.name}
                bestFor={plan.bestFor}
                description={plan.description}
                points={plan.points}
                price={plan.price}
                priceSuffix={plan.priceSuffix}
                featured={plan.featured}
                featuredLabel={plan.featuredLabel}
                headingLevel={cardHeadingLevel}
              />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<script>
  type PricingSectionWindow = Window & {
    __astroDsPricingSectionReady?: boolean;
  };
  const pricingSectionWindow = window as PricingSectionWindow;

  if (!pricingSectionWindow.__astroDsPricingSectionReady) {
    pricingSectionWindow.__astroDsPricingSectionReady = true;
    document.addEventListener("switch-change", (event) => {
      if (!(event.target instanceof Element)) return;
      const toggle = event.target.closest<HTMLElement>("[data-pricing-toggle]");
      const section = toggle?.closest<HTMLElement>(
        '[data-section-type="pricing"][data-section-variant="toggle"]',
      );
      if (!toggle || !section) return;

      const switchControl = toggle.querySelector<HTMLElement>('[role="switch"]');
      const selectedPeriod =
        switchControl?.getAttribute("aria-checked") === "true"
          ? "alternate"
          : "primary";
      const selectedGroup = section.querySelector<HTMLElement>(
        `[data-pricing-period="${selectedPeriod}"]`,
      );

      section.dataset.pricingPeriodActive = selectedPeriod;
      section
        .querySelectorAll<HTMLElement>("[data-pricing-period]")
        .forEach((group) => {
          group.hidden = group.dataset.pricingPeriod !== selectedPeriod;
        });

      const status = section.querySelector<HTMLElement>(
        "[data-pricing-period-status]",
      );
      if (status && selectedGroup?.dataset.pricingPeriodLabel) {
        status.textContent = selectedGroup.dataset.pricingPeriodLabel;
      }
    });
  }
</script>

<style>
  .pricing-section,
  .pricing-section__container,
  .pricing-section__header,
  .pricing-section__header > div,
  .pricing-section__periods,
  .pricing-section__plans,
  .pricing-section__plans > li {
    min-width: 0;
  }

  .pricing-section__container,
  .pricing-section__header > div,
  .pricing-section__periods {
    display: grid;
  }

  .pricing-section__container {
    gap: var(--gap-extra-large);
  }

  .pricing-section__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--gap-large);
  }

  .pricing-section__header > div:first-child {
    max-width: var(--content-max-width);
    gap: var(--gap-small);
  }

  .pricing-section__header :is(h2, h3),
  .pricing-section__header p,
  .pricing-section__period-status {
    margin: 0;
  }

  .pricing-section__header p {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    line-height: var(--text-style-body-base-line-height);
  }

  .pricing-section__toggle {
    display: grid;
    flex: none;
    justify-items: end;
    gap: var(--gap-tiny);
  }

  .pricing-section__period-status {
    color: var(--color-text-tertiary);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    line-height: var(--text-style-body-tiny-line-height);
  }

  .pricing-section__plans {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, var(--size-256)), 1fr));
  }

  .pricing-section__plans[hidden] {
    display: none;
  }

  .pricing-section__plans > li {
    display: grid;
  }

  .pricing-section[data-section-variant="usage-based"]
    .pricing-section__plans {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (width < 64rem) {
    .pricing-section__header {
      align-items: start;
      flex-direction: column;
    }

    .pricing-section__toggle {
      justify-items: start;
    }

    .pricing-section__plans,
    .pricing-section[data-section-variant="usage-based"]
      .pricing-section__plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .pricing-section__container {
      gap: var(--gap-large);
    }

    .pricing-section__plans,
    .pricing-section[data-section-variant="usage-based"]
      .pricing-section__plans {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
