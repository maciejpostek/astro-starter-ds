---
import type { HTMLAttributes } from "astro/types";
import type { MediaRatioValue } from "../../../atoms/media/types";
import ArticleCard from "../../../molecules/cards/ArticleCard.astro";
import type { ArticleCardHeadingLevel } from "../../../molecules/cards/ArticleCard.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";
import Pagination from "../../../molecules/navigation/Pagination.astro";

export type ChangelogSectionVariant = "changelog" | "newsletter-archive";

export interface ChangelogSectionMedia {
  src: string;
  alt: string;
}

export interface ChangelogSectionEntry {
  id: string;
  title: string;
  category: string;
  href: string;
  publishedDate: string;
  dateLabel: string;
  excerpt?: string;
  readingTime?: string;
  actionLabel?: string;
  visualLabel?: string;
  visualRatio?: MediaRatioValue;
  media?: ChangelogSectionMedia;
}

export interface ChangelogSectionPagination {
  currentPage: number;
  totalPages: number;
  basePath: string;
  label?: string;
  maxVisiblePages?: number;
}

export interface ChangelogSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  entries: ChangelogSectionEntry[];
  pagination?: ChangelogSectionPagination;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: ChangelogSectionContent;
  variant: ChangelogSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "ChangelogSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/))/i;
const isoDatePattern = /^\d{4}-\d{2}-\d{2}$/;
const supportedVariants: ChangelogSectionVariant[] = [
  "changelog",
  "newsletter-archive",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const entryLimits: Record<
  ChangelogSectionVariant,
  { min: number; max: number }
> = {
  changelog: { min: 2, max: 20 },
  "newsletter-archive": { min: 2, max: 12 },
};

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "ChangelogSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("ChangelogSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "ChangelogSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "ChangelogSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `ChangelogSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `ChangelogSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "ChangelogSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error("ChangelogSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("ChangelogSection does not expose public slots.");
}

const limits = entryLimits[variant];
if (
  !Array.isArray(content.entries) ||
  content.entries.length < limits.min ||
  content.entries.length > limits.max
) {
  throw new Error(
    `ChangelogSection ${variant} requires ${limits.min} to ${limits.max} entries.`,
  );
}

const entryIds = new Set<string>();
const entryDestinations = new Set<string>();
const normalizedEntries = content.entries.map((entry, entryIndex) => {
  const entryId = entry?.id?.trim();
  const title = entry?.title?.trim();
  const category = entry?.category?.trim();
  const href = entry?.href?.trim();
  const publishedDate = entry?.publishedDate?.trim();
  const dateLabel = entry?.dateLabel?.trim();
  const excerpt = entry?.excerpt?.trim();
  const readingTime = entry?.readingTime?.trim();
  const actionLabel = entry?.actionLabel?.trim();
  const visualLabel = entry?.visualLabel?.trim();
  const mediaSrc = entry?.media?.src?.trim();
  const mediaAlt = entry?.media?.alt?.trim();

  if (
    !entryId ||
    !selectorSafePattern.test(entryId) ||
    !title ||
    !category ||
    !publishedDate ||
    !dateLabel
  ) {
    throw new Error(
      `ChangelogSection entry ${entryIndex + 1} requires selector-safe identity, title, category, publishedDate, and dateLabel.`,
    );
  }
  if (
    !isoDatePattern.test(publishedDate) ||
    Number.isNaN(Date.parse(`${publishedDate}T00:00:00Z`))
  ) {
    throw new Error(
      `ChangelogSection entry "${entryId}" requires a valid YYYY-MM-DD publishedDate.`,
    );
  }
  if (!href || !safeHrefPattern.test(href)) {
    throw new Error(
      `ChangelogSection entry "${entryId}" requires a safe HTTPS or root-relative href.`,
    );
  }
  if (entryIds.has(entryId)) {
    throw new Error(
      `ChangelogSection contains duplicate entry id "${entryId}".`,
    );
  }
  if (entryDestinations.has(href)) {
    throw new Error(
      `ChangelogSection contains duplicate entry destination "${href}".`,
    );
  }
  if (entry.excerpt !== undefined && !excerpt) {
    throw new Error(
      `ChangelogSection entry "${entryId}" excerpt must be non-empty when provided.`,
    );
  }
  if (entry.readingTime !== undefined && !readingTime) {
    throw new Error(
      `ChangelogSection entry "${entryId}" readingTime must be non-empty when provided.`,
    );
  }
  if (entry.actionLabel !== undefined && !actionLabel) {
    throw new Error(
      `ChangelogSection entry "${entryId}" actionLabel must be non-empty when provided.`,
    );
  }
  if (entry.visualLabel !== undefined && !visualLabel) {
    throw new Error(
      `ChangelogSection entry "${entryId}" visualLabel must be non-empty when provided.`,
    );
  }
  if (
    entry.media !== undefined &&
    (!mediaSrc || !safeHrefPattern.test(mediaSrc) || !mediaAlt)
  ) {
    throw new Error(
      `ChangelogSection entry "${entryId}" media requires a safe HTTPS or root-relative src and non-empty alt text.`,
    );
  }

  entryIds.add(entryId);
  entryDestinations.add(href);
  return {
    id: entryId,
    title,
    category,
    href,
    publishedDate,
    dateLabel,
    excerpt,
    readingTime,
    actionLabel,
    visualLabel,
    visualRatio: entry.visualRatio,
    media:
      mediaSrc && mediaAlt
        ? {
            src: mediaSrc,
            alt: mediaAlt,
          }
        : undefined,
  };
});

for (let entryIndex = 1; entryIndex < normalizedEntries.length; entryIndex += 1) {
  if (
    normalizedEntries[entryIndex - 1].publishedDate <
    normalizedEntries[entryIndex].publishedDate
  ) {
    throw new Error(
      "ChangelogSection entries must be ordered newest first by publishedDate.",
    );
  }
}

if (
  variant === "changelog" &&
  normalizedEntries.some(
    (entry) => entry.excerpt !== undefined || entry.media !== undefined,
  )
) {
  throw new Error(
    "ChangelogSection Changelog does not accept entry excerpts or media.",
  );
}
if (
  variant === "newsletter-archive" &&
  normalizedEntries.some((entry) => !entry.excerpt)
) {
  throw new Error(
    "ChangelogSection Newsletter Archive requires an excerpt for every entry.",
  );
}

const normalizedPagination = content.pagination
  ? {
      currentPage: content.pagination.currentPage,
      totalPages: content.pagination.totalPages,
      basePath: content.pagination.basePath?.trim(),
      label: content.pagination.label?.trim(),
      maxVisiblePages: content.pagination.maxVisiblePages,
    }
  : undefined;
if (
  normalizedPagination &&
  (!Number.isSafeInteger(normalizedPagination.currentPage) ||
    !Number.isSafeInteger(normalizedPagination.totalPages) ||
    normalizedPagination.totalPages < 2 ||
    normalizedPagination.currentPage < 1 ||
    normalizedPagination.currentPage > normalizedPagination.totalPages ||
    !normalizedPagination.basePath ||
    !safeHrefPattern.test(normalizedPagination.basePath))
) {
  throw new Error(
    "ChangelogSection pagination requires a valid currentPage, totalPages of at least two, and safe basePath.",
  );
}
if (
  normalizedPagination?.label !== undefined &&
  !normalizedPagination.label
) {
  throw new Error(
    "ChangelogSection pagination label must be non-empty when provided.",
  );
}
if (
  normalizedPagination?.maxVisiblePages !== undefined &&
  (!Number.isSafeInteger(normalizedPagination.maxVisiblePages) ||
    normalizedPagination.maxVisiblePages < 5 ||
    normalizedPagination.maxVisiblePages % 2 === 0)
) {
  throw new Error(
    "ChangelogSection pagination maxVisiblePages must be an odd safe integer of at least five.",
  );
}

const cardHeadingLevel = (headingLevel + 1) as ArticleCardHeadingLevel;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "changelog-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="content-resources"
  data-section-type="changelog"
  data-section-variant={variant}
  data-changelog-entries={normalizedEntries.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div
    class="l-container changelog-section__container"
    data-container="main"
  >
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <ul class="changelog-section__entries">
      {
        normalizedEntries.map((entry) => (
          <li data-changelog-entry={entry.id}>
            {variant === "changelog" ? (
              <ArticleCard
                title={entry.title}
                category={entry.category}
                href={entry.href}
                publishedDate={entry.publishedDate}
                dateLabel={entry.dateLabel}
                variant="compact"
                readingTime={entry.readingTime}
                actionLabel={entry.actionLabel}
                visualLabel={entry.visualLabel}
                visualRatio={entry.visualRatio}
                headingLevel={cardHeadingLevel}
                componentName={`${normalizedComponentName}.Entry`}
              />
            ) : (
              <ArticleCard
                title={entry.title}
                category={entry.category}
                href={entry.href}
                publishedDate={entry.publishedDate}
                dateLabel={entry.dateLabel}
                variant="standard"
                excerpt={entry.excerpt}
                readingTime={entry.readingTime}
                actionLabel={entry.actionLabel}
                visualLabel={entry.visualLabel}
                visualRatio={entry.visualRatio}
                headingLevel={cardHeadingLevel}
                componentName={`${normalizedComponentName}.Entry`}
              >
                {entry.media && (
                  <img
                    slot="media"
                    class="changelog-section__image"
                    src={entry.media.src}
                    alt={entry.media.alt}
                    loading="lazy"
                  />
                )}
              </ArticleCard>
            )}
          </li>
        ))
      }
    </ul>

    {
      normalizedPagination && (
        <div class="changelog-section__pagination">
          <Pagination
            currentPage={normalizedPagination.currentPage}
            totalPages={normalizedPagination.totalPages}
            basePath={normalizedPagination.basePath}
            label={
              normalizedPagination.label ?? `${normalizedTitle} pages`
            }
            maxVisiblePages={normalizedPagination.maxVisiblePages}
            componentName={`${normalizedComponentName}.Pagination`}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .changelog-section,
  .changelog-section__container,
  .changelog-section__entries,
  .changelog-section__entries > li,
  .changelog-section__pagination {
    min-width: 0;
  }

  .changelog-section {
    background: var(--color-background-canvas);
  }

  .changelog-section__container,
  .changelog-section__entries {
    display: grid;
  }

  .changelog-section__container {
    gap: var(--gap-xlarge);
  }

  .changelog-section__entries {
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
  }

  .changelog-section[data-section-variant="newsletter-archive"]
    .changelog-section__entries {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .changelog-section__entries > li {
    height: 100%;
  }

  .changelog-section__pagination {
    display: flex;
    justify-content: center;
  }

  .changelog-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width < 64rem) {
    .changelog-section[data-section-variant="newsletter-archive"]
      .changelog-section__entries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .changelog-section__container {
      gap: var(--gap-large);
    }

    .changelog-section[data-section-variant="newsletter-archive"]
      .changelog-section__entries {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
