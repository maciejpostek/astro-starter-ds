---
import type { HTMLAttributes } from "astro/types";
import ArticleCard from "../../../molecules/cards/ArticleCard.astro";
import type {
  ArticleCardHeadingLevel,
  ArticleCardVariant,
} from "../../../molecules/cards/ArticleCard.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";
import SearchInput from "../../../molecules/forms/SearchInput.astro";
import Pagination from "../../../molecules/navigation/Pagination.astro";
import type { MediaRatioValue } from "../../../atoms/media/types";

export type ContentListingSectionVariant =
  "featured" | "grid" | "list" | "categories";

export interface ContentListingSectionMedia {
  src: string;
  alt: string;
}

export interface ContentListingSectionArticle {
  id: string;
  title: string;
  category: string;
  href: string;
  publishedDate: string;
  dateLabel: string;
  excerpt?: string;
  readingTime?: string;
  visualLabel?: string;
  visualRatio?: MediaRatioValue;
  media?: ContentListingSectionMedia;
}

export interface ContentListingSectionSearch {
  label: string;
  placeholder: string;
  emptyMessage: string;
}

export interface ContentListingSectionPagination {
  currentPage: number;
  totalPages: number;
  basePath: string;
  label?: string;
  maxVisiblePages?: number;
}

export interface ContentListingSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  articles: ContentListingSectionArticle[];
  search?: ContentListingSectionSearch;
  pagination?: ContentListingSectionPagination;
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: ContentListingSectionContent;
  variant: ContentListingSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "ContentListingSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/))/i;
const supportedVariants: ContentListingSectionVariant[] = [
  "featured",
  "grid",
  "list",
  "categories",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const articleLimits: Record<
  ContentListingSectionVariant,
  { min: number; max: number }
> = {
  featured: { min: 2, max: 5 },
  grid: { min: 2, max: 12 },
  list: { min: 2, max: 20 },
  categories: { min: 3, max: 20 },
};

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "ContentListingSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "ContentListingSection requires a structured content object.",
  );
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "ContentListingSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "ContentListingSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `ContentListingSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `ContentListingSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "ContentListingSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "ContentListingSection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("ContentListingSection does not expose public slots.");
}

const limits = articleLimits[variant];
if (
  !Array.isArray(content.articles) ||
  content.articles.length < limits.min ||
  content.articles.length > limits.max
) {
  throw new Error(
    `ContentListingSection ${variant} requires ${limits.min} to ${limits.max} articles.`,
  );
}

const articleIds = new Set<string>();
const articleDestinations = new Set<string>();
const normalizedArticles = content.articles.map((article, articleIndex) => {
  const articleId = article?.id?.trim();
  const title = article?.title?.trim();
  const category = article?.category?.trim();
  const href = article?.href?.trim();
  const publishedDate = article?.publishedDate?.trim();
  const dateLabel = article?.dateLabel?.trim();
  const excerpt = article?.excerpt?.trim();
  const readingTime = article?.readingTime?.trim();
  const visualLabel = article?.visualLabel?.trim();
  const mediaSrc = article?.media?.src?.trim();
  const mediaAlt = article?.media?.alt?.trim();

  if (
    !articleId ||
    !selectorSafePattern.test(articleId) ||
    !title ||
    !category ||
    !publishedDate ||
    !dateLabel
  ) {
    throw new Error(
      `ContentListingSection article ${articleIndex + 1} requires selector-safe identity, title, category, publishedDate, and dateLabel.`,
    );
  }
  if (!href || !safeHrefPattern.test(href)) {
    throw new Error(
      `ContentListingSection article "${articleId}" requires a safe HTTPS or root-relative href.`,
    );
  }
  if (articleIds.has(articleId)) {
    throw new Error(
      `ContentListingSection contains duplicate article id "${articleId}".`,
    );
  }
  if (articleDestinations.has(href)) {
    throw new Error(
      `ContentListingSection contains duplicate article destination "${href}".`,
    );
  }
  if (article.excerpt !== undefined && !excerpt) {
    throw new Error(
      `ContentListingSection article "${articleId}" excerpt must be non-empty when provided.`,
    );
  }
  if (article.readingTime !== undefined && !readingTime) {
    throw new Error(
      `ContentListingSection article "${articleId}" readingTime must be non-empty when provided.`,
    );
  }
  if (article.visualLabel !== undefined && !visualLabel) {
    throw new Error(
      `ContentListingSection article "${articleId}" visualLabel must be non-empty when provided.`,
    );
  }
  if (
    article.media !== undefined &&
    (!mediaSrc || !safeHrefPattern.test(mediaSrc) || !mediaAlt)
  ) {
    throw new Error(
      `ContentListingSection article "${articleId}" media requires a safe HTTPS or root-relative src and non-empty alt text.`,
    );
  }

  articleIds.add(articleId);
  articleDestinations.add(href);
  return {
    id: articleId,
    title,
    category,
    href,
    publishedDate,
    dateLabel,
    excerpt,
    readingTime,
    visualLabel,
    visualRatio: article.visualRatio,
    media:
      mediaSrc && mediaAlt
        ? {
            src: mediaSrc,
            alt: mediaAlt,
          }
        : undefined,
  };
});

if (variant === "featured") {
  if (!normalizedArticles[0]?.excerpt) {
    throw new Error(
      "ContentListingSection Featured requires an excerpt for the first article.",
    );
  }
  if (normalizedArticles.slice(1).some((article) => article.excerpt)) {
    throw new Error(
      "ContentListingSection Featured accepts an excerpt only on the first article.",
    );
  }
}
if (
  variant === "grid" &&
  normalizedArticles.some((article) => !article.excerpt)
) {
  throw new Error(
    "ContentListingSection Grid requires an excerpt for every article.",
  );
}
if (
  (variant === "list" || variant === "categories") &&
  normalizedArticles.some((article) => article.excerpt)
) {
  throw new Error(
    `ContentListingSection ${variant} does not accept article excerpts.`,
  );
}

const categoryNames = [
  ...new Set(normalizedArticles.map((article) => article.category)),
];
if (
  variant === "categories" &&
  (categoryNames.length < 2 || categoryNames.length > 6)
) {
  throw new Error(
    "ContentListingSection Categories requires two to six unique categories.",
  );
}

const normalizedSearch = content.search
  ? {
      label: content.search.label?.trim(),
      placeholder: content.search.placeholder?.trim(),
      emptyMessage: content.search.emptyMessage?.trim(),
    }
  : undefined;
if (
  variant === "categories" &&
  (!normalizedSearch?.label ||
    !normalizedSearch.placeholder ||
    !normalizedSearch.emptyMessage)
) {
  throw new Error(
    "ContentListingSection Categories requires non-empty search label, placeholder, and emptyMessage values.",
  );
}
if (variant !== "categories" && content.search !== undefined) {
  throw new Error(
    "ContentListingSection search content is supported only by Categories.",
  );
}

const normalizedPagination = content.pagination
  ? {
      currentPage: content.pagination.currentPage,
      totalPages: content.pagination.totalPages,
      basePath: content.pagination.basePath?.trim(),
      label: content.pagination.label?.trim(),
      maxVisiblePages: content.pagination.maxVisiblePages,
    }
  : undefined;
if (
  normalizedPagination &&
  (!Number.isSafeInteger(normalizedPagination.currentPage) ||
    !Number.isSafeInteger(normalizedPagination.totalPages) ||
    normalizedPagination.totalPages < 2 ||
    normalizedPagination.currentPage < 1 ||
    normalizedPagination.currentPage > normalizedPagination.totalPages ||
    !normalizedPagination.basePath ||
    normalizedPagination.basePath === "#")
) {
  throw new Error(
    "ContentListingSection pagination requires a valid currentPage, totalPages of at least two, and real basePath.",
  );
}
if (
  normalizedPagination?.label !== undefined &&
  !normalizedPagination.label
) {
  throw new Error(
    "ContentListingSection pagination label must be non-empty when provided.",
  );
}
if (
  normalizedPagination?.maxVisiblePages !== undefined &&
  (!Number.isSafeInteger(normalizedPagination.maxVisiblePages) ||
    normalizedPagination.maxVisiblePages < 5 ||
    normalizedPagination.maxVisiblePages % 2 === 0)
) {
  throw new Error(
    "ContentListingSection pagination maxVisiblePages must be an odd safe integer of at least five.",
  );
}
if (
  (variant === "featured" || variant === "categories") &&
  content.pagination !== undefined
) {
  throw new Error(
    "ContentListingSection pagination is supported only by Grid and List.",
  );
}

const cardHeadingLevel = (headingLevel + 1) as ArticleCardHeadingLevel;
const CategoryHeading = `h${headingLevel + 1}` as "h3" | "h4";
const articleVariant = (articleIndex: number): ArticleCardVariant => {
  if (variant === "featured") {
    return articleIndex === 0 ? "featured" : "compact";
  }
  if (variant === "grid") return "standard";
  return "compact";
};
const articleSearchValue = (article: typeof normalizedArticles[number]) =>
  `${article.title} ${article.category} ${article.dateLabel} ${article.readingTime ?? ""}`
    .toLocaleLowerCase()
    .trim();
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "content-listing-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="content-resources"
  data-section-type="content-listing"
  data-section-variant={variant}
  data-content-listing-articles={normalizedArticles.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div
    class="l-container content-listing-section__container"
    data-container="main"
    data-content-listing-directory={variant === "categories" ? "" : undefined}
  >
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    {
      variant === "categories" && normalizedSearch && (
        <div class="content-listing-section__search">
          <SearchInput
            id={`${normalizedId}-search`}
            name="content-query"
            label={normalizedSearch.label}
            placeholder={normalizedSearch.placeholder}
            componentName={`${normalizedComponentName}.Search`}
          />
          <p
            class="content-listing-section__empty"
            data-content-listing-empty
            aria-live="polite"
            hidden
          >
            {normalizedSearch.emptyMessage}
          </p>
        </div>
      )
    }

    {
      variant === "categories" ? (
        <div class="content-listing-section__categories">
          {categoryNames.map((category) => (
            <section
              class="content-listing-section__category"
              data-content-listing-category={category.toLocaleLowerCase()}
            >
              <CategoryHeading>{category}</CategoryHeading>
              <ul class="content-listing-section__articles">
                {normalizedArticles.map(
                  (article, articleIndex) =>
                    article.category === category && (
                      <li
                        data-content-listing-article={article.id}
                        data-content-listing-search-value={articleSearchValue(
                          article,
                        )}
                      >
                        <ArticleCard
                          title={article.title}
                          category={article.category}
                          href={article.href}
                          publishedDate={article.publishedDate}
                          dateLabel={article.dateLabel}
                          variant={articleVariant(articleIndex)}
                          readingTime={article.readingTime}
                          actionLabel="Read article"
                          headingLevel={cardHeadingLevel}
                          componentName={`${normalizedComponentName}.Article`}
                        />
                      </li>
                    ),
                )}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <ul class="content-listing-section__articles">
          {normalizedArticles.map((article, articleIndex) => (
            <li
              data-content-listing-article={article.id}
              data-content-listing-search-value={articleSearchValue(article)}
            >
              {articleVariant(articleIndex) === "compact" ? (
                <ArticleCard
                  title={article.title}
                  category={article.category}
                  href={article.href}
                  publishedDate={article.publishedDate}
                  dateLabel={article.dateLabel}
                  variant="compact"
                  readingTime={article.readingTime}
                  actionLabel="Read article"
                  headingLevel={cardHeadingLevel}
                  componentName={`${normalizedComponentName}.Article`}
                />
              ) : (
                <ArticleCard
                  title={article.title}
                  category={article.category}
                  href={article.href}
                  publishedDate={article.publishedDate}
                  dateLabel={article.dateLabel}
                  variant={articleVariant(articleIndex)}
                  excerpt={article.excerpt}
                  readingTime={article.readingTime}
                  visualLabel={article.visualLabel}
                  visualRatio={article.visualRatio}
                  actionLabel="Read article"
                  headingLevel={cardHeadingLevel}
                  componentName={`${normalizedComponentName}.Article`}
                >
                  {article.media && (
                    <img
                      slot="media"
                      class="content-listing-section__image"
                      src={article.media.src}
                      alt={article.media.alt}
                      loading="lazy"
                    />
                  )}
                </ArticleCard>
              )}
            </li>
          ))}
        </ul>
      )
    }

    {
      normalizedPagination && (
        <div class="content-listing-section__pagination">
          <Pagination
            currentPage={normalizedPagination.currentPage}
            totalPages={normalizedPagination.totalPages}
            basePath={normalizedPagination.basePath}
            label={normalizedPagination.label ?? `${normalizedTitle} pages`}
            maxVisiblePages={normalizedPagination.maxVisiblePages}
            componentName={`${normalizedComponentName}.Pagination`}
          />
        </div>
      )
    }
  </div>
</section>

<script>
  type ContentListingWindow = Window & {
    __astroDsContentListingReady?: boolean;
  };
  const contentListingWindow = window as ContentListingWindow;

  if (!contentListingWindow.__astroDsContentListingReady) {
    contentListingWindow.__astroDsContentListingReady = true;
    document.addEventListener("input", (event) => {
      const input =
        event.target instanceof HTMLInputElement &&
        event.target.type === "search"
          ? event.target
          : null;
      const directory = input?.closest<HTMLElement>(
        "[data-content-listing-directory]",
      );
      if (!input || !directory) return;

      const query = input.value.trim().toLocaleLowerCase();
      const articles = Array.from(
        directory.querySelectorAll<HTMLElement>(
          "[data-content-listing-article]",
        ),
      );
      let visibleCount = 0;

      articles.forEach((article) => {
        const isVisible =
          !query ||
          (article.dataset.contentListingSearchValue ?? "").includes(query);
        article.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });
      directory
        .querySelectorAll<HTMLElement>("[data-content-listing-category]")
        .forEach((category) => {
          category.hidden = !category.querySelector(
            "[data-content-listing-article]:not([hidden])",
          );
        });

      const emptyMessage = directory.querySelector<HTMLElement>(
        "[data-content-listing-empty]",
      );
      if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
    });
  }
</script>

<style>
  .content-listing-section,
  .content-listing-section__container,
  .content-listing-section__articles,
  .content-listing-section__articles > li,
  .content-listing-section__categories,
  .content-listing-section__category,
  .content-listing-section__search,
  .content-listing-section__pagination {
    min-width: 0;
  }

  .content-listing-section {
    background: var(--color-background-canvas);
  }

  .content-listing-section__container,
  .content-listing-section__articles,
  .content-listing-section__categories,
  .content-listing-section__category,
  .content-listing-section__search {
    display: grid;
  }

  .content-listing-section__container {
    gap: var(--gap-xlarge);
  }

  .content-listing-section__articles {
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
  }

  .content-listing-section__articles > li {
    height: 100%;
  }

  .content-listing-section[data-section-variant="featured"]
    > .content-listing-section__container
    > .content-listing-section__articles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .content-listing-section[data-section-variant="featured"]
    > .content-listing-section__container
    > .content-listing-section__articles
    > li:first-child {
    grid-column: 1 / -1;
  }

  .content-listing-section[data-section-variant="grid"]
    .content-listing-section__articles {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .content-listing-section[data-section-variant="list"]
    .content-listing-section__articles,
  .content-listing-section[data-section-variant="categories"]
    .content-listing-section__articles {
    grid-template-columns: minmax(0, 1fr);
  }

  .content-listing-section__categories {
    gap: var(--gap-xlarge);
  }

  .content-listing-section__category {
    gap: var(--gap-medium);
  }

  .content-listing-section__category h3,
  .content-listing-section__category h4,
  .content-listing-section__empty {
    margin: 0;
  }

  .content-listing-section__category h3,
  .content-listing-section__category h4 {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  .content-listing-section__search {
    max-width: var(--content-width-small);
    gap: var(--gap-small);
  }

  .content-listing-section__empty {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    line-height: var(--text-style-body-small-line-height);
  }

  .content-listing-section__pagination {
    display: flex;
    justify-content: center;
  }

  .content-listing-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width < 64rem) {
    .content-listing-section[data-section-variant="grid"]
      .content-listing-section__articles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .content-listing-section__container,
    .content-listing-section__categories {
      gap: var(--gap-large);
    }

    .content-listing-section[data-section-variant="featured"]
      > .content-listing-section__container
      > .content-listing-section__articles,
    .content-listing-section[data-section-variant="grid"]
      .content-listing-section__articles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
