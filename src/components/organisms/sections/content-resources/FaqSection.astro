---
import type { HTMLAttributes } from "astro/types";
import Accordion from "../../../molecules/disclosure/Accordion.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type FaqSectionVariant = "stacked" | "split";

export interface FaqSectionItem {
  id: string;
  question: string;
  answer: string;
  initiallyOpen?: boolean;
  disabled?: boolean;
}

export interface FaqSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  items: FaqSectionItem[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: FaqSectionContent;
  variant: FaqSectionVariant;
  closeSiblings?: boolean;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  closeSiblings = true,
  headingLevel = 2,
  ariaLabel,
  componentName = "FaqSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const supportedVariants: FaqSectionVariant[] = ["stacked", "split"];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "FaqSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("FaqSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "FaqSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error("FaqSection eyebrow must be non-empty when provided.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `FaqSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `FaqSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("FaqSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("FaqSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("FaqSection does not expose public slots.");
}
if (!Array.isArray(content.items) || content.items.length < 2) {
  throw new Error("FaqSection requires at least two FAQ items.");
}
if (content.items.length > 12) {
  throw new Error("FaqSection supports at most twelve FAQ items.");
}

const itemIds = new Set<string>();
const normalizedItems = content.items.map((item, index) => {
  const itemId = item?.id?.trim();
  const question = item?.question?.trim();
  const answer = item?.answer?.trim();

  if (!itemId || !selectorSafePattern.test(itemId)) {
    throw new Error(
      `FaqSection item ${index + 1} requires a selector-safe id that starts with a letter.`,
    );
  }
  if (itemIds.has(itemId)) {
    throw new Error(`FaqSection contains duplicate item id "${itemId}".`);
  }
  if (!question || !answer) {
    throw new Error(
      `FaqSection item "${itemId}" requires non-empty question and answer strings.`,
    );
  }
  if (item.disabled && item.initiallyOpen) {
    throw new Error(
      `FaqSection item "${itemId}" cannot be disabled and initially open.`,
    );
  }

  itemIds.add(itemId);
  return {
    id: `${normalizedId}-${itemId}`,
    title: question,
    content: answer,
    initiallyOpen: item.initiallyOpen ?? false,
    disabled: item.disabled ?? false,
  };
});

if (
  closeSiblings &&
  normalizedItems.filter((item) => item.initiallyOpen).length > 1
) {
  throw new Error(
    "FaqSection with closeSiblings=true supports at most one initially open item.",
  );
}

const accordionHeadingLevel = `h${headingLevel + 1}` as "h3" | "h4";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "faq-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="content-resources"
  data-section-type="faq"
  data-section-variant={variant}
  data-faq-items={normalizedItems.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container faq-section__container" data-container="main">
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <Accordion
      id={`${normalizedId}-accordion`}
      items={normalizedItems}
      closeSiblings={closeSiblings}
      headingLevel={accordionHeadingLevel}
      componentName={`${normalizedComponentName}.Accordion`}
    />
  </div>
</section>

<style>
  .faq-section,
  .faq-section__container {
    min-width: 0;
  }

  .faq-section {
    background: var(--color-background-canvas);
  }

  .faq-section__container {
    display: grid;
    max-width: var(--content-width-large);
    gap: var(--gap-xlarge);
  }

  .faq-section[data-section-variant="stacked"]
    .faq-section__container {
    max-width: var(--content-width-medium);
  }

  .faq-section[data-section-variant="split"]
    .faq-section__container {
    grid-template-columns: minmax(16rem, 0.75fr) minmax(24rem, 1.25fr);
    align-items: start;
  }

  @media (width < 64rem) {
    .faq-section[data-section-variant="split"]
      .faq-section__container {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
