---
import type { HTMLAttributes } from "astro/types";
import TeamMemberCard from "../../../molecules/cards/TeamMemberCard.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type TeamSectionVariant = "team" | "leadership";

export interface TeamSectionMember {
  id: string;
  name: string;
  role: string;
  description?: string;
  avatarSrc?: string;
  avatarAlt?: string;
  href?: string;
}

export interface TeamSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  members: TeamSectionMember[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: TeamSectionContent;
  variant: TeamSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "TeamSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const supportedVariants: TeamSectionVariant[] = ["team", "leadership"];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const memberLimits: Record<TeamSectionVariant, { min: number; max: number }> = {
  team: { min: 3, max: 12 },
  leadership: { min: 2, max: 6 },
};
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/)|mailto:|tel:)/i;

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "TeamSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("TeamSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "TeamSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error("TeamSection eyebrow must be non-empty when provided.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `TeamSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `TeamSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("TeamSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("TeamSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("TeamSection does not expose public slots.");
}

const limits = memberLimits[variant];
if (
  !Array.isArray(content.members) ||
  content.members.length < limits.min ||
  content.members.length > limits.max
) {
  throw new Error(
    `TeamSection ${variant} requires ${limits.min} to ${limits.max} members.`,
  );
}

const memberIds = new Set<string>();
const normalizedMembers = content.members.map((member, memberIndex) => {
  const memberId = member?.id?.trim();
  const name = member?.name?.trim();
  const role = member?.role?.trim();
  const description = member?.description?.trim();
  const avatarSrc = member?.avatarSrc?.trim();
  const avatarAlt = member?.avatarAlt?.trim() ?? "";
  const href = member?.href?.trim();

  if (!memberId || !selectorSafePattern.test(memberId) || !name || !role) {
    throw new Error(
      `TeamSection member ${memberIndex + 1} requires selector-safe identity, name, and role.`,
    );
  }
  if (memberIds.has(memberId)) {
    throw new Error(`TeamSection contains duplicate member id "${memberId}".`);
  }
  if (member.description !== undefined && !description) {
    throw new Error(
      `TeamSection member "${memberId}" description must be non-empty when provided.`,
    );
  }
  if (member.avatarSrc !== undefined && !avatarSrc) {
    throw new Error(
      `TeamSection member "${memberId}" avatarSrc must be non-empty when provided.`,
    );
  }
  if (
    member.avatarAlt !== undefined &&
    member.avatarAlt !== avatarAlt
  ) {
    throw new Error(
      `TeamSection member "${memberId}" avatarAlt cannot contain surrounding whitespace.`,
    );
  }
  if (member.href !== undefined && (!href || !safeHrefPattern.test(href))) {
    throw new Error(
      `TeamSection member "${memberId}" requires a safe supplied href.`,
    );
  }
  if (variant === "leadership" && !description) {
    throw new Error(
      "TeamSection Leadership requires a supplied description for every member.",
    );
  }
  if (variant === "team" && member.description !== undefined) {
    throw new Error(
      "TeamSection Team does not accept member descriptions.",
    );
  }

  memberIds.add(memberId);
  return {
    id: memberId,
    name,
    role,
    description,
    avatarSrc,
    avatarAlt,
    href,
  };
});

const cardVariant = variant === "leadership" ? "profile" : "compact";
const memberHeadingLevel = headingLevel === 2 ? 3 : 4;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "team-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="company"
  data-section-type="team"
  data-section-variant={variant}
  data-team-members={normalizedMembers.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container team-section__container" data-container="main">
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <ul class="team-section__members">
      {
        normalizedMembers.map((member) => (
          <li data-team-member={member.id}>
            <TeamMemberCard
              name={member.name}
              role={member.role}
              variant={cardVariant}
              description={member.description}
              avatarSrc={member.avatarSrc}
              avatarAlt={member.avatarAlt}
              href={member.href}
              headingLevel={memberHeadingLevel}
              componentName={`${normalizedComponentName}.Member`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team-section,
  .team-section__container,
  .team-section__members,
  .team-section__members > li {
    min-width: 0;
  }

  .team-section__container,
  .team-section__members,
  .team-section__members > li {
    display: grid;
  }

  .team-section__container {
    gap: var(--gap-xlarge);
  }

  .team-section__members {
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
  }

  .team-section__members > li {
    height: 100%;
  }

  .team-section[data-section-variant="team"] .team-section__members {
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, var(--size-256)), 1fr));
  }

  .team-section[data-section-variant="leadership"] .team-section__members {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (width < 64rem) {
    .team-section[data-section-variant="team"] .team-section__members,
    .team-section[data-section-variant="leadership"] .team-section__members {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .team-section__container {
      gap: var(--gap-large);
    }

    .team-section[data-section-variant="team"] .team-section__members,
    .team-section[data-section-variant="leadership"] .team-section__members {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
