---
import type { HTMLAttributes } from "astro/types";
import JobCard from "../../../molecules/cards/JobCard.astro";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type CareersSectionVariant = "overview" | "job-list";

export interface CareersSectionJob {
  id: string;
  title: string;
  department: string;
  location: string;
  employmentType: string;
  href: string;
  description?: string;
  actionLabel?: string;
}

export interface CareersSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  jobs: CareersSectionJob[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: CareersSectionContent;
  variant: CareersSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "CareersSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const supportedVariants: CareersSectionVariant[] = ["overview", "job-list"];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/))/i;
const jobLimits: Record<CareersSectionVariant, { min: number; max: number }> = {
  overview: { min: 1, max: 4 },
  "job-list": { min: 1, max: 12 },
};

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "CareersSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error("CareersSection requires a structured content object.");
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "CareersSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error("CareersSection eyebrow must be non-empty when provided.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `CareersSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `CareersSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error("CareersSection ariaLabel must be non-empty when provided.");
}
if (!normalizedComponentName) {
  throw new Error("CareersSection requires a non-empty componentName.");
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error("CareersSection does not expose public slots.");
}

const limits = jobLimits[variant];
if (
  !Array.isArray(content.jobs) ||
  content.jobs.length < limits.min ||
  content.jobs.length > limits.max
) {
  throw new Error(
    `CareersSection ${variant} requires ${limits.min} to ${limits.max} jobs.`,
  );
}

const jobIds = new Set<string>();
const jobDestinations = new Set<string>();
const normalizedJobs = content.jobs.map((job, jobIndex) => {
  const jobId = job?.id?.trim();
  const title = job?.title?.trim();
  const department = job?.department?.trim();
  const location = job?.location?.trim();
  const employmentType = job?.employmentType?.trim();
  const href = job?.href?.trim();
  const description = job?.description?.trim();
  const actionLabel = job?.actionLabel?.trim();

  if (
    !jobId ||
    !selectorSafePattern.test(jobId) ||
    !title ||
    !department ||
    !location ||
    !employmentType
  ) {
    throw new Error(
      `CareersSection job ${jobIndex + 1} requires selector-safe identity, title, department, location, and employmentType.`,
    );
  }
  if (!href || !safeHrefPattern.test(href)) {
    throw new Error(
      `CareersSection job "${jobId}" requires a safe HTTPS or root-relative href.`,
    );
  }
  if (jobIds.has(jobId)) {
    throw new Error(`CareersSection contains duplicate job id "${jobId}".`);
  }
  if (jobDestinations.has(href)) {
    throw new Error(
      `CareersSection contains duplicate job destination "${href}".`,
    );
  }
  if (job.description !== undefined && !description) {
    throw new Error(
      `CareersSection job "${jobId}" description must be non-empty when provided.`,
    );
  }
  if (job.actionLabel !== undefined && !actionLabel) {
    throw new Error(
      `CareersSection job "${jobId}" actionLabel must be non-empty when provided.`,
    );
  }
  if (variant === "overview" && !description) {
    throw new Error(
      "CareersSection Overview requires a supplied description for every job.",
    );
  }
  if (variant === "job-list" && job.description !== undefined) {
    throw new Error(
      "CareersSection Job List does not accept job descriptions.",
    );
  }

  jobIds.add(jobId);
  jobDestinations.add(href);
  return {
    id: jobId,
    title,
    department,
    location,
    employmentType,
    href,
    description,
    actionLabel,
  };
});

const cardVariant = variant === "overview" ? "detailed" : "compact";
const jobHeadingLevel = headingLevel === 2 ? 3 : 4;
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "careers-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="company"
  data-section-type="careers"
  data-section-variant={variant}
  data-careers-jobs={normalizedJobs.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container careers-section__container" data-container="main">
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <ul class="careers-section__jobs">
      {
        normalizedJobs.map((job) => (
          <li data-careers-job={job.id}>
            <JobCard
              title={job.title}
              department={job.department}
              location={job.location}
              employmentType={job.employmentType}
              href={job.href}
              variant={cardVariant}
              description={job.description}
              actionLabel={job.actionLabel}
              headingLevel={jobHeadingLevel}
              componentName={`${normalizedComponentName}.Job`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .careers-section,
  .careers-section__container,
  .careers-section__jobs,
  .careers-section__jobs > li {
    min-width: 0;
  }

  .careers-section__container,
  .careers-section__jobs,
  .careers-section__jobs > li {
    display: grid;
  }

  .careers-section__container {
    gap: var(--gap-xlarge);
  }

  .careers-section__jobs {
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
  }

  .careers-section__jobs > li {
    height: 100%;
  }

  .careers-section[data-section-variant="overview"] .careers-section__jobs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .careers-section[data-section-variant="job-list"] .careers-section__jobs {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (width < 64rem) {
    .careers-section[data-section-variant="overview"] .careers-section__jobs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .careers-section__container {
      gap: var(--gap-large);
    }
  }
</style>
