---
import type { HTMLAttributes } from "astro/types";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type CompanyStorySectionVariant = "about" | "mission" | "values" | "timeline";

export interface CompanyStorySectionItem {
  id: string;
  title: string;
  description: string;
  label?: string;
}

export interface CompanyStorySectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  items: CompanyStorySectionItem[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: CompanyStorySectionContent;
  variant: CompanyStorySectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "CompanyStorySection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const supportedVariants: CompanyStorySectionVariant[] = [
  "about",
  "mission",
  "values",
  "timeline",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const itemLimits: Record<
  CompanyStorySectionVariant,
  { min: number; max: number }
> = {
  about: { min: 2, max: 4 },
  mission: { min: 1, max: 3 },
  values: { min: 3, max: 6 },
  timeline: { min: 2, max: 8 },
};

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "CompanyStorySection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "CompanyStorySection requires a structured content object.",
  );
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "CompanyStorySection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "CompanyStorySection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `CompanyStorySection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `CompanyStorySection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "CompanyStorySection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "CompanyStorySection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error(
    "CompanyStorySection does not expose public slots.",
  );
}

const limits = itemLimits[variant];
if (
  !Array.isArray(content.items) ||
  content.items.length < limits.min ||
  content.items.length > limits.max
) {
  throw new Error(
    `CompanyStorySection ${variant} requires ${limits.min} to ${limits.max} items.`,
  );
}

const itemIds = new Set<string>();
const normalizedItems = content.items.map((item, itemIndex) => {
  const itemId = item?.id?.trim();
  const title = item?.title?.trim();
  const description = item?.description?.trim();
  const label = item?.label?.trim();

  if (
    !itemId ||
    !selectorSafePattern.test(itemId) ||
    !title ||
    !description
  ) {
    throw new Error(
      `CompanyStorySection item ${itemIndex + 1} requires selector-safe identity, title, and description.`,
    );
  }
  if (itemIds.has(itemId)) {
    throw new Error(
      `CompanyStorySection contains duplicate item id "${itemId}".`,
    );
  }
  if (item.label !== undefined && !label) {
    throw new Error(
      `CompanyStorySection item "${itemId}" label must be non-empty when provided.`,
    );
  }
  if (variant === "timeline" && !label) {
    throw new Error(
      "CompanyStorySection Timeline requires a supplied date or period label for every item.",
    );
  }
  if (variant === "values" && item.label !== undefined) {
    throw new Error(
      "CompanyStorySection Values does not accept item labels.",
    );
  }

  itemIds.add(itemId);
  return {
    id: itemId,
    title,
    description,
    label,
  };
});

const itemHeadingLevel = headingLevel === 2 ? 3 : 4;
const ItemHeading = `h${itemHeadingLevel}` as "h3" | "h4";
const ItemList =
  variant === "about" || variant === "timeline" ? "ol" : "ul";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "company-story-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="company"
  data-section-type="company-story"
  data-section-variant={variant}
  data-company-story-items={normalizedItems.length}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container company-story-section__container" data-container="main">
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <ItemList class="company-story-section__items">
      {
        normalizedItems.map((item) => (
          <li data-company-story-item={item.id}>
            <article class="company-story-section__item">
              {item.label && (
                <p class="company-story-section__label">{item.label}</p>
              )}
              <ItemHeading>{item.title}</ItemHeading>
              <p class="company-story-section__description">
                {item.description}
              </p>
            </article>
          </li>
        ))
      }
    </ItemList>
  </div>
</section>

<style>
  .company-story-section,
  .company-story-section__container,
  .company-story-section__items,
  .company-story-section__items > li,
  .company-story-section__item {
    min-width: 0;
  }

  .company-story-section__container,
  .company-story-section__items,
  .company-story-section__items > li,
  .company-story-section__item {
    display: grid;
  }

  .company-story-section__container {
    gap: var(--gap-xlarge);
  }

  .company-story-section__items {
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--gap-large);
  }

  .company-story-section__items > li {
    position: relative;
  }

  .company-story-section__item {
    height: 100%;
    align-content: start;
    gap: var(--gap-small);
    padding: var(--component-padding-large);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
  }

  .company-story-section__item :is(h3, h4),
  .company-story-section__label,
  .company-story-section__description {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .company-story-section__label {
    color: var(--color-text-accent);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    font-weight: var(--text-style-body-small-font-weight);
    line-height: var(--text-style-body-small-line-height);
  }

  .company-story-section__description {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    line-height: var(--text-style-body-base-line-height);
  }

  .company-story-section[data-section-variant="about"]
    .company-story-section__items,
  .company-story-section[data-section-variant="mission"]
    .company-story-section__items {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .company-story-section[data-section-variant="values"]
    .company-story-section__items {
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, var(--size-256)), 1fr));
  }

  .company-story-section[data-section-variant="timeline"]
    .company-story-section__items {
    gap: 0;
  }

  .company-story-section[data-section-variant="timeline"]
    .company-story-section__items
    > li {
    padding-inline-start: calc(var(--size-32) + var(--gap-large));
  }

  .company-story-section[data-section-variant="timeline"]
    .company-story-section__items
    > li::before {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--component-padding-large);
    inset-inline-start: var(--size-8);
    width: var(--size-16);
    height: var(--size-16);
    border: var(--border-width-default) solid var(--color-border-accent);
    border-radius: var(--radius-full);
    background: var(--color-background-canvas);
    content: "";
  }

  .company-story-section[data-section-variant="timeline"]
    .company-story-section__items
    > li:not(:last-child)::after {
    position: absolute;
    inset-block: calc(var(--component-padding-large) + var(--size-16))
      calc(-1 * var(--component-padding-large));
    inset-inline-start: calc(var(--size-8) + var(--size-8));
    width: var(--border-width-default);
    background: var(--color-border-default);
    content: "";
  }

  .company-story-section[data-section-variant="timeline"]
    .company-story-section__item {
    margin-block-end: var(--gap-large);
  }

  @media (width < 64rem) {
    .company-story-section[data-section-variant="values"]
      .company-story-section__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width < 40rem) {
    .company-story-section__container {
      gap: var(--gap-large);
    }

    .company-story-section[data-section-variant="about"]
      .company-story-section__items,
    .company-story-section[data-section-variant="mission"]
      .company-story-section__items,
    .company-story-section[data-section-variant="values"]
      .company-story-section__items {
      grid-template-columns: minmax(0, 1fr);
    }

    .company-story-section__item {
      padding: var(--component-padding-medium);
    }
  }
</style>
