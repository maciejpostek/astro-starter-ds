---
import type { HTMLAttributes } from "astro/types";
import ContentBlock from "../../../molecules/content/ContentBlock.astro";

export type CompanyContactSectionVariant =
  "locations" | "contact" | "press";

export interface CompanyContactSectionLink {
  label: string;
  href: string;
}

export interface CompanyContactSectionItem {
  id: string;
  title: string;
  description: string;
  address?: string[];
  links: CompanyContactSectionLink[];
}

export interface CompanyContactSectionContent {
  title: string;
  description: string;
  eyebrow?: string;
  items: CompanyContactSectionItem[];
}

type HeadingLevel = 2 | 3;

type Props = {
  id: string;
  content: CompanyContactSectionContent;
  variant: CompanyContactSectionVariant;
  headingLevel?: HeadingLevel;
  ariaLabel?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"section">, "id" | "class" | "aria-label">;

const {
  id,
  content,
  variant,
  headingLevel = 2,
  ariaLabel,
  componentName = "CompanyContactSection",
  class: className,
  ...attributes
} = Astro.props;

const selectorSafePattern = /^[A-Za-z][A-Za-z0-9_-]*$/;
const safeHrefPattern =
  /^(?:https?:\/\/\S+|\/(?!\/)\S*|mailto:[^@\s]+@[^@\s]+|tel:\+?[0-9().\s-]+)$/i;
const supportedVariants: CompanyContactSectionVariant[] = [
  "locations",
  "contact",
  "press",
];
const supportedHeadingLevels: HeadingLevel[] = [2, 3];
const itemLimits: Record<
  CompanyContactSectionVariant,
  { min: number; max: number }
> = {
  locations: { min: 1, max: 6 },
  contact: { min: 1, max: 6 },
  press: { min: 1, max: 4 },
};

const normalizedId = id?.trim();
const normalizedTitle = content?.title?.trim();
const normalizedDescription = content?.description?.trim();
const normalizedEyebrow = content?.eyebrow?.trim();
const normalizedAriaLabel = ariaLabel?.trim();
const normalizedComponentName = componentName?.trim();
const hasFormSlot = Astro.slots.has("form");

if (!normalizedId || !selectorSafePattern.test(normalizedId)) {
  throw new Error(
    "CompanyContactSection id must be selector-safe and start with a letter.",
  );
}
if (!content || typeof content !== "object") {
  throw new Error(
    "CompanyContactSection requires a structured content object.",
  );
}
if (!normalizedTitle || !normalizedDescription) {
  throw new Error(
    "CompanyContactSection requires non-empty title and description values.",
  );
}
if (content.eyebrow !== undefined && !normalizedEyebrow) {
  throw new Error(
    "CompanyContactSection eyebrow must be non-empty when provided.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `CompanyContactSection received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `CompanyContactSection received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (ariaLabel !== undefined && !normalizedAriaLabel) {
  throw new Error(
    "CompanyContactSection ariaLabel must be non-empty when provided.",
  );
}
if (!normalizedComponentName) {
  throw new Error(
    "CompanyContactSection requires a non-empty componentName.",
  );
}
if (
  Astro.slots.has("actions") ||
  Astro.slots.has("media") ||
  Astro.slots.has("default")
) {
  throw new Error(
    "CompanyContactSection exposes only the named form slot.",
  );
}
if (variant === "contact" && !hasFormSlot) {
  throw new Error(
    "CompanyContactSection Contact requires one canonical Form in the form slot.",
  );
}
if (variant !== "contact" && hasFormSlot) {
  throw new Error(
    "CompanyContactSection form slot is supported only by Contact.",
  );
}

const limits = itemLimits[variant];
if (
  !Array.isArray(content.items) ||
  content.items.length < limits.min ||
  content.items.length > limits.max
) {
  throw new Error(
    `CompanyContactSection ${variant} requires ${limits.min} to ${limits.max} items.`,
  );
}

const itemIds = new Set<string>();
const normalizedItems = content.items.map((item, itemIndex) => {
  const itemId = item?.id?.trim();
  const title = item?.title?.trim();
  const description = item?.description?.trim();
  if (
    !itemId ||
    !selectorSafePattern.test(itemId) ||
    !title ||
    !description
  ) {
    throw new Error(
      `CompanyContactSection item ${itemIndex + 1} requires selector-safe identity, title, and description.`,
    );
  }
  if (itemIds.has(itemId)) {
    throw new Error(
      `CompanyContactSection contains duplicate item id "${itemId}".`,
    );
  }
  itemIds.add(itemId);

  if (variant === "locations") {
    if (
      !Array.isArray(item.address) ||
      item.address.length < 1 ||
      item.address.length > 4
    ) {
      throw new Error(
        "CompanyContactSection Locations require one to four address lines per item.",
      );
    }
  } else if (item.address !== undefined) {
    throw new Error(
      "CompanyContactSection address content is supported only by Locations.",
    );
  }

  const address = item.address?.map((line, lineIndex) => {
    const normalizedLine = line?.trim();
    if (!normalizedLine) {
      throw new Error(
        `CompanyContactSection address line ${lineIndex + 1} must be non-empty.`,
      );
    }
    return normalizedLine;
  });

  const linkLimits =
    variant === "locations" ? { min: 0, max: 2 } : { min: 1, max: 3 };
  if (
    !Array.isArray(item.links) ||
    item.links.length < linkLimits.min ||
    item.links.length > linkLimits.max
  ) {
    throw new Error(
      `CompanyContactSection ${variant} items require ${linkLimits.min} to ${linkLimits.max} links.`,
    );
  }

  const destinations = new Set<string>();
  const links = item.links.map((link, linkIndex) => {
    const label = link?.label?.trim();
    const href = link?.href?.trim();
    if (!label || !href || !safeHrefPattern.test(href)) {
      throw new Error(
        `CompanyContactSection link ${linkIndex + 1} requires a non-empty label and safe supplied href.`,
      );
    }
    if (destinations.has(href)) {
      throw new Error(
        `CompanyContactSection item "${itemId}" contains a duplicate destination.`,
      );
    }
    destinations.add(href);
    return { label, href };
  });

  return {
    id: itemId,
    title,
    description,
    address,
    links,
  };
});

const itemHeadingLevel = headingLevel === 2 ? 3 : 4;
const ItemHeading = `h${itemHeadingLevel}` as "h3" | "h4";
---

<section
  {...attributes}
  id={normalizedId}
  class:list={["l-section", "company-contact-section", className]}
  data-padding="medium"
  data-component-name={normalizedComponentName}
  data-component-family="sections"
  data-section-family="company"
  data-section-type="company-contact"
  data-section-variant={variant}
  data-preview-target
  aria-label={normalizedAriaLabel ?? normalizedTitle}
>
  <div class="l-container company-contact-section__container" data-container="main">
    <ContentBlock
      eyebrow={normalizedEyebrow}
      title={normalizedTitle}
      body={normalizedDescription}
      headingLevel={headingLevel}
      componentName={`${normalizedComponentName}.Header`}
    />

    <div class="company-contact-section__body">
      <ul class="company-contact-section__list">
        {
          normalizedItems.map((item) => (
            <li data-company-contact-item={item.id}>
              <article class="company-contact-section__item">
                <ItemHeading>{item.title}</ItemHeading>
                <p>{item.description}</p>
                {item.address && (
                  <address>
                    {item.address.map((line) => (
                      <span>{line}</span>
                    ))}
                  </address>
                )}
                {item.links.length > 0 && (
                  <ul class="company-contact-section__links">
                    {item.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))
        }
      </ul>

      {
        hasFormSlot && (
          <div class="company-contact-section__form" data-company-contact-form>
            <slot name="form" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .company-contact-section,
  .company-contact-section__container,
  .company-contact-section__body,
  .company-contact-section__list,
  .company-contact-section__item,
  .company-contact-section__form {
    min-width: 0;
  }

  .company-contact-section__container,
  .company-contact-section__body,
  .company-contact-section__item {
    display: grid;
  }

  .company-contact-section__container {
    gap: var(--gap-xlarge);
  }

  .company-contact-section__body {
    gap: var(--gap-xlarge);
  }

  .company-contact-section[data-section-variant="contact"]
    .company-contact-section__body {
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    align-items: start;
  }

  .company-contact-section__list,
  .company-contact-section__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .company-contact-section__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-medium);
  }

  .company-contact-section[data-section-variant="contact"]
    .company-contact-section__list {
    grid-template-columns: minmax(0, 1fr);
  }

  .company-contact-section__item {
    height: 100%;
    align-content: start;
    gap: var(--gap-medium);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
    padding: var(--component-padding-large);
  }

  .company-contact-section__item :is(h3, h4),
  .company-contact-section__item p,
  .company-contact-section__item address {
    margin: 0;
  }

  .company-contact-section__item p,
  .company-contact-section__item address {
    color: var(--color-text-secondary);
  }

  .company-contact-section__item address {
    display: grid;
    gap: var(--gap-small);
    font-style: normal;
  }

  .company-contact-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-medium);
  }

  .company-contact-section__links a {
    color: var(--color-text-accent);
    overflow-wrap: anywhere;
  }

  .company-contact-section__form :global(.form) {
    padding: var(--component-padding-large);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
  }

  @media (width < 64rem) {
    .company-contact-section__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .company-contact-section[data-section-variant="contact"]
      .company-contact-section__body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (width < 40rem) {
    .company-contact-section__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .company-contact-section__item,
    .company-contact-section__form :global(.form) {
      padding: var(--component-padding-medium);
    }
  }
</style>
