---
import Label from "../../atoms/forms/Label.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import BulletPoint from "../../atoms/content/BulletPoint.astro";

type HeadingLevel = "h2" | "h3" | "h4" | "h5" | "h6";

interface Props {
  name: string;
  bestFor: string;
  description: string;
  points: string[];
  price?: string;
  priceSuffix?: string;
  featured?: boolean;
  featuredLabel?: string;
  headingLevel?: HeadingLevel;
  componentName?: string;
}

const {
  name,
  bestFor,
  description,
  points,
  price,
  priceSuffix,
  featured = false,
  featuredLabel = "Recommended",
  headingLevel = "h3",
  componentName = "PricingCard"
} = Astro.props;

const resolvedName = name.trim();
const resolvedBestFor = bestFor.trim();
const resolvedDescription = description.trim();
const resolvedPoints = points.map((point) => point.trim());
const resolvedPrice = price?.trim();
const resolvedPriceSuffix = priceSuffix?.trim();
const resolvedFeaturedLabel = featuredLabel.trim();
const resolvedComponentName = componentName.trim();
const HeadingTag = headingLevel;

if (!resolvedName || !resolvedBestFor || !resolvedDescription) {
  throw new Error("PricingCard requires non-empty name, bestFor, and description values.");
}

if (!Array.isArray(points) || resolvedPoints.length === 0) {
  throw new Error("PricingCard requires at least one point.");
}

if (resolvedPoints.some((point) => !point)) {
  throw new Error("PricingCard points must be non-empty strings.");
}

if (price !== undefined && !resolvedPrice) {
  throw new Error("PricingCard price must be non-empty when provided.");
}

if (priceSuffix !== undefined && !resolvedPriceSuffix) {
  throw new Error("PricingCard priceSuffix must be non-empty when provided.");
}

if (resolvedPriceSuffix && !resolvedPrice) {
  throw new Error("PricingCard priceSuffix requires price.");
}

if (featured && !resolvedFeaturedLabel) {
  throw new Error("PricingCard requires a non-empty featuredLabel when featured.");
}

if (!resolvedComponentName) {
  throw new Error("PricingCard requires a non-empty componentName.");
}
---

<article
  class="pricing-card"
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state={featured ? "featured" : "default"}
  data-preview-target
>
  <div class="pricing-card__top">
    <Label variant="metric">{resolvedBestFor}</Label>
    {featured && <Tag variant="accent">{resolvedFeaturedLabel}</Tag>}
  </div>
  <HeadingTag class="pricing-card__title">{resolvedName}</HeadingTag>
  <p>{resolvedDescription}</p>
  {
    resolvedPrice && (
      <p class="pricing-card__price">
        <strong>{resolvedPrice}</strong>
        {resolvedPriceSuffix && <span>{resolvedPriceSuffix}</span>}
      </p>
    )
  }
  <ul>
    {
      resolvedPoints.map((point) => (
        <li><BulletPoint text={point} componentSize="small" tone="success" /></li>
      ))
    }
  </ul>
</article>

<style>
  .pricing-card {
    display: flex;
    min-width: 0;
    min-height:
      calc(var(--size-320) + var(--size-64) + var(--size-6));
    flex-direction: column;
    border: var(--border-width-default) solid var(--color-border-subtle);
    border-radius: var(--radius-small);
    background: var(--color-background-surface);
    padding: var(--component-padding-large);
  }

  .pricing-card[data-card-state="featured"] {
    border-color: var(--color-border-accent);
    background: var(--color-status-info-background);
  }

  .pricing-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-small);
  }

  .pricing-card__title {
    margin: var(--space-huge) 0 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  p {
    margin: var(--space-heading-content) 0 0;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-relaxed);
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--gap-tiny);
    margin-top: var(--space-large);
    color: var(--color-text-secondary);
  }

  .pricing-card__price strong {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h4-font-family);
    font-size: var(--text-style-heading-h4-font-size);
    font-weight: var(--text-style-heading-h4-font-weight);
    line-height: var(--text-style-heading-h4-line-height);
    letter-spacing: var(--text-style-heading-h4-letter-spacing);
    overflow-wrap: anywhere;
  }

  .pricing-card__price span {
    overflow-wrap: anywhere;
  }

  ul {
    display: grid;
    gap: var(--gap-button-group);
    margin: var(--space-large) 0 0;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large) 0 0;
    list-style: none;
  }
</style>
