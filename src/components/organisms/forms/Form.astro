---
import type { HTMLAttributes } from "astro/types";

type Props = {
  action?: string;
  method?: "get" | "post";
  state?: "default" | "validating" | "submitting" | "success" | "error";
  statusMessage?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"form">, "class" | "action" | "method">;

const {
  action,
  method = "post",
  state = "default",
  statusMessage,
  componentName = "Form",
  class: className,
  ...attributes
} = Astro.props;
---

<form
  class:list={["form", className]}
  data-component-name={componentName}
  data-component-family="forms"
  data-form-state={state}
  data-preview-target
  aria-busy={state === "validating" || state === "submitting" ? "true" : undefined}
  action={action}
  method={method}
  {...attributes}
>
  <slot />
  {statusMessage && <p class="form__status" data-form-status role={state === "error" ? "alert" : "status"}>{statusMessage}</p>}
</form>

<style>
  .form {
    display: grid;
    gap: var(--gap-input-group);
  }

  .form__status { color: var(--color-text-secondary); font-size: var(--font-size-body-small); }
  .form[data-form-state="success"] .form__status,
  .form[data-preview-state="success"] .form__status { color: var(--color-status-success-text); }
  .form[data-form-state="error"] .form__status,
  .form[data-preview-state="error"] .form__status { color: var(--color-status-error-text); }
  .form[data-form-state="validating"],
  .form[data-form-state="submitting"],
  .form[data-preview-state="validating"],
  .form[data-preview-state="submitting"] { cursor: progress; opacity: .72; }
</style>
