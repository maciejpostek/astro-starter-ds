---
import type { HTMLAttributes } from "astro/types";

export type EyebrowVariant = "default" | "alternate";

export interface Props extends Omit<HTMLAttributes<"p">, "class"> {
  text: string;
  variant?: EyebrowVariant;
  class?: string;
}

const {
  text,
  variant = "default",
  class: className,
  ...attributes
} = Astro.props;

if (typeof text !== "string" || text.trim().length === 0) {
  throw new TypeError("Eyebrow text must be a non-empty string.");
}
if (variant !== "default" && variant !== "alternate") {
  throw new TypeError('Eyebrow variant must be either "default" or "alternate".');
}
---

<p
  {...attributes}
  class:list={["eyebrow", className]}
  data-component-name="Eyebrow"
  data-eyebrow-variant={variant}
>
  <span class="eyebrow__marker" aria-hidden="true"></span>
  <span class="eyebrow__text">{text}</span>
</p>

<style>
  .eyebrow {
    display: flex;
    inline-size: fit-content;
    max-inline-size: 100%;
    align-items: center;
    gap: var(--gap-small);
    margin: 0 0 var(--space-eyebrow-bottom);
    color: var(--eyebrow-text-default);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-compact);
    text-transform: var(--text-transform-none);
  }

  .eyebrow__marker {
    inline-size: var(--border-width-default);
    block-size: var(--eyebrow-marker-size);
    flex: 0 0 var(--border-width-default);
    background: var(--eyebrow-marker-default);
  }

  .eyebrow[data-eyebrow-variant="alternate"] {
    color: var(--eyebrow-text-alternate-default);
  }

  .eyebrow[data-eyebrow-variant="alternate"] .eyebrow__marker {
    background: var(--eyebrow-marker-alternate-default);
  }

  .eyebrow__text {
    min-inline-size: 0;
    overflow-wrap: var(--overflow-wrap-break-word);
  }

  @media (forced-colors: active) {
    .eyebrow {
      color: CanvasText;
    }

    .eyebrow__marker {
      background: CanvasText;
    }
  }
</style>
