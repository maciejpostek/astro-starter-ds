---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import type {
  AlertEmphasis,
  FeedbackLive,
  FeedbackSize,
  FeedbackStatus,
} from "../../../lib/feedback/feedbackTypes";
import {
  getFeedbackIcon,
  getFeedbackStatusLabel,
  resolveFeedbackRole,
  validateFeedbackContent,
  validateFeedbackPresentation,
} from "../../../lib/feedback/feedbackModel.mjs";
import "../../../styles/components/feedback-messages.css";

export interface Props extends Omit<HTMLAttributes<"div">, "class" | "title" | "role" | "aria-live"> {
  title: string;
  description?: string;
  status?: FeedbackStatus;
  emphasis?: AlertEmphasis;
  size?: FeedbackSize;
  showIcon?: boolean;
  statusLabel?: string;
  live?: FeedbackLive;
  class?: string;
}

const {
  title,
  description,
  status = "info",
  emphasis = "subtle",
  size = "medium",
  showIcon = true,
  statusLabel = getFeedbackStatusLabel(status),
  live = "off",
  class: className,
  ...attributes
} = Astro.props;

validateFeedbackContent({ title });
validateFeedbackPresentation({ status, emphasis, size });
const role = resolveFeedbackRole(live);
const iconName = getFeedbackIcon(status);
const iconSize = {
  small: "var(--feedback-size-small-icon-size)",
  medium: "var(--feedback-size-medium-icon-size)",
  large: "var(--feedback-size-large-icon-size)",
}[size];
---

<div
  {...attributes}
  class:list={["alert", className]}
  data-component-name="Alert"
  data-feedback-root
  data-feedback-kind="Alert"
  data-feedback-icon={showIcon ? "true" : "false"}
  data-feedback-status={status}
  data-feedback-emphasis={emphasis}
  data-feedback-size={size}
  role={role}
  aria-live={live === "off" ? undefined : live}
  aria-atomic={live === "off" ? undefined : "true"}
>
  {showIcon && <MaterialSymbol class="alert__icon" name={iconName} size={iconSize} />}
  <div class="alert__content">
    <p class="alert__title">
      <span class="alert__status-label">{statusLabel}: </span>{title}
    </p>
    {description && <p class="alert__description">{description}</p>}
  </div>
</div>
