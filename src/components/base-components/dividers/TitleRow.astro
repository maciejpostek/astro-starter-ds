---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"p">, "class"> {
  text: string;
  class?: string;
}

const {
  text,
  class: className,
  ...attributes
} = Astro.props;

const normalizedText = text.trim();

if (!normalizedText) {
  throw new TypeError("TitleRow requires non-empty text.");
}
---

<p
  {...attributes}
  class:list={["title-row", className]}
  data-component-name="TitleRow"
>
  {normalizedText}
</p>

<style>
  .title-row {
    inline-size: 100%;
    min-inline-size: 0;
    margin: 0;
    border-block-end: var(--border-width-default) solid var(--color-border-default);
    padding-block-end: var(--content-padding-xsmall);
    color: var(--color-text-tertiary);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-normal);
    overflow-wrap: var(--overflow-wrap-break-word);
    text-transform: var(--text-transform-none);
  }

  @media (forced-colors: active) {
    .title-row {
      border-color: CanvasText;
      color: CanvasText;
    }
  }
</style>
