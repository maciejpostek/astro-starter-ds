---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<
  HTMLAttributes<"input">,
  "checked" | "class" | "disabled" | "type"
> {
  label: string;
  checked?: boolean;
  disabled?: boolean;
  class?: string;
}

const {
  label,
  checked = false,
  disabled = false,
  class: className,
  ...attributes
} = Astro.props;
---

<label
  class:list={["ds-switch-button", className]}
  data-component-name="SwitchButton"
  data-component-size="small"
  data-switch-disabled={disabled ? "true" : undefined}
>
  <input
    {...attributes}
    class="ds-switch-button__input"
    type="checkbox"
    role="switch"
    checked={checked}
    disabled={disabled}
  />
  <span class="ds-switch-button__track" aria-hidden="true">
    <span class="ds-switch-button__thumb"></span>
  </span>
  <span class="ds-switch-button__label">{label}</span>
</label>

<style>
  .ds-switch-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--component-gap);
    color: var(--switch-label-text-default);
    cursor: pointer;
    font-family: var(--font-family-body);
    font-size: var(--component-font-size);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-compact);
  }

  .ds-switch-button__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    border: 0;
    margin: -1px;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ds-switch-button__track {
    position: relative;
    display: block;
    width: calc((var(--component-icon-size) * 2) + var(--size-4));
    height: calc(var(--component-icon-size) + var(--size-4));
    flex: 0 0 auto;
    overflow: hidden;
    border: var(--border-width-default) solid var(--switch-track-off-border-default);
    border-radius: var(--radius-full);
    background: var(--switch-track-off-background-default);
    transition:
      background-color var(--motion-transition),
      border-color var(--motion-transition),
      opacity var(--motion-transition);
  }

  .ds-switch-button__thumb {
    position: absolute;
    inset-block-start: var(--size-2);
    inset-inline-start: var(--size-2);
    width: var(--component-icon-size);
    height: var(--component-icon-size);
    border-radius: var(--radius-full);
    background: var(--switch-handle-background-default);
    box-shadow: var(--elevation-control-thumb);
    transition:
      inset-inline-start var(--motion-transition),
      background-color var(--motion-transition);
  }

  .ds-switch-button__label {
    padding-inline-start: var(--size-2);
    white-space: nowrap;
  }

  .ds-switch-button__input:checked + .ds-switch-button__track {
    border-color: var(--switch-track-on-border-default);
    background: var(--switch-track-on-background-default);
  }

  .ds-switch-button__input:checked + .ds-switch-button__track .ds-switch-button__thumb {
    inset-inline-start: calc(100% - var(--size-2) - var(--component-icon-size));
  }

  .ds-switch-button:hover .ds-switch-button__input:not(:disabled) + .ds-switch-button__track,
  .ds-switch-button__input:not(:disabled)[data-ds-preview-state="hover"] + .ds-switch-button__track {
    border-color: var(--switch-track-off-border-hover);
    background: var(--switch-track-off-background-hover);
  }

  .ds-switch-button:hover .ds-switch-button__input:not(:disabled) + .ds-switch-button__track .ds-switch-button__thumb,
  .ds-switch-button__input:not(:disabled)[data-ds-preview-state="hover"] + .ds-switch-button__track .ds-switch-button__thumb {
    background: var(--switch-handle-background-hover);
  }

  .ds-switch-button:hover .ds-switch-button__input:checked:not(:disabled) + .ds-switch-button__track,
  .ds-switch-button__input:checked:not(:disabled)[data-ds-preview-state="hover"] + .ds-switch-button__track {
    border-color: var(--switch-track-on-border-hover);
    background: var(--switch-track-on-background-hover);
  }

  .ds-switch-button__input:not(:disabled):is(:active, [data-ds-preview-state="pressed"]) + .ds-switch-button__track {
    border-color: var(--switch-track-off-border-pressed);
    background: var(--switch-track-off-background-pressed);
    opacity: 0.88;
  }

  .ds-switch-button__input:not(:disabled):is(:active, [data-ds-preview-state="pressed"]) + .ds-switch-button__track .ds-switch-button__thumb {
    background: var(--switch-handle-background-pressed);
  }

  .ds-switch-button__input:checked:not(:disabled):is(:active, [data-ds-preview-state="pressed"]) + .ds-switch-button__track {
    border-color: var(--switch-track-on-border-pressed);
    background: var(--switch-track-on-background-pressed);
  }

  .ds-switch-button__input:is(:focus-visible, [data-ds-preview-state="focus-visible"]) + .ds-switch-button__track {
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .ds-switch-button[data-switch-disabled="true"] {
    color: var(--switch-label-text-disabled);
    cursor: not-allowed;
    opacity: 0.64;
  }

  .ds-switch-button__input:disabled + .ds-switch-button__track {
    border-color: var(--switch-track-off-border-disabled);
    background: var(--switch-track-off-background-disabled);
  }

  .ds-switch-button__input:disabled + .ds-switch-button__track .ds-switch-button__thumb {
    background: var(--switch-handle-background-disabled);
  }

  .ds-switch-button__input:checked:disabled + .ds-switch-button__track {
    border-color: var(--switch-track-on-border-disabled);
    background: var(--switch-track-on-background-disabled);
  }

  @media (forced-colors: active) {
    .ds-switch-button__track {
      border-color: ButtonText;
      background: Canvas;
    }

    .ds-switch-button__input:checked + .ds-switch-button__track {
      border-color: Highlight;
      background: Highlight;
    }

    .ds-switch-button__thumb {
      background: ButtonText;
      box-shadow: none;
    }

    .ds-switch-button__input:checked + .ds-switch-button__track .ds-switch-button__thumb {
      background: HighlightText;
    }

    .ds-switch-button__input:is(:focus-visible, [data-ds-preview-state="focus-visible"]) + .ds-switch-button__track {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }
  }
</style>
