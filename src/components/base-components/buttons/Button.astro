---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import "../../../styles/components/button-controls.css";

export type ButtonVariant = "primary" | "secondary" | "tertiary";
export type ButtonSize = "small" | "medium" | "large";

export interface Props extends Omit<HTMLAttributes<"button">, "class" | "type"> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  showIcon?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
}

const {
  variant = "primary",
  size = "small",
  showIcon = true,
  class: className,
  type = "button",
  disabled = false,
  ...attributes
} = Astro.props;
---

<button
  {...attributes}
  class:list={["button", className]}
  data-button-variant={variant}
  data-component-name="Button"
  data-control-size={size}
  disabled={disabled}
  type={type}
>
  <span class="button__label"><slot /></span>
  {showIcon && (
    <MaterialSymbol
      class="button__icon"
      name="arrow_forward"
      size="var(--control-icon-size)"
    />
  )}
</button>
