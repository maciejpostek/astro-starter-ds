---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

export type TagTone = "neutral" | "accent" | "success" | "warning" | "error" | "info" | "inverse";

export interface Props extends Omit<HTMLAttributes<"span">, "class"> {
  label: string;
  tone?: TagTone;
  removable?: boolean;
  disabled?: boolean;
  removeLabel?: string;
  class?: string;
}

const {
  label,
  tone = "neutral",
  removable = false,
  disabled = false,
  removeLabel = `Remove ${label}`,
  class: className,
  ...attributes
} = Astro.props;
const hasLeading = Astro.slots.has("leading");
---

<span
  {...attributes}
  class:list={["tag", className]}
  data-component-name="Tag"
  data-tag-disabled={removable && disabled ? "true" : undefined}
  data-tag-leading={hasLeading ? "true" : "false"}
  data-tag-removable={removable ? "true" : "false"}
  data-tag-tone={tone}
>
  {hasLeading && (
    <span class="tag__leading" aria-hidden="true">
      <span class="tag__leading-visual">
        <slot name="leading" />
      </span>
    </span>
  )}
  <span class="tag__label">{label}</span>
  {removable && (
    <button
      class="tag__remove"
      type="button"
      aria-label={removeLabel}
      data-tag-remove
      data-tag-value={label}
      disabled={disabled}
    >
      <MaterialSymbol class="tag__remove-icon" name="close" />
    </button>
  )}
</span>

<style>
  .tag {
    display: inline-flex;
    min-height: var(--tag-min-height);
    align-items: center;
    justify-content: center;
    gap: var(--tag-gap);
    border: var(--border-width-default) solid var(--color-border-accent);
    border-radius: var(--radius-tag);
    padding-block: var(--tag-padding-block);
    padding-inline: var(--tag-padding-inline-text);
    color: var(--color-text-accent);
    background: var(--color-transparent);
    font-family: var(--font-family-body);
    font-size: var(--tag-font-size);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-none);
    text-transform: var(--text-transform-none);
    transition:
      border-color var(--motion-transition),
      color var(--motion-transition),
      background-color var(--motion-transition),
      box-shadow var(--motion-transition);
    white-space: nowrap;
  }

  .tag[data-tag-leading="true"] {
    padding-inline-start: var(--tag-padding-inline-visual);
  }

  .tag[data-tag-removable="true"] {
    padding-inline-end: var(--tag-padding-inline-visual);
  }

  .tag[data-tag-tone="accent"] {
    border-color: var(--color-accent-200);
    color: var(--color-accent-700);
    background: var(--color-accent-50);
  }

  .tag[data-tag-tone="success"] {
    border-color: var(--color-status-success-border);
    color: var(--color-status-success-text);
    background: var(--color-status-success-background);
  }

  .tag[data-tag-tone="warning"] {
    border-color: var(--color-status-warning-border);
    color: var(--color-status-warning-text);
    background: var(--color-status-warning-background);
  }

  .tag[data-tag-tone="error"] {
    border-color: var(--color-status-error-border);
    color: var(--color-status-error-text);
    background: var(--color-status-error-background);
  }

  .tag[data-tag-tone="info"] {
    border-color: var(--color-status-info-border);
    color: var(--color-status-info-text);
    background: var(--color-status-info-background);
  }

  .tag[data-tag-tone="inverse"] {
    border-color: var(--color-background-inverse);
    color: var(--color-text-inverse);
    background: var(--color-background-inverse);
  }

  .tag__label {
    overflow-wrap: anywhere;
  }

  .tag__leading {
    display: inline-grid;
    width: var(--tag-visual-target-size);
    height: var(--tag-visual-target-size);
    flex: 0 0 auto;
    place-items: center;
    color: inherit;
  }

  .tag__leading-visual {
    display: inline-grid;
    width: var(--tag-icon-size);
    height: var(--tag-icon-size);
    place-items: center;
    overflow: hidden;
  }

  .tag__leading-visual :global(svg),
  .tag__leading-visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tag[data-tag-leading="false"] .tag__leading,
  .tag[data-tag-removable="false"] .tag__remove {
    display: none;
  }

  .tag__remove {
    display: inline-grid;
    width: var(--tag-visual-target-size);
    height: var(--tag-visual-target-size);
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    border-radius: var(--radius-full);
    padding: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .tag__remove-icon {
    width: var(--tag-icon-size);
    height: var(--tag-icon-size);
    color: currentColor;
  }

  .tag[data-tag-removable="true"]:has(
    .tag__remove:not(:disabled):is(:hover, [data-ds-preview-state="hover"])
  ) {
    border-color: currentColor;
  }

  .tag[data-tag-removable="true"]:has(
    .tag__remove:not(:disabled):is(:active, [data-ds-preview-state="pressed"])
  ) {
    border-color: currentColor;
    box-shadow: inset 0 0 0 var(--border-width-default) currentColor;
  }

  .tag[data-tag-removable="true"]:has(
    .tag__remove:is(:focus-visible, [data-ds-preview-state="focus-visible"])
  ) {
    box-shadow: var(--effect-focused);
  }

  .tag[data-tag-removable="true"]:has(.tag__remove:disabled) {
    border-color: var(--color-state-disabled-border);
    color: var(--color-state-disabled-text);
    background: var(--color-state-disabled-background);
  }

  .tag__remove:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
    outline: none;
  }

  .tag__remove:disabled {
    cursor: not-allowed;
  }

  @media (forced-colors: active) {
    .tag {
      border-color: CanvasText;
      color: CanvasText;
      background: Canvas;
    }

    .tag[data-tag-removable="true"]:has(
      .tag__remove:is(:focus-visible, [data-ds-preview-state="focus-visible"])
    ) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }
  }
</style>
