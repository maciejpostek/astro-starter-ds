---
import type { HTMLAttributes } from "astro/types";
import Ratio from "../ratio/Ratio.astro";

export interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  class?: string;
}

const {
  class: className,
  ...attributes
} = Astro.props;
---

<div
  {...attributes}
  class:list={["avatar-image", className]}
  data-component-name="AvatarImage"
>
  <Ratio ratio="1:1">
    <slot />
  </Ratio>
</div>

<style>
  .avatar-image {
    flex: none;
    min-inline-size: 0;
    inline-size: var(--avatar-image-size);
    max-inline-size: 100%;
    overflow: hidden;
    border-radius: var(--radius-full);
  }
</style>
