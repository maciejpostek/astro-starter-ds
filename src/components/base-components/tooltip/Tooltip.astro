---
import type { HTMLAttributes } from "astro/types";
import type { OverlayPlacement } from "../../../lib/overlays/overlay-types";
import { validateTooltipContract } from "../../../lib/overlays/overlay-contract.mjs";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

export type { OverlayPlacement } from "../../../lib/overlays/overlay-types";

export interface Props extends Omit<HTMLAttributes<"span">, "class" | "id"> {
  text: string;
  label: string;
  placement?: OverlayPlacement;
  narrowPlacement?: OverlayPlacement;
  id?: string;
  class?: string;
}

const {
  text,
  label,
  placement = "top",
  narrowPlacement,
  id,
  class: className,
  ...attributes
} = Astro.props;

validateTooltipContract({ text, label, placement, narrowPlacement, id });

const rootId = id ?? `tooltip-${crypto.randomUUID()}`;
const contentId = `${rootId}-content`;
---

<span
  {...attributes}
  id={rootId}
  class:list={["tooltip", className]}
  data-component-name="Tooltip"
  data-overlay-mode="tooltip"
  data-overlay-placement={placement}
  data-overlay-placement-narrow={narrowPlacement}
  data-overlay-root
  data-tooltip-placement={placement}
  data-tooltip-placement-narrow={narrowPlacement}
>
  <button
    class="tooltip__trigger"
    type="button"
    aria-label={label}
    aria-describedby={contentId}
    data-overlay-trigger
    data-tooltip-trigger
  >
    <MaterialSymbol name="info" size="100%" />
  </button>
  <span
    id={contentId}
    class="tooltip__content body-tiny-regular"
    role="tooltip"
    popover="manual"
    hidden
    data-overlay-surface
    data-tooltip-content
  >
    <span
      class="tooltip__indicator"
      aria-hidden="true"
      data-overlay-indicator
      data-overlay-tail
    ></span>
    <span class="tooltip__text">{text}</span>
  </span>
</span>

<script>
  import {
    activateOverlay,
    deactivateOverlay,
    hidePopoverSurface,
    isPopoverOpen,
    showPopoverSurface,
  } from "../../../lib/overlays/overlay-runtime";

  declare global {
    interface Window {
      __astroDesignSystemTooltipReady?: boolean;
    }
  }

  type TooltipElement = HTMLElement & {
    hidePopover?: () => void;
    showPopover?: () => void;
  };

  const getRoot = (trigger: Element) =>
    trigger.closest<HTMLElement>('[data-component-name="Tooltip"]');

  const showTooltip = (root: HTMLElement) => {
    const content = root.querySelector<TooltipElement>("[data-tooltip-content]");
    if (!content || isPopoverOpen(content)) return;

    showPopoverSurface(content);
    activateOverlay(root);
  };

  const hideTooltip = (root: HTMLElement) => {
    const content = root.querySelector<TooltipElement>("[data-tooltip-content]");
    if (!content) return;

    deactivateOverlay(root);
    hidePopoverSurface(content);
  };

  if (!window.__astroDesignSystemTooltipReady) {
    window.__astroDesignSystemTooltipReady = true;

    document.addEventListener("pointerover", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest("[data-tooltip-trigger]");
      const root = trigger ? getRoot(trigger) : null;
      if (root) showTooltip(root);
    });

    document.addEventListener("pointerout", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest("[data-tooltip-trigger]");
      if (!trigger) return;
      const relatedTarget = event.relatedTarget;
      if (relatedTarget instanceof Node && trigger.contains(relatedTarget)) return;
      const root = getRoot(trigger);
      if (root) hideTooltip(root);
    });

    document.addEventListener("focusin", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest("[data-tooltip-trigger]");
      const root = trigger ? getRoot(trigger) : null;
      if (root) showTooltip(root);
    });

    document.addEventListener("focusout", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest("[data-tooltip-trigger]");
      const root = trigger ? getRoot(trigger) : null;
      if (root) hideTooltip(root);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      document
        .querySelectorAll<HTMLElement>('[data-component-name="Tooltip"]')
        .forEach(hideTooltip);
    });
  }
</script>

<style>
  .tooltip {
    display: inline-flex;
    box-sizing: border-box;
    inline-size: 100%;
    block-size: 100%;
    flex: 0 0 auto;
  }

  .tooltip__trigger {
    display: inline-grid;
    box-sizing: border-box;
    inline-size: 100%;
    block-size: 100%;
    min-inline-size: 0;
    min-block-size: 0;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    border-radius: var(--radius-small);
    background: transparent;
    padding: 0;
    color: var(--color-icon-secondary);
    cursor: help;
    transition: color var(--motion-transition);
  }

  .tooltip__trigger:is(:hover, :active),
  .tooltip[data-ds-preview-state="hover"] .tooltip__trigger {
    color: var(--color-icon-accent);
  }

  .tooltip__trigger:focus-visible,
  .tooltip[data-ds-preview-state="focus-visible"] .tooltip__trigger {
    color: var(--color-icon-accent);
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .tooltip__content {
    position: fixed;
    inset: auto;
    box-sizing: border-box;
    inline-size: max-content;
    max-inline-size:
      min(
        var(--tooltip-compact-max-inline-size),
        calc(100vw - (var(--tooltip-viewport-padding) * 2))
      );
    margin: 0;
    border: 0;
    border-radius: var(--radius-small);
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
    opacity: 0;
    overflow: visible;
    overflow-wrap: anywhere;
    padding: var(--content-padding-xsmall) var(--content-padding-small);
    pointer-events: none;
    transition: opacity var(--motion-transition);
  }

  .tooltip__content.is-visible {
    opacity: 1;
  }

  .tooltip__text {
    display: block;
    max-inline-size: 100%;
  }

  .tooltip__indicator {
    position: absolute;
    inline-size: var(--tooltip-tail-size);
    block-size: var(--tooltip-tail-size);
    background: var(--color-background-inverse);
  }

  .tooltip__indicator[data-overlay-indicator-direction="down"] {
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .tooltip__indicator[data-overlay-indicator-direction="up"] {
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .tooltip__indicator[data-overlay-indicator-direction="right"] {
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .tooltip__indicator[data-overlay-indicator-direction="left"] {
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip__trigger,
    .tooltip__content {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .tooltip__trigger {
      color: ButtonText;
    }

    .tooltip__trigger:focus-visible,
    .tooltip[data-ds-preview-state="focus-visible"] .tooltip__trigger {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }

    .tooltip__content {
      background: Canvas;
      color: CanvasText;
    }

    .tooltip__indicator {
      background: Canvas;
    }
  }
</style>
