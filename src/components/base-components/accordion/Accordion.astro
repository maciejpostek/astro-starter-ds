---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import type { MaterialSymbolName } from "../../../lib/icons/materialSymbols";
import ProgressBar from "../progress-bar/ProgressBar.astro";
import Tooltip from "../tooltip/Tooltip.astro";

export interface Props extends Omit<HTMLAttributes<"section">, "class" | "id" | "title"> {
  title: string;
  titleSuffix?: string;
  /** @deprecated Prefer the default slot for Accordion content. */
  content?: string;
  helpText?: string;
  helpLabel?: string;
  showTooltip?: boolean;
  showBrandIcon?: boolean;
  brandIcon?: MaterialSymbolName;
  progress?: number;
  progressLabel?: string;
  initialOpen?: boolean;
  disabled?: boolean;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  id?: string;
  class?: string;
}

type RuntimeProps = Omit<Props, "content"> & { content?: string };

const {
  title,
  titleSuffix,
  content,
  helpText,
  helpLabel,
  showTooltip = true,
  showBrandIcon = true,
  brandIcon = "language",
  progress,
  progressLabel,
  initialOpen = false,
  disabled = false,
  headingLevel = 3,
  id,
  class: className,
  ...attributes
} = Astro.props as RuntimeProps;

if (typeof title !== "string" || title.trim().length === 0) {
  throw new TypeError("Accordion title must be a non-empty string.");
}
for (const [name, value] of [
  ["titleSuffix", titleSuffix],
  ["content", content],
  ["helpText", helpText],
  ["helpLabel", helpLabel],
  ["progressLabel", progressLabel],
] as const) {
  if (value !== undefined && (typeof value !== "string" || value.trim().length === 0)) {
    throw new TypeError(`Accordion ${name} must be a non-empty string when provided.`);
  }
}
for (const [name, value] of [
  ["showTooltip", showTooltip],
  ["showBrandIcon", showBrandIcon],
  ["initialOpen", initialOpen],
  ["disabled", disabled],
] as const) {
  if (typeof value !== "boolean") throw new TypeError(`Accordion ${name} must be a boolean.`);
}
if (progress !== undefined && (!Number.isFinite(progress) || progress < 0 || progress > 100)) {
  throw new RangeError("Accordion progress must be a finite number between 0 and 100.");
}
if (![2, 3, 4, 5, 6].includes(headingLevel)) {
  throw new RangeError("Accordion headingLevel must be an integer from 2 to 6.");
}
if (id !== undefined && (typeof id !== "string" || id.trim().length === 0)) {
  throw new TypeError("Accordion id must be a non-empty string when provided.");
}

const hasSlottedContent = Astro.slots.has("default");
if (!hasSlottedContent && content === undefined) {
  throw new TypeError("Accordion requires default slot content or the deprecated content prop.");
}

const rootId = id ?? `accordion-${crypto.randomUUID()}`;
const triggerId = `${rootId}-trigger`;
const panelId = `${rootId}-panel`;
const HeadingTag = `h${headingLevel}` as HTMLTag;
const hasTooltip = showTooltip && Boolean(helpText);
const progressIsManual = progress !== undefined;
---

<section
  {...attributes}
  id={rootId}
  class:list={["accordion", className]}
  data-component-name="Accordion"
  data-accordion-state={initialOpen ? "open" : "closed"}
  data-accordion-help={hasTooltip ? "true" : "false"}
  data-accordion-brand-icon={showBrandIcon ? brandIcon : undefined}
  data-accordion-disabled={disabled ? "true" : undefined}
  data-accordion-progress-manual={progressIsManual ? "true" : undefined}
>
  <ProgressBar
    class="accordion__progress"
    value={progress ?? 0}
    label={progressLabel}
    decorative={!progressLabel}
    hidden={!progressIsManual}
    data-accordion-progress
  />
  <div class="accordion__content-layout">
    <div class="accordion__icons">
      {hasTooltip && (
        <span class="accordion__tooltip" data-accordion-help-trigger>
          <Tooltip
            text={helpText!}
            label={helpLabel ?? `More information about ${title}`}
          />
        </span>
      )}
      {showBrandIcon && (
        <span class="accordion__brand-icon" aria-hidden="true">
          <MaterialSymbol name={brandIcon} size="var(--size-20)" />
        </span>
      )}
    </div>
    <div class="accordion__body">
      <HeadingTag class="accordion__heading">
        <button
          id={triggerId}
          class="accordion__trigger"
          type="button"
          aria-expanded={initialOpen ? "true" : "false"}
          aria-controls={panelId}
          disabled={disabled}
          data-accordion-trigger
        >
          <span class="accordion__title-copy body-base-semibold">
            <span class="accordion__title">{title}</span>
            {titleSuffix && <span class="accordion__title-suffix">{titleSuffix}</span>}
          </span>
          <span class="accordion__indicator" aria-hidden="true">
            <MaterialSymbol name="arrow_drop_down" size="var(--size-20)" />
          </span>
        </button>
      </HeadingTag>
      <div
        id={panelId}
        class="accordion__panel"
        role="region"
        aria-labelledby={triggerId}
        aria-hidden={initialOpen ? "false" : "true"}
        hidden={!initialOpen}
        data-accordion-panel
      >
        <div class="accordion__panel-inner body-base-regular">
          {hasSlottedContent ? <slot /> : <p class="accordion__legacy-content">{content}</p>}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupAccordionController } from "../../../lib/accordion/accordionController";
  setupAccordionController();
</script>

<style>
  .accordion {
    position: relative;
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    overflow: clip;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-accordion);
    background: var(--color-background-surface);
    color: var(--color-text-primary);
    transition: background-color var(--motion-transition), color var(--motion-transition);
  }

  .accordion__progress {
    position: absolute;
    z-index: 1;
    inset-block-start: 0;
    inset-inline: 0;
  }

  .accordion__content-layout {
    display: flex;
    min-inline-size: 0;
    align-items: flex-start;
    gap: var(--gap-small);
    padding: var(--content-padding-medium);
  }

  .accordion__icons {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0;
  }

  .accordion__icons:empty { display: none; }

  .accordion__tooltip {
    display: block;
    inline-size: var(--size-20);
    block-size: var(--size-20);
    flex: 0 0 auto;
  }

  .accordion__brand-icon {
    display: inline-grid;
    inline-size: var(--size-32);
    block-size: var(--size-32);
    place-items: center;
    color: var(--color-icon-accent);
  }

  .accordion__body,
  .accordion__heading,
  .accordion__panel,
  .accordion__panel-inner,
  .accordion__title-copy,
  .accordion__title,
  .accordion__title-suffix,
  .accordion__legacy-content { min-inline-size: 0; }

  .accordion__body { inline-size: 100%; }

  .accordion__heading,
  .accordion__legacy-content { margin: 0; }

  .accordion__trigger {
    display: flex;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: var(--size-32);
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-small);
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }

  .accordion__title-copy {
    display: inline;
    overflow-wrap: anywhere;
  }

  .accordion__title-suffix { color: var(--color-text-secondary); }
  .accordion__title-suffix::before { content: " "; }

  .accordion__indicator {
    display: inline-grid;
    inline-size: var(--size-32);
    block-size: var(--size-32);
    flex: 0 0 auto;
    place-items: center;
    color: inherit;
    transition:
      color var(--motion-transition),
      transform var(--motion-duration-disclosure) var(--motion-ease-premium-out);
  }

  .accordion__panel {
    overflow: clip;
    opacity: 1;
  }

  .accordion__panel-inner {
    min-block-size: 0;
    overflow: hidden;
    padding-block-start: var(--content-padding-xsmall);
    color: var(--color-text-secondary);
  }

  .accordion__panel-inner :global(> :first-child) { margin-block-start: 0; }
  .accordion__panel-inner :global(> :last-child) { margin-block-end: 0; }

  .accordion:has(.accordion__trigger:hover),
  .accordion[data-ds-preview-state="hover"] {
    background: var(--color-background-subtle);
  }

  .accordion:has(.accordion__trigger:focus-visible),
  .accordion[data-ds-preview-state="focus-visible"] {
    position: relative;
    box-shadow: var(--effect-focused);
  }

  .accordion__trigger:focus-visible { outline: none; }

  .accordion[data-accordion-state="open"] .accordion__indicator {
    color: var(--color-icon-accent);
    transform: rotate(180deg);
  }

  .accordion[data-accordion-disabled="true"] {
    border-color: var(--color-state-disabled-border);
    background: var(--color-state-disabled-background);
    color: var(--color-state-disabled-text);
  }

  .accordion[data-accordion-disabled="true"] .accordion__brand-icon,
  .accordion[data-accordion-disabled="true"] .accordion__title-suffix,
  .accordion[data-accordion-disabled="true"] .accordion__panel-inner {
    color: var(--color-state-disabled-text);
  }

  .accordion__trigger:disabled { cursor: not-allowed; }

  @media (prefers-reduced-motion: reduce) {
    .accordion,
    .accordion__indicator { transition: none; }
  }

  @media (forced-colors: active) {
    .accordion { border-color: CanvasText; }

    .accordion:has(.accordion__trigger:focus-visible),
    .accordion[data-ds-preview-state="focus-visible"] {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: calc(var(--size-2) * -1);
      box-shadow: none;
    }
  }
</style>
