---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import Tooltip from "../tooltip/Tooltip.astro";

export interface Props extends Omit<HTMLAttributes<"section">, "class" | "id" | "title"> {
  title: string;
  content: string;
  helpText?: string;
  helpLabel?: string;
  initialOpen?: boolean;
  disabled?: boolean;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  id?: string;
  class?: string;
}

const {
  title,
  content,
  helpText,
  helpLabel,
  initialOpen = false,
  disabled = false,
  headingLevel = 3,
  id,
  class: className,
  ...attributes
} = Astro.props;

for (const [name, value] of [["title", title], ["content", content]] as const) {
  if (typeof value !== "string" || value.trim().length === 0) {
    throw new TypeError(`Accordion ${name} must be a non-empty string.`);
  }
}
for (const [name, value] of [["helpText", helpText], ["helpLabel", helpLabel]] as const) {
  if (value !== undefined && (typeof value !== "string" || value.trim().length === 0)) {
    throw new TypeError(`Accordion ${name} must be a non-empty string when provided.`);
  }
}
if (typeof initialOpen !== "boolean") throw new TypeError("Accordion initialOpen must be a boolean.");
if (typeof disabled !== "boolean") throw new TypeError("Accordion disabled must be a boolean.");
if (![2, 3, 4, 5, 6].includes(headingLevel)) {
  throw new RangeError("Accordion headingLevel must be an integer from 2 to 6.");
}
if (id !== undefined && (typeof id !== "string" || id.trim().length === 0)) {
  throw new TypeError("Accordion id must be a non-empty string when provided.");
}

const rootId = id ?? `accordion-${crypto.randomUUID()}`;
const triggerId = `${rootId}-trigger`;
const panelId = `${rootId}-panel`;
const HeadingTag = `h${headingLevel}` as HTMLTag;
---

<section
  {...attributes}
  id={rootId}
  class:list={["accordion", className]}
  data-component-name="Accordion"
  data-accordion-state={initialOpen ? "open" : "closed"}
  data-accordion-help={helpText ? "true" : "false"}
  data-accordion-disabled={disabled ? "true" : undefined}
>
  <div class:list={["accordion__row", { "accordion__row--with-help": helpText }]}>
    {helpText && (
      <Tooltip
        data-accordion-help-trigger
        text={helpText}
        label={helpLabel ?? `More information about ${title}`}
        size="small"
      />
    )}
    <div class="accordion__body">
      <HeadingTag class="accordion__heading">
        <button
          id={triggerId}
          class="accordion__trigger"
          type="button"
          aria-expanded={initialOpen ? "true" : "false"}
          aria-controls={panelId}
          disabled={disabled}
          data-accordion-trigger
        >
          <span class="accordion__title body-base-semibold">{title}</span>
          <span class="accordion__indicator" aria-hidden="true">
            <MaterialSymbol name="arrow_drop_down" size="var(--size-20)" />
          </span>
        </button>
      </HeadingTag>
      <div
        id={panelId}
        class="accordion__panel"
        role="region"
        aria-labelledby={triggerId}
        aria-hidden={initialOpen ? "false" : "true"}
        hidden={!initialOpen}
        data-accordion-panel
      >
        <div class="accordion__panel-inner">
          <p class="accordion__content body-base-regular">{content}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  declare global {
    interface Window {
      __astroDesignSystemAccordionReady?: boolean;
    }
  }

  const panelAnimations = new WeakMap<HTMLElement, Animation>();

  const parseTime = (value: string) => {
    const normalized = value.trim();
    const amount = Number.parseFloat(normalized);
    if (!Number.isFinite(amount)) return 0;
    return normalized.endsWith("ms") ? amount : amount * 1000;
  };

  const getMotion = (root: HTMLElement) => {
    const styles = getComputedStyle(root);
    return {
      duration: parseTime(styles.getPropertyValue("--motion-duration-surface-enter")),
      easing: styles.getPropertyValue("--motion-ease-premium-out").trim() || "ease-out",
    };
  };

  const cancelPanelAnimation = (panel: HTMLElement) => {
    panelAnimations.get(panel)?.cancel();
    panelAnimations.delete(panel);
  };

  const setAccordionOpen = (trigger: HTMLButtonElement, open: boolean) => {
    const accordion = trigger.closest<HTMLElement>('[data-component-name="Accordion"]');
    const panelId = trigger.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;
    if (!accordion || !(panel instanceof HTMLElement)) return;

    const currentHeight = panel.hidden ? 0 : panel.getBoundingClientRect().height;
    const currentOpacity = panel.hidden
      ? 0
      : Number.parseFloat(getComputedStyle(panel).opacity) || 0;

    cancelPanelAnimation(panel);
    trigger.setAttribute("aria-expanded", String(open));
    panel.setAttribute("aria-hidden", String(!open));
    accordion.dataset.accordionState = open ? "open" : "closed";

    const { duration, easing } = getMotion(accordion);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || duration === 0 || typeof panel.animate !== "function") {
      panel.hidden = !open;
      return;
    }

    if (open) panel.hidden = false;
    const targetHeight = open ? panel.scrollHeight : 0;
    const animation = panel.animate(
      [
        { height: `${currentHeight}px`, opacity: currentOpacity },
        { height: `${targetHeight}px`, opacity: open ? 1 : 0 },
      ],
      { duration, easing, fill: "both" },
    );

    panelAnimations.set(panel, animation);
    animation.onfinish = () => {
      if (panelAnimations.get(panel) !== animation) return;
      panelAnimations.delete(panel);
      animation.cancel();
      panel.hidden = !open;
    };
  };

  const getListTriggers = (list: HTMLElement) =>
    Array.from(list.querySelectorAll<HTMLButtonElement>("[data-accordion-trigger]:not(:disabled)"))
      .filter((trigger) => trigger.closest('[data-component-name="AccordionList"]') === list);

  if (!window.__astroDesignSystemAccordionReady) {
    window.__astroDesignSystemAccordionReady = true;

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest<HTMLButtonElement>("[data-accordion-trigger]");
      const accordion = trigger?.closest<HTMLElement>('[data-component-name="Accordion"]');
      if (!trigger || !accordion || trigger.disabled) return;

      const shouldOpen = trigger.getAttribute("aria-expanded") !== "true";
      const list = accordion.closest<HTMLElement>('[data-component-name="AccordionList"]');
      if (shouldOpen && list?.dataset.accordionMode === "single") {
        getListTriggers(list).forEach((candidate) => {
          if (candidate !== trigger) setAccordionOpen(candidate, false);
        });
      }
      setAccordionOpen(trigger, shouldOpen);
    });

    document.addEventListener("keydown", (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest<HTMLButtonElement>("[data-accordion-trigger]");
      const accordion = trigger?.closest<HTMLElement>('[data-component-name="Accordion"]');
      const list = accordion?.closest<HTMLElement>('[data-component-name="AccordionList"]');
      if (!trigger || !list) return;

      const triggers = getListTriggers(list);
      const currentIndex = triggers.indexOf(trigger);
      if (currentIndex < 0) return;

      let targetIndex;
      if (event.key === "ArrowDown") targetIndex = (currentIndex + 1) % triggers.length;
      if (event.key === "ArrowUp") targetIndex = (currentIndex - 1 + triggers.length) % triggers.length;
      if (event.key === "Home") targetIndex = 0;
      if (event.key === "End") targetIndex = triggers.length - 1;
      if (targetIndex === undefined) return;

      event.preventDefault();
      triggers[targetIndex]?.focus();
    });
  }
</script>

<style>
  .accordion {
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    overflow: clip;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-small);
    background: var(--color-background-surface);
    color: var(--color-text-primary);
    transition: background-color var(--motion-transition), color var(--motion-transition);
  }

  .accordion__row {
    min-inline-size: 0;
    padding: var(--content-padding-medium);
  }

  .accordion__row--with-help {
    display: grid;
    grid-template-columns: var(--size-32) minmax(0, 1fr);
    align-items: start;
    gap: var(--gap-small);
  }

  .accordion__row--with-help > .accordion__body {
    grid-column: 2;
  }

  .accordion__row--with-help:has(> [data-accordion-help-trigger][hidden]) {
    grid-template-columns: minmax(0, 1fr);
  }

  .accordion__row--with-help:has(> [data-accordion-help-trigger][hidden]) > .accordion__body {
    grid-column: 1;
  }

  .accordion__body,
  .accordion__heading,
  .accordion__panel,
  .accordion__panel-inner,
  .accordion__content {
    min-inline-size: 0;
  }

  .accordion__body {
    inline-size: 100%;
  }

  .accordion__heading {
    margin: 0;
  }

  .accordion__trigger {
    display: flex;
    inline-size: 100%;
    min-inline-size: 0;
    min-block-size: var(--size-32);
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-small);
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }

  .accordion__title,
  .accordion__content {
    overflow-wrap: anywhere;
  }

  .accordion__indicator {
    display: inline-grid;
    inline-size: var(--size-32);
    block-size: var(--size-32);
    flex: 0 0 auto;
    place-items: center;
    color: inherit;
    transition:
      color var(--motion-transition),
      transform var(--motion-duration-surface-enter) var(--motion-ease-premium-out);
  }

  .accordion__panel {
    overflow: clip;
    opacity: 1;
  }

  .accordion__panel-inner {
    min-block-size: 0;
    overflow: hidden;
  }

  .accordion__content {
    margin: 0;
    padding-block-start: var(--content-padding-xsmall);
    color: var(--color-text-secondary);
  }

  .accordion:has(.accordion__trigger:hover),
  .accordion[data-ds-preview-state="hover"] {
    background: var(--color-background-subtle);
  }

  .accordion:has(.accordion__trigger:focus-visible),
  .accordion[data-ds-preview-state="focus-visible"] {
    position: relative;
    box-shadow: var(--effect-focused);
  }

  .accordion__trigger:focus-visible {
    outline: none;
  }

  .accordion[data-accordion-state="open"] .accordion__indicator {
    color: var(--color-icon-accent);
    transform: rotate(180deg);
  }

  .accordion[data-accordion-disabled="true"] {
    background: var(--color-state-disabled-background);
    color: var(--color-state-disabled-text);
  }

  .accordion__trigger:disabled {
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion,
    .accordion__indicator {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .accordion {
      border-color: CanvasText;
    }

    .accordion:has(.accordion__trigger:focus-visible),
    .accordion[data-ds-preview-state="focus-visible"] {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: calc(var(--size-2) * -1);
      box-shadow: none;
    }
  }
</style>
