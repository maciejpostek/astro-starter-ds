---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import "../../../styles/components/input-controls.css";
import Input, { type InputSize, type InputValidation } from "./Input.astro";

export interface Props extends Omit<HTMLAttributes<"input">, "class" | "disabled" | "size" | "type"> {
  size?: InputSize;
  validation?: InputValidation;
  disabled?: boolean;
  showLabel?: string;
  hideLabel?: string;
  class?: string;
}

const {
  size = "medium",
  validation = "default",
  disabled = false,
  showLabel = "Show password",
  hideLabel = "Hide password",
  class: className,
  ...attributes
} = Astro.props;
---

<div
  class:list={["input-control", "input-control--leading", "input-control--trailing", className]}
  data-component-name="PasswordInput"
  data-control-size={size}
  data-input-control-disabled={disabled ? "true" : undefined}
  data-password-input
>
  <span class="input-control__leading">
    <MaterialSymbol name="shield_lock" size="var(--control-icon-size)" />
  </span>
  <Input
    {...attributes}
    class="input-control__field"
    data-password-input-control
    disabled={disabled}
    size={size}
    validation={validation}
    type="password"
  />
  <button
    class="input-control__action"
    type="button"
    aria-label={showLabel}
    aria-pressed="false"
    data-password-input-toggle
    data-show-label={showLabel}
    data-hide-label={hideLabel}
    disabled={disabled}
  >
    <MaterialSymbol data-password-icon-show name="visibility" size="var(--control-icon-size)" />
    <MaterialSymbol data-password-icon-hide name="visibility_off" size="var(--control-icon-size)" hidden />
  </button>
</div>

<script>
  const setupPasswordInput = (root: HTMLElement) => {
    if (root.dataset.passwordInputReady === "true") return;
    const input = root.querySelector<HTMLInputElement>("[data-password-input-control]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-password-input-toggle]");
    const showIcon = root.querySelector<SVGElement>("[data-password-icon-show]");
    const hideIcon = root.querySelector<SVGElement>("[data-password-icon-hide]");
    if (!input || !toggle || !showIcon || !hideIcon) return;

    root.dataset.passwordInputReady = "true";
    toggle.addEventListener("click", () => {
      if (input.disabled) return;
      const visible = input.type === "text";
      input.type = visible ? "password" : "text";
      toggle.setAttribute("aria-pressed", String(!visible));
      toggle.setAttribute("aria-label", visible ? toggle.dataset.showLabel ?? "Show password" : toggle.dataset.hideLabel ?? "Hide password");
      showIcon.toggleAttribute("hidden", !visible);
      hideIcon.toggleAttribute("hidden", visible);
      input.focus({ preventScroll: true });
    });
  };

  const setupPasswordInputs = () => document.querySelectorAll<HTMLElement>("[data-password-input]").forEach(setupPasswordInput);
  setupPasswordInputs();
  document.addEventListener("astro:page-load", setupPasswordInputs);
</script>
