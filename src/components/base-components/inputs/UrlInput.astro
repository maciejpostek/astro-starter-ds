---
import type { HTMLAttributes } from "astro/types";
import "../../../styles/components/input-controls.css";
import Input, { type InputSize, type InputValidation } from "./Input.astro";
import { normalizeValidationState } from "../../../lib/forms/validationState";

export interface Props extends Omit<HTMLAttributes<"input">, "class" | "disabled" | "name" | "size" | "type" | "value"> {
  name?: string;
  value?: string;
  size?: InputSize;
  validation?: InputValidation;
  disabled?: boolean;
  class?: string;
}

const {
  name,
  value = "",
  size = "medium",
  validation = "none",
  disabled = false,
  class: className,
  ...attributes
} = Astro.props;
const validationState = normalizeValidationState(validation);
const protocol = "https://";
const visibleValue = value.replace(/^https:\/\//iu, "");
const submittedValue = visibleValue ? `${protocol}${visibleValue}` : "";
---

<div
  class:list={["url-input", className]}
  data-component-name="UrlInput"
  data-control-size={size}
  data-input-validation={validationState}
  data-input-control-disabled={disabled ? "true" : undefined}
  data-url-input
>
  <span class="url-input__protocol" aria-hidden="true">{protocol}</span>
  <Input
    {...attributes}
    class="url-input__field"
    data-url-input-control
    disabled={disabled}
    size={size}
    validation={validationState}
    type="text"
    inputmode="url"
    value={visibleValue}
  />
  <input data-url-input-value type="hidden" name={name} value={submittedValue} disabled={disabled} />
</div>

<script>
  const setupUrlInput = (root: HTMLElement) => {
    if (root.dataset.urlInputReady === "true") return;
    const control = root.querySelector<HTMLInputElement>("[data-url-input-control]");
    const hidden = root.querySelector<HTMLInputElement>("[data-url-input-value]");
    if (!control || !hidden) return;

    root.dataset.urlInputReady = "true";
    const syncValue = () => {
      const editableValue = control.value.replace(/^https:\/\//iu, "");
      if (control.value !== editableValue) control.value = editableValue;
      hidden.value = editableValue ? `https://${editableValue}` : "";
      hidden.disabled = control.disabled;
    };

    control.addEventListener("input", syncValue);
    control.form?.addEventListener("reset", () => queueMicrotask(syncValue));
    syncValue();
  };

  const setupUrlInputs = () => document.querySelectorAll<HTMLElement>("[data-url-input]").forEach(setupUrlInput);
  setupUrlInputs();
  document.addEventListener("astro:page-load", setupUrlInputs);
</script>

<style>
  .url-input {
    display: grid;
    width: 100%;
    min-width: 0;
    min-height: var(--control-min-height);
    grid-template-columns: max-content minmax(0, 1fr);
    overflow: hidden;
    border: var(--border-width-default) solid var(--input-border-default);
    border-radius: var(--radius-input);
    background: var(--input-background-default);
    box-shadow: var(--elevation-control-raised);
    transition:
      background-color var(--motion-transition),
      border-color var(--motion-transition),
      box-shadow var(--motion-transition);
  }

  .url-input__protocol {
    display: inline-flex;
    align-items: center;
    border: 0;
    border-inline-end: var(--border-width-default) solid var(--input-border-default);
    padding: var(--control-padding-block) var(--control-padding-inline);
    color: var(--input-helper-default);
    background: var(--input-background-hover);
    font-family: var(--font-family-body);
    font-size: var(--control-font-size);
    line-height: var(--control-line-height);
  }

  .url-input :global(.url-input__field),
  .url-input :global(.url-input__field:is(:hover, :focus-visible, :disabled, [data-input-validation="success"], [data-input-validation="warning"], [data-input-validation="error"])) {
    height: 100%;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:hover, [data-ds-preview-state="hover"]) {
    border-color: var(--input-border-hover);
    background: var(--input-background-hover);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="error"] {
    border-color: var(--input-border-error);
    box-shadow: var(--effect-validation-error);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="warning"] {
    border-color: var(--input-border-warning);
    box-shadow: var(--effect-validation-warning);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="success"] {
    border-color: var(--input-border-success);
    box-shadow: var(--effect-validation-success);
  }

  .url-input:not([data-input-control-disabled="true"]):is(:focus-within, [data-ds-preview-state="focus-visible"]) {
    background: var(--input-background-focus);
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:focus-within, [data-ds-preview-state="focus-visible"]) {
    border-color: var(--input-border-focus);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:hover, [data-ds-preview-state="hover"]) .url-input__protocol {
    border-inline-end-color: var(--input-border-hover);
  }

  .url-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:focus-within, [data-ds-preview-state="focus-visible"]) .url-input__protocol {
    border-inline-end-color: var(--input-border-focus);
  }

  .url-input[data-input-validation="error"] .url-input__protocol {
    border-inline-end-color: var(--input-border-error);
  }

  .url-input[data-input-validation="warning"] .url-input__protocol {
    border-inline-end-color: var(--input-border-warning);
  }

  .url-input[data-input-validation="success"] .url-input__protocol {
    border-inline-end-color: var(--input-border-success);
  }

  .url-input[data-input-control-disabled="true"] {
    border-color: var(--input-border-disabled);
    background: var(--input-background-disabled);
    box-shadow: none;
  }

  .url-input[data-input-control-disabled="true"] .url-input__protocol {
    border-inline-end-color: var(--input-border-disabled);
    color: var(--input-text-disabled);
    background: var(--input-background-disabled);
  }

  @media (forced-colors: active) {
    .url-input {
      border-color: FieldText;
      background: Field;
      box-shadow: none;
    }

    .url-input__protocol {
      border-inline-end-color: FieldText;
      color: FieldText;
      background: Field;
    }

    .url-input:not([data-input-control-disabled="true"]):is(:focus-within, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }

    .url-input:not([data-input-control-disabled="true"])[data-input-validation="error"] {
      border-color: Mark;
    }
  }
</style>
