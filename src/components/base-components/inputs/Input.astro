---
import type { HTMLAttributes } from "astro/types";

export type InputSize = "small" | "medium" | "large";
export type InputValidation = "default" | "valid" | "invalid";

interface InputSharedProps {
  size?: InputSize;
  validation?: InputValidation;
  disabled?: boolean;
  class?: string;
}

type SingleLineInputProps = InputSharedProps & {
  multiline?: false;
} & Omit<HTMLAttributes<"input">, "class" | "disabled" | "size">;

type MultilineInputProps = InputSharedProps & {
  multiline: true;
} & Omit<HTMLAttributes<"textarea">, "class" | "disabled">;

export type Props = SingleLineInputProps | MultilineInputProps;

const {
  multiline = false,
  size = "medium",
  validation = "default",
  disabled = false,
  class: className,
  value,
  ...attributes
} = Astro.props as Props;

const ariaInvalid = validation === "invalid"
  ? "true"
  : attributes["aria-invalid"];
---

{
  multiline ? (
    <textarea
      {...attributes}
      class:list={["ds-input", "ds-input--textarea", className]}
      data-component-name="Input"
      data-component-size={size}
      data-input-validation={validation}
      disabled={disabled}
      aria-invalid={ariaInvalid}
    >{value}</textarea>
  ) : (
    <input
      {...attributes}
      class:list={["ds-input", className]}
      data-component-name="Input"
      data-component-size={size}
      data-input-validation={validation}
      disabled={disabled}
      aria-invalid={ariaInvalid}
      type={(attributes as HTMLAttributes<"input">).type ?? "text"}
      value={value}
    />
  )
}

<style>
  .ds-input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: var(--component-min-height);
    appearance: none;
    border: var(--border-width-default) solid var(--input-border-default);
    border-radius: var(--radius-input);
    padding: var(--component-padding-block) var(--component-padding-inline);
    color: var(--input-text-default);
    background: var(--input-background-default);
    font-family: var(--font-family-body);
    font-size: var(--component-font-size);
    font-weight: var(--font-weight-normal);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--component-line-height);
    transition:
      background-color var(--motion-transition),
      border-color var(--motion-transition),
      box-shadow var(--motion-transition);
  }

  .ds-input::placeholder {
    color: var(--input-placeholder-default);
    opacity: 1;
  }

  .ds-input--textarea {
    min-height: var(--size-128);
    resize: vertical;
  }

  .ds-input:not(:disabled):is(:hover, [data-ds-preview-state="hover"]) {
    border-color: var(--input-border-hover);
    background: var(--input-background-hover);
  }

  .ds-input:not(:disabled):is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
    border-color: var(--input-border-focus);
    background: var(--input-background-focus);
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .ds-input:is([data-input-validation="invalid"], :user-invalid) {
    border-color: var(--input-border-invalid);
  }

  .ds-input[data-input-validation="valid"] {
    border-color: var(--input-border-valid);
  }

  .ds-input:disabled {
    border-color: var(--input-border-disabled);
    color: var(--input-text-disabled);
    background: var(--input-background-disabled);
    cursor: not-allowed;
  }

  .ds-input:disabled::placeholder {
    color: var(--input-placeholder-disabled);
  }

  @media (forced-colors: active) {
    .ds-input {
      border-color: FieldText;
      color: FieldText;
      background: Field;
    }

    .ds-input:not(:disabled):is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }

    .ds-input:is([data-input-validation="invalid"], :user-invalid) {
      border-color: Mark;
    }
  }
</style>
