---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import "../../../styles/components/input-controls.css";
import Input, { type InputSize, type InputValidation } from "./Input.astro";

export interface Props extends Omit<HTMLAttributes<"input">, "class" | "disabled" | "size" | "type"> {
  size?: InputSize;
  validation?: InputValidation;
  disabled?: boolean;
  pickerLabel?: string;
  class?: string;
}

const {
  size = "medium",
  validation = "default",
  disabled = false,
  pickerLabel = "Open date picker",
  class: className,
  ...attributes
} = Astro.props;
---

<div
  class:list={["input-control", "input-control--trailing", className]}
  data-component-name="DateInput"
  data-control-size={size}
  data-input-control-disabled={disabled ? "true" : undefined}
  data-date-input
>
  <Input
    {...attributes}
    class="input-control__field"
    data-date-input-control
    disabled={disabled}
    size={size}
    validation={validation}
    type="date"
  />
  <button
    class="input-control__action"
    type="button"
    aria-label={pickerLabel}
    data-date-input-picker
    disabled={disabled}
  >
    <MaterialSymbol name="calendar_month" size="var(--control-icon-size)" />
  </button>
</div>

<script>
  const setupDateInput = (root: HTMLElement) => {
    if (root.dataset.dateInputReady === "true") return;
    const input = root.querySelector<HTMLInputElement>("[data-date-input-control]");
    const picker = root.querySelector<HTMLButtonElement>("[data-date-input-picker]");
    if (!input || !picker) return;

    root.dataset.dateInputReady = "true";
    picker.addEventListener("click", () => {
      if (input.disabled) return;
      input.focus({ preventScroll: true });
      try {
        input.showPicker?.();
      } catch {
        input.focus({ preventScroll: true });
      }
    });
  };

  const setupDateInputs = () => document.querySelectorAll<HTMLElement>("[data-date-input]").forEach(setupDateInput);
  setupDateInputs();
  document.addEventListener("astro:page-load", setupDateInputs);
</script>

<style>
  :global(.input-control__field::-webkit-calendar-picker-indicator) {
    display: none;
  }
</style>
