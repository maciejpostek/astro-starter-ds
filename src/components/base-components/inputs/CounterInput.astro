---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import "../../../styles/components/input-controls.css";
import Input, { type InputSize, type InputValidation } from "./Input.astro";
import { normalizeValidationState } from "../../../lib/forms/validationState";

export interface Props extends Omit<HTMLAttributes<"input">, "class" | "disabled" | "readonly" | "size" | "type"> {
  size?: InputSize;
  validation?: InputValidation;
  disabled?: boolean;
  readonly?: boolean;
  decrementLabel?: string;
  incrementLabel?: string;
  class?: string;
}

const {
  size = "medium",
  validation = "none",
  disabled = false,
  readonly = false,
  decrementLabel = "Decrease value",
  incrementLabel = "Increase value",
  class: className,
  min,
  max,
  step,
  ...attributes
} = Astro.props;
const validationState = normalizeValidationState(validation);
---

<div
  class:list={["counter-input", className]}
  data-component-name="CounterInput"
  data-control-size={size}
  data-input-validation={validationState}
  data-input-control-disabled={disabled ? "true" : undefined}
  data-counter-input
  data-counter-readonly={readonly ? "true" : undefined}
>
  <button
    class="counter-input__action"
    type="button"
    aria-label={decrementLabel}
    data-counter-decrement
    disabled={disabled || readonly}
  >
    <MaterialSymbol name="remove" size="var(--control-icon-size)" />
  </button>
  <Input
    {...attributes}
    class="counter-input__field"
    data-counter-control
    disabled={disabled}
    readonly={readonly}
    min={min}
    max={max}
    step={step}
    size={size}
    validation={validationState}
    type="number"
  />
  <button
    class="counter-input__action"
    type="button"
    aria-label={incrementLabel}
    data-counter-increment
    disabled={disabled || readonly}
  >
    <MaterialSymbol name="add" size="var(--control-icon-size)" />
  </button>
</div>

<script>
  const setupCounterInput = (root: HTMLElement) => {
    if (root.dataset.counterInputReady === "true") return;
    const input = root.querySelector<HTMLInputElement>("[data-counter-control]");
    const decrement = root.querySelector<HTMLButtonElement>("[data-counter-decrement]");
    const increment = root.querySelector<HTMLButtonElement>("[data-counter-increment]");
    if (!input || !decrement || !increment) return;

    root.dataset.counterInputReady = "true";
    const isReadonly = () => input.readOnly || root.dataset.counterReadonly === "true";
    const syncActions = () => {
      const value = input.valueAsNumber;
      const hasValue = Number.isFinite(value);
      const minimum = Number(input.min);
      const maximum = Number(input.max);
      const atMinimum = input.min !== "" && hasValue && value <= minimum;
      const atMaximum = input.max !== "" && hasValue && value >= maximum;
      decrement.disabled = input.disabled || isReadonly() || atMinimum;
      increment.disabled = input.disabled || isReadonly() || atMaximum;
    };
    const stepValue = (direction: "up" | "down") => {
      if (input.disabled || isReadonly()) return;
      try {
        direction === "up" ? input.stepUp() : input.stepDown();
      } catch {
        return;
      }
      input.dispatchEvent(new Event("input", { bubbles: true }));
      input.focus({ preventScroll: true });
    };

    decrement.addEventListener("click", () => stepValue("down"));
    increment.addEventListener("click", () => stepValue("up"));
    input.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
      event.preventDefault();
      stepValue(event.key === "ArrowUp" ? "up" : "down");
    });
    input.addEventListener("input", syncActions);
    input.form?.addEventListener("reset", () => queueMicrotask(syncActions));
    syncActions();
  };

  const setupCounterInputs = () => document.querySelectorAll<HTMLElement>("[data-counter-input]").forEach(setupCounterInput);
  setupCounterInputs();
  document.addEventListener("astro:page-load", setupCounterInputs);
</script>

<style>
  .counter-input {
    display: grid;
    width: 100%;
    min-width: 0;
    min-height: var(--control-min-height);
    grid-template-columns: var(--control-min-height) minmax(0, 1fr) var(--control-min-height);
    border: var(--border-width-default) solid var(--input-border-default);
    border-radius: var(--radius-input);
    background: var(--input-background-default);
    box-shadow: var(--elevation-control-raised);
    transition:
      background-color var(--motion-transition),
      border-color var(--motion-transition),
      box-shadow var(--motion-transition);
  }

  .counter-input__action {
    display: inline-grid;
    min-width: 0;
    min-height: 0;
    place-items: center;
    border: 0;
    padding: 0;
    color: var(--input-icon-default);
    background: transparent;
    cursor: pointer;
    opacity: 0.72;
  }

  .counter-input__action:not(:disabled):is(:hover, [data-ds-preview-state="hover"]) {
    opacity: 1;
  }

  .counter-input__action:not(:disabled):is(:active, [data-ds-preview-state="pressed"]) {
    opacity: 0.56;
  }

  .counter-input__action:focus-visible {
    position: relative;
    z-index: 1;
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .counter-input__action:disabled {
    color: var(--input-icon-disabled);
    background: transparent;
    cursor: not-allowed;
    opacity: 1;
  }

  .counter-input :global(.counter-input__field),
  .counter-input :global(.counter-input__field:is(:hover, :focus-visible, :disabled, [data-input-validation="success"], [data-input-validation="warning"], [data-input-validation="error"])) {
    height: 100%;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    text-align: center;
  }

  .counter-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:hover, [data-ds-preview-state="hover"]) {
    border-color: var(--input-border-hover);
    background: var(--input-background-hover);
  }

  .counter-input:not([data-input-control-disabled="true"])[data-input-validation="error"] {
    border-color: var(--input-border-error);
    box-shadow: var(--effect-validation-error);
  }

  .counter-input:not([data-input-control-disabled="true"])[data-input-validation="warning"] {
    border-color: var(--input-border-warning);
    box-shadow: var(--effect-validation-warning);
  }

  .counter-input:not([data-input-control-disabled="true"])[data-input-validation="success"] {
    border-color: var(--input-border-success);
    box-shadow: var(--effect-validation-success);
  }

  .counter-input:not([data-input-control-disabled="true"]):is(:focus-within, [data-ds-preview-state="focus-visible"]) {
    background: var(--input-background-focus);
    outline: none;
    box-shadow: var(--effect-focused);
  }

  .counter-input:not([data-input-control-disabled="true"])[data-input-validation="none"]:is(:focus-within, [data-ds-preview-state="focus-visible"]) {
    border-color: var(--input-border-focus);
  }

  .counter-input[data-input-control-disabled="true"] {
    border-color: var(--input-border-disabled);
    background: var(--input-background-disabled);
    box-shadow: none;
  }

  :global(.counter-input__field::-webkit-inner-spin-button),
  :global(.counter-input__field::-webkit-outer-spin-button) {
    margin: 0;
    appearance: none;
  }

  @media (forced-colors: active) {
    .counter-input {
      border-color: FieldText;
      background: Field;
      box-shadow: none;
    }

    .counter-input__action {
      color: ButtonText;
      background: transparent;
    }

    .counter-input:not([data-input-control-disabled="true"]):is(:focus-within, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }

    .counter-input:not([data-input-control-disabled="true"])[data-input-validation="error"] {
      border-color: Mark;
    }
  }
</style>
