---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import { validatePaginationItem } from "../../../lib/pagination/pagination-item-model.mjs";

export type PaginationItemKind = "page" | "first" | "previous" | "next" | "last";

export type PaginationItemLinkAttributes = Omit<HTMLAttributes<"a">, "aria-current" | "aria-disabled" | "aria-label" | "href">;

export interface Props extends Omit<HTMLAttributes<"li">, "class"> {
  kind: PaginationItemKind;
  label: string;
  href?: string;
  disabled?: boolean;
  page?: number;
  current?: boolean;
  linkAttributes?: PaginationItemLinkAttributes;
  class?: string;
}

const {
  kind,
  label,
  href,
  disabled = false,
  page,
  current = false,
  linkAttributes = {},
  class: className,
  ...attributes
} = Astro.props;

validatePaginationItem({ kind, label, href, disabled, page, current });

const {
  class: linkClassName,
  tabindex: requestedTabindex,
  ...nativeLinkAttributes
} = linkAttributes;
---

<li
  {...attributes}
  class:list={["pagination-item", className]}
  data-component-name="PaginationItem"
  data-pagination-item={kind}
>
  <a
    {...nativeLinkAttributes}
    aria-current={current ? "page" : undefined}
    aria-disabled={disabled ? "true" : undefined}
    aria-label={label}
    class:list={[
      "pagination-item__control",
      `pagination-item__control--${kind}`,
      linkClassName,
    ]}
    data-pagination-control
    data-pagination-page={kind === "page" ? page : undefined}
    href={disabled ? undefined : href}
    tabindex={disabled ? -1 : requestedTabindex}
  >
    {kind === "previous" ? (
      <MaterialSymbol name="chevron_left" size="var(--pagination-icon-size)" />
    ) : kind === "next" ? (
      <MaterialSymbol name="chevron_right" size="var(--pagination-icon-size)" />
    ) : kind === "page" ? page : label}
  </a>
</li>

<style>
  .pagination-item {
    display: flex;
    flex: 0 0 auto;
  }

  .pagination-item__control {
    display: inline-grid;
    min-inline-size: var(--pagination-control-size);
    min-block-size: var(--pagination-control-size);
    place-items: center;
    border: var(--border-width-default) solid var(--pagination-control-border-default);
    border-radius: var(--radius-button);
    padding: 0;
    color: var(--pagination-control-text-default);
    background: var(--pagination-control-background-default);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-none);
    text-decoration: none;
    white-space: nowrap;
  }

  .pagination-item__control--first,
  .pagination-item__control--last {
    padding-inline: var(--pagination-control-padding-inline);
  }

  .pagination-item__control--previous,
  .pagination-item__control--next,
  .pagination-item__control--page {
    inline-size: var(--pagination-control-size);
  }

  .pagination-item__control:visited {
    color: var(--pagination-control-text-default);
  }

  .pagination-item__control:not([aria-current="page"]):not([aria-disabled="true"]):is(:hover, [data-ds-preview-state="hover"]) {
    border-color: var(--pagination-control-border-hover);
    color: var(--pagination-control-text-hover);
    background: var(--pagination-control-background-hover);
  }

  .pagination-item__control:not([aria-current="page"]):not([aria-disabled="true"]):is(:active, [data-ds-preview-state="pressed"]) {
    border-color: var(--pagination-control-border-pressed);
    color: var(--pagination-control-text-pressed);
    background: var(--pagination-control-background-pressed);
  }

  .pagination-item__control[aria-current="page"] {
    border-color: var(--pagination-control-border-current);
    color: var(--pagination-control-text-current);
    background: var(--pagination-control-background-current);
  }

  .pagination-item__control[aria-current="page"]:visited {
    color: var(--pagination-control-text-current);
  }

  .pagination-item__control[aria-disabled="true"] {
    border-color: var(--pagination-control-border-disabled);
    color: var(--pagination-control-text-disabled);
    background: var(--pagination-control-background-disabled);
    cursor: not-allowed;
  }

  .pagination-item__control:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
    border-color: var(--color-state-focus-ring);
    outline: var(--border-width-emphasis) solid transparent;
    outline-offset: var(--size-2);
    box-shadow: var(--effect-focused);
  }

  @media (forced-colors: active) {
    .pagination-item__control {
      border-color: CanvasText;
      color: LinkText;
      background: Canvas;
    }

    .pagination-item__control[aria-current="page"] {
      border-color: Highlight;
      color: HighlightText;
      background: Highlight;
    }

    .pagination-item__control[aria-disabled="true"] {
      border-color: GrayText;
      color: GrayText;
    }

    .pagination-item__control:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }
  }
</style>
