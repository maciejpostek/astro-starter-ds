---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import Button from "../buttons/Button.astro";
import ButtonGroup from "../buttons/ButtonGroup.astro";
import CheckboxLabel from "../checkbox-radio/CheckboxLabel.astro";
import {
  getPopupStatusIcon,
  getPopupStatusLabel,
  validatePopupContract,
} from "../../../lib/popup/popupModel.mjs";
import type { PopupAlignment, PopupStatus } from "../../../lib/popup/popupTypes";

export interface Props extends Omit<
  HTMLAttributes<"dialog">,
  "aria-describedby" | "aria-label" | "aria-labelledby" | "aria-modal" | "class" | "id" | "open" | "role" | "title"
> {
  id: string;
  title: string;
  description: string;
  status?: PopupStatus;
  alignment?: PopupAlignment;
  confirmLabel?: string;
  cancelLabel?: string;
  preferenceLabel?: string;
  statusLabel?: string;
  showCancel?: boolean;
  showPreference?: boolean;
  preferenceChecked?: boolean;
  dismissible?: boolean;
  initialOpen?: boolean;
  class?: string;
}

const {
  id,
  title,
  description,
  status = "info",
  alignment = "horizontal",
  confirmLabel = "Continue",
  cancelLabel = "Cancel",
  preferenceLabel = "Don't show this again",
  statusLabel = getPopupStatusLabel(status),
  showCancel = true,
  showPreference = true,
  preferenceChecked = false,
  dismissible = true,
  initialOpen = false,
  class: className,
  ...attributes
} = Astro.props;

validatePopupContract({
  id,
  title,
  description,
  status,
  alignment,
  confirmLabel,
  cancelLabel,
  preferenceLabel,
  statusLabel,
});

const titleId = `${id}-title`;
const descriptionId = `${id}-description`;
const preferenceId = `${id}-preference`;
const statusIcon = getPopupStatusIcon(status);
---

<dialog
  {...attributes}
  class:list={["popup", className]}
  id={id}
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
  data-component-name="Popup"
  data-popup
  data-popup-id={id}
  data-popup-status={status}
  data-popup-alignment={alignment}
  data-popup-dismissible={String(dismissible)}
  data-popup-initial-open={String(initialOpen)}
>
  <form class="popup__surface" method="dialog" data-popup-form>
    <div class="popup__body">
      <span class="popup__icon" aria-hidden="true">
        <MaterialSymbol class="popup__status-icon" name={statusIcon} size="var(--popup-icon-size)" />
      </span>

      <div class="popup__copy">
        <h2 class="popup__title heading-h6" id={titleId}>
          <span class="popup__status-label">{statusLabel}: </span>{title}
        </h2>
        <p class="popup__description body-small-regular" id={descriptionId}>{description}</p>
      </div>
    </div>

    <footer class="popup__footer">
      {showPreference && (
        <CheckboxLabel
          class="popup__preference"
          id={preferenceId}
          label={preferenceLabel}
          name="dontShowAgain"
          value="true"
          checked={preferenceChecked}
          data-popup-preference
        />
      )}

      <ButtonGroup class="popup__actions" aria-labelledby={titleId}>
        {showCancel && (
          <Button
            variant="secondary"
            size="small"
            type="submit"
            value="cancel"
            showIcon={false}
            data-popup-cancel
          >
            {cancelLabel}
          </Button>
        )}
        <Button
          variant="primary"
          size="small"
          type="submit"
          value="confirm"
          showIcon={false}
          data-popup-confirm
        >
          {confirmLabel}
        </Button>
      </ButtonGroup>
    </footer>
  </form>
</dialog>

<script>
  import { initializePopupRuntime } from "../../../lib/popup/popup-runtime";
  initializePopupRuntime();
</script>

<style>
  .popup {
    inline-size: min(
      calc(100dvi - (var(--popup-viewport-inset) * 2)),
      var(--popup-max-inline-size)
    );
    max-inline-size: var(--popup-max-inline-size);
    max-block-size: calc(100dvb - (var(--popup-viewport-inset) * 2));
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-large);
    color: var(--color-text-primary);
    background: var(--color-background-canvas);
    box-shadow: var(--elevation-surface-overlay);
  }

  .popup::backdrop {
    background: var(--color-background-overlay);
  }

  .popup[open] {
    animation: popup-enter var(--motion-duration-surface-enter) var(--motion-ease-premium-out) both;
  }

  .popup__surface {
    display: flex;
    max-block-size: inherit;
    flex-direction: column;
  }

  .popup__body {
    display: flex;
    min-block-size: 0;
    align-items: flex-start;
    gap: var(--gap-regular);
    padding: var(--content-padding-medium);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .popup[data-popup-alignment="vertical"] .popup__body {
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .popup__icon {
    display: grid;
    flex: none;
    padding: var(--content-padding-xsmall);
    border-radius: var(--radius-full);
    place-items: center;
  }

  .popup[data-popup-status="error"] .popup__icon {
    color: var(--color-status-error-icon);
    background: var(--color-status-error-background);
  }

  .popup[data-popup-status="warning"] .popup__icon {
    color: var(--color-status-warning-icon);
    background: var(--color-status-warning-background);
  }

  .popup[data-popup-status="success"] .popup__icon {
    color: var(--color-status-success-icon);
    background: var(--color-status-success-background);
  }

  .popup[data-popup-status="info"] .popup__icon {
    color: var(--color-status-info-icon);
    background: var(--color-status-info-background);
  }

  .popup__copy {
    display: grid;
    min-inline-size: 0;
    gap: var(--gap-small);
  }

  .popup__description {
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  .popup__status-label {
    position: absolute;
    inline-size: var(--size-1);
    block-size: var(--size-1);
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .popup__footer {
    display: flex;
    flex: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-regular);
    padding: var(--content-padding-small) var(--content-padding-medium);
    border-block-start: var(--border-width-default) solid var(--color-border-subtle);
  }

  .popup__preference {
    flex: 1 1 auto;
  }

  .popup__actions {
    flex: 0 1 auto;
    margin-inline-start: auto;
  }

  @keyframes popup-enter {
    from {
      opacity: 0;
      transform: translateY(var(--gap-small)) scale(0.98);
    }
  }

  @media (forced-colors: active) {
    .popup {
      border-color: CanvasText;
    }

    .popup::backdrop {
      background: CanvasText;
      opacity: 0.2;
      forced-color-adjust: none;
    }

    .popup__icon {
      border: var(--border-width-default) solid currentColor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .popup[open] {
      animation: none;
    }
  }
</style>
