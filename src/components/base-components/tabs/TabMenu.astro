---
import type { HTMLAttributes } from "astro/types";
import { validateTabMenuItems } from "../../../lib/tabs/tabs-model.mjs";

export interface TabMenuItem {
  label: string;
  href: `#${string}`;
}

export type TabMenuItems = readonly [TabMenuItem, ...TabMenuItem[]];
export type TabMenuSize = "small" | "medium" | "large";

type AccessibleName =
  | { "aria-label": string; "aria-labelledby"?: never }
  | { "aria-label"?: never; "aria-labelledby": string };

export type Props = Omit<HTMLAttributes<"nav">, "class"> & AccessibleName & {
  items: TabMenuItems;
  size?: TabMenuSize;
  class?: string;
};

const {
  items,
  size = "medium",
  class: className,
  "aria-label": ariaLabel,
  "aria-labelledby": ariaLabelledby,
  ...attributes
} = Astro.props;

if (!ariaLabel?.trim() && !ariaLabelledby?.trim()) {
  throw new TypeError("TabMenu requires aria-label or aria-labelledby.");
}

const normalizedItems = validateTabMenuItems(items);
---

<nav
  {...attributes}
  class:list={["tab-menu", className]}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
  data-component-name="TabMenu"
  data-control-size={size}
  data-tab-menu
>
  <ul class="tab-menu__list">
    {normalizedItems.map((item: TabMenuItem, index: number) => (
      <li class="tab-menu__item">
        <a
          class="tab-menu__link"
          href={item.href}
          aria-current={index === 0 ? "location" : undefined}
          data-tab-menu-link
          data-tab-menu-current={index === 0 ? "true" : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  declare global {
    interface Window {
      __astroDesignSystemTabMenuReady?: boolean;
    }
  }

  const initializeTabMenus = () => {
    document.querySelectorAll<HTMLElement>("[data-tab-menu]").forEach((menu) => {
      if (menu.dataset.tabMenuReady === "true") return;
      menu.dataset.tabMenuReady = "true";

      const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>("[data-tab-menu-link]"));
      const targets = links.map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        return { link, target: document.getElementById(id) };
      }).filter((entry): entry is { link: HTMLAnchorElement; target: HTMLElement } => (
        entry.target instanceof HTMLElement
      ));

      const setCurrent = (hash: string) => {
        const matchingLink = links.find((link) => link.hash === hash);
        if (!matchingLink) return;
        links.forEach((link) => {
          const isCurrent = link === matchingLink;
          if (isCurrent) {
            link.setAttribute("aria-current", "location");
            link.dataset.tabMenuCurrent = "true";
          } else {
            link.removeAttribute("aria-current");
            delete link.dataset.tabMenuCurrent;
          }
        });
      };

      const syncFromHash = () => {
        const fallbackHash = links[0]?.hash;
        if (window.location.hash) setCurrent(window.location.hash);
        else if (fallbackHash) setCurrent(fallbackHash);
      };

      links.forEach((link) => {
        link.addEventListener("click", () => setCurrent(link.hash));
      });
      window.addEventListener("hashchange", syncFromHash);
      syncFromHash();

      if ("IntersectionObserver" in window && targets.length > 0) {
        const observer = new IntersectionObserver(() => {
          const threshold = window.innerHeight * 0.35;
          const passed = targets.filter(({ target }) => target.getBoundingClientRect().top <= threshold);
          const current = passed.at(-1) ?? targets[0];
          if (current) setCurrent(current.link.hash);
        }, {
          rootMargin: "-20% 0px -65% 0px",
          threshold: [0, 1],
        });
        targets.forEach(({ target }) => observer.observe(target));
      }
    });
  };

  if (!window.__astroDesignSystemTabMenuReady) {
    window.__astroDesignSystemTabMenuReady = true;
    document.addEventListener("astro:page-load", initializeTabMenus);
  }
  initializeTabMenus();
</script>

<style>
  .tab-menu {
    inline-size: 100%;
    min-inline-size: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    background: var(--tab-menu-background-default);
    box-shadow: inset 0 calc(var(--border-width-default) * -1) var(--tab-menu-border-default);
    scrollbar-width: thin;
  }

  .tab-menu__list {
    display: flex;
    inline-size: max-content;
    min-inline-size: 100%;
    min-block-size: var(--control-min-height);
    align-items: stretch;
    gap: var(--gap-regular);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tab-menu__item {
    display: flex;
    flex: 0 0 auto;
  }

  .tab-menu__link {
    position: relative;
    display: inline-flex;
    block-size: var(--control-min-height);
    min-block-size: var(--control-min-height);
    align-items: center;
    justify-content: center;
    padding: var(--content-padding-none) var(--control-padding-inline);
    color: var(--tab-menu-text-default);
    font-family: var(--font-family-body);
    font-size: var(--control-font-size);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--control-line-height);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--motion-transition), box-shadow var(--motion-transition);
  }

  .tab-menu__link::after {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: var(--border-width-strong);
    background: var(--color-transparent);
    content: "";
  }

  .tab-menu__link:hover {
    color: var(--tab-menu-text-hover);
  }

  .tab-menu__link[data-tab-menu-current="true"] {
    color: var(--tab-menu-text-current);
  }

  .tab-menu__link[data-tab-menu-current="true"]::after {
    background: var(--tab-menu-indicator-current);
  }

  .tab-menu[data-ds-preview-state="default"] .tab-menu__link,
  .tab-menu[data-ds-preview-state="hover"] .tab-menu__link,
  .tab-menu[data-ds-preview-state="focus-visible"] .tab-menu__link {
    color: var(--tab-menu-text-default);
  }

  .tab-menu[data-ds-preview-state="default"] .tab-menu__link::after,
  .tab-menu[data-ds-preview-state="hover"] .tab-menu__link::after,
  .tab-menu[data-ds-preview-state="focus-visible"] .tab-menu__link::after {
    background: var(--color-transparent);
  }

  .tab-menu[data-ds-preview-state="hover"] .tab-menu__link {
    color: var(--tab-menu-text-hover);
  }

  .tab-menu[data-ds-preview-state="current"] .tab-menu__link {
    color: var(--tab-menu-text-current);
  }

  .tab-menu[data-ds-preview-state="current"] .tab-menu__link::after {
    background: var(--tab-menu-indicator-current);
  }

  .tab-menu__link:focus-visible {
    outline: var(--border-width-strong) solid var(--color-state-focus-ring);
    outline-offset: calc(var(--size-2) * -1);
    box-shadow: var(--effect-focused);
  }

  .tab-menu[data-ds-preview-state="focus-visible"] .tab-menu__link {
    outline: var(--border-width-strong) solid var(--color-state-focus-ring);
    outline-offset: calc(var(--size-2) * -1);
    box-shadow: var(--effect-focused);
  }

  @media (forced-colors: active) {
    .tab-menu {
      box-shadow: inset 0 calc(var(--border-width-default) * -1) CanvasText;
    }

    .tab-menu__link[data-tab-menu-current="true"] {
      color: LinkText;
    }

    .tab-menu__link[data-tab-menu-current="true"]::after {
      background: Highlight;
    }
  }
</style>
