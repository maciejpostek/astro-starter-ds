---
import type { HTMLAttributes } from "astro/types";

type AccessibleName =
  | { "aria-label": string; "aria-labelledby"?: never }
  | { "aria-label"?: never; "aria-labelledby": string };

export type Props = Omit<HTMLAttributes<"div">, "class" | "role"> & AccessibleName & {
  class?: string;
};

const {
  class: className,
  "aria-label": ariaLabel,
  "aria-labelledby": ariaLabelledby,
  ...attributes
} = Astro.props;

if (!ariaLabel?.trim() && !ariaLabelledby?.trim()) {
  throw new TypeError("Tabs requires aria-label or aria-labelledby.");
}
if (!Astro.slots.has("default")) {
  throw new TypeError("Tabs requires Tab children in its default slot.");
}
---

<div
  {...attributes}
  class:list={["tabs", className]}
  role="tablist"
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
  aria-orientation="horizontal"
  data-component-name="Tabs"
  data-tabs-root
>
  <slot />
</div>

<script>
  declare global {
    interface Window {
      __astroDesignSystemTabsReady?: boolean;
    }
  }

  const initializeTabs = () => {
    document.querySelectorAll<HTMLElement>('[data-tabs-root][role="tablist"]').forEach((root) => {
      if (root.dataset.tabsReady === "true") return;
      root.dataset.tabsReady = "true";

      const getTabs = () => Array.from(root.children).filter(
        (child): child is HTMLButtonElement => child instanceof HTMLButtonElement
          && child.matches('[data-component-name="Tab"][role="tab"]'),
      );
      const getEnabledTabs = () => getTabs().filter((tab) => !tab.disabled);

      const syncState = (activeTab?: HTMLButtonElement) => {
        const tabs = getTabs();
        tabs.forEach((tab) => {
          const isSelected = tab === activeTab;
          tab.setAttribute("aria-selected", String(isSelected));
          tab.tabIndex = isSelected ? 0 : -1;

          const panelId = tab.getAttribute("aria-controls")?.trim();
          const panel = panelId ? document.getElementById(panelId) : null;
          if (panel?.getAttribute("role") === "tabpanel") panel.hidden = !isSelected;
        });
      };

      const setActive = (nextTab: HTMLButtonElement | undefined, emitChange = true) => {
        if (!nextTab || nextTab.disabled || nextTab.parentElement !== root) return;
        const currentTab = getTabs().find((tab) => tab.getAttribute("aria-selected") === "true");
        const previousId = currentTab?.id;

        syncState(nextTab);

        if (emitChange && previousId !== nextTab.id) {
          root.dispatchEvent(new CustomEvent("astro-ds:tabs-change", {
            bubbles: true,
            detail: { id: nextTab.id, previousId },
          }));
        }
      };

      const selectedTabs = getTabs().filter(
        (tab) => !tab.disabled && tab.getAttribute("aria-selected") === "true",
      );
      setActive(selectedTabs[0] ?? getEnabledTabs()[0], false);

      root.addEventListener("focusin", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) return;
        if (!event.target.matches('[data-component-name="Tab"][role="tab"]')) return;
        setActive(event.target);
      });

      root.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const tab = event.target.closest<HTMLButtonElement>('[data-component-name="Tab"][role="tab"]');
        if (tab?.parentElement === root) setActive(tab);
      });

      root.addEventListener("keydown", (event) => {
        if (!(event.target instanceof HTMLButtonElement)) return;
        if (!event.target.matches('[data-component-name="Tab"][role="tab"]')) return;

        const tabs = getEnabledTabs();
        const currentIndex = tabs.indexOf(event.target);
        if (currentIndex < 0) return;

        const isRtl = getComputedStyle(root).direction === "rtl";
        let targetIndex;
        if (event.key === "ArrowRight") {
          targetIndex = (currentIndex + (isRtl ? -1 : 1) + tabs.length) % tabs.length;
        }
        if (event.key === "ArrowLeft") {
          targetIndex = (currentIndex + (isRtl ? 1 : -1) + tabs.length) % tabs.length;
        }
        if (event.key === "Home") targetIndex = 0;
        if (event.key === "End") targetIndex = tabs.length - 1;
        if (targetIndex === undefined) return;

        event.preventDefault();
        tabs[targetIndex]?.focus();
      });
    });
  };

  if (!window.__astroDesignSystemTabsReady) {
    window.__astroDesignSystemTabsReady = true;
    document.addEventListener("astro:page-load", initializeTabs);
  }
  initializeTabs();
</script>

<style>
  .tabs {
    display: flex;
    inline-size: 100%;
    min-inline-size: 0;
    gap: var(--gap-small);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }
</style>
