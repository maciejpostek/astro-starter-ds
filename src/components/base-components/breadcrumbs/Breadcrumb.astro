---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

export type BreadcrumbLinkAttributes = Omit<
  HTMLAttributes<"a">,
  "aria-current" | "href"
>;

export interface Props extends Omit<HTMLAttributes<"li">, "class"> {
  label: string;
  href?: string;
  current?: boolean;
  linkAttributes?: BreadcrumbLinkAttributes;
  class?: string;
}

const {
  label,
  href,
  current = false,
  linkAttributes = {},
  class: className,
  ...attributes
} = Astro.props;

const { class: linkClassName, ...nativeLinkAttributes } = linkAttributes;
---

<li
  {...attributes}
  class:list={["breadcrumb", className]}
  data-breadcrumb-current={current ? "true" : undefined}
  data-component-name="Breadcrumb"
>
  {href ? (
    <a
      {...nativeLinkAttributes}
      class:list={[
        "breadcrumb__label",
        "breadcrumb__link",
        "body-small-regular",
        linkClassName,
      ]}
      href={href}
      aria-current={current ? "page" : undefined}
    >
      {label}
    </a>
  ) : (
    <span
      class="breadcrumb__label breadcrumb__text body-small-regular"
      aria-current={current ? "page" : undefined}
    >
      {label}
    </span>
  )}

  <span class="breadcrumb__separator" aria-hidden="true">
    <MaterialSymbol
      class="breadcrumb__separator-icon"
      name="chevron_right"
      size="var(--size-16)"
    />
  </span>
</li>

<style>
  .breadcrumb {
    display: inline-flex;
    min-inline-size: 0;
    max-inline-size: 100%;
    align-items: center;
    gap: var(--gap-tiny);
  }

  .breadcrumb__separator {
    display: inline-grid;
    width: var(--size-16);
    height: var(--size-16);
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-icon-secondary);
  }

  .breadcrumb[data-breadcrumb-current="true"] .breadcrumb__separator {
    display: none;
  }

  .breadcrumb__label {
    min-inline-size: 0;
    max-inline-size: 100%;
    color: var(--color-text-secondary);
    text-decoration-line: none;
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--border-width-default);
    text-underline-offset: var(--size-2);
  }

  .breadcrumb__link:visited {
    color: var(--color-text-secondary);
  }

  .breadcrumb__link:is(:hover, [data-ds-preview-state="hover"]) {
    color: var(--color-text-primary);
  }

  .breadcrumb__link:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
    border-radius: var(--radius-small);
    outline: none;
    color: var(--color-text-primary);
    box-shadow: var(--effect-focused);
  }

  .breadcrumb__link:is(:active, [data-ds-preview-state="pressed"]) {
    color: var(--color-text-primary);
  }

  .breadcrumb[data-breadcrumb-current="true"] .breadcrumb__label {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-strong);
    text-decoration-line: underline;
  }

  @media (forced-colors: active) {
    .breadcrumb__separator,
    .breadcrumb__label {
      color: CanvasText;
    }

    .breadcrumb__link:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }
  }
</style>
