---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

export type BreadcrumbSeparator = "chevron" | "slash" | "dot";

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export type BreadcrumbItems = readonly [BreadcrumbItem, ...BreadcrumbItem[]];

export interface Props extends Omit<HTMLAttributes<"nav">, "class"> {
  items: BreadcrumbItems;
  separator?: BreadcrumbSeparator;
  label?: string;
  class?: string;
}

const {
  items,
  separator = "chevron",
  label = "Breadcrumb",
  class: className,
  ...attributes
} = Astro.props;

if (items.length === 0) {
  throw new Error("Breadcrumb requires at least one item.");
}
---

<nav
  {...attributes}
  class:list={["breadcrumb", className]}
  aria-label={label}
  data-breadcrumb-separator={separator}
  data-component-name="Breadcrumb"
>
  <ol class="breadcrumb__list">
    {items.map((item, index) => {
      const current = index === items.length - 1;
      return (
        <li class="breadcrumb__item">
          {index > 0 && (
            <span class="breadcrumb__separator" aria-hidden="true">
              <MaterialSymbol
                class="breadcrumb__separator-icon"
                name="chevron_right"
                size="var(--size-16)"
              />
              <span class="breadcrumb__separator-character" data-separator-character="slash">/</span>
              <span class="breadcrumb__separator-character" data-separator-character="dot">•</span>
            </span>
          )}
          {item.href ? (
            <a
              class:list={[
                "breadcrumb__label",
                "breadcrumb__link",
                "body-small-regular",
                { "breadcrumb__current": current },
              ]}
              href={item.href}
              aria-current={current ? "page" : undefined}
            >
              {item.label}
            </a>
          ) : (
            <span
              class:list={[
                "breadcrumb__label",
                "breadcrumb__text",
                "body-small-regular",
                { "breadcrumb__current": current },
              ]}
              aria-current={current ? "page" : undefined}
            >
              {item.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    min-inline-size: 0;
  }

  .breadcrumb__list {
    display: flex;
    min-inline-size: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-tiny);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumb__item {
    display: inline-flex;
    min-inline-size: 0;
    max-inline-size: 100%;
    align-items: center;
    gap: var(--gap-tiny);
  }

  .breadcrumb__separator {
    display: inline-grid;
    width: var(--size-16);
    height: var(--size-16);
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-icon-secondary);
  }

  .breadcrumb__separator-icon,
  .breadcrumb__separator-character {
    grid-area: 1 / 1;
  }

  .breadcrumb__separator-character {
    display: none;
    color: var(--color-text-tertiary);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-none);
  }

  .breadcrumb[data-breadcrumb-separator="slash"] .breadcrumb__separator-icon,
  .breadcrumb[data-breadcrumb-separator="dot"] .breadcrumb__separator-icon {
    display: none;
  }

  .breadcrumb[data-breadcrumb-separator="slash"] [data-separator-character="slash"],
  .breadcrumb[data-breadcrumb-separator="dot"] [data-separator-character="dot"] {
    display: inline;
  }

  .breadcrumb__label {
    min-inline-size: 0;
    max-inline-size: 100%;
    color: var(--color-text-secondary);
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--border-width-default);
    text-underline-offset: var(--size-2);
  }

  .breadcrumb__link:visited {
    color: var(--color-text-secondary);
  }

  .breadcrumb__link:is(:hover, [data-ds-preview-state="hover"]) {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  .breadcrumb__link:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
    border-radius: var(--radius-small);
    outline: none;
    color: var(--color-text-primary);
    box-shadow: var(--effect-focused);
  }

  .breadcrumb__link:is(:active, [data-ds-preview-state="pressed"]) {
    color: var(--color-text-primary);
  }

  .breadcrumb__current {
    color: var(--color-text-primary);
    text-decoration-line: underline;
  }

  @media (forced-colors: active) {
    .breadcrumb__separator,
    .breadcrumb__separator-character,
    .breadcrumb__label {
      color: CanvasText;
    }

    .breadcrumb__link:is(:focus-visible, [data-ds-preview-state="focus-visible"]) {
      outline: var(--border-width-strong) solid Highlight;
      outline-offset: var(--size-2);
      box-shadow: none;
    }
  }
</style>
