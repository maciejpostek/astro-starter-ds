---
import Eyebrow from "../../atoms/text/Eyebrow.astro";
import Button from "../../atoms/actions/Button.astro";

interface Props {
  title: string;
  body: string;
  eyebrow?: string;
  headingLevel?: 2 | 3 | 4;
  actionLabel?: string;
  actionHref?: string;
  align?: "start" | "center";
  componentName?: string;
}

const {
  title,
  body,
  eyebrow,
  headingLevel = 2,
  actionLabel,
  actionHref,
  align = "start",
  componentName = "ContentBlock"
} = Astro.props;
---

<section
  class="content-block"
  data-component-name={componentName}
  data-component-family="content"
  data-content-align={align}
  data-preview-target
>
  {eyebrow && <Eyebrow text={eyebrow} />}
  {
    headingLevel === 2 ? (
      <h2 class="content-block__title">{title}</h2>
    ) : headingLevel === 3 ? (
      <h3 class="content-block__title">{title}</h3>
    ) : (
      <h4 class="content-block__title">{title}</h4>
    )
  }
  <p class="content-block__body">{body}</p>
  <slot />
  {
    actionLabel && actionHref && (
      <Button href={actionHref} variant="secondary">{actionLabel}</Button>
    )
  }
</section>

<style>
  .content-block {
    display: grid;
    max-width: 44rem;
    justify-items: start;
    gap: var(--gap-medium);
  }

  .content-block[data-content-align="center"] {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .content-block__title {
    max-width: 20ch;
    font-family: var(--text-style-heading-h3-font-family);
    font-size: var(--text-style-heading-h3-font-size);
    font-weight: var(--text-style-heading-h3-font-weight);
    font-style: var(--text-style-heading-h3-font-style);
    line-height: var(--text-style-heading-h3-line-height);
    letter-spacing: var(--text-style-heading-h3-letter-spacing);
    text-transform: var(--text-style-heading-h3-text-transform);
    text-wrap: var(--text-style-heading-h3-text-wrap);
    overflow-wrap: var(--text-style-heading-h3-overflow-wrap);
    word-break: var(--text-style-heading-h3-word-break);
    white-space: var(--text-style-heading-h3-white-space);
  }

  .content-block__body {
    max-width: 60ch;
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    font-weight: var(--text-style-body-base-font-weight);
    font-style: var(--text-style-body-base-font-style);
    line-height: var(--text-style-body-base-line-height);
    letter-spacing: var(--text-style-body-base-letter-spacing);
    text-transform: var(--text-style-body-base-text-transform);
    text-wrap: var(--text-style-body-base-text-wrap);
    overflow-wrap: var(--text-style-body-base-overflow-wrap);
    word-break: var(--text-style-body-base-word-break);
    white-space: var(--text-style-body-base-white-space);
  }
</style>
