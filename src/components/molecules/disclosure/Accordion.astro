---
import type { HTMLAttributes } from "astro/types";
import { ChevronUp } from "@lucide/astro";

type HeadingLevel = "h2" | "h3" | "h4" | "h5" | "h6";

export interface AccordionItem {
  id?: string;
  title: string;
  content?: string;
  initiallyOpen?: boolean;
  disabled?: boolean;
}

type Props = {
  id: string;
  items?: AccordionItem[];
  closeSiblings?: boolean;
  headingLevel?: HeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"div">, "class">;

const {
  items = [],
  closeSiblings = true,
  headingLevel = "h3",
  componentName = "Accordion",
  class: className,
  id,
  ...attributes
} = Astro.props;

const HeadingTag = headingLevel;
const rootId = id;

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

let hasInitialActive = false;
const explicitIds = new Set<string>();
const normalizedItems = items.map((item, index) => {
  const shouldOpen =
    Boolean(item.initiallyOpen) && (!closeSiblings || !hasInitialActive);

  if (shouldOpen) hasInitialActive = true;

  const generatedId = `${rootId}-${slugify(item.title) || "item"}-${index + 1}`;
  const itemId = item.id ?? generatedId;
  if (explicitIds.has(itemId)) {
    throw new Error(`Accordion "${rootId}" contains duplicate item id "${itemId}".`);
  }
  explicitIds.add(itemId);

  return {
    ...item,
    id: itemId,
    isOpen: shouldOpen
  };
});
---

<div
  id={rootId}
  class:list={["accordion", className]}
  data-component-name={componentName}
  data-component-family="disclosure"
  data-preview-target
  data-accordion-css-init=""
  data-accordion-close-siblings={closeSiblings ? "true" : "false"}
  {...attributes}
>
  {
    normalizedItems.length > 0 ? (
      <ul class="accordion__list">
        {normalizedItems.map((item) => {
          const panelId = `${item.id}-panel`;
          const triggerId = `${item.id}-trigger`;

          return (
            <li
              class:list={["accordion__item", item.disabled && "is-disabled"]}
              data-component-name="Accordion.Item"
              data-accordion-status={item.isOpen ? "active" : "not-active"}
            >
              <HeadingTag class="accordion__item-heading">
                <button
                  id={triggerId}
                  class="accordion__item-top"
                  type="button"
                  data-hover
                  data-accordion-toggle
                  aria-expanded={item.isOpen}
                  aria-controls={panelId}
                  disabled={item.disabled}
                >
                  <span class="accordion__item-title">{item.title}</span>
                  <span class="accordion__item-icon" aria-hidden="true">
                    <ChevronUp />
                  </span>
                </button>
              </HeadingTag>

              <div
                id={panelId}
                class="accordion__item-bottom"
                role="region"
                aria-labelledby={triggerId}
                aria-hidden={!item.isOpen}
              >
                <div class="accordion__item-bottom-wrap">
                  <div class="accordion__item-bottom-content">
                    {item.content && <p class="accordion__item-p">{item.content}</p>}
                  </div>
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <slot />
    )
  }
</div>

<style>
  .accordion {
    position: relative;
    width: 100%;
  }

  .accordion__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
  }

  .accordion__item {
    overflow: hidden;
    background: var(--color-background-surface);
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    list-style: none;
  }

  .accordion__item-heading {
    margin: 0;
  }

  .accordion__item-top {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-button-group);
    padding: var(--component-padding-medium);
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
    text-align: left;
    transition:
      background var(--motion-transition),
      color var(--motion-transition);
  }

  .accordion__item-top:hover {
    background: var(--color-background-subtle);
  }

  .accordion[data-preview-state="hover"] .accordion__item-top {
    background: var(--color-background-subtle);
  }

  .accordion__item-top:active,
  .accordion[data-preview-state="pressed"] .accordion__item-top {
    background: var(--color-background-accent);
    color: var(--color-text-on-accent);
  }

  .accordion__item:has(.accordion__item-top:focus-visible),
  .accordion[data-preview-state="focused"] .accordion__item {
    position: relative;
    z-index: 1;
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  .accordion__item-title {
    font-family: var(--text-style-heading-h6-font-family);
    font-size: var(--text-style-heading-h6-font-size);
    font-weight: var(--text-style-heading-h6-font-weight);
    line-height: var(--text-style-heading-h6-line-height);
    letter-spacing: var(--text-style-heading-h6-letter-spacing);
  }

  .accordion__item-icon {
    display: inline-flex;
    flex: 0 0 var(--size-32);
    width: var(--size-32);
    height: var(--size-32);
    align-items: center;
    justify-content: center;
    border: var(--border-width-default) solid var(--color-border-subtle);
    background: var(--color-background-canvas);
    color: currentColor;
    transform: rotate(180deg);
    transition:
      transform var(--motion-duration-disclosure) var(--motion-ease-premium-out),
      border-color var(--motion-transition),
      color var(--motion-transition);
  }

  .accordion__item-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  [data-accordion-status="active"] .accordion__item-icon {
    border-color: var(--color-border-accent);
    color: var(--color-text-accent);
    transform: rotate(0.001deg);
  }

  .accordion__item-bottom {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition:
      grid-template-rows
      var(--motion-duration-disclosure)
      var(--motion-ease-premium-out);
  }

  [data-accordion-status="active"] .accordion__item-bottom {
    grid-template-rows: 1fr;
  }

  .accordion__item-bottom-wrap {
    min-height: 0;
    overflow: hidden;
  }

  .accordion__item-bottom-content {
    padding:
      0
      var(--component-padding-medium)
      var(--component-padding-medium);
  }

  .accordion__item-p {
    max-width: 48rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    font-weight: var(--text-style-body-small-font-weight);
    line-height: var(--text-style-body-small-line-height);
    letter-spacing: var(--text-style-body-small-letter-spacing);
  }

  .accordion__item.is-disabled {
    opacity: 0.48;
  }

  .accordion__item.is-disabled .accordion__item-top {
    cursor: not-allowed;
  }

  .accordion__item.is-disabled .accordion__item-top:hover {
    background: transparent;
  }

  .accordion[data-preview-state="disabled"] .accordion__item {
    opacity: 0.48;
  }

  .accordion[data-preview-state="disabled"] .accordion__item-top {
    background: transparent;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__item-bottom,
    .accordion__item-icon {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  type WindowWithAccordion = Window & {
    __astroDsAccordionsInitialized?: boolean;
  };

  const win = window as WindowWithAccordion;

  if (!win.__astroDsAccordionsInitialized) {
    win.__astroDsAccordionsInitialized = true;

    const syncAccordionItem = (item: HTMLElement) => {
      const isActive = item.getAttribute("data-accordion-status") === "active";
      const toggle = item.querySelector<HTMLElement>("[data-accordion-toggle]");
      toggle?.setAttribute("aria-expanded", String(isActive));
      const panelId = toggle?.getAttribute("aria-controls");
      const panel = panelId
        ? item.querySelector<HTMLElement>(`#${CSS.escape(panelId)}`)
        : null;
      panel?.setAttribute("aria-hidden", String(!isActive));
    };

    const initAccordions = () => {
      document
        .querySelectorAll<HTMLElement>("[data-accordion-css-init]")
        .forEach((accordion) => {
          if (accordion.dataset.accordionReady === "true") return;

          accordion.dataset.accordionReady = "true";
          const closeSiblings =
            accordion.getAttribute("data-accordion-close-siblings") === "true";

          accordion
            .querySelectorAll<HTMLElement>("[data-accordion-status]")
            .forEach(syncAccordionItem);

          accordion.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const toggle = target.closest<HTMLElement>("[data-accordion-toggle]");
            if (!toggle || !accordion.contains(toggle)) return;
            if (toggle instanceof HTMLButtonElement && toggle.disabled) return;

            const singleAccordion = toggle.closest<HTMLElement>(
              "[data-accordion-status]"
            );
            if (!singleAccordion) return;

            const isActive =
              singleAccordion.getAttribute("data-accordion-status") === "active";

            singleAccordion.setAttribute(
              "data-accordion-status",
              isActive ? "not-active" : "active"
            );
            syncAccordionItem(singleAccordion);

            if (closeSiblings && !isActive) {
              accordion
                .querySelectorAll<HTMLElement>(
                  '[data-accordion-status="active"]'
                )
                .forEach((sibling) => {
                  if (sibling === singleAccordion) return;
                  sibling.setAttribute("data-accordion-status", "not-active");
                  syncAccordionItem(sibling);
                });
            }
          });
        });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAccordions, {
        once: true
      });
    } else {
      initAccordions();
    }

    document.addEventListener("astro:page-load", initAccordions);
  }
</script>
