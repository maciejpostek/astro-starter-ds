---
interface Props {
  id: string;
  content: string;
  componentName?: string;
}

const { id, content, componentName = "Tooltip" } = Astro.props;
---

<span
  class="tooltip"
  data-component-name={componentName}
  data-component-family="disclosure"
  data-tooltip-state="hidden"
  data-preview-target
>
  <span class="tooltip__trigger">
    <slot />
  </span>
  <span class="tooltip__content" id={id} role="tooltip">{content}</span>
</span>

<style>
  .tooltip {
    position: relative;
    display: inline-flex;
  }

  .tooltip__trigger {
    display: inline-flex;
  }

  .tooltip__content {
    position: absolute;
    inset: auto auto calc(100% + var(--gap-small)) 50%;
    z-index: 20;
    width: max-content;
    max-width: 18rem;
    border: var(--border-width-default) solid var(--color-border-accent);
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
    padding: var(--component-padding-small);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, var(--size-4));
    transition:
      opacity var(--motion-transition),
      transform var(--motion-transition);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    font-weight: var(--text-style-body-tiny-font-weight);
    font-style: var(--text-style-body-tiny-font-style);
    line-height: var(--text-style-body-tiny-line-height);
    letter-spacing: var(--text-style-body-tiny-letter-spacing);
    text-transform: var(--text-style-body-tiny-text-transform);
    text-wrap: var(--text-style-body-tiny-text-wrap);
    overflow-wrap: var(--text-style-body-tiny-overflow-wrap);
    word-break: var(--text-style-body-tiny-word-break);
    white-space: var(--text-style-body-tiny-white-space);
  }

  .tooltip:hover .tooltip__content,
  .tooltip:focus-within .tooltip__content,
  .tooltip[data-tooltip-state="visible"] .tooltip__content,
  .tooltip[data-preview-state="visible"] .tooltip__content {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip__content {
      transition-duration: 1ms;
    }
  }
</style>
