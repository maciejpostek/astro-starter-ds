---
import type { HTMLAttributes } from "astro/types";
import Button from "../../atoms/actions/Button.astro";
import Tag from "../../atoms/data-display/Tag.astro";

export type JobCardVariant = "compact" | "detailed";
export type JobCardHeadingLevel = 2 | 3 | 4;

type Props = {
  title: string;
  department: string;
  location: string;
  employmentType: string;
  href: string;
  variant: JobCardVariant;
  description?: string;
  actionLabel?: string;
  headingLevel?: JobCardHeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"article">, "class" | "role">;

const {
  title,
  department,
  location,
  employmentType,
  href,
  variant,
  description,
  actionLabel = "View role",
  headingLevel = 3,
  componentName = "JobCard",
  class: className,
  ...attributes
} = Astro.props;

const supportedVariants: JobCardVariant[] = ["compact", "detailed"];
const supportedHeadingLevels: JobCardHeadingLevel[] = [2, 3, 4];
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/))/i;
const normalizedTitle = title?.trim();
const normalizedDepartment = department?.trim();
const normalizedLocation = location?.trim();
const normalizedEmploymentType = employmentType?.trim();
const normalizedHref = href?.trim();
const normalizedDescription = description?.trim();
const normalizedActionLabel = actionLabel?.trim();
const normalizedComponentName = componentName?.trim();

if (
  !normalizedTitle ||
  !normalizedDepartment ||
  !normalizedLocation ||
  !normalizedEmploymentType
) {
  throw new Error(
    "JobCard requires non-empty title, department, location, and employmentType values.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `JobCard received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `JobCard received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (!normalizedHref || !safeHrefPattern.test(normalizedHref)) {
  throw new Error("JobCard requires a safe HTTPS or root-relative href.");
}
if (!normalizedActionLabel) {
  throw new Error("JobCard requires a non-empty actionLabel.");
}
if (!normalizedComponentName) {
  throw new Error("JobCard requires a non-empty componentName.");
}
if (variant === "detailed" && !normalizedDescription) {
  throw new Error("JobCard Detailed requires a non-empty description.");
}
if (variant === "compact" && description !== undefined) {
  throw new Error("JobCard description is supported only by Detailed.");
}
if (description !== undefined && !normalizedDescription) {
  throw new Error("JobCard description must be non-empty when provided.");
}
if (Astro.slots.has("default")) {
  throw new Error("JobCard does not expose a default slot.");
}

const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
const metadata = [
  { id: "department", label: normalizedDepartment },
  { id: "location", label: normalizedLocation },
  { id: "employment-type", label: normalizedEmploymentType },
];
---

<article
  {...attributes}
  class:list={["job-card", className]}
  data-component-name={normalizedComponentName}
  data-component-family="cards"
  data-card-variant={variant}
  data-card-state="actionable"
  data-job-metadata={metadata.length}
  data-preview-target
>
  <div class="job-card__content">
    <Heading>{normalizedTitle}</Heading>

    <ul class="job-card__metadata" aria-label="Job details">
      {
        metadata.map((item) => (
          <li data-job-detail={item.id}>
            <Tag componentName={`${normalizedComponentName}.${item.id}`}>
              {item.label}
            </Tag>
          </li>
        ))
      }
    </ul>

    {
      variant === "detailed" && normalizedDescription && (
        <p class="job-card__description">{normalizedDescription}</p>
      )
    }
  </div>

  <Button
    variant="link"
    size="small"
    href={normalizedHref}
    aria-label={`${normalizedActionLabel}: ${normalizedTitle}`}
    componentName={`${normalizedComponentName}.Action`}
  >
    {normalizedActionLabel}
  </Button>
</article>

<style>
  .job-card,
  .job-card__content,
  .job-card__metadata {
    min-width: 0;
  }

  .job-card {
    display: grid;
    align-items: start;
    gap: var(--gap-large);
    height: 100%;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-medium);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
  }

  .job-card[data-card-variant="compact"] {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .job-card__content {
    display: grid;
    gap: var(--gap-medium);
  }

  .job-card__content :is(h2, h3, h4),
  .job-card__description {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .job-card__content :is(h2, h3, h4) {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  .job-card__metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-tag-group);
    max-width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
  }

  .job-card__description {
    color: var(--color-text-secondary);
  }

  @media (width < 40rem) {
    .job-card {
      gap: var(--gap-medium);
      padding: var(--component-padding-medium);
    }

    .job-card[data-card-variant="compact"] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
