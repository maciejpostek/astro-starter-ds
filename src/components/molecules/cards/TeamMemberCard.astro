---
import type { HTMLAttributes } from "astro/types";
import Avatar from "../../atoms/media/Avatar.astro";

export type TeamMemberCardVariant = "compact" | "profile";
export type TeamMemberCardHeadingLevel = 2 | 3 | 4;

type Props = {
  name: string;
  role: string;
  variant: TeamMemberCardVariant;
  description?: string;
  avatarSrc?: string;
  avatarAlt?: string;
  href?: string;
  headingLevel?: TeamMemberCardHeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"article">, "class" | "role">;

const {
  name,
  role,
  variant,
  description,
  avatarSrc,
  avatarAlt = "",
  href,
  headingLevel = 3,
  componentName = "TeamMemberCard",
  class: className,
  ...attributes
} = Astro.props;

const supportedVariants: TeamMemberCardVariant[] = ["compact", "profile"];
const supportedHeadingLevels: TeamMemberCardHeadingLevel[] = [2, 3, 4];
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/)|mailto:|tel:)/i;
const normalizedName = name?.trim();
const normalizedRole = role?.trim();
const normalizedDescription = description?.trim();
const normalizedAvatarSrc = avatarSrc?.trim();
const normalizedAvatarAlt = avatarAlt.trim();
const normalizedHref = href?.trim();
const normalizedComponentName = componentName?.trim();

if (!normalizedName || !normalizedRole) {
  throw new Error("TeamMemberCard requires non-empty name and role values.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `TeamMemberCard received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `TeamMemberCard received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (!normalizedComponentName) {
  throw new Error("TeamMemberCard requires a non-empty componentName.");
}
if (avatarSrc !== undefined && !normalizedAvatarSrc) {
  throw new Error("TeamMemberCard avatarSrc must be non-empty when provided.");
}
if (avatarAlt !== undefined && avatarAlt !== normalizedAvatarAlt) {
  throw new Error("TeamMemberCard avatarAlt cannot contain surrounding whitespace.");
}
if (href !== undefined && !normalizedHref) {
  throw new Error("TeamMemberCard href must be non-empty when provided.");
}
if (normalizedHref && !safeHrefPattern.test(normalizedHref)) {
  throw new Error("TeamMemberCard requires a safe supplied href.");
}
if (variant === "profile" && !normalizedDescription) {
  throw new Error("TeamMemberCard Profile requires a non-empty description.");
}
if (variant === "compact" && description !== undefined) {
  throw new Error("TeamMemberCard description is supported only by Profile.");
}
if (description !== undefined && !normalizedDescription) {
  throw new Error("TeamMemberCard description must be non-empty when provided.");
}
if (Astro.slots.has("default")) {
  throw new Error("TeamMemberCard does not expose a default slot.");
}

const Heading = `h${headingLevel}` as "h2" | "h3" | "h4";
const avatarSize = variant === "profile" ? "large" : "medium";
const state = normalizedHref ? "actionable" : "static";
---

<article
  {...attributes}
  class:list={["team-member-card", className]}
  data-component-name={normalizedComponentName}
  data-component-family="cards"
  data-card-variant={variant}
  data-card-state={state}
  data-preview-target
>
  {
    normalizedHref ? (
      <a class="team-member-card__body" href={normalizedHref}>
        <Avatar
          src={normalizedAvatarSrc}
          alt={normalizedAvatarAlt}
          name={normalizedName}
          size={avatarSize}
          shape="circle"
        />
        <span class="team-member-card__content">
          <Heading>{normalizedName}</Heading>
          <span class="team-member-card__role">{normalizedRole}</span>
          {variant === "profile" && normalizedDescription && (
            <span class="team-member-card__description">
              {normalizedDescription}
            </span>
          )}
        </span>
      </a>
    ) : (
      <div class="team-member-card__body">
        <Avatar
          src={normalizedAvatarSrc}
          alt={normalizedAvatarAlt}
          name={normalizedName}
          size={avatarSize}
          shape="circle"
        />
        <div class="team-member-card__content">
          <Heading>{normalizedName}</Heading>
          <span class="team-member-card__role">{normalizedRole}</span>
          {variant === "profile" && normalizedDescription && (
            <p class="team-member-card__description">
              {normalizedDescription}
            </p>
          )}
        </div>
      </div>
    )
  }
</article>

<style>
  .team-member-card,
  .team-member-card__body,
  .team-member-card__content {
    min-width: 0;
  }

  .team-member-card {
    height: 100%;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-medium);
    background: var(--color-background-surface);
    transition:
      border-color var(--motion-transition),
      background var(--motion-transition);
  }

  .team-member-card__body {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .team-member-card[data-card-variant="compact"] .team-member-card__body {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--gap-medium);
    padding: var(--component-padding-medium);
  }

  .team-member-card[data-card-variant="profile"] .team-member-card__body {
    align-content: start;
    gap: var(--gap-large);
    padding: var(--component-padding-large);
  }

  .team-member-card__content {
    display: grid;
    align-content: start;
    gap: var(--gap-small);
  }

  .team-member-card__content :is(h2, h3, h4),
  .team-member-card__role,
  .team-member-card__description {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .team-member-card__content :is(h2, h3, h4) {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  .team-member-card__role {
    color: var(--color-text-tertiary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  .team-member-card__description {
    color: var(--color-text-secondary);
  }

  .team-member-card[data-card-state="actionable"]:hover {
    border-color: var(--color-border-accent);
    background: var(--color-background-subtle);
  }

  .team-member-card:has(.team-member-card__body:focus-visible) {
    border-color: var(--color-border-accent);
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }

  .team-member-card__body:focus-visible {
    outline: none;
  }

  @media (width < 40rem) {
    .team-member-card[data-card-variant="profile"] .team-member-card__body {
      gap: var(--gap-medium);
      padding: var(--component-padding-medium);
    }
  }
</style>
