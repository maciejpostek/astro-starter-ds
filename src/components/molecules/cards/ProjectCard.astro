---
import { Eye } from "@lucide/astro";
import Button from "../../atoms/actions/Button.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import MediaRatio from "../../atoms/media/MediaRatio.astro";
import type { MediaRatioValue } from "../../atoms/media/types";

type ProjectCardData = {
  slug?: string;
  title?: string;
  labels?: string[];
  visualLabel?: string;
  visualRatio?: MediaRatioValue;
  linkLabel?: string;
};

type ProjectCardProject = {
  slug: string;
  title: string;
  scope: string;
};

type HeadingLevel = "h2" | "h3" | "h4" | "h5" | "h6";

interface Props extends ProjectCardData {
  project?: ProjectCardProject;
  headingLevel?: HeadingLevel;
  componentName?: string;
}

const {
  project,
  slug: rawSlug = project?.slug,
  title: rawTitle = project?.title,
  labels = project?.scope.split(" · ") ?? [],
  visualLabel,
  visualRatio = "4:3",
  linkLabel = "Read more",
  headingLevel = "h3",
  componentName = "ProjectCard"
} = Astro.props;

const slug = rawSlug?.trim();
const title = rawTitle?.trim();
const resolvedLabels = labels.map((label) => label.trim());
const resolvedLinkLabel = linkLabel.trim();
const resolvedVisualLabel =
  visualLabel?.trim() || `${title ?? "Project"} case study visual`;
const resolvedComponentName = componentName.trim();
const HeadingTag = headingLevel;

if (!title) {
  throw new Error("ProjectCard requires a non-empty title or project.title.");
}

if (rawSlug !== undefined && (!slug || slug === "#")) {
  throw new Error("ProjectCard slug must be a real non-placeholder identifier.");
}

if (resolvedLabels.some((label) => !label)) {
  throw new Error("ProjectCard labels must be non-empty strings.");
}

if (slug && !resolvedLinkLabel) {
  throw new Error("ProjectCard requires a non-empty linkLabel when slug is present.");
}

if (!resolvedComponentName) {
  throw new Error("ProjectCard requires a non-empty componentName.");
}
---

<article
  class="project-card"
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state={slug ? "actionable" : "static"}
  data-preview-target
>
  {
    slug ? (
      <button
        class="project-card__visual"
        type="button"
        data-open-case={slug}
        aria-label={`Open ${title}`}
      >
        <MediaRatio
          ratio={visualRatio}
          label={resolvedVisualLabel}
          componentName="ProjectCard.Visual"
        />
      </button>
    ) : (
      <div class="project-card__visual">
        <MediaRatio
          ratio={visualRatio}
          label={resolvedVisualLabel}
          componentName="ProjectCard.Visual"
        />
      </div>
    )
  }
  <div class="project-card__content">
    <HeadingTag class="project-card__title">{title}</HeadingTag>
    {
      resolvedLabels.length > 0 && (
        <div class="project-card__labels" aria-label="Project scope">
          {resolvedLabels.map((label) => <Tag>{label}</Tag>)}
        </div>
      )
    }
    {
      slug && (
        <Button
          variant="link"
          type="button"
          data-open-case={slug}
          aria-label={`${resolvedLinkLabel}: ${title}`}
        >
          {resolvedLinkLabel}
          <Eye slot="icon" aria-hidden="true" />
        </Button>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: grid;
    min-width: 0;
    grid-template-rows: auto 1fr;
  }

  .project-card__visual {
    display: block;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 0;
    font-family: var(--font-family-body);
    text-align: inherit;
  }

  button.project-card__visual {
    cursor: pointer;
  }

  button.project-card__visual:focus-visible {
    position: relative;
    z-index: 1;
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--color-background-surface);
    padding: var(--component-padding-medium);
  }

  .project-card__title {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h6-font-family);
    font-size: var(--text-style-heading-h6-font-size);
    font-weight: var(--text-style-heading-h6-font-weight);
    line-height: var(--text-style-heading-h6-line-height);
    letter-spacing: var(--text-style-heading-h6-letter-spacing);
  }

  .project-card__labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-tag-group);
    margin-top: var(--space-medium);
  }

  .project-card__content :global(.button) {
    margin-top: var(--space-medium);
  }
</style>
