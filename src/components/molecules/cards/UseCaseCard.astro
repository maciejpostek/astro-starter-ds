---
import type { HTMLAttributes } from "astro/types";
import ContentBlock from "../content/ContentBlock.astro";

export type UseCaseCardVariant = "role" | "industry" | "scenario";
export type UseCaseCardHeadingLevel = 2 | 3 | 4;

type Props = {
  context: string;
  title: string;
  description: string;
  variant: UseCaseCardVariant;
  actionLabel?: string;
  actionHref?: string;
  headingLevel?: UseCaseCardHeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"article">, "class">;

const {
  context,
  title,
  description,
  variant,
  actionLabel,
  actionHref,
  headingLevel = 3,
  componentName = "UseCaseCard",
  class: className,
  ...attributes
} = Astro.props;

const supportedVariants: UseCaseCardVariant[] = [
  "role",
  "industry",
  "scenario",
];
const supportedHeadingLevels: UseCaseCardHeadingLevel[] = [2, 3, 4];
const resolvedContext = context?.trim();
const resolvedTitle = title?.trim();
const resolvedDescription = description?.trim();
const resolvedActionLabel = actionLabel?.trim();
const resolvedActionHref = actionHref?.trim();
const resolvedComponentName = componentName?.trim();
const hasAction = Boolean(resolvedActionLabel && resolvedActionHref);

if (!resolvedContext || !resolvedTitle || !resolvedDescription) {
  throw new Error(
    "UseCaseCard requires non-empty context, title, and description values.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `UseCaseCard received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `UseCaseCard received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (!resolvedComponentName) {
  throw new Error("UseCaseCard requires a non-empty componentName.");
}
if (Boolean(resolvedActionLabel) !== Boolean(resolvedActionHref)) {
  throw new Error(
    "UseCaseCard actionLabel and actionHref must be provided together.",
  );
}
if (
  resolvedActionHref &&
  (
    resolvedActionHref === "#" ||
    /^javascript:/i.test(resolvedActionHref) ||
    /^data:/i.test(resolvedActionHref)
  )
) {
  throw new Error("UseCaseCard requires a real non-placeholder actionHref.");
}
if (actionLabel !== undefined && !resolvedActionLabel) {
  throw new Error("UseCaseCard actionLabel must be non-empty when provided.");
}
---

<article
  {...attributes}
  class:list={["use-case-card", className]}
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state={hasAction ? "actionable" : "static"}
  data-card-variant={variant}
  data-preview-target
>
  <span class="use-case-card__marker" aria-hidden="true"></span>
  <ContentBlock
    title={resolvedTitle}
    body={resolvedDescription}
    eyebrow={resolvedContext}
    headingLevel={headingLevel}
    actionLabel={resolvedActionLabel}
    actionHref={resolvedActionHref}
    componentName={`${resolvedComponentName}.Content`}
  />
</article>

<style>
  .use-case-card {
    position: relative;
    display: flex;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
  }

  .use-case-card__marker {
    flex: 0 0 auto;
    background: var(--color-border-accent);
  }

  .use-case-card[data-card-variant="role"] .use-case-card__marker {
    width: var(--border-width-strong);
  }

  .use-case-card[data-card-variant="industry"] {
    flex-direction: column;
  }

  .use-case-card[data-card-variant="industry"] .use-case-card__marker {
    width: 100%;
    height: var(--size-8);
  }

  .use-case-card[data-card-variant="scenario"] {
    border-color: var(--color-border-accent);
    background: var(--color-background-subtle);
  }

  .use-case-card[data-card-variant="scenario"] .use-case-card__marker {
    width: var(--size-16);
    background: var(--color-background-accent);
  }

  .use-case-card :global(.content-block) {
    width: 100%;
    max-width: none;
    min-width: 0;
    align-content: start;
    padding: var(--component-padding-large);
  }

  .use-case-card :global(.content-block__title),
  .use-case-card :global(.content-block__body) {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .use-case-card :global(.content-block .button) {
    margin-top: auto;
  }

  @media (width < 40rem) {
    .use-case-card :global(.content-block) {
      padding: var(--component-padding-medium);
    }
  }
</style>
