---
import type { HTMLAttributes } from "astro/types";
import Button from "../../atoms/actions/Button.astro";
import Tag from "../../atoms/data-display/Tag.astro";
import MediaRatio from "../../atoms/media/MediaRatio.astro";
import type { MediaRatioValue } from "../../atoms/media/types";
import StatCard from "./StatCard.astro";

export type CaseStudyCardVariant = "standard" | "highlight";
export type CaseStudyCardHeadingLevel = "h2" | "h3" | "h4" | "h5" | "h6";

export interface CaseStudyCardMetric {
  label: string;
  value: string;
  change?: string;
  changeDirection?: "up" | "down" | "neutral";
  changeLabel?: string;
  description?: string;
}

type Props = {
  title: string;
  summary: string;
  client: string;
  href: string;
  actionLabel?: string;
  tags?: string[];
  visualLabel?: string;
  visualRatio?: MediaRatioValue;
  metric?: CaseStudyCardMetric;
  variant?: CaseStudyCardVariant;
  headingLevel?: CaseStudyCardHeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"article">, "class">;

const {
  title,
  summary,
  client,
  href,
  actionLabel = "Read case study",
  tags = [],
  visualLabel,
  visualRatio = "16:9",
  metric,
  variant = "standard",
  headingLevel = "h3",
  componentName = "CaseStudyCard",
  class: className,
  ...attributes
} = Astro.props;

const supportedVariants: CaseStudyCardVariant[] = ["standard", "highlight"];
const supportedHeadingLevels: CaseStudyCardHeadingLevel[] = [
  "h2",
  "h3",
  "h4",
  "h5",
  "h6",
];
const resolvedTitle = title?.trim();
const resolvedSummary = summary?.trim();
const resolvedClient = client?.trim();
const resolvedHref = href?.trim();
const resolvedActionLabel = actionLabel?.trim();
const resolvedTags = tags.map((tag) => tag.trim());
const resolvedVisualLabel =
  visualLabel?.trim() || `${resolvedTitle || "Case study"} visual`;
const resolvedComponentName = componentName?.trim();
const hasMedia = Astro.slots.has("media");
const HeadingTag = headingLevel;

if (!resolvedTitle || !resolvedSummary || !resolvedClient) {
  throw new Error(
    "CaseStudyCard requires non-empty title, summary, and client values.",
  );
}
if (
  !resolvedHref ||
  resolvedHref === "#" ||
  /^javascript:/i.test(resolvedHref) ||
  /^data:/i.test(resolvedHref)
) {
  throw new Error(
    "CaseStudyCard requires a real non-placeholder href.",
  );
}
if (!resolvedActionLabel) {
  throw new Error("CaseStudyCard requires a non-empty actionLabel.");
}
if (resolvedTags.some((tag) => !tag)) {
  throw new Error("CaseStudyCard tags must be non-empty strings.");
}
if (new Set(resolvedTags).size !== resolvedTags.length) {
  throw new Error("CaseStudyCard tags must be unique.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `CaseStudyCard received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `CaseStudyCard received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (!resolvedComponentName) {
  throw new Error("CaseStudyCard requires a non-empty componentName.");
}
if (visualLabel !== undefined && !visualLabel.trim()) {
  throw new Error(
    "CaseStudyCard visualLabel must be non-empty when provided.",
  );
}
---

<article
  {...attributes}
  class:list={["case-study-card", className]}
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state="actionable"
  data-card-variant={variant}
  data-preview-target
>
  <div class="case-study-card__media">
    {
      hasMedia ? (
        <MediaRatio
          ratio={visualRatio}
          label={resolvedVisualLabel}
          componentName={`${resolvedComponentName}.Media`}
        >
          <slot name="media" />
        </MediaRatio>
      ) : (
        <MediaRatio
          ratio={visualRatio}
          label={resolvedVisualLabel}
          componentName={`${resolvedComponentName}.Media`}
        />
      )
    }
  </div>

  <div class="case-study-card__content">
    <p class="case-study-card__client">{resolvedClient}</p>
    <HeadingTag class="case-study-card__title">{resolvedTitle}</HeadingTag>
    <p class="case-study-card__summary">{resolvedSummary}</p>

    {
      resolvedTags.length > 0 && (
        <ul class="case-study-card__tags" aria-label="Case study topics">
          {resolvedTags.map((tag) => <li><Tag>{tag}</Tag></li>)}
        </ul>
      )
    }

    {
      metric && (
        <StatCard
          {...metric}
          componentName={`${resolvedComponentName}.Metric`}
        />
      )
    }

    <Button
      variant="link"
      href={resolvedHref}
      aria-label={`${resolvedActionLabel}: ${resolvedTitle}`}
      componentName={`${resolvedComponentName}.Action`}
    >
      {resolvedActionLabel}
    </Button>
  </div>
</article>

<style>
  .case-study-card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
  }

  .case-study-card[data-card-variant="standard"] {
    grid-template-rows: auto 1fr;
  }

  .case-study-card[data-card-variant="highlight"] {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .case-study-card__media,
  .case-study-card__content {
    min-width: 0;
  }

  .case-study-card__media {
    display: grid;
  }

  .case-study-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-medium);
    padding: var(--component-padding-large);
  }

  .case-study-card__client,
  .case-study-card__title,
  .case-study-card__summary {
    margin: 0;
  }

  .case-study-card__client {
    color: var(--color-text-accent);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--text-style-body-tiny-line-height);
    letter-spacing: var(--text-style-body-tiny-letter-spacing);
    text-transform: uppercase;
  }

  .case-study-card__title {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
    overflow-wrap: anywhere;
  }

  .case-study-card__summary {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    font-weight: var(--text-style-body-base-font-weight);
    line-height: var(--text-style-body-base-line-height);
    letter-spacing: var(--text-style-body-base-letter-spacing);
    overflow-wrap: anywhere;
  }

  .case-study-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-tag-group);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study-card__content :global(.stat-card) {
    width: 100%;
  }

  .case-study-card__content :global(.button) {
    margin-top: auto;
  }

  @media (width < 64rem) {
    .case-study-card[data-card-variant="highlight"] {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
  }

  @media (width < 40rem) {
    .case-study-card__content {
      padding: var(--component-padding-medium);
    }
  }
</style>
