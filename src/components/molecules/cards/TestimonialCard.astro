---
import Avatar from "../../atoms/media/Avatar.astro";

interface Props {
  quote: string;
  client: string;
  person: string;
  role: string;
  avatarSrc?: string;
  avatarAlt?: string;
  componentName?: string;
}

const {
  quote,
  client,
  person,
  role,
  avatarSrc,
  avatarAlt = "",
  componentName = "TestimonialCard"
} = Astro.props;

const resolvedQuote = quote.trim();
const resolvedClient = client.trim();
const resolvedPerson = person.trim();
const resolvedRole = role.trim();
const resolvedAvatarSrc = avatarSrc?.trim();
const resolvedAvatarAlt = avatarAlt.trim();
const resolvedComponentName = componentName.trim();

if (!resolvedQuote || !resolvedClient || !resolvedPerson || !resolvedRole) {
  throw new Error("TestimonialCard requires non-empty quote, client, person, and role values.");
}

if (avatarSrc !== undefined && !resolvedAvatarSrc) {
  throw new Error("TestimonialCard avatarSrc must be non-empty when provided.");
}

if (!resolvedComponentName) {
  throw new Error("TestimonialCard requires a non-empty componentName.");
}
---
<article
  class="testimonial-card"
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state="default"
  data-preview-target
>
  <blockquote>
    <p>{resolvedQuote}</p>
    <footer>
      <Avatar
        src={resolvedAvatarSrc}
        alt={resolvedAvatarAlt}
        name={resolvedPerson}
        size="small"
      />
      <span class="testimonial-card__author">
        <strong>{resolvedPerson}</strong>
        <span>{resolvedRole} · {resolvedClient}</span>
      </span>
    </footer>
  </blockquote>
</article>

<style>
  .testimonial-card {
    min-width: 0;
    min-height: var(--size-320);
    border-right: var(--border-width-default) solid var(--color-border-subtle);
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
  }

  blockquote {
    display: flex;
    width: 100%;
    max-width:
      calc(var(--size-320) + var(--size-256) + var(--size-32));
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--gap-xlarge);
    margin: 0;
  }

  blockquote > p {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-body-large);
    line-height: var(--line-height-normal);
  }

  footer {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--gap-medium);
  }

  .testimonial-card__author,
  strong,
  .testimonial-card__author > span {
    display: block;
  }

  .testimonial-card__author {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  strong,
  .testimonial-card__author > span {
    font-size: var(--font-size-body-tiny);
  }

  strong {
    font-weight: var(--font-weight-emphasis);
  }

  .testimonial-card__author > span {
    margin-top: var(--space-tiny);
    color: var(--color-text-tertiary);
  }
</style>
