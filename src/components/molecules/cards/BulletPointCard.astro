---
import BulletPoint from "../../atoms/content/BulletPoint.astro";

type HeadingLevel = "h2" | "h3" | "h4" | "h5" | "h6";

interface Props {
  title: string;
  description?: string;
  items: string[];
  headingLevel?: HeadingLevel;
  componentName?: string;
}

const {
  title,
  description,
  items,
  headingLevel = "h3",
  componentName = "BulletPointCard"
} = Astro.props;

const resolvedTitle = title.trim();
const resolvedDescription = description?.trim();
const resolvedComponentName = componentName.trim();

if (!resolvedTitle) {
  throw new Error("BulletPointCard requires a non-empty title.");
}

if (description !== undefined && !resolvedDescription) {
  throw new Error("BulletPointCard description must be non-empty when provided.");
}

if (!Array.isArray(items) || items.length === 0) {
  throw new Error("BulletPointCard requires at least one item.");
}

const resolvedItems = items.map((item) => item.trim());

if (resolvedItems.some((item) => !item)) {
  throw new Error("BulletPointCard items must be non-empty strings.");
}

if (!resolvedComponentName) {
  throw new Error("BulletPointCard requires a non-empty componentName.");
}

const HeadingTag = headingLevel;
---

<article
  class="bullet-point-card"
  data-component-name={resolvedComponentName}
  data-component-family="cards"
  data-card-state={resolvedDescription ? "with-description" : "without-description"}
  data-preview-target
>
  <header>
    <HeadingTag>{resolvedTitle}</HeadingTag>
    {resolvedDescription && <p>{resolvedDescription}</p>}
  </header>
  <ul>
    {
      resolvedItems.map((item) => (
        <li>
          <BulletPoint text={item} />
        </li>
      ))
    }
  </ul>
</article>

<style>
  .bullet-point-card {
    display: grid;
    min-width: 0;
    gap: var(--gap-large);
    border: var(--border-width-default) solid var(--color-border-default);
    background: var(--color-background-surface);
    padding: var(--component-padding-medium);
  }

  header {
    display: grid;
    min-width: 0;
    gap: var(--gap-small);
  }

  h2,
  h3,
  h4,
  h5,
  h6 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
    overflow-wrap: anywhere;
  }

  p {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    font-weight: var(--text-style-body-base-font-weight);
    line-height: var(--text-style-body-base-line-height);
    letter-spacing: var(--text-style-body-base-letter-spacing);
    overflow-wrap: anywhere;
  }

  ul {
    display: grid;
    min-width: 0;
    gap: var(--gap-small);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    min-width: 0;
  }
</style>
