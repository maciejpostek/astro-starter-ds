---
import type { HTMLAttributes } from "astro/types";
import Tag from "../../atoms/data-display/Tag.astro";
import MediaRatio from "../../atoms/media/MediaRatio.astro";
import type { MediaRatioValue } from "../../atoms/media/types";

export type ArticleCardVariant = "featured" | "standard" | "compact";
export type ArticleCardHeadingLevel = 2 | 3 | 4 | 5;

type Props = {
  title: string;
  category: string;
  href: string;
  publishedDate: string;
  dateLabel: string;
  variant: ArticleCardVariant;
  excerpt?: string;
  readingTime?: string;
  actionLabel?: string;
  visualLabel?: string;
  visualRatio?: MediaRatioValue;
  headingLevel?: ArticleCardHeadingLevel;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"article">, "class">;

const {
  title,
  category,
  href,
  publishedDate,
  dateLabel,
  variant,
  excerpt,
  readingTime,
  actionLabel = "Read article",
  visualLabel,
  visualRatio = "16:9",
  headingLevel = 3,
  componentName = "ArticleCard",
  class: className,
  ...attributes
} = Astro.props;

const supportedVariants: ArticleCardVariant[] = [
  "featured",
  "standard",
  "compact",
];
const supportedHeadingLevels: ArticleCardHeadingLevel[] = [2, 3, 4, 5];
const safeHrefPattern = /^(?:https?:\/\/|\/(?!\/))/i;
const isoDatePattern = /^\d{4}-\d{2}-\d{2}$/;
const normalizedTitle = title?.trim();
const normalizedCategory = category?.trim();
const normalizedHref = href?.trim();
const normalizedPublishedDate = publishedDate?.trim();
const normalizedDateLabel = dateLabel?.trim();
const normalizedExcerpt = excerpt?.trim();
const normalizedReadingTime = readingTime?.trim();
const normalizedActionLabel = actionLabel?.trim();
const normalizedVisualLabel =
  visualLabel?.trim() || `${normalizedTitle || "Article"} visual`;
const normalizedComponentName = componentName?.trim();
const hasMedia = Astro.slots.has("media");

if (
  !normalizedTitle ||
  !normalizedCategory ||
  !normalizedDateLabel ||
  !normalizedPublishedDate
) {
  throw new Error(
    "ArticleCard requires non-empty title, category, publishedDate, and dateLabel values.",
  );
}
if (!normalizedHref || !safeHrefPattern.test(normalizedHref)) {
  throw new Error(
    "ArticleCard requires a safe HTTPS or root-relative href.",
  );
}
if (
  !isoDatePattern.test(normalizedPublishedDate) ||
  Number.isNaN(Date.parse(`${normalizedPublishedDate}T00:00:00Z`))
) {
  throw new Error(
    "ArticleCard publishedDate must be a valid YYYY-MM-DD date.",
  );
}
if (!supportedVariants.includes(variant)) {
  throw new Error(
    `ArticleCard received unsupported variant "${String(variant)}".`,
  );
}
if (!supportedHeadingLevels.includes(headingLevel)) {
  throw new Error(
    `ArticleCard received unsupported headingLevel "${String(headingLevel)}".`,
  );
}
if (!normalizedActionLabel) {
  throw new Error("ArticleCard requires a non-empty actionLabel.");
}
if (!normalizedComponentName) {
  throw new Error("ArticleCard requires a non-empty componentName.");
}
if (excerpt !== undefined && !normalizedExcerpt) {
  throw new Error("ArticleCard excerpt must be non-empty when provided.");
}
if (readingTime !== undefined && !normalizedReadingTime) {
  throw new Error(
    "ArticleCard readingTime must be non-empty when provided.",
  );
}
if (visualLabel !== undefined && !visualLabel.trim()) {
  throw new Error(
    "ArticleCard visualLabel must be non-empty when provided.",
  );
}
if (variant !== "compact" && !normalizedExcerpt) {
  throw new Error(
    "ArticleCard Featured and Standard require a non-empty excerpt.",
  );
}
if (variant === "compact" && excerpt !== undefined) {
  throw new Error("ArticleCard Compact does not accept an excerpt.");
}
if (variant === "compact" && hasMedia) {
  throw new Error("ArticleCard Compact does not accept the media slot.");
}
if (Astro.slots.has("default")) {
  throw new Error("ArticleCard does not expose a default slot.");
}

const Heading = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5";
---

<article
  {...attributes}
  class:list={["article-card", className]}
  data-component-name={normalizedComponentName}
  data-component-family="cards"
  data-card-state="actionable"
  data-card-variant={variant}
  data-article-date={normalizedPublishedDate}
  data-preview-target
>
  <a
    class="article-card__link"
    href={normalizedHref}
    aria-label={`${normalizedActionLabel}: ${normalizedTitle}`}
  >
    {
      variant !== "compact" && (
        <div class="article-card__media">
          {hasMedia ? (
            <MediaRatio
              ratio={visualRatio}
              label={normalizedVisualLabel}
              componentName={`${normalizedComponentName}.Media`}
            >
              <slot name="media" />
            </MediaRatio>
          ) : (
            <MediaRatio
              ratio={visualRatio}
              label={normalizedVisualLabel}
              componentName={`${normalizedComponentName}.Media`}
            />
          )}
        </div>
      )
    }

    <div class="article-card__content">
      <div class="article-card__meta">
        <Tag componentName={`${normalizedComponentName}.Category`}>
          {normalizedCategory}
        </Tag>
        <span class="article-card__publication">
          <time datetime={normalizedPublishedDate}>{normalizedDateLabel}</time>
          {
            normalizedReadingTime && (
              <>
                <span aria-hidden="true">·</span>
                <span>{normalizedReadingTime}</span>
              </>
            )
          }
        </span>
      </div>

      <Heading class="article-card__title">{normalizedTitle}</Heading>
      {
        variant !== "compact" && normalizedExcerpt && (
          <p class="article-card__excerpt">{normalizedExcerpt}</p>
        )
      }
    </div>
  </a>
</article>

<style>
  .article-card,
  .article-card__link,
  .article-card__media,
  .article-card__content,
  .article-card__meta {
    min-width: 0;
  }

  .article-card {
    height: 100%;
    overflow: hidden;
    border: var(--border-width-default) solid var(--color-border-default);
    border-radius: var(--radius-medium);
    background: var(--color-background-surface);
  }

  .article-card__link {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .article-card[data-card-variant="featured"] .article-card__link {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .article-card[data-card-variant="standard"] .article-card__link {
    grid-template-rows: auto 1fr;
  }

  .article-card[data-card-variant="compact"] .article-card__link {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-card__media {
    display: grid;
  }

  .article-card__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-medium);
    padding: var(--component-padding-large);
  }

  .article-card[data-card-variant="compact"] .article-card__content {
    padding: var(--component-padding-medium);
  }

  .article-card__meta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-small);
  }

  .article-card__publication {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--gap-xsmall);
    color: var(--color-text-tertiary);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    line-height: var(--text-style-body-tiny-line-height);
  }

  .article-card__title,
  .article-card__excerpt {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .article-card__title {
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
  }

  .article-card[data-card-variant="featured"] .article-card__title {
    font-family: var(--text-style-heading-h4-font-family);
    font-size: var(--text-style-heading-h4-font-size);
    font-weight: var(--text-style-heading-h4-font-weight);
    line-height: var(--text-style-heading-h4-line-height);
    letter-spacing: var(--text-style-heading-h4-letter-spacing);
  }

  .article-card__excerpt {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-base-font-family);
    font-size: var(--text-style-body-base-font-size);
    line-height: var(--text-style-body-base-line-height);
  }

  .article-card__link:hover .article-card__title {
    color: var(--color-text-accent);
  }

  .article-card__link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: calc(var(--focus-ring-width) * -1);
  }

  @media (width < 64rem) {
    .article-card[data-card-variant="featured"] .article-card__link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
  }

  @media (width < 40rem) {
    .article-card__content {
      padding: var(--component-padding-medium);
    }

    .article-card__meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .article-card__publication {
      justify-content: flex-start;
    }
  }
</style>
