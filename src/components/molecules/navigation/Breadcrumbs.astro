---
import { ChevronRight, Ellipsis } from "@lucide/astro";

interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
  maxItems?: number;
  label?: string;
  componentName?: string;
}

type VisibleItem =
  | { kind: "item"; item: Item; sourceIndex: number }
  | { kind: "ellipsis" };

const {
  items,
  maxItems = 4,
  label = "Breadcrumb",
  componentName = "Breadcrumbs"
} = Astro.props;

const resolvedLabel = label.trim();
const resolvedComponentName = componentName.trim();

if (!resolvedLabel) {
  throw new Error("Breadcrumbs requires a non-empty accessible label.");
}

if (!resolvedComponentName) {
  throw new Error("Breadcrumbs requires a non-empty componentName.");
}

if (!Array.isArray(items) || items.length === 0) {
  throw new Error("Breadcrumbs requires at least one item.");
}

if (!Number.isSafeInteger(maxItems) || maxItems < 3) {
  throw new Error("Breadcrumbs maxItems must be a safe integer of at least 3.");
}

const normalizedItems = items.map((item, index) => {
  const normalized = {
    label: item.label.trim(),
    href: item.href?.trim()
  };

  if (!normalized.label) {
    throw new Error(`Breadcrumbs item ${index + 1} requires a non-empty label.`);
  }

  const isCurrent = index === items.length - 1;
  if (!isCurrent && (!normalized.href || normalized.href === "#")) {
    throw new Error(
      `Breadcrumbs item ${index + 1} requires a real non-placeholder href.`
    );
  }

  return normalized;
});

const collapsed = normalizedItems.length > maxItems;
const visibleItems: VisibleItem[] = collapsed
  ? [
      { kind: "item", item: normalizedItems[0], sourceIndex: 0 },
      { kind: "ellipsis" },
      ...normalizedItems
        .slice(-(maxItems - 2))
        .map((item, index) => ({
          kind: "item" as const,
          item,
          sourceIndex: normalizedItems.length - (maxItems - 2) + index
        }))
    ]
  : normalizedItems.map((item, sourceIndex) => ({
      kind: "item" as const,
      item,
      sourceIndex
    }));
---

<nav
  class="breadcrumbs"
  aria-label={resolvedLabel}
  data-component-name={resolvedComponentName}
  data-component-family="navigation"
  data-breadcrumbs-state={collapsed ? "collapsed" : "default"}
  data-preview-target
>
  <ol>
    {
      visibleItems.map((entry, index) => {
        const isCurrent =
          entry.kind === "item" &&
          entry.sourceIndex === normalizedItems.length - 1;

        return (
          <li>
            {index > 0 && (
              <span
                class="breadcrumbs__separator"
                data-breadcrumb-separator
                aria-hidden="true"
              >
                <ChevronRight aria-hidden="true" />
              </span>
            )}
            {entry.kind === "ellipsis" ? (
              <span
                class="breadcrumbs__ellipsis"
                aria-label="Collapsed breadcrumb items"
              >
                <Ellipsis size="var(--size-16)" aria-hidden="true" />
              </span>
            ) : isCurrent ? (
              <span aria-current="page">{entry.item.label}</span>
            ) : (
              <a href={entry.item.href}>{entry.item.label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-small);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs li {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: var(--gap-small);
    color: var(--color-text-tertiary);
    font-size: var(--font-size-body-tiny);
  }

  .breadcrumbs__separator {
    display: inline-flex;
    flex: none;
    align-items: center;
    color: var(--color-icon-secondary);
  }

  .breadcrumbs__separator :global(svg) {
    width: var(--size-16);
    height: var(--size-16);
  }

  .breadcrumbs a {
    color: var(--link-text-default);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--link-text-hover);
    text-decoration: underline;
    text-decoration-color: var(--link-underline-hover);
  }

  .breadcrumbs a:focus-visible {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-emphasis);
    overflow-wrap: anywhere;
  }

  .breadcrumbs__ellipsis {
    display: inline-flex;
    color: var(--color-icon-secondary);
  }
</style>
