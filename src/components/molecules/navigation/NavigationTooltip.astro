---
interface Props {
  label?: string;
  preview?: boolean;
}

const { label = "Navigation item", preview = false } = Astro.props;
---

{
  preview ? (
    <div
      class="navigation-tooltip navigation-tooltip--preview"
      data-component-name="NavigationTooltip"
      data-component-family="navigation"
      data-component-size="small"
      data-navigation-state="visible"
      data-navigation-tooltip-preview
      data-preview-target
      aria-hidden="true"
    >
      <span>{label}</span>
    </div>
  ) : (
    <div
      class="navigation-tooltip"
      data-component-name="NavigationTooltip"
      data-component-family="navigation"
      data-component-size="small"
      data-navigation-state="hidden"
      data-navigation-tooltip
      hidden
      aria-hidden="true"
    >
      <span data-navigation-tooltip-text>{label}</span>
    </div>
  )
}

{
  !preview && (
    <script>
      const tooltip = document.querySelector<HTMLElement>("[data-navigation-tooltip]");
      const tooltipText = tooltip?.querySelector<HTMLElement>("[data-navigation-tooltip-text]");
      let activeTooltipTarget: HTMLElement | null = null;

      const canShowTooltip = () => document.documentElement.dataset.grid !== "visible";

      const getTooltipTarget = (target: EventTarget | null) => {
        if (!(target instanceof Element)) return null;
        return target.closest<HTMLElement>("[data-nav-tooltip]");
      };

      const getTooltipLabel = (target: HTMLElement) =>
        target.dataset.navTooltipLabel ??
        target.getAttribute("aria-label") ??
        target.textContent?.trim() ??
        "Navigation item";

      const moveTooltip = (x: number, y: number) => {
        if (!tooltip) return;
        tooltip.style.transform = `translate3d(${x + 12}px, ${y + 12}px, 0)`;
      };

      const hideTooltip = () => {
        if (!tooltip) return;
        activeTooltipTarget = null;
        tooltip.hidden = true;
        tooltip.dataset.navigationState = "hidden";
      };

      const refreshTooltipText = () => {
        if (!activeTooltipTarget || !tooltipText) return;
        tooltipText.textContent = getTooltipLabel(activeTooltipTarget);
      };

      const showTooltip = (target: HTMLElement, x: number, y: number) => {
        if (!canShowTooltip()) {
          hideTooltip();
          return;
        }
        if (!tooltip || !tooltipText) return;
        activeTooltipTarget = target;
        tooltipText.textContent = getTooltipLabel(target);
        tooltip.hidden = false;
        tooltip.dataset.navigationState = "visible";
        moveTooltip(x, y);
      };

      document.addEventListener("pointerover", (event) => {
        const target = getTooltipTarget(event.target);
        if (!target) return;
        showTooltip(target, event.clientX, event.clientY);
      });

      document.addEventListener("pointermove", (event) => {
        if (!activeTooltipTarget) return;
        if (!canShowTooltip()) {
          hideTooltip();
          return;
        }
        refreshTooltipText();
        moveTooltip(event.clientX, event.clientY);
      });

      document.addEventListener("click", () => {
        if (!canShowTooltip()) {
          hideTooltip();
          return;
        }
        refreshTooltipText();
      });

      document.addEventListener("pointerout", (event) => {
        if (!activeTooltipTarget) return;
        const relatedTarget = event.relatedTarget;
        if (relatedTarget instanceof Node && activeTooltipTarget.contains(relatedTarget)) return;
        const target = getTooltipTarget(event.target);
        if (target === activeTooltipTarget) hideTooltip();
      });

      document.addEventListener("focusin", (event) => {
        if (!canShowTooltip()) return;
        const target = getTooltipTarget(event.target);
        if (!target) return;
        const rect = target.getBoundingClientRect();
        showTooltip(target, rect.right, rect.top + rect.height / 2);
      });

      document.addEventListener("focusout", (event) => {
        const target = getTooltipTarget(event.target);
        if (target === activeTooltipTarget) hideTooltip();
      });

      new MutationObserver(() => {
        if (!canShowTooltip()) hideTooltip();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-grid"]
      });
    </script>
  )
}

<style>
  .navigation-tooltip {
    position: fixed;
    z-index: 1001;
    top: 0;
    left: 0;
    display: inline-flex;
    max-width: 18rem;
    align-items: center;
    border: var(--border-width-default) solid var(--color-background-accent);
    color: var(--color-text-on-accent);
    background: var(--color-background-accent);
    box-shadow:
      0
      var(--size-8)
      var(--size-24)
      color-mix(in oklab, var(--color-background-accent) 18%, transparent);
    padding: var(--size-4) var(--size-6);
    pointer-events: none;
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-compact);
    white-space: nowrap;
  }

  .navigation-tooltip--preview {
    position: relative;
    z-index: auto;
    top: auto;
    left: auto;
    transform: none;
  }

  @media (width < 64rem) {
    .navigation-tooltip:not(.navigation-tooltip--preview) {
      display: none;
    }
  }
</style>
