---
import type { HTMLAttributes } from "astro/types";

export type SubnavigationVariant = "underline" | "pills";

export interface SubnavigationItem {
  href: string;
  label: string;
  isCurrent?: boolean;
}

type Props = {
  id: string;
  items: SubnavigationItem[];
  label?: string;
  variant?: SubnavigationVariant;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"nav">, "aria-label" | "class" | "id">;

const {
  id,
  items,
  label = "Section navigation",
  variant = "underline",
  componentName = "Subnavigation",
  class: className,
  ...attributes
} = Astro.props;

const variants: SubnavigationVariant[] = ["underline", "pills"];
const normalize = (value: string) => value.trim();
const isRealHref = (value: string) =>
  Boolean(value) && value !== "#" && !/^javascript:/i.test(value);
const normalizedId = normalize(id);
const normalizedLabel = normalize(label);
const normalizedComponentName = normalize(componentName);
const normalizedItems = items.map((item) => ({
  href: normalize(item.href),
  label: normalize(item.label),
  isCurrent: item.isCurrent === true,
}));

if (!/^[A-Za-z][A-Za-z0-9:_-]*$/.test(normalizedId)) {
  throw new Error(
    "Subnavigation id must start with a letter and contain only letters, numbers, colon, underscore, or hyphen.",
  );
}
if (!normalizedLabel || !normalizedComponentName) {
  throw new Error(
    "Subnavigation requires non-empty label and componentName values.",
  );
}
if (!variants.includes(variant)) {
  throw new Error(
    `Subnavigation received unsupported variant "${String(variant)}".`,
  );
}
if (normalizedItems.length < 2) {
  throw new Error("Subnavigation requires at least two destinations.");
}
if (
  normalizedItems.some(
    (item) => !item.label || !isRealHref(item.href),
  )
) {
  throw new Error(
    "Subnavigation items require non-empty labels and real non-placeholder href values.",
  );
}
if (
  new Set(normalizedItems.map((item) => item.href)).size !==
  normalizedItems.length
) {
  throw new Error("Subnavigation destination href values must be unique.");
}
if (normalizedItems.filter((item) => item.isCurrent).length > 1) {
  throw new Error(
    "Subnavigation accepts at most one current destination.",
  );
}
---

<nav
  {...attributes}
  id={normalizedId}
  class:list={["subnavigation", className]}
  data-component-name={normalizedComponentName}
  data-component-family="navigation"
  data-component-size="small"
  data-subnavigation
  data-subnavigation-variant={variant}
  data-preview-target
  aria-label={normalizedLabel}
>
  <div class="subnavigation__viewport">
    <ul>
      {
        normalizedItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.isCurrent ? "page" : undefined}
              data-navigation-state={item.isCurrent ? "current" : "default"}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .subnavigation {
    width: 100%;
    min-width: 0;
    border-block:
      var(--border-width-default) solid
      var(--color-border-subtle);
    background: var(--color-background-canvas);
    color: var(--color-text-secondary);
  }

  .subnavigation__viewport {
    width:
      min(
        var(--container-content),
        calc(100% - 2 * var(--site-padding-inline))
      );
    min-width: 0;
    margin-inline: auto;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .subnavigation ul {
    display: flex;
    width: max-content;
    min-width: 100%;
    align-items: center;
    gap: var(--gap-large);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .subnavigation a {
    position: relative;
    display: inline-flex;
    min-height: var(--component-min-height);
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    font-size: var(--component-font-size);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--component-line-height);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--motion-transition),
      background var(--motion-transition),
      border-color var(--motion-transition);
  }

  .subnavigation a:hover,
  .subnavigation a[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .subnavigation a:focus-visible {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  .subnavigation[data-subnavigation-variant="underline"] a {
    border-block-end:
      var(--border-width-strong) solid
      transparent;
  }

  .subnavigation[data-subnavigation-variant="underline"]
    a:hover,
  .subnavigation[data-subnavigation-variant="underline"]
    a[aria-current="page"] {
    border-block-end-color: var(--color-border-accent);
  }

  .subnavigation[data-subnavigation-variant="pills"] {
    padding-block: var(--component-padding-block);
    background: var(--color-background-surface);
  }

  .subnavigation[data-subnavigation-variant="pills"]
    .subnavigation__viewport {
    scrollbar-width: none;
  }

  .subnavigation[data-subnavigation-variant="pills"]
    .subnavigation__viewport::-webkit-scrollbar {
    display: none;
  }

  .subnavigation[data-subnavigation-variant="pills"] ul {
    gap: var(--gap-small);
  }

  .subnavigation[data-subnavigation-variant="pills"] a {
    border:
      var(--border-width-default) solid
      transparent;
    border-radius: var(--radius-full);
    padding-inline: var(--component-padding-inline);
  }

  .subnavigation[data-subnavigation-variant="pills"] a:hover {
    border-color: var(--color-border-default);
    background: var(--color-background-canvas);
  }

  .subnavigation[data-subnavigation-variant="pills"]
    a[aria-current="page"] {
    border-color: var(--color-border-accent);
    background: var(--color-background-subtle);
  }

  @media (width < 40rem) {
    .subnavigation__viewport {
      width: calc(100% - 2 * var(--size-16));
    }
  }
</style>
