---
import type { HTMLAttributes } from "astro/types";

type Props = {
  href: string;
  label: string;
  isCurrent?: boolean;
  class?: string;
} & Omit<HTMLAttributes<"a">, "class" | "href">;

const {
  href,
  label,
  isCurrent = false,
  class: className,
  ...attributes
} = Astro.props;

const resolvedHref = href.trim();
const resolvedLabel = label.trim();

if (!resolvedHref || resolvedHref === "#") {
  throw new Error("MenuLink requires a real non-placeholder href.");
}

if (!resolvedLabel) {
  throw new Error("MenuLink requires a non-empty label.");
}
---

<a
  class:list={["menu-link", className]}
  {...attributes}
  data-component-name="MenuLink"
  data-component-family="navigation"
  data-component-size="large"
  data-navigation-state={isCurrent ? "current" : "default"}
  href={resolvedHref}
  aria-current={isCurrent ? "page" : undefined}
>
  <span class="menu-link__label">{resolvedLabel}</span>
</a>

<style>
  .menu-link {
    position: relative;
    display: flex;
    min-height: var(--sidebar-icon-column);
    height: var(--sidebar-icon-column);
    flex: 0 0 var(--sidebar-icon-column);
    align-items: center;
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    padding: 0 var(--menu-link-padding-inline, var(--size-20));
    color: var(--color-text-primary);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-ultra-tight);
    line-height: var(--line-height-tight);
    text-decoration: none;
    transition:
      background var(--motion-transition),
      color var(--motion-transition),
      border-color var(--motion-transition);
  }

  .menu-link::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--size-4);
    background: var(--color-background-accent);
    content: "";
    opacity: 0;
  }

  .menu-link:hover,
  .menu-link[data-preview-state="hover"],
  .menu-link[data-navigation-state="current"],
  .menu-link[data-preview-state="current"] {
    background: var(--color-background-subtle);
  }

  .menu-link[data-navigation-state="current"]::before,
  .menu-link[data-preview-state="current"]::before {
    opacity: 1;
  }

  .menu-link:focus-visible,
  .menu-link[data-preview-state="focus"] {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  .menu-link__label {
    min-width: 0;
  }
</style>
