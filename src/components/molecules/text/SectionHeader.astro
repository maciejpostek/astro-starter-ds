---
import Eyebrow from "../../atoms/text/Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  variant?: "section" | "hero";
}

const { eyebrow, title, variant = "section" } = Astro.props;
const HeadingTag = variant === "hero" ? "h1" : "h2";
const hasActions = Astro.slots.has("actions");
---

<header
  class="section-header"
  data-component-name="SectionHeader"
  data-component-family="text"
  data-section-header-variant={variant}
  data-preview-target
>
  <div class="section-header__copy">
    <Eyebrow text={eyebrow} />
    <HeadingTag class="section-header__title">{title}</HeadingTag>
  </div>
  {
    hasActions && (
      <div class="section-header__actions">
        <slot name="actions" />
      </div>
    )
  }
</header>

<style>
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-xlarge);
    margin-bottom: var(--space-section-header-bottom);
  }

  .section-header__copy {
    display: grid;
    gap: 0;
  }

  .section-header__title {
    font-family: var(--section-header-title-font-family, var(--text-style-heading-h2-font-family));
    font-size: var(--section-header-title-font-size, var(--text-style-heading-h2-font-size));
    font-weight: var(--section-header-title-font-weight, var(--text-style-heading-h2-font-weight));
    line-height: var(--section-header-title-line-height, var(--text-style-heading-h2-line-height));
    letter-spacing: var(--section-header-title-letter-spacing, var(--text-style-heading-h2-letter-spacing));
  }

  .section-header[data-section-header-variant="hero"] .section-header__title {
    --section-header-title-font-family: var(--text-style-heading-h1-font-family);
    --section-header-title-font-size: var(--text-style-heading-h1-font-size);
    --section-header-title-font-weight: var(--text-style-heading-h1-font-weight);
    --section-header-title-line-height: var(--text-style-heading-h1-line-height);
    --section-header-title-letter-spacing: var(--text-style-heading-h1-letter-spacing);
  }

  .section-header__actions {
    display: flex;
    flex: 0 0 auto;
    justify-content: flex-end;
  }

  @media (width < 64rem) {
    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-header__actions {
      width: 100%;
    }

    .section-header__actions {
      justify-content: flex-start;
    }
  }
</style>
