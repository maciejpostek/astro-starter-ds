---
interface Props {
  title: string;
  id?: string;
  description?: string;
}

const { title, id, description } = Astro.props;
---

<header class="ds-section-header-level-3" data-component-name="DsDocumentation.SectionHeaderLevel3">
  <div class="ds-section-header-level-3__copy">
    <h3 id={id}>{title}</h3>
    {description && <p>{description}</p>}
  </div>
</header>

<style>
  .ds-section-header-level-3 {
    margin-block: var(--space-large) var(--space-medium);
  }

  .ds-section-header-level-3__copy {
    display: grid;
    max-width: 48rem;
    gap: var(--gap-small);
  }

  .ds-section-header-level-3 h3 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h3-font-family);
    font-size: var(--text-style-heading-h3-font-size);
    font-weight: var(--text-style-heading-h3-font-weight);
    line-height: var(--text-style-heading-h3-line-height);
    letter-spacing: var(--text-style-heading-h3-letter-spacing);
  }

  .ds-section-header-level-3 p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }
</style>
