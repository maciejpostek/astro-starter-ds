---
import Tag from "../atoms/data-display/Tag.astro";

type RoadmapStatus = "not-started" | "in-progress" | "done" | "blocked" | "later";
type RoadmapPriority = "critical" | "high" | "medium" | "low";

interface Props {
  title: string;
  id?: string;
  description?: string;
  status?: RoadmapStatus;
  priority?: RoadmapPriority;
}

const { title, id, description, status, priority } = Astro.props;

const statusLabels: Record<RoadmapStatus, string> = {
  "not-started": "Not started",
  "in-progress": "In progress",
  done: "Done",
  blocked: "Blocked",
  later: "Later"
};

const priorityLabels: Record<RoadmapPriority, string> = {
  critical: "Critical",
  high: "High",
  medium: "Medium",
  low: "Low"
};

const statusVariants: Record<RoadmapStatus, "neutral" | "accent" | "success" | "error" | "info"> = {
  "not-started": "neutral",
  "in-progress": "accent",
  done: "success",
  blocked: "error",
  later: "info"
};

const priorityVariants: Record<RoadmapPriority, "neutral" | "accent" | "warning" | "info"> = {
  critical: "accent",
  high: "info",
  medium: "warning",
  low: "neutral"
};
---

<header class="ds-section-header" data-component-name="DsDocumentation.SectionHeader">
  <div class="ds-section-header__copy">
    <h2 id={id}>{title}</h2>
    {description && <p>{description}</p>}
  </div>

  {(status || priority) && (
    <div class="ds-section-header__meta" aria-label="Roadmap metadata">
      {status && (
        <Tag
          variant={statusVariants[status]}
          size="small"
          componentName="DsDocumentation.StatusTag"
        >
          {statusLabels[status]}
        </Tag>
      )}
      {priority && (
        <Tag
          variant={priorityVariants[priority]}
          size="small"
          componentName="DsDocumentation.PriorityTag"
        >
          {priorityLabels[priority]}
        </Tag>
      )}
    </div>
  )}
</header>

<style>
  .ds-section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-xlarge);
    margin-bottom: var(--space-section-header-bottom);
  }

  .ds-section-header__copy {
    display: grid;
    max-width: 56rem;
    gap: var(--gap-regular);
  }

  .ds-section-header h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h2-font-family);
    font-size: var(--text-style-heading-h2-font-size);
    font-weight: var(--text-style-heading-h2-font-weight);
    line-height: var(--text-style-heading-h2-line-height);
    letter-spacing: var(--text-style-heading-h2-letter-spacing);
  }

  .ds-section-header p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  .ds-section-header__meta {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--gap-tag-group);
  }

  @media (width < 48rem) {
    .ds-section-header {
      flex-direction: column;
    }

    .ds-section-header__meta {
      justify-content: flex-start;
    }
  }
</style>
