---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"a">, "class" | "href"> {
  href: string;
  class?: string;
}

const { href, class: className, ...attributes } = Astro.props;

if (typeof href !== "string" || href.trim().length === 0) {
  throw new TypeError("NavLink href must be a non-empty string.");
}
if (!Astro.slots.has("default")) {
  throw new TypeError("NavLink requires label content in its default slot.");
}
---

<li class:list={["nav-link", className]} data-component-name="NavLink">
  <a {...attributes} class="nav-link__anchor body-small-semibold" href={href}>
    <slot />
  </a>
</li>

<style>
  .nav-link {
    min-inline-size: 0;
    list-style: none;
  }

  .nav-link__anchor {
    display: inline-flex;
    min-block-size: var(--control-size-small-min-height);
    align-items: center;
    border-radius: var(--radius-small);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--motion-transition), background-color var(--motion-transition);
    white-space: nowrap;
  }

  .nav-link__anchor:is(:hover, :focus-visible),
  .nav-link__anchor[aria-current] {
    color: var(--color-text-accent);
  }

  :global([data-navigation-presentation="full"]) .nav-link__anchor {
    inline-size: 100%;
    min-block-size: var(--control-size-medium-min-height);
    padding-inline: var(--content-padding-small);
    white-space: normal;
  }

  :global([data-navigation-presentation="full"]) .nav-link__anchor:is(:hover, :focus-visible) {
    background: var(--color-background-subtle);
  }

  @media (forced-colors: active) {
    .nav-link__anchor[aria-current] {
      text-decoration: underline;
    }
  }
</style>
