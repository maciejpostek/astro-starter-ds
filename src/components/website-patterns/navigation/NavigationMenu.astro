---
import type { HTMLAttributes } from "astro/types";

export interface Props extends Omit<HTMLAttributes<"ul">, "class"> {
  class?: string;
}

const { class: className, ...attributes } = Astro.props;
---

<ul
  {...attributes}
  class:list={["navigation-menu", className]}
  data-component-name="NavigationMenu"
>
  <slot />
</ul>

<style>
  .navigation-menu {
    display: flex;
    min-inline-size: 0;
    align-items: center;
    justify-content: center;
    gap: var(--gap-medium);
    list-style: none;
  }

  :global([data-navigation-presentation="full"]) .navigation-menu {
    inline-size: 100%;
    align-items: stretch;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--gap-small);
  }
</style>
