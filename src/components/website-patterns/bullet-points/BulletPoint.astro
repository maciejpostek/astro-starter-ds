---
import type { HTMLAttributes } from "astro/types";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

export type BulletPointStatus = "included" | "excluded";
export type BulletPointTone = "neutral" | "status";

export interface Props extends Omit<HTMLAttributes<"li">, "class"> {
  text: string;
  status?: BulletPointStatus;
  tone?: BulletPointTone;
  class?: string;
}

const { text, status = "included", tone = "neutral", class: className, ...attributes } = Astro.props;
const iconName = status === "included" ? "check_circle" : "cancel";
---

<li
  {...attributes}
  class:list={["bullet-point", "body-base-regular", className]}
  data-component-name="BulletPoint"
  data-status={status}
  data-tone={tone}
>
  <span class="bullet-point__icon" aria-hidden="true">
    <MaterialSymbol name={iconName} size="var(--bullet-point-icon-size)" />
  </span>
  <span class="bullet-point__text">{text}</span>
</li>

<style>
  .bullet-point {
    display: flex;
    inline-size: fit-content;
    min-inline-size: 0;
    max-inline-size: 100%;
    align-items: flex-start;
    gap: var(--bullet-point-content-gap);
    margin: 0;
    color: var(--color-text-primary);
    list-style: none;
  }

  .bullet-point__icon {
    display: flex;
    inline-size: var(--bullet-point-icon-size);
    flex: 0 0 var(--bullet-point-icon-size);
    align-items: center;
    justify-content: center;
    padding-block: var(--bullet-point-icon-offset);
    color: var(--color-icon-primary);
  }

  .bullet-point__icon :global(svg) {
    display: block;
  }

  .bullet-point__text {
    min-inline-size: 0;
    overflow-wrap: var(--overflow-wrap-break-word);
  }

  .bullet-point[data-tone="status"][data-status="included"] .bullet-point__icon {
    color: var(--color-status-success-icon);
  }

  .bullet-point[data-tone="status"][data-status="excluded"] .bullet-point__icon {
    color: var(--color-status-error-icon);
  }

  @media (forced-colors: active) {
    .bullet-point,
    .bullet-point__icon {
      color: CanvasText;
    }
  }
</style>
