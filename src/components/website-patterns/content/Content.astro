---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import ButtonGroup from "../../base-components/buttons/ButtonGroup.astro";
import Eyebrow from "../../base-components/eyebrow/Eyebrow.astro";

export type ContentAlign = "left" | "centered";

export interface Props extends Omit<HTMLAttributes<"div">, "align" | "class"> {
  heading: string;
  eyebrow?: string;
  paragraph?: string;
  align?: ContentAlign;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  class?: string;
}

const {
  heading,
  eyebrow,
  paragraph,
  align = "left",
  headingLevel = 2,
  id,
  class: className,
  ...attributes
} = Astro.props;

if (typeof heading !== "string" || heading.trim().length === 0) {
  throw new TypeError("Content heading must be a non-empty string.");
}
for (const [name, value] of [["eyebrow", eyebrow], ["paragraph", paragraph]] as const) {
  if (value !== undefined && (typeof value !== "string" || value.trim().length === 0)) {
    throw new TypeError(`Content ${name} must be a non-empty string when provided.`);
  }
}
if (!["left", "centered"].includes(align)) {
  throw new TypeError('Content align must be "left" or "centered".');
}
if (![2, 3, 4, 5, 6].includes(headingLevel)) {
  throw new RangeError("Content headingLevel must be an integer from 2 to 6.");
}

const hasActions = Astro.slots.has("actions");
const headingId = id ? `${id}-heading` : `content-${crypto.randomUUID()}-heading`;
const HeadingTag = `h${headingLevel}` as HTMLTag;
---

<div
  {...attributes}
  id={id}
  class:list={["content", className]}
  data-component-name="Content"
  data-content-align={align}
>
  <div class="content__text">
    <div class="content__heading-stack">
      {eyebrow && <Eyebrow text={eyebrow} />}
      <HeadingTag class="content__heading heading-h4" id={headingId}>{heading}</HeadingTag>
    </div>

    {paragraph && <p class="content__paragraph body-base-regular">{paragraph}</p>}
  </div>

  {hasActions && (
    <div class="content__actions">
      <ButtonGroup aria-labelledby={headingId}>
        <slot name="actions" />
      </ButtonGroup>
    </div>
  )}
</div>

<style>
  .content {
    display: flex;
    min-inline-size: 0;
    inline-size: 100%;
    flex-direction: column;
    gap: var(--gap-medium);
  }

  .content__text,
  .content__heading-stack {
    display: flex;
    min-inline-size: 0;
    inline-size: 100%;
    flex-direction: column;
  }

  .content__text {
    gap: var(--gap-regular);
  }

  .content__heading-stack {
    align-items: flex-start;
  }

  .content__heading,
  .content__paragraph {
    inline-size: 100%;
    margin: 0;
  }

  .content__heading {
    color: var(--color-text-primary);
  }

  .content__paragraph {
    color: var(--color-text-secondary);
  }

  .content__actions {
    display: flex;
    min-inline-size: 0;
    inline-size: 100%;
    justify-content: flex-start;
  }

  .content__actions > :global([data-component-name="ButtonGroup"]) {
    max-inline-size: 100%;
    inline-size: fit-content;
  }

  .content[data-content-align="centered"] {
    text-align: center;
  }

  .content[data-content-align="centered"] .content__heading-stack {
    align-items: center;
  }

  .content[data-content-align="centered"] .content__actions {
    justify-content: center;
  }
</style>
