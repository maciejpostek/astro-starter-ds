---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import IconButton from "../../atoms/actions/IconButton.astro";

interface Item {
  title: string;
  description?: string;
  image?: string;
  alt?: string;
}

interface Props {
  id: string;
  label: string;
  items: Item[];
  headingLevel?: 2 | 3 | 4 | 5 | 6;
  componentName?: string;
}

const {
  id,
  label,
  items,
  headingLevel = 3,
  componentName = "SwiperStarter"
} = Astro.props;

if (!id.trim()) {
  throw new Error("SwiperStarter requires a non-empty id.");
}

if (items.length === 0) {
  throw new Error(`SwiperStarter "${id}" requires at least one item.`);
}

const Heading = `h${headingLevel}` as
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6";
---

<section
  class="swiper-starter"
  id={id}
  aria-label={label}
  aria-roledescription="carousel"
  data-component-name={componentName}
  data-component-family="media"
  data-carousel-state="first"
  data-swiper-starter
  data-preview-target
>
  <header>
    <Heading>{label}</Heading>
    <div>
      <IconButton
        type="button"
        label="Previous slide"
        data-swiper-previous
        disabled
      >
        <ChevronLeft />
      </IconButton>
      <IconButton
        type="button"
        label="Next slide"
        data-swiper-next
        disabled={items.length < 2}
      >
        <ChevronRight />
      </IconButton>
    </div>
  </header>

  <div class="swiper-starter__viewport">
    <div class="swiper-starter__track" data-swiper-track>
      {
        items.map((item, index) => (
          <article
            data-swiper-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${items.length}`}
            aria-current={index === 0 ? "true" : undefined}
            aria-hidden={index !== 0}
            inert={index !== 0}
          >
            {item.image && <img src={item.image} alt={item.alt ?? ""} />}
            <h4>{item.title}</h4>
            {item.description && <p>{item.description}</p>}
          </article>
        ))
      }
    </div>
  </div>

  <p class="swiper-starter__status" aria-live="polite" data-swiper-status>
    Slide 1 of {items.length}
  </p>
</section>

<script>
  type SwiperWindow = Window & {
    __astroDsSwiperReady?: boolean;
  };

  const swiperWindow = window as SwiperWindow;

  if (!swiperWindow.__astroDsSwiperReady) {
    swiperWindow.__astroDsSwiperReady = true;

    document.addEventListener("click", (event) => {
      const button =
        event.target instanceof Element
          ? event.target.closest<HTMLButtonElement>(
              "[data-swiper-previous],[data-swiper-next]"
            )
          : null;
      const root = button?.closest<HTMLElement>("[data-swiper-starter]");
      if (!button || !root) return;

      const slides = Array.from(
        root.querySelectorAll<HTMLElement>("[data-swiper-slide]")
      );
      let index =
        Number(root.dataset.swiperIndex ?? 0) +
        (button.hasAttribute("data-swiper-next") ? 1 : -1);

      index = Math.max(0, Math.min(slides.length - 1, index));
      root.dataset.swiperIndex = String(index);
      root.dataset.carouselState =
        index === 0 ? "first" : index === slides.length - 1 ? "last" : "middle";
      root
        .querySelector<HTMLElement>("[data-swiper-track]")
        ?.style.setProperty("--swiper-index", String(index));

      const previous =
        root.querySelector<HTMLButtonElement>("[data-swiper-previous]");
      const next = root.querySelector<HTMLButtonElement>("[data-swiper-next]");
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;

      const status = root.querySelector<HTMLElement>("[data-swiper-status]");
      if (status) status.textContent = `Slide ${index + 1} of ${slides.length}`;

      slides.forEach((slide, slideIndex) => {
        const isCurrent = slideIndex === index;
        slide.toggleAttribute("inert", !isCurrent);
        slide.setAttribute("aria-hidden", String(!isCurrent));
        if (isCurrent) {
          slide.setAttribute("aria-current", "true");
        } else {
          slide.removeAttribute("aria-current");
        }
      });
    });
  }
</script>

<style>
  .swiper-starter {
    display: grid;
    width: 100%;
    gap: var(--gap-medium);
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-medium);
  }

  header > div {
    display: flex;
    gap: var(--gap-tiny);
  }

  header :is(h2, h3, h4, h5, h6) {
    margin: 0;
    font-family: var(--text-style-heading-h5-font-family);
    font-size: var(--text-style-heading-h5-font-size);
    font-weight: var(--text-style-heading-h5-font-weight);
    font-style: var(--text-style-heading-h5-font-style);
    line-height: var(--text-style-heading-h5-line-height);
    letter-spacing: var(--text-style-heading-h5-letter-spacing);
    text-transform: var(--text-style-heading-h5-text-transform);
    text-wrap: var(--text-style-heading-h5-text-wrap);
    overflow-wrap: var(--text-style-heading-h5-overflow-wrap);
    word-break: var(--text-style-heading-h5-word-break);
    white-space: var(--text-style-heading-h5-white-space);
  }

  .swiper-starter__viewport {
    overflow: hidden;
  }

  .swiper-starter__track {
    display: flex;
    transform: translateX(calc(var(--swiper-index, 0) * -100%));
    transition: transform var(--motion-transition);
  }

  article {
    display: grid;
    min-width: 100%;
    gap: var(--gap-small);
    border: var(--border-width-default) solid var(--color-border-default);
    padding: var(--component-padding-medium);
  }

  article img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  article h4 {
    font-family: var(--text-style-heading-h6-font-family);
    font-size: var(--text-style-heading-h6-font-size);
    font-weight: var(--text-style-heading-h6-font-weight);
    font-style: var(--text-style-heading-h6-font-style);
    line-height: var(--text-style-heading-h6-line-height);
    letter-spacing: var(--text-style-heading-h6-letter-spacing);
    text-transform: var(--text-style-heading-h6-text-transform);
    text-wrap: var(--text-style-heading-h6-text-wrap);
    overflow-wrap: var(--text-style-heading-h6-overflow-wrap);
    word-break: var(--text-style-heading-h6-word-break);
    white-space: var(--text-style-heading-h6-white-space);
  }

  article p,
  .swiper-starter__status {
    color: var(--color-text-secondary);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    font-weight: var(--text-style-body-small-font-weight);
    font-style: var(--text-style-body-small-font-style);
    line-height: var(--text-style-body-small-line-height);
    letter-spacing: var(--text-style-body-small-letter-spacing);
    text-transform: var(--text-style-body-small-text-transform);
    text-wrap: var(--text-style-body-small-text-wrap);
    overflow-wrap: var(--text-style-body-small-overflow-wrap);
    word-break: var(--text-style-body-small-word-break);
    white-space: var(--text-style-body-small-white-space);
  }
</style>
