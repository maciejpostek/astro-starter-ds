---
interface Props {
  label?: string;
  mode?: "overlay" | "static";
  scope?: "document" | "preview";
}

const { label = "Component", mode = "overlay", scope = "document" } = Astro.props;
const isOverlay = mode === "overlay";
---

<div
  class="component-info-layer"
  data-component-name="ComponentInfoLayer"
  data-component-info-layer
  data-component-info-mode={mode}
  data-component-info-scope={scope}
  hidden={isOverlay ? true : undefined}
  aria-hidden={isOverlay ? "true" : undefined}
>
  <span class="component-info-layer__icon" aria-hidden="true">❖</span>
  <span data-component-info-text>{label}</span>
</div>

<script>
  interface InfoContext {
    layer: HTMLElement;
    text: HTMLElement;
    scope: "document" | "preview";
    root: HTMLElement;
  }

  let activeComponent: HTMLElement | null = null;
  let activeContext: InfoContext | null = null;

  const getInfoContext = (target: EventTarget | null): InfoContext | null => {
    if (!(target instanceof Element)) return null;
    const previewRoot = target.closest<HTMLElement>("[data-ds-responsive-preview]");
    if (previewRoot) {
      if (previewRoot.dataset.previewGuides !== "visible"
        || !target.closest("[data-preview-viewport]")) return null;
      const layer = previewRoot.querySelector<HTMLElement>(
        "[data-component-info-layer][data-component-info-mode='overlay'][data-component-info-scope='preview']",
      );
      const text = layer?.querySelector<HTMLElement>("[data-component-info-text]");
      return layer && text ? { layer, text, scope: "preview", root: previewRoot } : null;
    }

    if (document.documentElement.dataset.guides !== "visible") return null;
    const layer = document.querySelector<HTMLElement>(
      "[data-component-info-layer][data-component-info-mode='overlay'][data-component-info-scope='document']",
    );
    const text = layer?.querySelector<HTMLElement>("[data-component-info-text]");
    return layer && text
      ? { layer, text, scope: "document", root: document.documentElement }
      : null;
  };

  const isContextActive = (context: InfoContext) => context.scope === "preview"
    ? context.root.dataset.previewGuides === "visible"
    : document.documentElement.dataset.guides === "visible";

  const getComponentTarget = (target: EventTarget | null, context: InfoContext) => {
    if (!(target instanceof Element)) return null;
    if (target.closest("[data-grid-toggle], [data-preview-guides-button]")) return null;
    const component = target.closest<HTMLElement>("[data-component-name]");
    if (!component) return null;
    if (context.scope === "preview") {
      const viewport = context.root.querySelector<HTMLElement>("[data-preview-viewport]");
      if (!viewport?.contains(component)) return null;
    }
    return component;
  };

  const isGuidesToggle = (target: EventTarget | null) =>
    target instanceof Element && Boolean(
      target.closest("[data-grid-toggle], [data-preview-guides-button]"),
    );

  const isInteractiveTarget = (target: EventTarget | null) =>
    target instanceof Element && Boolean(
      target.closest(
        'a[href], button, input, textarea, select, label, summary, [role="button"], [contenteditable="true"]'
      )
    );

  const getComponentName = (target: HTMLElement) => target.dataset.componentName ?? "Component";
  const getClipboardText = (target: HTMLElement) => `Component name: ${getComponentName(target)}`;

  const preventGuidesInteraction = (event: Event) => {
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
  };

  const setInfoText = (context: InfoContext, text: string) => {
    context.text.textContent = text;
  };

  const moveInfoLayer = (context: InfoContext, x: number, y: number) => {
    context.layer.style.transform = `translate3d(${x + 14}px, ${y + 14}px, 0)`;
  };

  const hideInfoLayer = () => {
    if (activeContext) activeContext.layer.hidden = true;
    activeComponent = null;
    activeContext = null;
  };

  const showInfoLayer = (context: InfoContext, target: HTMLElement, x: number, y: number) => {
    if (!isContextActive(context)) {
      hideInfoLayer();
      return;
    }
    if (activeContext && activeContext.layer !== context.layer) {
      activeContext.layer.hidden = true;
    }
    activeComponent = target;
    activeContext = context;
    setInfoText(context, getComponentName(target));
    context.layer.hidden = false;
    moveInfoLayer(context, x, y);
  };

  const writeClipboardText = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textArea = document.createElement("textarea");
    const copyCommand = (document as unknown as { execCommand?: (command: string) => boolean })
      .execCommand?.bind(document);

    textArea.value = text;
    textArea.setAttribute("readonly", "");
    textArea.style.position = "fixed";
    textArea.style.inset = "0";
    textArea.style.opacity = "0";
    textArea.style.pointerEvents = "none";

    document.body.append(textArea);
    textArea.select();

    const didCopy = typeof copyCommand === "function" && copyCommand("copy");
    textArea.remove();

    if (!didCopy) {
      throw new Error("Clipboard unavailable");
    }
  };

  const showToast = (id: string) => {
    window.dispatchEvent(
      new CustomEvent("astro-ds:toast-show", {
        detail: { id }
      })
    );
  };

  const copyComponentName = async (target: HTMLElement) => {
    try {
      await writeClipboardText(getClipboardText(target));
      showToast("ds-clipboard-copy-success");
    } catch {
      showToast("ds-clipboard-copy-error");
    }
  };

  document.addEventListener("pointerover", (event) => {
    const context = getInfoContext(event.target);
    if (!context) {
      hideInfoLayer();
      return;
    }
    const target = getComponentTarget(event.target, context);
    if (!target) return;
    showInfoLayer(context, target, event.clientX, event.clientY);
  });

  document.addEventListener("pointermove", (event) => {
    if (!activeComponent || !activeContext) return;
    if (!isContextActive(activeContext)) {
      hideInfoLayer();
      return;
    }
    moveInfoLayer(activeContext, event.clientX, event.clientY);
  });

  document.addEventListener("pointerout", (event) => {
    if (!activeComponent) return;
    const relatedTarget = event.relatedTarget;
    if (relatedTarget instanceof Node && activeComponent.contains(relatedTarget)) return;
    if (!activeContext) return;
    const target = getComponentTarget(event.target, activeContext);
    if (target === activeComponent) hideInfoLayer();
  });

  document.addEventListener("focusin", (event) => {
    const context = getInfoContext(event.target);
    if (!context) return;
    const target = getComponentTarget(event.target, context);
    if (!target) return;
    const rect = target.getBoundingClientRect();
    showInfoLayer(context, target, rect.left + rect.width, rect.top);
  });

  document.addEventListener("focusout", (event) => {
    if (!activeContext) return;
    const target = getComponentTarget(event.target, activeContext);
    if (target === activeComponent) hideInfoLayer();
  });

  (["pointerdown", "pointerup", "auxclick", "dblclick", "contextmenu", "dragstart"] as const)
    .forEach((eventName) => {
      document.addEventListener(
        eventName,
        (event) => {
          const context = getInfoContext(event.target);
          if (!context || isGuidesToggle(event.target)) return;
          if (!getComponentTarget(event.target, context)) return;

          preventGuidesInteraction(event);
        },
        { capture: true }
      );
    });

  document.addEventListener(
    "keydown",
    (event) => {
      if (!getInfoContext(event.target) || isGuidesToggle(event.target)) return;
      if (!isInteractiveTarget(event.target)) return;

      preventGuidesInteraction(event);
    },
    { capture: true }
  );

  document.addEventListener(
    "beforeinput",
    (event) => {
      if (!getInfoContext(event.target) || isGuidesToggle(event.target)) return;
      if (!isInteractiveTarget(event.target)) return;

      preventGuidesInteraction(event);
    },
    { capture: true }
  );

  document.addEventListener(
    "submit",
    (event) => {
      if (!getInfoContext(event.target)) return;
      preventGuidesInteraction(event);
    },
    { capture: true }
  );

  document.addEventListener(
    "click",
    (event) => {
      const context = getInfoContext(event.target);
      if (!context) return;
      if (isGuidesToggle(event.target)) return;

      const target = getComponentTarget(event.target, context);
      if (!target) return;

      preventGuidesInteraction(event);

      showInfoLayer(context, target, event.clientX, event.clientY);
      void copyComponentName(target);
    },
    { capture: true }
  );

  new MutationObserver(() => {
    if (activeContext && !isContextActive(activeContext)) hideInfoLayer();
  }).observe(document, {
    attributes: true,
    subtree: true,
    attributeFilter: ["data-guides", "data-preview-guides"],
  });
</script>

<style>
  .component-info-layer {
    --ds-guide-highlight-background: #f5f0ff;
    --ds-guide-highlight-border: #8b5cf6;

    z-index: 1000;
    top: 0;
    left: 0;
    display: inline-flex;
    max-width: 18rem;
    align-items: center;
    gap: var(--size-4);
    border: var(--border-width-default) solid var(--ds-guide-highlight-border);
    color: var(--ds-guide-highlight-border);
    background: var(--ds-guide-highlight-background);
    box-shadow: 0 var(--size-12) var(--size-40) rgb(0 0 0 / 0.1);
    padding: var(--size-6) var(--size-8);
    pointer-events: none;
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
    white-space: nowrap;
  }

  .component-info-layer[data-component-info-mode="overlay"] {
    position: fixed;
  }

  .component-info-layer[data-component-info-mode="static"] {
    position: absolute;
    top: var(--content-padding-medium);
    left: var(--content-padding-medium);
    transform: none;
  }

  .component-info-layer__icon {
    line-height: 1;
  }
</style>
