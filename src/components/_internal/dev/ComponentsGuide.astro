---
interface Props { items?: string[]; }
const { items = ["Hover a component to inspect its name.", "Enable Guides mode to copy component identity.", "Use the documented component before creating local markup."] } = Astro.props;
---
<aside class="components-guide" data-component-name="ComponentsGuide">
  <strong>Components Guide</strong>
  <ol>{items.map((item) => <li>{item}</li>)}</ol>
</aside>
<style>
  .components-guide { border: var(--border-width-default) solid var(--color-border-subtle); background: var(--color-background-surface); padding: var(--content-padding-medium); }
  strong { font-size: var(--font-size-body-small); font-weight: var(--font-weight-emphasis); }
  ol { display: grid; gap: var(--gap-small); margin-top: var(--space-medium); padding-left: var(--content-padding-medium); color: var(--color-text-secondary); font-size: var(--font-size-body-small); line-height: var(--line-height-normal); }
</style>
