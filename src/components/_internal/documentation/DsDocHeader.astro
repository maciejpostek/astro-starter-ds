---
import FigmaIcon from "../../../assets/documentation/figma.svg";
import ButtonGroup from "../../base-components/buttons/ButtonGroup.astro";
import CopyButton from "../../base-components/buttons/CopyButton.astro";
import NotificationAndToast from "../../base-components/feedback-messages/NotificationAndToast.astro";
import DsCopyButton from "./DsCopyButton.astro";
import Eyebrow from "../../base-components/eyebrow/Eyebrow.astro";
import type { DocumentationHeaderSegment } from "../../../data/documentationRegistry";
import "../../../styles/components/button-controls.css";

interface Props {
  eyebrow?: string;
  title: string;
  summary: readonly DocumentationHeaderSegment[];
  copyValue?: string;
  sourcePath?: string;
  figmaHref?: string;
  status?: string;
  componentName?: string;
}

const {
  eyebrow,
  title,
  summary,
  copyValue,
  sourcePath,
  figmaHref,
  status,
  componentName = "DsDocHeader",
} = Astro.props;
---

<header
  class="ds-documentation-page-header"
  data-component-name={componentName}
>
  <div class="ds-documentation-page-header__inner">
    {(eyebrow || status) && (
      <div class="ds-documentation-page-header__meta">
        {eyebrow && <Eyebrow class="ds-documentation-page-header__eyebrow" text={eyebrow} />}
        {status && <span class="ds-documentation-status">{status}</span>}
      </div>
    )}
    <h1 class="heading-h1">{title}</h1>
    {summary.length > 0 && (
      <p class="body-base-regular">
        {
          summary.map((segment) =>
            segment.kind === "link"
              ? <a href={segment.href}>{segment.text}</a>
              : segment.text
          )
        }
      </p>
    )}
    {sourcePath && (
      <div class="ds-documentation-page-header__source-snippet">
        <code>{sourcePath}</code>
        <DsCopyButton
          value={sourcePath}
          label={`Copy source path ${sourcePath}`}
        />
      </div>
    )}
    {(copyValue || figmaHref) && (
      <div class="ds-documentation-page-header__resources">
        <ButtonGroup aria-label={`${title} component actions`}>
          {copyValue && (
            <CopyButton
              copyValue={copyValue}
              successToastId="ds-component-name-copy-success"
              errorToastId="ds-component-name-copy-error"
              variant="primary"
              size="small"
            >
              {copyValue}
            </CopyButton>
          )}
          {figmaHref && (
            <a
              class="icon-button ds-documentation-page-header__figma-link"
              href={figmaHref}
              target="_blank"
              rel="noreferrer"
              aria-label={`Open ${title} in Figma`}
              data-button-variant="secondary"
              data-control-size="small"
            >
              <FigmaIcon aria-hidden="true" />
            </a>
          )}
        </ButtonGroup>
      </div>
    )}
    {copyValue && (
      <>
        <NotificationAndToast
          delivery="toast"
          id="ds-component-name-copy-success"
          title={`${copyValue} component name copied`}
          status="success"
        />
        <NotificationAndToast
          delivery="toast"
          id="ds-component-name-copy-error"
          title={`${copyValue} component name could not be copied`}
          status="error"
        />
      </>
    )}
  </div>
</header>

<style>
  .ds-documentation-page-header__inner {
    display: grid;
    width: 100%;
    gap: var(--gap-small);
  }

  .ds-documentation-page-header__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-medium);
  }

  .ds-documentation-page-header__meta :global(.ds-documentation-page-header__eyebrow) {
    margin-block-end: 0;
  }

  .ds-documentation-page-header__inner .heading-h1 {
    min-inline-size: 0;
    margin-block-end: var(--size-12);
    overflow-wrap: anywhere;
  }

  .ds-documentation-page-header__inner > p a {
    color: var(--link-text-default);
  }

  .ds-documentation-page-header__inner > p {
    margin-block-end: var(--size-12);
  }

  .ds-documentation-page-header__inner > p a:is(:hover, :focus-visible) {
    color: var(--link-text-hover);
  }

  .ds-documentation-page-header__resources {
    min-inline-size: 0;
  }

  .ds-documentation-page-header__source-snippet {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: var(--size-4);
    margin-block-end: var(--size-12);
    border: var(--border-width-default) solid var(--code-snippet-border);
    border-radius: var(--radius-button);
    background: var(--code-snippet-background);
    color: var(--code-snippet-foreground);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
    padding-inline-start: var(--content-padding-small);
  }

  .ds-documentation-page-header__source-snippet code {
    min-inline-size: 0;
    color: inherit;
    font-family: var(--font-family-mono);
    font-size: inherit;
    overflow-wrap: anywhere;
  }

  .ds-documentation-page-header__figma-link {
    text-decoration: none;
  }

</style>
