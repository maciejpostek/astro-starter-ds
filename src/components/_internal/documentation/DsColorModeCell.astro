---
import DsTableCell from "./DsTableCell.astro";

type ColorMode = "light" | "dark";
type SampleType = "fill" | "border" | "text";

interface Props {
  mode: ColorMode;
  value: string;
  sampleValue: string;
  sampleSurfaceValue?: string;
  sampleType?: SampleType;
  label?: string;
  showSample?: boolean;
}

const {
  mode,
  value,
  sampleValue,
  sampleSurfaceValue = "var(--color-background-canvas)",
  sampleType = "fill",
  label = "Aa",
  showSample = true,
} = Astro.props as Props;
---

<DsTableCell
  class={showSample ? "ds-color-mode-cell ds-color-mode-cell--with-sample" : "ds-color-mode-cell"}
  componentName="DsColorModeCell"
  flushInlineStart={showSample}
  overflow={showSample ? "visual" : "ellipsis"}
  role="cell"
  tone="secondary"
>
  {
    showSample ? (
      <span class="ds-color-mode-cell__value">
        {
          sampleType === "fill" && (
            <span class="ds-color-mode-cell__sample-frame" data-theme={mode}>
              <span
                class="ds-color-mode-cell__sample ds-color-mode-cell__sample--fill"
                style={`--ds-color-mode-cell-value: ${sampleValue}`}
              />
            </span>
          )
        }
        {
          sampleType === "border" && (
            <span class="ds-color-mode-cell__sample-frame" data-theme={mode}>
              <span
                class="ds-color-mode-cell__sample ds-color-mode-cell__sample--border"
                style={`--ds-color-mode-cell-value: ${sampleValue}`}
              />
            </span>
          )
        }
        {
          sampleType === "text" && (
            <span class="ds-color-mode-cell__sample-frame" data-theme={mode}>
              <span
                class="ds-color-mode-cell__sample ds-color-mode-cell__sample--text"
                style={`--ds-color-mode-cell-value: ${sampleValue}; --ds-color-mode-cell-surface-value: ${sampleSurfaceValue}`}
              >
                {label}
              </span>
            </span>
          )
        }
        <span
          class="ds-color-mode-cell__text"
          data-ds-table-overflow-target="true"
        >
          <code>{value}</code>
        </span>
      </span>
    ) : (
      <code>{value}</code>
    )
  }
</DsTableCell>

<style>
  :global(.ds-color-mode-cell) {
    min-width: 0;
  }

  :global(.ds-color-mode-cell.ds-color-mode-cell--with-sample) {
    position: relative;
    padding-block: 0;
  }

  :global(.ds-color-mode-cell.ds-color-mode-cell--with-sample)::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--ds-doc-table-mode-sample-width);
    width: var(--size-1);
    background: var(--color-border-subtle);
    pointer-events: none;
  }

  .ds-color-mode-cell__value {
    display: inline-flex;
    min-width: 0;
    width: 100%;
    min-height: var(--ds-doc-table-row-min-height);
    align-items: stretch;
    gap: var(--gap-small);
  }

  .ds-color-mode-cell__text {
    display: block;
    min-width: 0;
    flex: 1 1 auto;
    align-self: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ds-color-mode-cell__text code {
    font: inherit;
  }

  .ds-color-mode-cell__value > code {
    align-self: center;
  }

  .ds-color-mode-cell__sample-frame {
    display: flex;
    width: var(--ds-doc-table-mode-sample-width);
    min-width: var(--ds-doc-table-mode-sample-width);
    flex: 0 0 var(--ds-doc-table-mode-sample-width);
    min-height: 100%;
  }

  .ds-color-mode-cell__sample {
    display: flex;
    width: 100%;
    min-width: 100%;
    min-height: 100%;
  }

  .ds-color-mode-cell__sample--fill {
    background: var(--ds-color-mode-cell-value);
  }

  .ds-color-mode-cell__sample--border {
    background:
      linear-gradient(45deg, var(--color-background-surface) 25%, transparent 25%),
      linear-gradient(-45deg, var(--color-background-surface) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--color-background-surface) 75%),
      linear-gradient(-45deg, transparent 75%, var(--color-background-surface) 75%);
    background-color: var(--color-background-canvas);
    background-position: 0 0, 0 0.5rem, 0.5rem -0.5rem, -0.5rem 0;
    background-size: 1rem 1rem;
    border: var(--size-4) solid var(--ds-color-mode-cell-value);
  }

  .ds-color-mode-cell__sample--text {
    align-items: center;
    justify-content: center;
    background: var(--ds-color-mode-cell-surface-value);
    color: var(--ds-color-mode-cell-value);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-strong);
    letter-spacing: var(--letter-spacing-ultra-tight);
  }
</style>
