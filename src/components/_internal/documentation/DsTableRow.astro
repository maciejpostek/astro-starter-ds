---
interface Props {
  variant?: "header" | "body";
  role?: "row" | "rowgroup";
  state?: string;
  id?: string;
  variable?: string;
  componentName?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  variant = "body",
  role = "row",
  state,
  id,
  variable,
  componentName = "DsTableRow",
  class: className,
  ...attributes
} = Astro.props as Props;
---

<div
  {...attributes}
  id={id}
  class:list={["ds-table-row", className]}
  data-component-name={componentName}
  data-component-style-state={state}
  data-ds-table-row-variant={variant}
  data-variable-row={variable}
  role={role}
>
  <slot />
</div>

<style>
  .ds-table-row {
    display: grid;
    width: 100%;
    grid-template-columns:
      var(--ds-table-grid-template-columns, var(--ds-doc-table-grid-template-columns));
    min-width: 0;
  }

  .ds-table-row[data-ds-table-row-variant="header"] {
    min-height: var(--ds-doc-table-column-title-min-height);
  }

  .ds-table-row[data-ds-table-row-variant="body"] {
    min-height: var(--ds-doc-table-row-min-height);
  }

  .ds-table-row[hidden] {
    display: none;
  }
</style>
