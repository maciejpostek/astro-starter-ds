---
import DsSpacingRow from "./DsSpacingRow.astro";
import DsTableCell from "./DsTableCell.astro";
import DsTableFrame from "./DsTableFrame.astro";
import DsTableRow from "./DsTableRow.astro";

interface Row {
  token: string;
  output: string;
  source?: string;
  sampleValue?: string;
  sampleLabel?: string;
  sampleType?: "size" | "radius" | "border";
  agenticRule?: string;
}

interface Props {
  name: string;
  description: string;
  rows: Row[];
  showHeader?: boolean;
  size?: "tiny";
}

const { name, description, rows, showHeader = true, size = "tiny" } = Astro.props;
const id = `spacing-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<section
  class="ds-spacing-block"
  aria-label={showHeader ? undefined : `${name} sizing tokens`}
  aria-labelledby={showHeader ? `${id}-title` : undefined}
  data-component-name="DsSpacingBlock"
  data-ds-doc-table-size={size}
>
  {showHeader && (
    <div class="ds-spacing-block__header">
      <h3 id={`${id}-title`}>{name}</h3>
      <p>{description}</p>
    </div>
  )}

  <DsTableFrame label={`${name} sizing tokens`} size={size}>
    <DsTableRow variant="header">
      <DsTableCell role="columnheader" variant="header">Sample</DsTableCell>
      <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
      <DsTableCell role="columnheader" variant="header">Value (REM)</DsTableCell>
      <DsTableCell role="columnheader" variant="header">Value (PX)</DsTableCell>
    </DsTableRow>
    {
      rows.map((row) => (
        <DsSpacingRow
          agenticRule={row.agenticRule}
          output={row.output}
          sampleLabel={row.sampleLabel}
          sampleType={row.sampleType}
          sampleValue={row.sampleValue}
          source={row.source}
          size={size}
          token={row.token}
        />
      ))
    }
  </DsTableFrame>
</section>

<style>
  .ds-spacing-block {
    display: grid;
    gap: var(--gap-medium);
  }

  .ds-spacing-block__header {
    display: grid;
    gap: var(--gap-regular);
  }

  .ds-spacing-block__header h3 {
    color: var(--color-text-primary);
    font-size: var(--font-size-h6);
    font-weight: var(--font-weight-emphasis);
    letter-spacing: var(--letter-spacing-ultra-tight);
    line-height: var(--line-height-compact);
  }

  .ds-spacing-block__header p {
    max-width: 48rem;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

</style>
