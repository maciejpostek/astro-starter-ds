---
import Button from "../../base-components/buttons/Button.astro";
import HeroAlignBottom from "../../website-patterns/hero/HeroAlignBottom.astro";

interface Props {
  idPrefix?: string;
}

const { idPrefix = "documentation-hero-align-bottom" } = Astro.props;
---

<div
  class="ds-hero-align-bottom-preview"
  data-component-name="DsHeroAlignBottomPreview"
  data-hero-align-bottom-preview
  data-ds-preview-target
>
  <HeroAlignBottom
    id={`${idPrefix}-default`}
    heading="Build from one clear promise"
    eyebrow="Design system"
    paragraph="Pair concise supporting copy and focused actions with a prominent visual while preserving a calm, bottom-aligned composition."
    headingLevel={2}
  >
    <Button slot="actions">Start a project</Button>
    <Button slot="actions" variant="secondary">Explore the system</Button>
    <div
      class="ds-hero-align-bottom-preview__visual"
      slot="visual"
      aria-hidden="true"
    ></div>
  </HeroAlignBottom>
</div>

<script>
  type HeroAlignBottomPreviewState = {
    eyebrow: "visible" | "hidden";
    paragraph: "visible" | "hidden";
    actions: "visible" | "hidden";
  };

  const initializeHeroAlignBottomPreviews = () => {
    document.querySelectorAll<HTMLElement>("[data-hero-align-bottom-preview]").forEach((preview) => {
      if (preview.dataset.heroAlignBottomPreviewReady === "true") return;
      preview.dataset.heroAlignBottomPreviewReady = "true";

      const state: HeroAlignBottomPreviewState = {
        eyebrow: "visible",
        paragraph: "visible",
        actions: "visible",
      };

      const render = () => {
        preview.querySelectorAll<HTMLElement>('[data-component-name="Eyebrow"]').forEach((node) => {
          node.hidden = state.eyebrow === "hidden";
        });
        preview.querySelectorAll<HTMLElement>(".content__paragraph").forEach((node) => {
          node.hidden = state.paragraph === "hidden";
        });
        preview.querySelectorAll<HTMLElement>(".content__actions").forEach((node) => {
          node.hidden = state.actions === "hidden";
        });
      };

      preview.closest("[data-ds-interactive-preview], [data-ds-responsive-preview]")
        ?.addEventListener("astro-ds:preview-change", (event) => {
          if (!(event instanceof CustomEvent)) return;
          const axisId = String(event.detail?.axisId ?? "");
          const value = String(event.detail?.value ?? "");

          if (axisId === "heroAlignBottomEyebrow" && (value === "visible" || value === "hidden")) state.eyebrow = value;
          if (axisId === "heroAlignBottomParagraph" && (value === "visible" || value === "hidden")) state.paragraph = value;
          if (axisId === "heroAlignBottomActions" && (value === "visible" || value === "hidden")) state.actions = value;
          render();
        });
    });
  };

  initializeHeroAlignBottomPreviews();
  document.addEventListener("astro:page-load", initializeHeroAlignBottomPreviews);
</script>

<style>
  .ds-hero-align-bottom-preview {
    min-inline-size: 0;
    inline-size: 100%;
  }

  .ds-hero-align-bottom-preview__visual {
    aspect-ratio: 738 / 640;
    min-inline-size: 0;
    inline-size: 100%;
    background: var(--color-background-surface);
    background-image: conic-gradient(
      var(--color-background-muted) 25%,
      var(--color-background-surface) 0 50%,
      var(--color-background-muted) 0 75%,
      var(--color-background-surface) 0
    );
    background-position: left top;
    background-repeat: repeat;
    background-size: 32px 32px;
  }
</style>
