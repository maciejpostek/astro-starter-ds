---
import Accordion from "../../base-components/accordion/Accordion.astro";
import AccordionList from "../../base-components/accordion/AccordionList.astro";
---

<div class="ds-preview-renderer-boundary" data-component-name="DsAccordionListPreview">
  <AccordionList data-ds-preview-target mode="single" autoplay>
    <Accordion
      title="What belongs in the system?"
      helpText="See the component contract for scope details."
    >
      <p>Tokens, reusable components and operational documentation.</p>
    </Accordion>
    <Accordion
      title="How do components stay aligned?"
      initialOpen
    >
      <p>Astro remains the source of truth while Figma provides an editable design representation.</p>
    </Accordion>
    <Accordion
      title="Where do tokens come from?"
    >
      <p>Semantic variables map directly to documented CSS custom properties.</p>
    </Accordion>
  </AccordionList>
</div>

<style>
  .ds-preview-renderer-boundary {
    position: absolute;
    box-sizing: border-box;
    inset-block-start: 50%;
    inset-inline: var(--content-padding-xlarge);
    min-inline-size: 0;
    transform: translateY(-50%);
  }
</style>
