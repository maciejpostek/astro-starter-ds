---
import Accordion from "../../base-components/accordion/Accordion.astro";
---

<div class="ds-preview-renderer-boundary" data-component-name="DsAccordionPreview">
  <Accordion
    data-ds-preview-target
    title="How quickly will I receive a response?"
    titleSuffix="Usually within one day"
    helpText="Response time starts when a complete request reaches the team."
    helpLabel="Explain how response time is measured"
    progress={0}
  >
    <p>Most requests receive an initial response within one business day.</p>
  </Accordion>
</div>

<script>
  const readAutoplayDuration = () => {
    const rawValue = getComputedStyle(document.documentElement)
      .getPropertyValue("--motion-duration-accordion-autoplay")
      .trim();
    const value = Number.parseFloat(rawValue);
    if (!Number.isFinite(value)) return 8000;
    return rawValue.endsWith("ms") ? value : value * 1000;
  };

  const initializeAccordionPreviews = () => {
    document
      .querySelectorAll<HTMLElement>('[data-component-name="DsAccordionPreview"]')
      .forEach((boundary) => {
        if (boundary.dataset.accordionPreviewReady === "true") return;

        const preview = boundary.closest<HTMLElement>("[data-ds-interactive-preview]");
        const progress = boundary.querySelector<HTMLProgressElement>("[data-accordion-progress]");
        if (!preview || !progress) return;

        boundary.dataset.accordionPreviewReady = "true";
        let frame = 0;
        let isRunning = false;

        const cancel = () => {
          cancelAnimationFrame(frame);
          frame = 0;
        };

        const selectAxisValue = (axisId: string, value: string) => {
          const control = preview.querySelector<HTMLButtonElement>(
            `[data-ds-preview-control][data-axis-id="${axisId}"][data-axis-value="${value}"]`
          );
          if (control?.getAttribute("aria-pressed") !== "true") control?.click();
          return control;
        };

        const resetProgress = () => {
          cancel();
          isRunning = false;
          progress.value = 0;
        };

        const complete = () => {
          resetProgress();
          progress.hidden = false;
          selectAxisValue("state", "default");
        };

        const startProgress = () => {
          cancel();
          isRunning = true;
          progress.value = 0;
          progress.hidden = false;
          selectAxisValue("state", "open");

          const duration = readAutoplayDuration();
          if (duration <= 0) {
            progress.value = progress.max;
            frame = requestAnimationFrame(complete);
            return;
          }

          let startedAt: number | undefined;
          const tick = (timestamp: number) => {
            if (!boundary.isConnected) return;
            startedAt ??= timestamp;
            const ratio = Math.min(1, (timestamp - startedAt) / duration);
            progress.value = progress.max * ratio;
            if (ratio < 1) frame = requestAnimationFrame(tick);
            else frame = requestAnimationFrame(complete);
          };
          frame = requestAnimationFrame(tick);
        };

        preview.addEventListener("astro-ds:preview-change", (event) => {
          if (!(event instanceof CustomEvent)) return;
          const { axisId, value } = event.detail ?? {};
          if (axisId === "state" && value === "open" && !isRunning) startProgress();
          if (axisId === "state" && value !== "open" && isRunning) resetProgress();
        });

        boundary.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const trigger = target.closest<HTMLButtonElement>("[data-accordion-trigger]");
          if (!trigger) return;

          if (isRunning) {
            isRunning = false;
            cancel();
            frame = requestAnimationFrame(complete);
            return;
          }

          const willOpen = trigger.getAttribute("aria-expanded") !== "true";
          if (!willOpen) return;
          frame = requestAnimationFrame(() => {
            if (trigger.getAttribute("aria-expanded") === "true" && !isRunning) startProgress();
          });
        });
      });
  };

  initializeAccordionPreviews();
  document.addEventListener("astro:page-load", initializeAccordionPreviews);
</script>

<style>
  .ds-preview-renderer-boundary {
    box-sizing: border-box;
    min-inline-size: 0;
    inline-size: 100%;
  }
</style>
