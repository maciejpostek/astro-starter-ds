---
import FormField from "../../base-components/inputs/FormField.astro";
import Input from "../../base-components/inputs/Input.astro";
---

<div
  class="form-field-preview"
  data-component-name="DsFormFieldPreview"
  data-ds-preview-target
  data-ds-preview-state="default"
>
  <div class="form-field-preview__state" data-preview-field-state="default">
    <FormField controlId="form-field-preview-default" label="Label" hint="Hint text" optionalText="Optional">
      <Input id="form-field-preview-default" aria-describedby="form-field-preview-default-hint" data-input-preview-control placeholder="name@example.com" />
    </FormField>
  </div>
  <div class="form-field-preview__state" data-preview-field-state="success">
    <FormField controlId="form-field-preview-success" label="Label" hint="Email is available" size="medium" validation="success" required>
      <Input id="form-field-preview-success" aria-describedby="form-field-preview-success-hint" data-input-preview-control validation="success" value="name@example.com" required />
    </FormField>
  </div>
  <div class="form-field-preview__state" data-preview-field-state="warning">
    <FormField controlId="form-field-preview-warning" label="Label" hint="Double-check this address" size="medium" validation="warning" required>
      <Input id="form-field-preview-warning" aria-describedby="form-field-preview-warning-hint" data-input-preview-control validation="warning" value="name@example" required />
    </FormField>
  </div>
  <div class="form-field-preview__state" data-preview-field-state="error">
    <FormField controlId="form-field-preview-error" label="Label" hint="Enter a valid email address" size="medium" validation="error" required>
      <Input id="form-field-preview-error" aria-describedby="form-field-preview-error-hint" data-input-preview-control validation="error" value="name@" required />
    </FormField>
  </div>
  <div class="form-field-preview__state" data-preview-field-state="disabled">
    <FormField controlId="form-field-preview-disabled" label="Label" hint="Hint text" size="medium" disabled>
      <Input id="form-field-preview-disabled" aria-describedby="form-field-preview-disabled-hint" data-input-preview-control disabled value="name@example.com" />
    </FormField>
  </div>
</div>

<style>
  .form-field-preview {
    display: grid;
    width: min(100%, 24rem);
  }

  .form-field-preview__state {
    display: none;
  }

  .form-field-preview[data-ds-preview-state="default"] [data-preview-field-state="default"],
  .form-field-preview[data-ds-preview-state="hover"] [data-preview-field-state="default"],
  .form-field-preview[data-ds-preview-state="focus-visible"] [data-preview-field-state="default"],
  .form-field-preview[data-ds-preview-state="success"] [data-preview-field-state="success"],
  .form-field-preview[data-ds-preview-state="warning"] [data-preview-field-state="warning"],
  .form-field-preview[data-ds-preview-state="error"] [data-preview-field-state="error"],
  .form-field-preview[data-ds-preview-state="disabled"] [data-preview-field-state="disabled"] {
    display: block;
  }
</style>
