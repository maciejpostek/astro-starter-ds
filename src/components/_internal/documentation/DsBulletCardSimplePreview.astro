---
import BulletCardSimple from "../../website-patterns/bullet-points/BulletCardSimple.astro";
import Button from "../../base-components/buttons/Button.astro";
import ButtonLink from "../../base-components/buttons/ButtonLink.astro";

interface Props {
  idPrefix?: string;
}

const { idPrefix = "documentation-bullet-card-simple" } = Astro.props;
const previewId = `${idPrefix}-preview`;
---

<div
  class="bullet-card-simple-preview"
  data-component-name="DsBulletCardSimplePreview"
  data-bullet-card-simple-preview
>
  <BulletCardSimple
    id={previewId}
    title="Bullet Card Title"
    description="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers at Letraset."
    data-ds-preview-target
  >
    <Fragment slot="actions">
      <Button>Button</Button>
      <Button variant="secondary">Button</Button>
      <ButtonLink href={`#${previewId}`}>Button Link</ButtonLink>
    </Fragment>
  </BulletCardSimple>
</div>

<style>
  .bullet-card-simple-preview {
    inline-size: 100%;
    min-inline-size: 0;
  }
</style>
