---
import { componentSizeAttributeProfiles } from "../../../data/documentationFoundationData";
import DsAttributeBlock from "./DsAttributeBlock.astro";
import DsSectionHeaderLevel3 from "./DsSectionHeaderLevel3.astro";

interface Props {
  id?: string;
}

const {
  id = "sizing-size-attributes",
} = Astro.props;
---

<section
  id={id}
  class="ds-component-size-reference"
  aria-labelledby={`${id}-title`}
  data-component-name="DsComponentSizeReference"
>
  <DsSectionHeaderLevel3
    id={`${id}-title`}
    title="Component size attributes"
    description="Buttons, tags, inputs, tabs and labels use shared size profiles where possible. The data-component-size attribute maps profile tokens onto internal component aliases."
  />
  <DsAttributeBlock groups={componentSizeAttributeProfiles} />
</section>

<style>
  .ds-component-size-reference {
    min-width: 0;
    scroll-margin-top: var(--ds-doc-anchor-offset, 0px);
  }
</style>
