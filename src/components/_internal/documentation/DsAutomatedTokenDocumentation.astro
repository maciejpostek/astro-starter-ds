---
import DsTableCell from "./DsTableCell.astro";
import DsTableFrame from "./DsTableFrame.astro";
import DsTableRow from "./DsTableRow.astro";
import {
  documentationTokenMap,
  getDocumentationTokenValue,
} from "../../../data/documentationTokenRegistry";

interface Props { source: string; prefix?: string; label?: string; }
const { source, prefix, label = `${source} tokens` } = Astro.props;
const modules = import.meta.glob<string>("../../styles/tokens/*.css", { query: "?raw", import: "default", eager: true });
const match = Object.entries(modules).find(([path]) => path.endsWith(`/${source}`));
if (!match) throw new Error(`Unknown token source: ${source}`);
const [, css] = match;
const tokens = Array.from(css.matchAll(/(--[a-z0-9-]+)\s*:\s*([^;]+);/gi))
  .map((entry) => ({ token: entry[1], value: entry[2].trim().replace(/\s+/g, " ") }))
  .filter((row, index, rows) => (!prefix || row.token.startsWith(prefix)) && rows.findIndex((candidate) => candidate.token === row.token) === index);
---
<section class="ds-automated-token-documentation" data-component-name="DsAutomatedTokenDocumentation" data-token-source={source}>
  <DsTableFrame label={label} columns="minmax(18rem, 45fr) minmax(24rem, 55fr)" minWidth="48rem">
    <DsTableRow variant="header"><DsTableCell role="columnheader" variant="header">Token</DsTableCell><DsTableCell role="columnheader" variant="header">Value</DsTableCell></DsTableRow>
    {tokens.map((row) => {
      const token = documentationTokenMap.get(row.token);
      return <DsTableRow><DsTableCell role="cell"><code>{row.token}</code></DsTableCell><DsTableCell role="cell" tone="secondary"><code>{token ? getDocumentationTokenValue(token) : row.value}</code></DsTableCell></DsTableRow>;
    })}
  </DsTableFrame>
</section>
