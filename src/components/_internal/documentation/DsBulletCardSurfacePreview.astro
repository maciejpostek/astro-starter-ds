---
import BulletCardSurface from "../../website-patterns/bullet-points/BulletCardSurface.astro";
import Button from "../../base-components/buttons/Button.astro";
import ButtonLink from "../../base-components/buttons/ButtonLink.astro";

interface Props {
  idPrefix?: string;
}

const { idPrefix = "documentation-bullet-card-surface" } = Astro.props;
const previewId = `${idPrefix}-preview`;
---

<div
  class="bullet-card-surface-preview"
  data-component-name="DsBulletCardSurfacePreview"
  data-ds-preview-target
  data-bullet-card-icon="visible"
  data-bullet-card-description="visible"
  data-bullet-card-actions="visible"
  data-bullet-card-visual="visible"
>
  <BulletCardSurface
    id={previewId}
    title="Benefit title"
    description="Explain the customer benefit in one or two concise sentences."
  >
    <Fragment slot="actions">
      <Button showIcon={false}>Get started</Button>
      <ButtonLink href={`#${previewId}`}>Learn more</ButtonLink>
    </Fragment>
    <span slot="visual" aria-hidden="true"></span>
  </BulletCardSurface>
</div>

<style>
  .bullet-card-surface-preview {
    inline-size: 100%;
    min-inline-size: 0;
  }
</style>
