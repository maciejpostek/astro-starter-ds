---
interface Props {
  label: string;
  href: string;
  isCurrent?: boolean;
  hasAnchors?: boolean;
}

const { label, href, isCurrent = false, hasAnchors = true } = Astro.props as Props;
---

<div class:list={["ds-sidebar-section", isCurrent && "is-current"]}>
  <a
    aria-current={isCurrent ? "page" : undefined}
    class="ds-sidebar-section__link"
    href={href}
  >
    <span>{label}</span>
  </a>

  {
    hasAnchors && (
      <div class="ds-sidebar-section__anchors" data-ds-accordion-group>
        <slot />
      </div>
    )
  }
</div>

<style>
  .ds-sidebar-section {
    display: grid;
    gap: var(--gap-tiny);
  }

  .ds-sidebar-section__link {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: var(--size-32);
    align-items: center;
    color: var(--color-text-tertiary);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--line-height-compact);
    padding-inline: 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ds-sidebar-section__link::before {
    display: none;
  }

  .ds-sidebar-section.is-current > .ds-sidebar-section__link {
    color: var(--color-text-accent);
  }

  .ds-sidebar-section__anchors {
    display: grid;
    gap: var(--gap-tiny);
  }
</style>
