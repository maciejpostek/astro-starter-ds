---
import BulletIconCard from "../../website-patterns/bullet-points/BulletIconCard.astro";
import Button from "../../base-components/buttons/Button.astro";
import ButtonLink from "../../base-components/buttons/ButtonLink.astro";
import Tag from "../../base-components/tag/Tag.astro";

interface Props {
  idPrefix?: string;
}

const { idPrefix = "documentation-bullet-icon-card" } = Astro.props;
const previewId = `${idPrefix}-preview`;
---

<div class="bullet-icon-card-preview" data-component-name="DsBulletIconCardPreview">
  <BulletIconCard
    id={previewId}
    title="Global availability"
    description="Reach customers in new markets with one consistent product experience."
    stat="24 markets supported"
    layout="vertical"
    data-ds-preview-target
  >
    <Fragment slot="tags">
      <Tag label="Global" />
      <Tag label="Scalable" />
      <Tag label="Localized" />
    </Fragment>
    <Fragment slot="actions">
      <Button showIcon={false}>Get started</Button>
      <ButtonLink href={`#${previewId}`}>Learn more</ButtonLink>
    </Fragment>
  </BulletIconCard>
</div>

<style>
  .bullet-icon-card-preview {
    inline-size: 100%;
    min-inline-size: 0;
  }
</style>
