---
import DsCopyButton from "./DsCopyButton.astro";
import DsTableCell from "./DsTableCell.astro";
import DsTableRow from "./DsTableRow.astro";
import DsTableSampleCell from "./DsTableSampleCell.astro";
import DsTooltip from "./DsTooltip.astro";

interface Props {
  token: string;
  output: string;
  source?: string;
  sampleValue?: string;
  sampleLabel?: string;
  sampleType?: "size" | "radius" | "border";
  size?: "tiny";
  agenticRule?: string;
}

const {
  token,
  output,
  source = "",
  sampleValue = output,
  sampleLabel = "",
  sampleType = "size",
  agenticRule,
} = Astro.props;

const sourceSize = Number.parseFloat(source);
const samplePercent = Number.isFinite(sourceSize)
  ? `${Math.min(Math.max((sourceSize / 320) * 100, 0), 100)}%`
  : "100%";
const tokenId = `token-${token.replace(/^--/, "").replace(/[^a-zA-Z0-9]+/g, "-").toLowerCase()}`;
---

<DsTableRow
  class="spacing-row"
  componentName="DsSpacingRow"
  id={tokenId}
  variable={token}
>
  <DsTableSampleCell
    label={`${token} spacing sample`}
    sampleLabel={sampleLabel}
    samplePercent={samplePercent}
    sampleType={sampleType}
    sampleValue={sampleValue}
  />

  <DsTableCell class="spacing-row__token-cell" justify="between" role="cell">
    <code>{token}</code>
    <span class="spacing-row__token-actions">
      {
        agenticRule && (
          <DsTooltip
            label="Agentic Rule"
            name={`${token} usage`}
            text={agenticRule}
          />
        )
      }
      <DsCopyButton label={`Copy ${token}`} value={token} />
    </span>
  </DsTableCell>

  <DsTableCell role="cell" tone="secondary">
    <code>{output}</code>
  </DsTableCell>

  <DsTableCell role="cell" tone="secondary">
    <code>{source}</code>
  </DsTableCell>
</DsTableRow>

<style>
  .spacing-row__token-actions {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--gap-tiny);
  }

</style>
