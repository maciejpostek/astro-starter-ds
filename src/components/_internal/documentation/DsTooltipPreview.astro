---
import Tooltip from "../../base-components/tooltip/Tooltip.astro";
---

<div class="ds-preview-renderer-boundary" data-component-name="DsTooltipPreview">
  <span class="ds-tooltip-preview__trigger-size">
    <Tooltip
      data-ds-preview-target
      label="Explain response time"
      text="Response times are measured during standard business hours."
    />
  </span>
</div>

<style>
  .ds-tooltip-preview__trigger-size {
    display: block;
    inline-size: var(--size-16);
    block-size: var(--size-16);
  }
</style>
