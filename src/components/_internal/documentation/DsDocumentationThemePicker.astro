---
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";

const options = [
  { value: "system", label: "System", icon: "desktop_windows" },
  { value: "light", label: "Jasny", icon: "light_mode" },
  { value: "dark", label: "Ciemny", icon: "dark_mode" },
] as const;
---

<fieldset
  class="ds-documentation-theme-picker"
  data-component-name="DsDocumentationThemePicker"
  data-ds-theme-picker
>
  <legend>Motyw dokumentacji</legend>
  <div class="ds-documentation-theme-picker__options">
    {
      options.map((option) => (
        <label class="ds-documentation-theme-picker__option">
          <input
            type="radio"
            name="ds-documentation-theme"
            value={option.value}
            data-ds-theme-option
          />
          <span>
            <MaterialSymbol name={option.icon} size="var(--size-16)" />
            <span class="ds-documentation-theme-picker__label">{option.label}</span>
          </span>
        </label>
      ))
    }
  </div>
</fieldset>

<script>
  const runtimeWindow = window as Window & {
    __astroDsThemePickerAbortController?: AbortController;
  };
  runtimeWindow.__astroDsThemePickerAbortController?.abort();
  const controller = new AbortController();
  const signal = controller.signal;
  runtimeWindow.__astroDsThemePickerAbortController = controller;

  const root = document.documentElement;
  const systemPreference = window.matchMedia("(prefers-color-scheme: dark)");
  const options = document.querySelectorAll<HTMLInputElement>("[data-ds-theme-option]");
  type ThemePreference = "system" | "light" | "dark";

  const isThemePreference = (value: string | undefined): value is ThemePreference =>
    value === "system" || value === "light" || value === "dark";

  const updateThemeColor = () => {
    const themeColor = getComputedStyle(root)
      .getPropertyValue("--color-background-canvas")
      .trim();
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (meta && themeColor) meta.content = themeColor;
  };

  const resolveTheme = (preference: ThemePreference) =>
    preference === "system"
      ? systemPreference.matches
        ? "dark"
        : "light"
      : preference;

  const syncControls = () => {
    const preference = isThemePreference(root.dataset.themePreference)
      ? root.dataset.themePreference
      : "system";
    options.forEach((option) => {
      option.checked = option.value === preference;
    });
  };

  const applyPreference = (preference: ThemePreference, persist = true) => {
    root.dataset.themePreference = preference;
    root.dataset.theme = resolveTheme(preference);
    if (persist) localStorage.setItem("astro-ds-theme", preference);
    syncControls();
    requestAnimationFrame(updateThemeColor);
  };

  options.forEach((option) => {
    option.addEventListener(
      "change",
      () => {
        if (!option.checked || !isThemePreference(option.value)) return;
        applyPreference(option.value);
      },
      { signal }
    );
  });

  systemPreference.addEventListener(
    "change",
    () => {
      if (root.dataset.themePreference !== "system") return;
      applyPreference("system", false);
    },
    { signal }
  );

  const initialPreference = isThemePreference(root.dataset.themePreference)
    ? root.dataset.themePreference
    : "system";
  applyPreference(initialPreference, false);
</script>
