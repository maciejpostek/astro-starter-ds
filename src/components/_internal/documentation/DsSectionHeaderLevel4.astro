---
import DsSectionHeading from "./DsSectionHeading.astro";

interface Props { title: string; id?: string; description?: string; }
const { title, id, description } = Astro.props as Props;
---

<DsSectionHeading
  componentName="DsSectionHeaderLevel4"
  level={4}
  title={title}
  id={id}
  description={description}
/>
