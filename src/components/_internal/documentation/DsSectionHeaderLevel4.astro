---
interface Props {
  title: string;
  id?: string;
  description?: string;
}

const { title, id, description } = Astro.props;
---

<header class="ds-section-header-level-4" data-component-name="DsDocumentation.SectionHeaderLevel4">
  <div class="ds-section-header-level-4__copy">
    <h4 id={id}>{title}</h4>
    {description && <p>{description}</p>}
  </div>
</header>

<style>
  .ds-section-header-level-4 {
    margin-block: var(--space-medium) var(--space-regular);
  }

  .ds-section-header-level-4__copy {
    display: grid;
    max-width: 44rem;
    gap: var(--gap-small);
  }

  .ds-section-header-level-4 h4 {
    margin: 0;
    color: var(--color-text-primary);
    font-family: var(--text-style-heading-h4-font-family);
    font-size: var(--text-style-heading-h4-font-size);
    font-weight: var(--text-style-heading-h4-font-weight);
    line-height: var(--text-style-heading-h4-line-height);
    letter-spacing: var(--text-style-heading-h4-letter-spacing);
  }

  .ds-section-header-level-4 p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }
</style>
