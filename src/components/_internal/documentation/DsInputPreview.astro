---
import Input from "../../base-components/inputs/Input.astro";
---

<div
  class="input-preview"
  data-component-name="DsInputPreview"
  data-ds-preview-target
  data-input-type="input"
  data-control-size="medium"
  data-ds-preview-state="default"
>
  <Input
    class="input-preview__single"
    data-input-preview-control
    aria-label="Input preview"
    placeholder="Enter a value…"
  />
  <Input
    class="input-preview__multiline"
    data-input-preview-control
    aria-label="Textarea preview"
    multiline
    placeholder="Enter a value…"
  />
</div>

<style>
  .input-preview {
    display: grid;
    width: min(100%, 20rem);
  }

  .input-preview[data-input-type="input"] :global(.input-preview__multiline),
  .input-preview[data-input-type="textarea"] :global(.input-preview__single) {
    display: none;
  }
</style>
