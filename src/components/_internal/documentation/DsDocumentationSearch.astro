---
import SearchInput from "../../base-components/inputs/SearchInput.astro";
import {
  documentationSearchRegistry,
  type DocumentationSearchRecord,
} from "../../../data/documentationRegistry";
import DsDocumentationSearchResult from "./DsDocumentationSearchResult.astro";
import NotificationAndToast from "../../base-components/feedback-messages/NotificationAndToast.astro";

interface Props {
  triggerClass?: string;
}

const { triggerClass } = Astro.props;
const searchRecords: DocumentationSearchRecord[] = documentationSearchRegistry;
const serializedSearchRecords = JSON.stringify(searchRecords).replace(/</g, "\\u003c");
---

<div class="ds-documentation-search" data-component-name="DsDocumentationSearch">
  <SearchInput
    class:list={["ds-documentation-search__trigger", triggerClass]}
    label="Search documentation"
    size="small"
    autocomplete="off"
    placeholder="Search documentation…"
    readonly
    aria-haspopup="dialog"
    aria-keyshortcuts="Meta+K Control+K"
    data-ds-search-open
  />

  <dialog
    class="ds-documentation-dialog"
    aria-label="Search documentation"
    data-ds-search-dialog
  >
    <div class="ds-documentation-search-panel" data-ds-search-panel data-has-query="false">
      <div class="ds-documentation-dialog__header">
        <SearchInput
          class="ds-documentation-dialog__search"
          label="Search documentation"
          size="medium"
          autocomplete="off"
          placeholder="Search pages, components, icons and variables…"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="ds-documentation-search-results"
          aria-expanded="false"
        />
      </div>

      <p
        class="ds-documentation-search__status"
        aria-live="polite"
        data-ds-search-status
        hidden
      ></p>
      <div
        class="ds-documentation-search-results"
        id="ds-documentation-search-results"
        role="listbox"
        aria-label="Documentation search results"
        data-ds-search-results
        hidden
      ></div>
      <footer
        class="ds-documentation-search__footer"
        aria-label="Search keyboard shortcuts"
        data-ds-search-footer
        hidden
      >
        <span><kbd>↑</kbd><kbd>↓</kbd> Select</span>
        <span><kbd>Enter</kbd> Open</span>
        <span><kbd>Esc</kbd> Close</span>
      </footer>

      <DsDocumentationSearchResult />
      <script
        type="application/json"
        is:inline
        data-ds-search-records
        set:html={serializedSearchRecords}
      ></script>
    </div>
  </dialog>

  <NotificationAndToast
    delivery="toast"
    id="ds-documentation-variable-copy-success"
    title="Variable copied to clipboard"
    status="success"
  />
  <NotificationAndToast
    delivery="toast"
    id="ds-documentation-variable-copy-error"
    title="Variable could not be copied"
    status="error"
  />
</div>

<script>
  import {
    getDocumentationHighlightSegments,
    normalizeDocumentationQuery,
    rankDocumentationSearchRecords,
  } from "../../../lib/documentation/search.mjs";
  import type { DocumentationSearchRecord } from "../../../data/documentationRegistry";

  type SearchRuntimeWindow = Window & {
    __astroDsSearchAbortController?: AbortController;
  };

  const runtimeWindow = window as SearchRuntimeWindow;
  runtimeWindow.__astroDsSearchAbortController?.abort();
  const controller = new AbortController();
  const { signal } = controller;
  runtimeWindow.__astroDsSearchAbortController = controller;

  const dialog = document.querySelector<HTMLDialogElement>("[data-ds-search-dialog]");
  const panel = dialog?.querySelector<HTMLElement>("[data-ds-search-panel]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input-control]");
  const results = dialog?.querySelector<HTMLElement>("[data-ds-search-results]");
  const status = dialog?.querySelector<HTMLElement>("[data-ds-search-status]");
  const footer = dialog?.querySelector<HTMLElement>("[data-ds-search-footer]");
  const recordsSource = dialog?.querySelector<HTMLScriptElement>("[data-ds-search-records]");
  const resultTemplate = dialog?.querySelector<HTMLTemplateElement>("[data-ds-search-result-template]");
  const separatorTemplate = dialog?.querySelector<HTMLTemplateElement>(
    "[data-ds-search-result-separator-template]",
  );
  const variableActionTemplate = dialog?.querySelector<HTMLTemplateElement>(
    "[data-ds-search-result-variable-action-template]",
  );
  const searchRecords: DocumentationSearchRecord[] = recordsSource?.textContent
    ? JSON.parse(recordsSource.textContent)
    : [];

  let matches: DocumentationSearchRecord[] = [];
  let selectedIndex = -1;
  let returnFocusTarget: HTMLElement | null = null;

  const optionId = (record: DocumentationSearchRecord) =>
    `ds-documentation-search-option-${record.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;

  const appendHighlightedText = (target: Element, text: string, query: string) => {
    const nodes = getDocumentationHighlightSegments(text, query).map((segment) => {
      if (!segment.highlighted) return document.createTextNode(segment.text);
      const mark = document.createElement("mark");
      mark.textContent = segment.text;
      return mark;
    });
    target.append(...nodes);
  };

  const cloneTemplateElement = (template: HTMLTemplateElement | null | undefined) =>
    template?.content.firstElementChild?.cloneNode(true) ?? null;

  const renderResult = (record: DocumentationSearchRecord, query: string) => {
    const result = cloneTemplateElement(resultTemplate);
    if (!(result instanceof HTMLElement) || !dialog) return null;

    const link = result.querySelector<HTMLAnchorElement>('[role="option"]');
    if (!link) return null;
    link.id = optionId(record);
    link.href = record.href;
    link.setAttribute("aria-selected", "false");

    const iconTarget = result.querySelector("[data-ds-search-result-icon]");
    const iconTemplate = dialog.querySelector<HTMLTemplateElement>(
      `[data-ds-search-result-icon-template="${record.categoryKey}"]`,
    );
    const icon = cloneTemplateElement(iconTemplate);
    if (iconTarget && icon) iconTarget.append(icon);

    const title = result.querySelector("[data-ds-search-result-title]");
    if (title) appendHighlightedText(title, record.label, query);

    const breadcrumb = result.querySelector("[data-ds-search-result-breadcrumb]");
    if (breadcrumb) {
      record.breadcrumb.filter(Boolean).forEach((segment, index, segments) => {
        const item = document.createElement("span");
        item.className = "ds-search-result__breadcrumb-segment";
        appendHighlightedText(item, segment, query);
        breadcrumb.append(item);

        if (index < segments.length - 1) {
          const separator = cloneTemplateElement(separatorTemplate);
          if (separator instanceof Element) {
            separator.classList.add("ds-search-result__breadcrumb-separator");
            separator.setAttribute("aria-hidden", "true");
            breadcrumb.append(separator);
          }
        }
      });
    }

    if (record.kind === "Variable") {
      const actionTarget = result.querySelector("[data-ds-search-result-action]");
      const copyButton = cloneTemplateElement(variableActionTemplate);
      if (actionTarget && copyButton instanceof HTMLButtonElement) {
        copyButton.setAttribute("aria-label", `Copy variable ${record.copyValue}`);
        copyButton.setAttribute("data-clipboard-value", record.copyValue);
        actionTarget.append(copyButton);
      }
    }

    return result;
  };

  const syncSelection = (shouldScroll = false) => {
    if (!results || !input) return;
    const options = results.querySelectorAll<HTMLElement>('[role="option"]');
    options.forEach((option, index) => {
      const selected = index === selectedIndex;
      option.dataset.selected = String(selected);
      option.setAttribute("aria-selected", String(selected));
      const result = option.closest<HTMLElement>(".ds-search-result");
      if (result) result.dataset.selected = String(selected);
    });
    const active = options[selectedIndex];
    if (active) {
      input.setAttribute("aria-activedescendant", active.id);
      if (shouldScroll) active.scrollIntoView({ block: "nearest" });
    } else {
      input.removeAttribute("aria-activedescendant");
    }
  };

  const renderResults = (query: string) => {
    if (!results || !status) return;
    results.replaceChildren();

    if (!matches.length) {
      const empty = document.createElement("p");
      empty.className = "ds-search-empty";
      empty.textContent = "No documentation record matches this query.";
      results.append(empty);
    } else {
      const fragment = document.createDocumentFragment();
      matches.forEach((record) => {
        const result = renderResult(record, query);
        if (result) fragment.append(result);
      });
      results.append(fragment);
    }

    status.textContent = matches.length === 1 ? "1 result" : `${matches.length} results`;
    syncSelection();
  };

  const updateSearch = () => {
    const query = normalizeDocumentationQuery(input?.value ?? "");
    const hasQuery = query.length > 0;
    matches = hasQuery ? rankDocumentationSearchRecords(searchRecords, query, 30) : [];
    selectedIndex = matches.length ? 0 : -1;

    if (panel) panel.dataset.hasQuery = String(hasQuery);
    if (results) results.hidden = !hasQuery;
    if (footer) footer.hidden = !hasQuery;
    if (status) {
      status.hidden = !hasQuery;
      if (!hasQuery) status.textContent = "";
    }
    if (input) input.setAttribute("aria-expanded", String(hasQuery));

    if (hasQuery) renderResults(query);
    else {
      results?.replaceChildren();
      syncSelection();
    }
  };

  const closeSearch = () => {
    if (dialog?.open) dialog.close();
  };

  const openSearch = (trigger: EventTarget | null) => {
    if (!dialog) return;
    document.dispatchEvent(new CustomEvent("ds:sidebar-close"));
    const mobileMenuTrigger = document.querySelector<HTMLElement>("button[data-ds-sidebar-open]");
    const openedFromMobileSidebar =
      trigger instanceof Element &&
      Boolean(trigger.closest("[data-ds-documentation-sidebar]")) &&
      window.matchMedia("(width < 64rem)").matches;
    returnFocusTarget = openedFromMobileSidebar && mobileMenuTrigger
      ? mobileMenuTrigger
      : trigger instanceof HTMLElement
        ? trigger
        : document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
    if (!dialog.open) dialog.showModal();
    updateSearch();
    requestAnimationFrame(() => input?.focus());
  };

  document.addEventListener(
    "click",
    (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest("[data-ds-search-open]");
      if (trigger) openSearch(trigger);
    },
    { signal },
  );

  document.addEventListener(
    "keydown",
    (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target?.closest("[data-ds-search-open]");
      if (!trigger || (event.key !== "Enter" && event.key !== " ")) return;
      event.preventDefault();
      openSearch(trigger);
    },
    { signal },
  );

  input?.addEventListener("input", updateSearch, { signal });
  input?.addEventListener(
    "keydown",
    (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeSearch();
        return;
      }
      if (!matches.length) return;
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        const direction = event.key === "ArrowDown" ? 1 : -1;
        selectedIndex = (selectedIndex + direction + matches.length) % matches.length;
        syncSelection(true);
      }
      if (event.key === "Enter") {
        event.preventDefault();
        const selected = matches[selectedIndex];
        if (selected) {
          closeSearch();
          window.location.assign(selected.href);
        }
      }
    },
    { signal },
  );

  dialog?.addEventListener(
    "cancel",
    (event) => {
      event.preventDefault();
      closeSearch();
    },
    { signal },
  );
  dialog?.addEventListener(
    "click",
    (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const resultLink = target?.closest<HTMLAnchorElement>(".ds-search-result__link");
      if (resultLink && dialog.contains(resultLink)) {
        closeSearch();
        return;
      }
      if (event.target === dialog) closeSearch();
    },
    { signal },
  );
  dialog?.addEventListener(
    "close",
    () => {
      if (input) {
        input.value = "";
        input.dispatchEvent(new Event("input", { bubbles: true }));
      }
      returnFocusTarget?.focus();
    },
    { signal },
  );

  window.addEventListener(
    "keydown",
    (event) => {
      if (!(event.metaKey || event.ctrlKey) || event.key.toLocaleLowerCase() !== "k") return;
      event.preventDefault();
      openSearch(document.activeElement);
    },
    { signal },
  );
</script>
