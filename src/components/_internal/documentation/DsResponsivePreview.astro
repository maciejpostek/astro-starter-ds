---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type {
  DocumentationPreviewAxis,
  DocumentationPreviewContainer,
  DocumentationPreviewSizing,
} from "../../../data/documentationComponentRegistry";
import DsResponsivePreviewCanvas from "./DsResponsivePreviewCanvas.astro";

interface Props {
  title: string;
  backHref: string;
  renderer: AstroComponentFactory;
  rendererProps?: Record<string, unknown>;
  axes?: DocumentationPreviewAxis[];
  container?: DocumentationPreviewContainer;
  sizing?: DocumentationPreviewSizing;
  scope: string;
}

const {
  title,
  backHref,
  renderer,
  rendererProps = {},
  axes = [],
  container = "full",
  sizing = "fill",
  scope,
} = Astro.props;
---

<div class="ds-responsive-preview" data-component-name="DsResponsivePreview">
  <DsResponsivePreviewCanvas
    title={title}
    backHref={backHref}
    renderer={renderer}
  rendererProps={rendererProps}
  axes={axes}
  container={container}
  sizing={sizing}
  scope={scope}
  persistToUrl
/>
</div>
