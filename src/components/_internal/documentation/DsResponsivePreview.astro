---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { DocumentationPreviewAxis } from "../../../data/documentationComponentRegistry";
import DsResponsivePreviewCanvas from "./DsResponsivePreviewCanvas.astro";

interface Props {
  title: string;
  backHref: string;
  renderer: AstroComponentFactory;
  rendererProps?: Record<string, unknown>;
  axes?: DocumentationPreviewAxis[];
  scope: string;
}

const {
  title,
  backHref,
  renderer,
  rendererProps = {},
  axes = [],
  scope,
} = Astro.props;
---

<div class="ds-responsive-preview" data-component-name="DsResponsivePreview">
  <DsResponsivePreviewCanvas
    title={title}
    backHref={backHref}
    renderer={renderer}
  rendererProps={rendererProps}
  axes={axes}
  scope={scope}
  persistToUrl
/>
</div>
