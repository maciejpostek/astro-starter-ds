---
interface Props {
  label: string;
  columns?: string;
  minWidth?: string;
  size?: "tiny";
  componentName?: string;
  class?: string;
}

const {
  label,
  columns,
  minWidth,
  size = "tiny",
  componentName = "DsTableFrame",
  class: className,
} = Astro.props as Props;
const style = [
  columns && `--ds-table-grid-template-columns: ${columns}`,
  minWidth && `--ds-table-min-width: ${minWidth}`,
]
  .filter(Boolean)
  .join("; ");
---

<div
  aria-label={label}
  class:list={["ds-table-frame", className]}
  data-component-name={componentName}
  data-ds-doc-table-size={size}
  role="table"
  style={style || undefined}
>
  <slot />
</div>

<style>
  .ds-table-frame {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    border-top: var(--size-1) solid var(--color-border-subtle);
    border-left: var(--size-1) solid var(--color-border-subtle);
  }
</style>
