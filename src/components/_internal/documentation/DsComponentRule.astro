---
import DsCodeSnippet from "./DsCodeSnippet.astro";
import DsSectionHeaderLevel2 from "./DsSectionHeaderLevel2.astro";
import type { ComponentRuleDocument } from "../../../data/componentRuleLoader";

interface Props {
  rule: ComponentRuleDocument;
}

const { rule } = Astro.props;
---

<section
  class="ds-component-rule"
  data-component-name="DsComponentRule"
  id="component-rule"
  aria-labelledby="component-rule-title"
  data-ds-doc-section
>
  <DsSectionHeaderLevel2
    id="component-rule-title"
    title="Component Agentic Rules"
  />
  <DsCodeSnippet
    filename={rule.sourcePath}
    label={`${rule.title} · Markdown`}
    language="markdown"
    code={rule.raw}
  />
</section>

<style>
  .ds-component-rule {
    display: grid;
    gap: var(--space-large);
    margin-top: var(--section-padding-small);
    scroll-margin-top: var(--ds-doc-anchor-offset, 0px);
  }

</style>
