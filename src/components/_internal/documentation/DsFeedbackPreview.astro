---
import Alert from "../../base-components/feedback-messages/Alert.astro";
import NotificationAndToast from "../../base-components/feedback-messages/NotificationAndToast.astro";
import MaterialSymbol from "../../assets/icons/MaterialSymbol.astro";
import type { FeedbackStatus } from "../../../lib/feedback/feedbackTypes";

interface Props {
  kind: "alert" | "notification-and-toast";
}

const { kind } = Astro.props;
const previewId = `feedback-preview-${kind}`;
const statuses: FeedbackStatus[] = ["error", "warning", "success", "info", "feature"];
const statusIcons = {
  error: "error",
  warning: "warning",
  success: "check_circle",
  info: "info",
  feature: "star_rate",
} as const;
const statusLabels = {
  error: "Error",
  warning: "Warning",
  success: "Success",
  info: "Information",
  feature: "Featured",
} as const;
---

<div
  class="feedback-preview"
  data-component-name="DsFeedbackPreview"
  data-feedback-preview={kind}
  data-feedback-preview-layout={kind === "notification-and-toast" ? "compact" : undefined}
>
  {kind === "alert" && (
    <div class="feedback-preview__primary" data-ds-preview-target>
      <Alert
        title="Complete the required fields"
        description="Name and email are required before the form can be submitted."
        status="warning"
      />
    </div>
  )}

  {kind === "notification-and-toast" && (
    <div class="feedback-preview__primary" data-ds-preview-target>
      <NotificationAndToast
        id={`${previewId}-compact`}
        title="Changes saved"
        layout="compact"
        status="success"
        actions={[{ label: "View settings", href: "#api" }]}
        data-feedback-layout-preview="compact"
      />
      <NotificationAndToast
        id={`${previewId}-expanded`}
        title="Changes saved"
        description="Your latest settings are now available to everyone on the project."
        layout="expanded"
        status="success"
        actions={[{ label: "Upgrade", href: "#api" }, { label: "Learn more", href: "#dependencies" }]}
        data-feedback-layout-preview="expanded"
        hidden
      />
    </div>
  )}

  <div hidden data-feedback-preview-templates>
    {statuses.map((status) => (
      <template
        data-feedback-icon-template={status}
        data-feedback-status-label={statusLabels[status]}
      >
        <MaterialSymbol
          class="notification-and-toast__icon"
          name={statusIcons[status]}
          size="var(--feedback-size-medium-icon-size)"
        />
      </template>
    ))}
  </div>
</div>

<script>
  const syncFeedbackLayout = (preview: HTMLElement, layout: string) => {
    preview.dataset.feedbackPreviewLayout = layout;
    preview.querySelectorAll<HTMLElement>("[data-feedback-layout-preview]").forEach((root) => {
      root.hidden = root.dataset.feedbackLayoutPreview !== layout;
    });
  };

  const initializeFeedbackPreviews = () => {
    document.querySelectorAll<HTMLElement>("[data-feedback-preview]").forEach((preview) => {
      if (preview.dataset.feedbackPreviewReady === "true") return;
      preview.dataset.feedbackPreviewReady = "true";

      if (preview.dataset.feedbackPreview === "notification-and-toast") {
        syncFeedbackLayout(preview, preview.dataset.feedbackPreviewLayout ?? "compact");
      }

      preview.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const dismiss = event.target.closest("[data-feedback-dismiss]");
        const message = dismiss?.closest<HTMLElement>("[data-feedback-layout-preview]");
        if (message) message.hidden = true;
      });

      preview.closest("[data-ds-interactive-preview]")?.addEventListener("astro-ds:preview-change", (event) => {
        if (!(event instanceof CustomEvent)) return;
        const target = preview.querySelector<HTMLElement>("[data-ds-preview-target]");
        if (!target) return;

        if (event.detail?.axisId === "notificationLayout") {
          syncFeedbackLayout(preview, String(event.detail.value));
          return;
        }

        const feedbackRoots = [
          ...(target.matches("[data-feedback-root]") ? [target] : []),
          ...target.querySelectorAll<HTMLElement>("[data-feedback-root]"),
        ];

        if (event.detail?.axisId === "feedbackStatus") {
          const status = String(event.detail.value);
          const template = preview.querySelector<HTMLTemplateElement>(
            `template[data-feedback-icon-template="${status}"]`,
          );
          feedbackRoots.forEach((feedbackRoot) => {
            const currentIcon = feedbackRoot.querySelector<SVGElement>(
              ".notification-and-toast__icon, .alert__icon",
            );
            const nextIcon = template?.content.querySelector<SVGElement>(".notification-and-toast__icon");
            const statusLabel = feedbackRoot.querySelector<HTMLElement>(
              ".notification-and-toast__status-label, .alert__status-label",
            );
            feedbackRoot.dataset.feedbackStatus = status;
            if (currentIcon && nextIcon) {
              const replacement = nextIcon.cloneNode(true) as SVGElement;
              replacement.setAttribute(
                "class",
                currentIcon.classList.contains("alert__icon") ? "alert__icon" : "notification-and-toast__icon",
              );
              const currentStyle = currentIcon.getAttribute("style");
              if (currentStyle) replacement.setAttribute("style", currentStyle);
              currentIcon.replaceWith(replacement);
            }
            if (statusLabel && template?.dataset.feedbackStatusLabel) {
              statusLabel.textContent = `${template.dataset.feedbackStatusLabel}: `;
            }
          });
        }
        if (event.detail?.axisId === "feedbackEmphasis") {
          feedbackRoots.forEach((feedbackRoot) => {
            feedbackRoot.dataset.feedbackEmphasis = String(event.detail.value);
          });
        }
        if (event.detail?.axisId === "feedbackSize") {
          const size = String(event.detail.value);
          const iconSize = {
            small: "var(--feedback-size-small-icon-size)",
            medium: "var(--feedback-size-medium-icon-size)",
            large: "var(--feedback-size-large-icon-size)",
          }[size];
          feedbackRoots.forEach((feedbackRoot) => {
            feedbackRoot.dataset.feedbackSize = size;
            const icon = feedbackRoot.querySelector<SVGElement>(".alert__icon");
            if (icon && iconSize) {
              icon.style.width = iconSize;
              icon.style.height = iconSize;
            }
          });
        }
      });
    });
  };

  initializeFeedbackPreviews();
  document.addEventListener("astro:page-load", initializeFeedbackPreviews);
</script>

<style>
  .feedback-preview,
  .feedback-preview__primary {
    display: grid;
    width: 100%;
    gap: var(--gap-regular);
  }

  .feedback-preview__primary {
    justify-items: center;
  }
</style>
