---
import InfoPopover from "../../base-components/tooltip/InfoPopover.astro";
---

<div class="ds-preview-renderer-boundary" data-component-name="DsInfoPopoverPreview">
  <span class="ds-info-popover-preview__trigger-size">
    <InfoPopover
      data-ds-preview-target
      label="Explain response time"
      closeLabel="Close response time information"
      title="Response time"
      description="Measured during standard business hours and updated after each completed support request."
    />
  </span>
</div>

<style>
  .ds-info-popover-preview__trigger-size {
    display: inline-block;
    inline-size: var(--size-16);
    block-size: var(--size-16);
  }
</style>
