---
import Hint from "../../base-components/hint/Hint.astro";
---

<div
  class="hint-preview"
  data-component-name="DsHintPreview"
  data-control-size="medium"
  data-ds-preview-target
  data-ds-preview-state="default"
>
  <Hint class="hint-preview__default" text="Hint text" />
  <Hint class="hint-preview__success" text="Changes saved" tone="success" />
  <Hint class="hint-preview__warning" text="Check this value" tone="warning" />
  <Hint class="hint-preview__error" text="Enter a valid value" tone="error" />
  <Hint class="hint-preview__disabled" text="Hint text" disabled />
</div>

<style>
  .hint-preview > :global(*) {
    display: none;
  }

  .hint-preview[data-ds-preview-state="default"] :global(.hint-preview__default),
  .hint-preview[data-ds-preview-state="success"] :global(.hint-preview__success),
  .hint-preview[data-ds-preview-state="warning"] :global(.hint-preview__warning),
  .hint-preview[data-ds-preview-state="error"] :global(.hint-preview__error),
  .hint-preview[data-ds-preview-state="disabled"] :global(.hint-preview__disabled) {
    display: flex;
  }
</style>
