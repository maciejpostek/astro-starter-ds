---
import {
  getMaterialSymbol,
  type MaterialSymbolName
} from "../../../lib/icons/materialSymbols";

type Props = {
  name: MaterialSymbolName;
  size?: number | string;
  label?: string;
  class?: string;
  rotate?: number;
  [attribute: string]: unknown;
};

const {
  name,
  size = "1em",
  label,
  class: className,
  rotate,
  ...attributes
} = Astro.props;
const icon = getMaterialSymbol(name);

if (!icon) {
  throw new Error(`Unknown Material Symbol: ${name}`);
}

const style = rotate === undefined ? undefined : `transform:rotate(${rotate}deg)`;
---

<svg
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  class={className}
  data-material-symbol={name}
  fill="currentColor"
  focusable="false"
  height={size}
  role={label ? "img" : undefined}
  style={style}
  viewBox={icon.viewBox}
  width={size}
  xmlns="http://www.w3.org/2000/svg"
  {...attributes}
>
  {icon.paths.map((path) => <path d={path} />)}
</svg>
