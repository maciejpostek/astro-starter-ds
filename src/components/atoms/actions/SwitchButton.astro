---
import type { HTMLAttributes } from "astro/types";

type Props = {
  label: string;
  checked?: boolean;
  componentSize?: "small" | "medium" | "large";
  componentName?: string;
} & Omit<HTMLAttributes<"button">, "role">;

const {
  label,
  checked = false,
  componentSize = "medium",
  componentName = "SwitchButton",
  disabled,
  ...attributes
} = Astro.props;
---

<button
  class="switch-button"
  type="button"
  role="switch"
  aria-checked={checked}
  disabled={disabled}
  data-component-name={componentName}
  data-component-family="actions"
  data-component-size={componentSize}
  data-switch-state={disabled ? "disabled" : checked ? "on" : "off"}
  data-preview-target
  {...attributes}
>
  <span class="switch-button__track" aria-hidden="true"><span></span></span>
  <span class="switch-button__label">{label}</span>
</button>

<script>
  type SwitchButtonWindow = Window & { __astroDsSwitchButtonReady?: boolean };
  const switchButtonWindow = window as SwitchButtonWindow;
  if (!switchButtonWindow.__astroDsSwitchButtonReady) {
    switchButtonWindow.__astroDsSwitchButtonReady = true;
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>('[role="switch"][data-switch-state]')
        : null;
      if (!target || target.disabled) return;
      const checked = target.getAttribute("aria-checked") !== "true";
      target.setAttribute("aria-checked", String(checked));
      target.dataset.switchState = checked ? "on" : "off";
      target.dispatchEvent(new CustomEvent("switch-change", { bubbles: true, detail: { checked } }));
    });
  }
</script>

<style>
  .switch-button { display:inline-flex; min-height:var(--component-min-height); align-items:center; gap:var(--component-gap); border:0; background:transparent; color:var(--color-text-primary); padding:var(--component-padding-block) 0; cursor:pointer; font-size:var(--component-font-size); }
  .switch-button__track { display:flex; width:calc(var(--component-icon-size) * 2.25); height:calc(var(--component-icon-size) * 1.25); align-items:center; border:var(--border-width-default) solid var(--color-border-default); border-radius:var(--radius-full); background:var(--color-background-muted); padding:var(--size-2); transition:background var(--motion-transition), border-color var(--motion-transition); }
  .switch-button__track span { width:var(--component-icon-size); height:var(--component-icon-size); border-radius:50%; background:var(--color-background-canvas); box-shadow:0 0 0 var(--border-width-default) var(--color-border-subtle); transform:translateX(0); transition:transform var(--motion-transition); }
  .switch-button[aria-checked="true"] .switch-button__track { border-color:var(--color-border-accent); background:var(--color-background-accent); }
  .switch-button[data-preview-state="on"] .switch-button__track { border-color:var(--color-border-accent); background:var(--color-background-accent); }
  .switch-button[aria-checked="true"] .switch-button__track span { transform:translateX(100%); }
  .switch-button[data-preview-state="on"] .switch-button__track span { transform:translateX(100%); }
  .switch-button:hover .switch-button__track, .switch-button[data-preview-state="hover"] .switch-button__track { border-color:var(--color-border-strong); }
  .switch-button:active .switch-button__track, .switch-button[data-preview-state="pressed"] .switch-button__track { transform:scale(.96); }
  .switch-button:focus-visible, .switch-button[data-preview-state="focused"] { outline:var(--border-width-strong) solid var(--component-focus-ring); outline-offset:var(--size-2); }
  .switch-button:disabled, .switch-button[data-preview-state="disabled"] { color:var(--color-state-disabled-text); cursor:not-allowed; opacity:.64; }
</style>
