---
import type { HTMLAttributes } from "astro/types";

type Variant =
  | "neutral"
  | "accent"
  | "success"
  | "warning"
  | "error"
  | "info"
  | "inverse";

type Props = {
  variant?: Variant;
  size?: "small" | "medium" | "large";
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"span">, "class">;

const {
  variant = "neutral",
  size = "small",
  componentName,
  class: className,
  ...attributes
} = Astro.props;

const formatName = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const resolvedComponentName =
  componentName ??
  (variant === "neutral"
    ? `Tag.${formatName(size)}`
    : `Tag.${formatName(variant)}.${formatName(size)}`);
---

<span
  class:list={["tag", `tag--${variant}`, className]}
  data-component-name={resolvedComponentName}
  data-component-family="data-display"
  data-component-size={size}
  data-tag-tone={variant}
  data-preview-target
  {...attributes}
>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    width: fit-content;
    min-height: var(--component-min-height);
    align-items: center;
    gap: var(--component-gap);
    border: var(--border-width-default) solid var(--color-border-accent);
    border-radius: var(--radius-tag);
    color: var(--color-text-accent);
    background: transparent;
    padding:
      var(--component-padding-block)
      var(--component-padding-inline);
    font-family: var(--font-family-mono);
    font-size: var(--component-font-size);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--component-line-height);
    letter-spacing: var(--letter-spacing-none);
    text-transform: var(--text-transform-uppercase);
    white-space: nowrap;
  }

  .tag--accent,
  .tag[data-tag-tone="accent"] {
    border-color: var(--color-accent-200);
    color: var(--color-accent-700);
    background: var(--color-accent-50);
  }

  .tag--success,
  .tag[data-tag-tone="success"] {
    border-color: var(--color-status-success-border);
    color: var(--color-status-success-text);
    background: var(--color-status-success-background);
  }

  .tag--warning,
  .tag[data-tag-tone="warning"] {
    border-color: var(--color-status-warning-border);
    color: var(--color-status-warning-text);
    background: var(--color-status-warning-background);
  }

  .tag--error,
  .tag[data-tag-tone="error"] {
    border-color: var(--color-status-error-border);
    color: var(--color-status-error-text);
    background: var(--color-status-error-background);
  }

  .tag--info,
  .tag[data-tag-tone="info"] {
    border-color: var(--color-status-info-border);
    color: var(--color-status-info-text);
    background: var(--color-status-info-background);
  }

  .tag--inverse,
  .tag[data-tag-tone="inverse"] {
    border-color: var(--color-background-inverse);
    color: var(--color-text-inverse);
    background: var(--color-background-inverse);
  }
</style>
