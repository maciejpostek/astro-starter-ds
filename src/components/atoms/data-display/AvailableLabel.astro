---
interface Props {
  label?: string;
  status?: "available" | "unavailable";
  componentName?: string;
}

const {
  label = "Available",
  status = "available",
  componentName = "AvailableLabel"
} = Astro.props;
---

<span
  class="available-label"
  data-component-name={componentName}
  data-component-family="data-display"
  data-availability-state={status}
  data-preview-target
  role="status"
>
  <span class="available-label__indicator" aria-hidden="true"></span>
  <span>{label}</span>
</span>

<style>
  .available-label {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: var(--gap-small);
    color: var(--color-text-secondary);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-compact);
    letter-spacing: var(--letter-spacing-none);
    text-transform: var(--text-transform-uppercase);
  }

  .available-label__indicator {
    width: var(--size-8);
    height: var(--size-8);
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-status-success-icon);
    box-shadow: 0 0 0 var(--size-4) var(--color-status-success-background);
  }

  .available-label[data-availability-state="unavailable"] .available-label__indicator {
    background: var(--color-state-disabled-icon);
    box-shadow: 0 0 0 var(--size-4) var(--color-state-disabled-background);
  }
</style>
