---
interface Props {
  src?: string;
  alt?: string;
  name: string;
  size?: "small" | "medium" | "large";
  shape?: "circle" | "square";
  status?: "online" | "offline" | "busy";
  componentName?: string;
}

const {
  src,
  alt,
  name,
  size = "medium",
  shape = "square",
  status,
  componentName = "Avatar"
} = Astro.props;

const resolvedAlt = alt ?? name;
const initials = name
  .split(/\s+/)
  .slice(0, 2)
  .map((part) => part[0])
  .join("")
  .toUpperCase();
---

<span
  class="avatar"
  data-component-name={componentName}
  data-component-family="media"
  data-component-size={size}
  data-avatar-shape={shape}
  data-avatar-status={status}
  data-preview-target
>
  {
    src ? (
      <img src={src} alt={resolvedAlt} />
    ) : (
      <span aria-label={name}>{initials}</span>
    )
  }
  {
    status && (
      <>
        <i aria-hidden="true"></i>
        <span class="avatar__status-label">Status: {status}</span>
      </>
    )
  }
</span>

<style>
  .avatar {
    position: relative;
    display: inline-grid;
    width: var(--component-min-height);
    height: var(--component-min-height);
    flex: none;
    place-items: center;
    overflow: visible;
    border-radius: var(--radius-avatar);
    background: var(--color-background-muted);
    color: var(--color-text-primary);
    font-size: var(--component-font-size);
    font-weight: var(--font-weight-emphasis);
    line-height: var(--component-line-height);
  }

  .avatar[data-avatar-shape="square"] {
    border-radius: var(--radius-avatar);
  }

  .avatar[data-avatar-shape="circle"] {
    border-radius: var(--radius-full);
  }

  .avatar > img,
  .avatar > span {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    border-radius: inherit;
    object-fit: cover;
  }

  .avatar i {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 25%;
    height: 25%;
    min-width: var(--size-8);
    min-height: var(--size-8);
    border: var(--border-width-strong) solid var(--color-background-canvas);
    border-radius: var(--radius-full);
    background: var(--color-text-tertiary);
  }

  .avatar__status-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .avatar[data-avatar-status="online"] i {
    background: var(--color-status-success-icon);
  }

  .avatar[data-avatar-status="busy"] i {
    background: var(--color-status-error-icon);
  }
</style>
