---
import type { HTMLAttributes } from "astro/types";
import type { MediaRatioValue } from "./types";

type Props = {
  ratio?: MediaRatioValue;
  label?: string;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"div">, "class">;

const {
  ratio = "16:9",
  label = "Media placeholder",
  componentName = "MediaRatio",
  class: className,
  ...attributes
} = Astro.props;
const hasContent = Astro.slots.has("default");
---

<div
  class:list={["media-ratio", className]}
  data-component-name={componentName}
  data-component-family="media"
  data-media-ratio={ratio}
  data-preview-target
  {...attributes}
>
  {
    hasContent ? (
      <slot />
    ) : (
      <span class="media-ratio__placeholder">[{label} · {ratio}]</span>
    )
  }
</div>

<style>
  .media-ratio {
    position: relative;
    display: grid;
    width: 100%;
    min-height: var(--size-160);
    place-items: center;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    color: var(--color-text-on-accent);
    background: var(--color-background-accent);
    font-family: var(--text-style-body-tiny-font-family);
    font-size: var(--text-style-body-tiny-font-size);
    font-weight: var(--font-weight-emphasis);
    font-style: var(--text-style-body-tiny-font-style);
    line-height: var(--text-style-body-tiny-line-height);
    letter-spacing: var(--text-style-body-tiny-letter-spacing);
    text-transform: var(--text-style-body-tiny-text-transform);
    text-wrap: var(--text-style-body-tiny-text-wrap);
    overflow-wrap: var(--text-style-body-tiny-overflow-wrap);
    word-break: var(--text-style-body-tiny-word-break);
    white-space: var(--text-style-body-tiny-white-space);
  }

  .media-ratio__placeholder {
    position: relative;
    z-index: 1;
  }

  .media-ratio :global(img),
  .media-ratio :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-ratio :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .media-ratio[data-media-ratio="1:1"] { aspect-ratio: 1 / 1; }
  .media-ratio[data-media-ratio="3:2"] { aspect-ratio: 3 / 2; }
  .media-ratio[data-media-ratio="2:3"] { aspect-ratio: 2 / 3; }
  .media-ratio[data-media-ratio="4:3"] { aspect-ratio: 4 / 3; }
  .media-ratio[data-media-ratio="3:4"] { aspect-ratio: 3 / 4; }
  .media-ratio[data-media-ratio="16:9"] { aspect-ratio: 16 / 9; }
  .media-ratio[data-media-ratio="2.39:1"] { aspect-ratio: 2.39 / 1; }
  .media-ratio[data-media-ratio="9:16"] { aspect-ratio: 9 / 16; }
  .media-ratio[data-media-ratio="21:9"] { aspect-ratio: 21 / 9; }
</style>
