---
import type { HTMLAttributes } from "astro/types";

export type LogoVariant = "default" | "monochrome";

type Props = {
  label: string;
  variant?: LogoVariant;
  componentName?: string;
  class?: string;
} & Omit<HTMLAttributes<"span">, "class" | "role" | "aria-label">;

const {
  label,
  variant = "default",
  componentName = "Logo",
  class: className,
  ...attributes
} = Astro.props;

const normalizedLabel = label?.trim();
const normalizedComponentName = componentName?.trim();
const supportedVariants: LogoVariant[] = ["default", "monochrome"];

if (!normalizedLabel) {
  throw new Error("Logo requires a non-empty accessible label.");
}
if (!normalizedComponentName) {
  throw new Error("Logo requires a non-empty componentName.");
}
if (!supportedVariants.includes(variant)) {
  throw new Error(`Logo received unsupported variant "${variant}".`);
}
if (!Astro.slots.has("default")) {
  throw new Error("Logo requires brand artwork in its default slot.");
}
---

<span
  {...attributes}
  class:list={["logo", className]}
  role="img"
  aria-label={normalizedLabel}
  data-component-name={normalizedComponentName}
  data-component-family="media"
  data-logo-variant={variant}
  data-preview-target
>
  <slot />
</span>

<style>
  .logo {
    display: inline-flex;
    max-width: 100%;
    min-width: 0;
    flex: none;
    align-items: center;
    color: var(--color-text-primary);
    line-height: 0;
  }

  .logo[data-logo-variant="monochrome"] {
    filter: grayscale(1);
  }

  .logo :global(svg),
  .logo :global(img),
  .logo :global(picture) {
    display: block;
    max-width: 100%;
    height: auto;
    flex: none;
  }
</style>
