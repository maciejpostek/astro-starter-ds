---
import { SquareCheck } from "@lucide/astro";

interface Props {
  text: string;
  componentSize?: "small" | "medium";
  tone?: "default" | "success";
  componentName?: string;
}

const {
  text,
  componentSize = "medium",
  tone = "default",
  componentName = "BulletPoint"
} = Astro.props;
---

<span
  class="bullet-point"
  data-component-name={componentName}
  data-component-family="content"
  data-component-size={componentSize}
  data-bullet-point-tone={tone}
>
  <SquareCheck aria-hidden="true" />
  <span>{text}</span>
</span>

<style>
  .bullet-point {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--component-gap);
    color: var(--color-text-secondary);
    font-size: var(--component-font-size);
    line-height: var(--line-height-normal);
  }

  .bullet-point :global(svg) {
    width: var(--component-icon-size);
    height: var(--component-icon-size);
    flex: none;
    margin-top: var(--border-width-default);
    color: var(--color-icon-accent);
  }

  .bullet-point[data-bullet-point-tone="success"] :global(svg) {
    color: var(--color-status-success-icon);
  }
</style>
