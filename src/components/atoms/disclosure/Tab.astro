---
import type { HTMLAttributes } from "astro/types";

type Props = {
  selected?: boolean;
  componentName?: string;
  class?: string;
} & Omit<
  HTMLAttributes<"button">,
  "aria-selected" | "class" | "role" | "type"
>;

const {
  selected = false,
  componentName = "Tab",
  class: className,
  disabled,
  ...attributes
} = Astro.props;
---

<button
  class:list={["tab", className]}
  type="button"
  role="tab"
  data-component-name={componentName}
  data-component-family="disclosure"
  data-component-size="small"
  data-tab-state={disabled ? "disabled" : selected ? "selected" : "default"}
  data-preview-target
  aria-selected={selected}
  disabled={disabled}
  {...attributes}
>
  <slot />
</button>

<style>
  .tab {
    display: inline-flex;
    min-height: var(--component-min-height);
    align-items: center;
    justify-content: center;
    gap: var(--component-gap);
    border: 0;
    border-radius: var(--radius-tab);
    color: var(--tab-text-default);
    background: var(--tab-background-default);
    padding: var(--component-padding-block) var(--component-padding-inline);
    cursor: pointer;
    font-size: var(--component-font-size);
    line-height: var(--component-line-height);
    transition:
      color var(--motion-transition),
      background var(--motion-transition);
  }

  .tab:hover,
  .tab[data-preview-state="hover"] {
    color: var(--tab-text-hover);
    background: var(--tab-background-hover);
  }

  .tab[data-tab-state="selected"],
  .tab[data-preview-state="selected"] {
    color: var(--tab-text-selected);
    background: var(--tab-background-selected);
  }

  .tab:focus-visible,
  .tab[data-preview-state="focus"] {
    outline: var(--border-width-strong) solid var(--component-focus-ring);
    outline-offset: var(--size-2);
  }

  .tab:disabled,
  .tab[data-preview-state="disabled"] {
    color: var(--tab-text-disabled);
    background: var(--tab-background-disabled);
    cursor: not-allowed;
  }
</style>
