---
interface Props {
  label?: string;
  orientation?: "horizontal" | "vertical";
  componentName?: string;
}

const {
  label,
  orientation = "horizontal",
  componentName = "ContentDivider"
} = Astro.props;
const visibleLabel = orientation === "horizontal" ? label : undefined;
---

<div
  class="content-divider"
  data-component-name={componentName}
  data-component-family="text"
  data-divider-orientation={orientation}
  data-preview-target
  role="separator"
  aria-orientation={orientation}
>
  {visibleLabel && <span>{visibleLabel}</span>}
</div>

<style>
  .content-divider {
    display: flex;
    align-items: center;
    gap: var(--gap-small);
    color: var(--color-text-tertiary);
    font-family: var(--font-family-body);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-relaxed);
    letter-spacing: var(--letter-spacing-none);
  }

  .content-divider::before,
  .content-divider::after {
    content: "";
    flex: 1;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
  }

  .content-divider:not(:has(span))::after {
    display: none;
  }

  .content-divider[data-divider-orientation="vertical"] {
    display: inline-flex;
    align-self: stretch;
    width: var(--border-width-default);
    min-height: var(--size-24);
    border-left: var(--border-width-default) solid var(--color-border-subtle);
  }

  .content-divider[data-divider-orientation="vertical"]::before,
  .content-divider[data-divider-orientation="vertical"]::after {
    display: none;
  }

  .content-divider[data-divider-orientation="vertical"] > span {
    display: none;
  }
</style>
