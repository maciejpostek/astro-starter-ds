---
interface Props {
  variant?: "metric" | "field";
  componentName?: string;
  for?: string;
}

const { variant = "metric", componentName, for: htmlFor } = Astro.props;
const formatName = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const resolvedComponentName = componentName ?? `Label.${formatName(variant)}`;
const Element = variant === "field" ? "label" : "span";
---

<Element
  class:list={["label", `label--${variant}`]}
  data-component-name={resolvedComponentName}
  data-component-family="forms"
  data-label-variant={variant}
  data-preview-target
  for={variant === "field" ? htmlFor : undefined}
>
  <slot />
</Element>

<style>
  .label {
    font-weight: var(--font-weight-emphasis);
  }

  .label--metric,
  .label[data-label-variant="metric"] {
    color: var(--label-metric-text-default);
    font-size: var(--font-size-body-tiny);
    font-weight: var(--font-weight-strong);
    line-height: var(--line-height-normal);
  }

  .label--field,
  .label[data-label-variant="field"] {
    color: var(--label-field-text-default);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
  }
</style>
