---
import { Upload } from "@lucide/astro";
interface Props { id:string; name?:string; label?:string; hint?:string; accept?:string; multiple?:boolean; required?:boolean; disabled?:boolean; state?:"default"|"invalid"|"valid"; componentName?:string; }
const { id,name=id,label="Choose a file or drag it here",hint,accept,multiple=false,required=false,disabled=false,state="default",componentName="FileUpload" }=Astro.props;
---
<div class="file-upload" data-component-name={componentName} data-component-family="forms" data-upload-state={disabled?"disabled":state} data-file-upload data-preview-target>
  <input id={id} name={name} type="file" accept={accept} multiple={multiple} required={required} disabled={disabled} aria-invalid={state==="invalid"?"true":undefined} data-file-upload-input />
  <label for={id}><Upload aria-hidden="true" /><strong>{label}</strong>{hint&&<span>{hint}</span>}<output data-file-upload-output>No file selected</output></label>
</div>
<script>
  type FileUploadWindow = Window & { __astroDsFileUploadReady?: boolean };
  const fileUploadWindow=window as FileUploadWindow;
  if(!fileUploadWindow.__astroDsFileUploadReady){fileUploadWindow.__astroDsFileUploadReady=true;
    document.addEventListener("change",(event)=>{const input=event.target instanceof HTMLInputElement&&event.target.matches("[data-file-upload-input]")?event.target:null;if(!input)return;const root=input.closest<HTMLElement>("[data-file-upload]");const output=root?.querySelector<HTMLOutputElement>("[data-file-upload-output]");if(output)output.value=input.files?.length?Array.from(input.files).map(file=>file.name).join(", "):"No file selected";if(root)root.dataset.uploadState=input.files?.length?"selected":"default";});
    for(const eventName of ["dragenter","dragover","dragleave","drop"]){document.addEventListener(eventName,(event)=>{const target=event.target instanceof Element?event.target.closest<HTMLElement>("[data-file-upload]"):null;if(!target)return;if(eventName==="dragenter"||eventName==="dragover"){event.preventDefault();target.dataset.uploadState="dragging";}else target.dataset.uploadState="default";});}
  }
</script>
<style>
  .file-upload{position:relative}.file-upload input{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  .file-upload label{display:grid;min-height:var(--size-128);place-content:center;gap:var(--gap-small);border:var(--border-width-default) dashed var(--input-border-default);border-radius:var(--radius-input);background:var(--input-background-default);padding:var(--component-padding-medium);text-align:center;cursor:pointer;transition:border-color var(--motion-transition),background var(--motion-transition)}
  .file-upload label :global(svg){width:var(--size-24);height:var(--size-24);margin-inline:auto;color:var(--color-icon-accent)}
  .file-upload span,.file-upload output{color:var(--color-text-secondary);font-size:var(--font-size-body-tiny)}
  .file-upload label:hover,.file-upload[data-preview-state="hover"] label{border-color:var(--input-border-hover);background:var(--input-background-hover)}
  .file-upload:has(input:focus-visible) label,.file-upload[data-preview-state="focused"] label{outline:var(--border-width-strong) solid var(--component-focus-ring);outline-offset:var(--size-2)}
  .file-upload[data-upload-state="dragging"] label,.file-upload[data-preview-state="dragging"] label{border-style:solid;border-color:var(--color-border-accent);background:var(--color-background-subtle)}
  .file-upload[data-upload-state="selected"] label,.file-upload[data-preview-state="selected"] label{border-color:var(--input-border-valid)}
  .file-upload[data-upload-state="invalid"] label,.file-upload[data-preview-state="invalid"] label{border-color:var(--input-border-invalid)}
  .file-upload:has(input:disabled),.file-upload[data-preview-state="disabled"]{opacity:.64}.file-upload:has(input:disabled) label{cursor:not-allowed}
</style>
