---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "../styles/tokens/tokens.css";
import "../styles/global.css";
import GridVisualizer from "../components/_internal/dev/GridVisualizer.astro";
import ComponentInfoLayer from "../components/_internal/dev/ComponentInfoLayer.astro";
import ClipboardCopy from "../components/_internal/behaviors/ClipboardCopy.astro";
import SwitchButton from "../components/base-components/switch/SwitchButton.astro";

interface Props {
  title: string;
  description?: string;
  showGridVisualizer?: boolean;
  showComponentInfo?: boolean;
  mainClass?: string;
}

const {
  title,
  description = "Astro Starter provides a reusable, token-driven component system with operational documentation for people and AI.",
  showGridVisualizer = true,
  showComponentInfo = true,
  mainClass,
} = Astro.props;
const activePath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light" data-grid="visible" data-guides="visible">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={new URL(activePath, Astro.site)} />
    <title>{title}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("astro-ds-theme");
      document.documentElement.dataset.theme =
        storedTheme === "dark" || storedTheme === "light" ? storedTheme : "light";
      const storedGuides = localStorage.getItem("astro-ds-guides");
      const storedGrid = localStorage.getItem("astro-ds-grid");
      const guidesState = storedGuides === "hidden" || storedGuides === "visible"
        ? storedGuides
        : storedGrid === "hidden"
          ? "hidden"
          : "visible";
      document.documentElement.dataset.guides = guidesState;
      document.documentElement.dataset.grid = guidesState;
    </script>
  </head>
  <body>
    <div class="app">
      <div class="app__workspace">
        {showGridVisualizer && <GridVisualizer />}
        <main class:list={["main", mainClass]}>
          <slot />
        </main>
      </div>
    </div>
    {showComponentInfo && <ComponentInfoLayer />}
    {(showGridVisualizer || showComponentInfo) && (
      <div class="guides-toggle" data-grid-toggle>
        <SwitchButton
          label="Guides"
          aria-label="Disable guides"
          checked
          data-guides-switch
        />
      </div>
    )}
    <ClipboardCopy />

    <script>
      const runtimeWindow = window as Window & {
        __astroDsShellAbortController?: AbortController;
      };
      runtimeWindow.__astroDsShellAbortController?.abort();
      const shellAbortController = new AbortController();
      const shellSignal = shellAbortController.signal;
      runtimeWindow.__astroDsShellAbortController = shellAbortController;

      const root = document.documentElement;
      const guidesSwitches = document.querySelectorAll<HTMLInputElement>("[data-guides-switch]");
      const syncGuidesSwitch = () => {
        const isVisible = root.dataset.guides !== "hidden";
        guidesSwitches.forEach((guidesSwitch) => {
          guidesSwitch.checked = isVisible;
          guidesSwitch.setAttribute(
            "aria-label",
            isVisible ? "Disable guides" : "Enable guides"
          );
        });
      };
      const setGuidesState = (next: "visible" | "hidden") => {
        root.dataset.guides = next;
        root.dataset.grid = next;
        localStorage.setItem("astro-ds-guides", next);
        localStorage.setItem("astro-ds-grid", next);
        syncGuidesSwitch();
      };
      const isTypingContext = (event: KeyboardEvent) => {
        const element = event.target as HTMLElement | null;
        if (!element) return false;
        const tag = element.tagName.toLowerCase();
        return tag === "input" || tag === "textarea" || tag === "select" || element.isContentEditable;
      };
      syncGuidesSwitch();
      guidesSwitches.forEach((guidesSwitch) => {
        guidesSwitch.addEventListener(
          "change",
          () => {
            setGuidesState(guidesSwitch.checked ? "visible" : "hidden");
          },
          { signal: shellSignal }
        );
      });
      window.addEventListener(
        "keydown",
        (event) => {
          if (isTypingContext(event)) return;
          if (!(event.shiftKey && event.key.toLowerCase() === "g")) return;
          event.preventDefault();
          const next = root.dataset.guides === "hidden" ? "visible" : "hidden";
          setGuidesState(next);
        },
        { signal: shellSignal }
      );

    </script>

    <style>
      .guides-toggle {
        position: fixed;
        right: var(--size-16);
        bottom: var(--size-16);
        z-index: 1100;
        display: grid;
        place-items: center;
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-medium);
        padding: var(--size-8);
        background: var(--color-background-surface);
        box-shadow: var(--elevation-surface-floating);
      }

      .guides-toggle :global(.ds-switch-button__label) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        border: 0;
        margin: -1px;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
