---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "../styles/tokens/tokens.css";
import "../styles/global.css";
import GridVisualizer from "../components/_internal/dev/GridVisualizer.astro";
import ComponentInfoLayer from "../components/_internal/dev/ComponentInfoLayer.astro";
import ClipboardCopy from "../components/_internal/behaviors/ClipboardCopy.astro";
import SwitchLabel from "../components/base-components/switch/SwitchLabel.astro";

interface Props {
  title: string;
  description?: string;
  showGridVisualizer?: boolean;
  showComponentInfo?: boolean;
  showGuidesToggle?: boolean;
  mainClass?: string;
}

const {
  title,
  description = "Astro Starter provides a reusable, token-driven component system with operational documentation for people and AI.",
  showGridVisualizer = true,
  showComponentInfo = true,
  showGuidesToggle = true,
  mainClass,
} = Astro.props;
const activePath = Astro.url.pathname;
const developerToolsEnabled = import.meta.env.DEV || process.env.DOCS_ENABLED === "true";
const renderGridVisualizer = developerToolsEnabled && showGridVisualizer;
const renderComponentInfo = developerToolsEnabled && showComponentInfo;
const renderGuidesToggle = developerToolsEnabled
  && (renderGridVisualizer || renderComponentInfo)
  && showGuidesToggle;
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="system" data-grid="hidden" data-guides="hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(activePath, Astro.site)} />
    <title>{title}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("astro-ds-theme");
      const themePreference = storedTheme === "dark" || storedTheme === "light" || storedTheme === "system"
        ? storedTheme
        : "system";
      const resolvedTheme = themePreference === "system"
        ? window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light"
        : themePreference;
      document.documentElement.dataset.themePreference = themePreference;
      document.documentElement.dataset.theme = resolvedTheme;
      const storedGuides = localStorage.getItem("astro-ds-guides");
      const storedGrid = localStorage.getItem("astro-ds-grid");
      const guidesState = storedGuides === "hidden" || storedGuides === "visible"
        ? storedGuides
        : storedGrid === "visible"
          ? "visible"
          : "hidden";
      document.documentElement.dataset.guides = guidesState;
      document.documentElement.dataset.grid = guidesState;
    </script>
  </head>
  <body>
    <div class="app">
      <div class="app__workspace">
        {renderGridVisualizer && <GridVisualizer />}
        <main class:list={["main", mainClass]}>
          <slot />
        </main>
      </div>
    </div>
    {renderComponentInfo && <ComponentInfoLayer />}
    {renderGuidesToggle && (
      <div class="guides-toggle" data-grid-toggle>
        <SwitchLabel
          id="ds-guides-toggle"
          label="Guides"
          data-guides-switch
        />
      </div>
    )}
    <ClipboardCopy />

    <script>
      const runtimeWindow = window as Window & {
        __astroDsShellAbortController?: AbortController;
      };
      runtimeWindow.__astroDsShellAbortController?.abort();
      const shellAbortController = new AbortController();
      const shellSignal = shellAbortController.signal;
      runtimeWindow.__astroDsShellAbortController = shellAbortController;

      const root = document.documentElement;
      const guidesSwitches = document.querySelectorAll<HTMLInputElement>("[data-guides-switch]");
      const guidesButtons = document.querySelectorAll<HTMLButtonElement>("[data-guides-button]");
      const syncGuidesControls = () => {
        const isVisible = root.dataset.guides !== "hidden";
        guidesSwitches.forEach((guidesSwitch) => {
          guidesSwitch.checked = isVisible;
          guidesSwitch.setAttribute(
            "aria-label",
            isVisible ? "Disable guides" : "Enable guides"
          );
        });
        guidesButtons.forEach((guidesButton) => {
          guidesButton.setAttribute("aria-pressed", String(isVisible));
          guidesButton.setAttribute("aria-label", isVisible ? "Disable guides" : "Enable guides");
          const visibleIcon = guidesButton.querySelector("[data-guides-visible-icon]");
          const hiddenIcon = guidesButton.querySelector("[data-guides-hidden-icon]");
          visibleIcon?.toggleAttribute("hidden", !isVisible);
          hiddenIcon?.toggleAttribute("hidden", isVisible);
        });
      };
      const setGuidesState = (next: "visible" | "hidden") => {
        root.dataset.guides = next;
        root.dataset.grid = next;
        localStorage.setItem("astro-ds-guides", next);
        localStorage.setItem("astro-ds-grid", next);
        syncGuidesControls();
      };
      const isTypingContext = (event: KeyboardEvent) => {
        const element = event.target as HTMLElement | null;
        if (!element) return false;
        const tag = element.tagName.toLowerCase();
        return tag === "input" || tag === "textarea" || tag === "select" || element.isContentEditable;
      };
      syncGuidesControls();
      guidesSwitches.forEach((guidesSwitch) => {
        guidesSwitch.addEventListener(
          "change",
          () => {
            setGuidesState(guidesSwitch.checked ? "visible" : "hidden");
          },
          { signal: shellSignal }
        );
      });
      guidesButtons.forEach((guidesButton) => {
        guidesButton.addEventListener(
          "click",
          () => {
            const next = root.dataset.guides === "hidden" ? "visible" : "hidden";
            setGuidesState(next);
          },
          { signal: shellSignal }
        );
      });
      window.addEventListener(
        "keydown",
        (event) => {
          if (isTypingContext(event)) return;
          if (!(event.shiftKey && event.key.toLowerCase() === "g")) return;
          event.preventDefault();
          const next = root.dataset.guides === "hidden" ? "visible" : "hidden";
          setGuidesState(next);
        },
        { signal: shellSignal }
      );

    </script>

    <style>
      .guides-toggle {
        position: fixed;
        right: var(--size-16);
        bottom: var(--size-16);
        z-index: 1100;
        display: grid;
        place-items: center;
        border: var(--border-width-default) solid var(--color-border-subtle);
        border-radius: var(--radius-medium);
        padding: var(--size-8);
        background: var(--color-background-surface);
        box-shadow: var(--elevation-surface-floating);
      }

      .guides-toggle :global(.switch-label__text) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        border: 0;
        margin: -1px;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
      }
    </style>
  </body>
</html>
