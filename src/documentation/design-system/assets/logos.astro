---
import DesignSystemLayout from "../../../layouts/DesignSystemLayout.astro";
import DsIconGallery from "../../../components/_internal/documentation/DsIconGallery.astro";
import DsLogoCard from "../../../components/_internal/documentation/DsLogoCard.astro";
import DsLogoAssetPreview from "../../../components/_internal/documentation/DsLogoAssetPreview.astro";
import DsDocSection from "../../../components/_internal/documentation/DsDocSection.astro";
import DsCodeSnippet from "../../../components/_internal/documentation/DsCodeSnippet.astro";
import DsComponentRule from "../../../components/_internal/documentation/DsComponentRule.astro";
import { loadComponentRule } from "../../../data/componentRuleLoader";
import { logoRecords } from "../../../lib/logos/logoAssets";

const successToastId = "logo-copy-success";
const errorToastId = "logo-copy-error";
const logoAssetRule = await loadComponentRule(".agentic-rules/components/logo-asset.md");
const pageToc = [
  { label: "LogoAsset", href: "#logo-asset" },
  { label: "Catalog", href: "#logo-catalog" },
  { label: "Component UX rule", href: "#component-rule" },
];
const usageExample = `---
import LogoAsset from "../../components/assets/logos/LogoAsset.astro";
---

<div class="partner-logos">
  <LogoAsset slug="github" variant="full" alt="GitHub" />
  <LogoAsset slug="jitter" variant="full" alt="Jitter" />
  <a href="https://medium.com" aria-label="Visit Medium">
    <LogoAsset slug="medium" variant="full" alt="" />
  </a>
</div>

<style>
  .partner-logos > * { block-size: var(--partner-logo-size); }
  .partner-logos > a > :global([data-component-name="LogoAsset"]) {
    block-size: 100%;
  }
</style>`;
const apiExample = `interface Props extends SafeSpanAttributes {
  slug: string;
  variant: "mark" | "full";
  alt: string;
  loading?: "eager" | "lazy";
  class?: string;
}

// Deliberately unsupported: src, size, width, height, style`;
---

<DesignSystemLayout
  title="Logos - Astro Design System"
  pageType="asset-gallery"
  toc={pageToc}
  header={{
    eyebrow: "Assets",
    title: "Logos",
    summary: [{
      kind: "text",
      text: `Browse ${logoRecords.length} brands across ${logoRecords.reduce((count, logo) => count + logo.files.length, 0)} local SVG assets. Select a card to copy its brand name.`,
    }],
  }}
>
  <DsDocSection id="logo-asset" title="LogoAsset">
    <p>
      LogoAsset resolves an approved local mark or wordmark. The consuming component owns the
      wrapper height; the logo fills that box while preserving its natural proportions.
    </p>
    <DsLogoAssetPreview />
    <DsCodeSnippet filename="LogoAsset.astro" language="astro" code={usageExample} />
    <DsCodeSnippet label="Public API" language="typescript" code={apiExample} />
  </DsDocSection>

  <DsDocSection id="logo-catalog" title="Catalog">
    <DsIconGallery
      label="Search logos by brand"
      clearLabel="Clear logo search"
      placeholder="Search logos"
      emptyMessage="No logo matches this search."
      successToastId={successToastId}
      successToastTitle="Brand name copied"
      errorToastId={errorToastId}
      errorToastTitle="Brand name could not be copied"
      layout="wide"
    >
      {logoRecords.map((logo) => (
        <DsLogoCard
          id={`logo-${logo.slug}`}
          name={logo.name}
          slug={logo.slug}
          hasMark={Boolean(logo.mark)}
          hasFull={Boolean(logo.full)}
          copyLabel={`Copy ${logo.name} brand name`}
          searchKeywords={`${logo.name} ${logo.files.map((asset) => asset.fileName).join(" ")} logo brand`}
          successToastId={successToastId}
          errorToastId={errorToastId}
        />
      ))}
    </DsIconGallery>
  </DsDocSection>

  <DsComponentRule rule={logoAssetRule} />
</DesignSystemLayout>
