---
import DesignSystemLayout from "../../../../../layouts/DesignSystemLayout.astro";
import DsComponentDetail from "../../../../../components/_internal/documentation/DsComponentDetail.astro";
import {
  architecture,
  createDocumentationSummary,
  documentationFigmaHref,
  isActivePublicDocumentationComponent,
  resolveDocumentationPageMode,
  type ArchitectureComponent,
} from "../../../../../data/documentationRegistry";
import { loadComponentRule } from "../../../../../data/componentRuleLoader";
import {
  getComponentDocumentationAdapter,
} from "../../../../../data/documentationComponentRegistry";

export function getStaticPaths() {
  return architecture.components
    .filter(
      (component) =>
        component.categoryKey === "base-components" &&
        isActivePublicDocumentationComponent(component) &&
        resolveDocumentationPageMode(component.categoryKey, component.pageKey) === "multi",
    )
    .map((component) => ({
      params: { familyKey: component.pageKey, componentSlug: component.id },
      props: { component },
    }));
}

interface Props { component: ArchitectureComponent; }
const { component } = Astro.props;
const rule = component.agenticRule ? await loadComponentRule(component.agenticRule) : undefined;
const adapter = getComponentDocumentationAdapter(component.id);
const documentationToc = adapter?.toc ?? [];
const pageToc = [
  ...documentationToc,
  ...(!documentationToc.some((item) => item.href === "#dependencies")
    ? [{ label: "Dependencies", href: "#dependencies" }]
    : []),
  ...(rule ? [{ label: "Component Agentic Rules", href: "#component-rule" }] : []),
];
const figmaHref = documentationFigmaHref(component);
---

<DesignSystemLayout
  title={`${component.name} - Astro Design System`}
  pageType="component-detail"
  toc={pageToc}
  header={{
    eyebrow: `Base Components / ${component.pageLabel}`,
    title: component.name,
    summary: createDocumentationSummary(
      component.sourcePath
        ? "This canonical Astro component is documented from its implementation, registry identity and UX contract. Use"
        : "This canonical Figma identity intentionally exposes no fabricated Astro API or preview. Use",
      pageToc,
      component.sourcePath
        ? "to inspect its supported presentation, dependencies and usage rules."
        : "to verify the recorded identity, dependencies and implementation boundary.",
    ),
    copyValue: component.name,
    sourcePath: component.sourcePath ?? undefined,
    figmaHref,
  }}
>
  <DsComponentDetail
    component={component}
    rule={rule}
    adapter={adapter}
  />
</DesignSystemLayout>
