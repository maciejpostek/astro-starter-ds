---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/base-components/buttons/Button.astro";
import Eyebrow from "../components/base-components/eyebrow/Eyebrow.astro";
---

<BaseLayout title="Astro Design System Starter" mainClass="home-page">
  <section class="home-hero l-section" data-padding="none" data-theme="dark">
    <div class="l-container" data-container="main">
      <div class="l-grid" data-grid="site">
        <div class="home-hero__content l-stack" data-align="center" data-gap="medium">
          <Eyebrow text="Astro Starter" />
          <h1 class="heading-h1">
            Discover Astro Design System Starter documentation
          </h1>
          <Button
            variant="primary"
            size="large"
            onclick="window.location.assign('/design-system')"
          >
            Explore Design System
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.home-page) {
    padding-block-start: 0;
  }

  .home-hero {
    display: grid;
    min-block-size: 100svh;
    place-items: center;
    color: var(--color-text-primary);
    background: var(--color-background-canvas);
  }

  .home-hero__content {
    grid-column: 5 / 9;
    justify-items: center;
    text-align: center;
  }

  .home-hero__content :global(.eyebrow) {
    margin-block-end: 0;
  }

  @media (width < 48rem) {
    .home-hero__content {
      grid-column: 1 / -1;
    }
  }
</style>
