---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/_internal/documentation/SectionHeader.astro";
---

<BaseLayout title="Astro Design System Starter">
  <main class="starter">
    <SectionHeader
      eyebrow="Astro Design System"
      title="A clean family-first starter ready for canonical Figma components."
      variant="hero"
    />
    <p class="body-large-regular">
      The public component folders are intentionally empty. Build the library
      one approved Figma node at a time and track every mapping in the shared
      architecture manifest.
    </p>
    <a href="/design-system/base-components/buttons">Open the component catalog</a>
  </main>
</BaseLayout>

<style>
  .starter { display:grid; gap:var(--gap-large); max-width:72rem; padding:var(--section-padding-large) 0; }
  .starter p { max-width:64ch; color:var(--color-text-secondary); }
  .starter a { color:var(--color-text-link); font-weight:var(--font-weight-emphasis); }
</style>
