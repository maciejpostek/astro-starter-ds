---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsCodeSnippet from "../../components/design-system/DsCodeSnippet.astro";
import DsDocCard from "../../components/design-system/DsDocCard.astro";
import DsDocGrid from "../../components/design-system/DsDocGrid.astro";
import DsDocSection from "../../components/design-system/DsDocSection.astro";
import Logo from "../../components/atoms/media/Logo.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";
import {
  brandMarkBackgrounds,
  brandMarkFormats,
  brandMarkIntakeChecklist,
  brandMarkKinds,
  brandMarkRegistry,
  brandMarkTreatments,
} from "../../data/design-system/brandMarkContract";

const ownershipRules = [
  {
    title: "Project-owned artwork",
    text: "Source files, visual form, safe area, approved backgrounds, naming and usage rights come from populated project context.",
  },
  {
    title: "System-owned wrapper",
    text: "Logo owns one accessible image label, responsive intrinsic dimensions and the approved Default or Monochrome treatment.",
  },
  {
    title: "No starter brand",
    text: "The starter registry remains empty. Neutral documentation boundaries never become client, product or framework marks.",
  },
];

const agenticRules = [
  "Do not create or infer a project mark from starter initials, colors, product names, or example content.",
  "Accept only approved local files with recorded rights evidence and intrinsic dimensions.",
  "Prefer SVG for scalable marks; preserve a supplied PNG or WebP when certification or brand rules require it.",
  "Use the Logo wrapper for accessible naming and responsive placement.",
  "Apply monochrome only when the record explicitly permits that treatment.",
  "Keep nested artwork decorative because Logo owns the accessible name.",
  "Do not recolor, redraw, crop, distort, outline, animate, or combine supplied marks without explicit project approval.",
];
---

<BaseLayout title="Brand Marks - Astro Design System">
  <div class="page">
    <SectionHeader eyebrow="Assets" title="Brand Marks" variant="hero" />

    <DsDocSection
      id="brand-mark-status"
      title="Registry Status"
      description="The contract is ready, while the project-owned asset registry is intentionally empty until populated project context supplies approved artwork."
    >
      <div class="brand-mark-status">
        <strong>{brandMarkRegistry.length}</strong>
        <span>project-owned marks registered</span>
      </div>
    </DsDocSection>

    <DsDocSection
      id="brand-mark-ownership"
      title="Ownership Boundary"
      description="Code controls integration behavior. Project context controls the artwork, rights, and allowed visual treatments."
    >
      <DsDocGrid columns={3}>
        {
          ownershipRules.map((item) => (
            <DsDocCard title={item.title} text={item.text} />
          ))
        }
      </DsDocGrid>
    </DsDocSection>

    <DsDocSection
      id="brand-mark-taxonomy"
      title="Contract Taxonomy"
      description="The schema records only decisions required to select, validate, and render a supplied mark."
    >
      <div class="brand-mark-taxonomy">
        <dl>
          <div>
            <dt>Kinds</dt>
            <dd>{brandMarkKinds.join(", ")}</dd>
          </div>
          <div>
            <dt>Formats</dt>
            <dd>{brandMarkFormats.join(", ")}</dd>
          </div>
          <div>
            <dt>Backgrounds</dt>
            <dd>{brandMarkBackgrounds.join(", ")}</dd>
          </div>
          <div>
            <dt>Treatments</dt>
            <dd>{brandMarkTreatments.join(", ")}</dd>
          </div>
        </dl>
      </div>
    </DsDocSection>

    <DsDocSection
      id="brand-mark-wrapper"
      title="Logo Wrapper"
      description="The neutral fixture below demonstrates the integration boundary only. It is not a starter or project mark."
    >
      <div class="brand-mark-examples">
        <article>
          <h3>Default</h3>
          <Logo label="Supplied project mark">
            <span class="brand-mark-fixture" aria-hidden="true">
              SUPPLIED ARTWORK
            </span>
          </Logo>
        </article>
        <article>
          <h3>Monochrome, when approved</h3>
          <Logo label="Supplied project mark" variant="monochrome">
            <span class="brand-mark-fixture" aria-hidden="true">
              SUPPLIED ARTWORK
            </span>
          </Logo>
        </article>
      </div>
      <DsCodeSnippet
        label="Real public wrapper API"
        code={`<Logo label={brand.label} variant="default">
  <img src={brand.sourcePath} alt="" />
</Logo>`}
      />
    </DsDocSection>

    <DsDocSection
      id="brand-mark-intake"
      title="Intake Checklist"
      description="A record is not ready until every required source, rights, rendering, and parity field is evidenced."
    >
      <ol class="brand-mark-checklist">
        {brandMarkIntakeChecklist.map((item) => <li>{item}</li>)}
      </ol>
    </DsDocSection>

    <DsDocSection
      id="brand-mark-agentic-rules"
      title="Agentic Rules"
      description="Constraints that prevent a neutral starter from fabricating or misusing brand identity."
    >
      <ol class="brand-mark-rules">
        {agenticRules.map((rule) => <li>{rule}</li>)}
      </ol>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    min-width: 0;
  }

  .brand-mark-status {
    display: flex;
    align-items: baseline;
    gap: var(--gap-regular);
    border-left: var(--border-width-emphasis) solid var(--color-border-accent);
    padding: var(--component-padding-large);
    background: var(--color-background-subtle);
  }

  .brand-mark-status strong {
    color: var(--color-text-accent);
    font-family: var(--text-style-heading-h2-font-family);
    font-size: var(--text-style-heading-h2-font-size);
    line-height: var(--text-style-heading-h2-line-height);
  }

  .brand-mark-status span {
    color: var(--color-text-secondary);
  }

  .brand-mark-taxonomy dl,
  .brand-mark-taxonomy dl div {
    display: grid;
  }

  .brand-mark-taxonomy dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    border-left: var(--border-width-default) solid var(--color-border-subtle);
  }

  .brand-mark-taxonomy dl div {
    gap: var(--gap-small);
    border-right: var(--border-width-default) solid var(--color-border-subtle);
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
  }

  .brand-mark-taxonomy dt {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }

  .brand-mark-taxonomy dd {
    margin: 0;
    color: var(--color-text-primary);
  }

  .brand-mark-examples {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-large);
  }

  .brand-mark-examples article {
    display: grid;
    min-width: 0;
    place-items: center;
    gap: var(--gap-large);
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
  }

  .brand-mark-examples h3 {
    justify-self: start;
    margin: 0;
  }

  .brand-mark-fixture {
    display: inline-flex;
    min-height: var(--size-48);
    align-items: center;
    border: var(--border-width-default) dashed var(--color-border-accent);
    padding-inline: var(--component-padding-medium);
    color: var(--color-text-accent);
    font-family: var(--text-style-body-small-font-family);
    font-size: var(--text-style-body-small-font-size);
    line-height: var(--text-style-body-small-line-height);
  }

  .brand-mark-checklist,
  .brand-mark-rules {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--gap-regular);
    list-style: none;
    counter-reset: brand-mark-step;
  }

  .brand-mark-checklist li,
  .brand-mark-rules li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--gap-regular);
    padding: var(--component-padding-medium);
    background: var(--color-background-surface);
    counter-increment: brand-mark-step;
  }

  .brand-mark-checklist li::before,
  .brand-mark-rules li::before {
    content: counter(brand-mark-step, decimal-leading-zero);
    color: var(--color-text-accent);
    font-family: var(--text-style-code-font-family);
  }

  @media (width < 64rem) {
    .brand-mark-taxonomy dl,
    .brand-mark-examples {
      grid-template-columns: 1fr;
    }
  }
</style>
