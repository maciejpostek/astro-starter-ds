const sizingRules = [
  {
    name: "sizing.intent.order",
    title: "Start from intent",
    text: "Choose sizing values in this order: component attribute, component-based semantic token, global semantic token, primitive token. Do not start from raw pixels in component CSS.",
  },
  {
    name: "sizing.primitives.fixed",
    title: "Keep primitives fixed",
    text: "Primitive size tokens are the fixed rem scale. Use them to define the system, not as the default API for components or page layouts.",
  },
  {
    name: "sizing.semantic.global-vs-component",
    title: "Separate global and component-based semantics",
    text: "Use global semantic tokens when the name describes size only. Create component-based tokens only for repeated use cases that need one shared contract.",
  },
  {
    name: "sizing.spacing.roles",
    title: "Respect spacing roles",
    text: "Use padding for internal space, gap for distance between children, and space tokens for margins or vertical relationships between separate elements.",
  },
  {
    name: "sizing.attributes.api",
    title: "Expose repeatable component sizes through attributes",
    text: "Buttons, tags, inputs, tabs and labels should use data-component-size profiles before adding one-off sizing classes or local component overrides.",
  },
  {
    name: "sizing.radius.contracts",
    title: "Use radius contracts",
    text: "Use component-based radius tokens for repeated surfaces such as buttons, inputs, tabs, tags and labels. Use global radius tokens only when the surface is not component-specific.",
  },
  {
    name: "sizing.agentic-tooltip-context",
    title: "Document non-obvious component-based tokens",
    text: "Every component-based sizing token with a specific use case should include an Agentic Rule tooltip or matching Agentic Rule card so future agents know when to use it.",
  },
  {
    name: "sizing.documentation-components",
    title: "Use documentation components",
    text: "Sizing documentation tables should use the shared Design System table atoms and spacing blocks. Do not create local table layouts for new sizing sections.",
  },
  {
    name: "sizing.patch-global-first",
    title: "Patch globally first",
    text: "When a size rule affects multiple pages or components, update the token or master documentation component before adding local page CSS.",
  },
];
---

<BaseLayout title="Sizing - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Field 2"
      title="Sizing"
      variant="hero"
    />

    <DsDocSection
      id="sizing-primitive-tokens"
      title="Sizing Primitives"
      description="Primitive size tokens encode pixel-equivalent values as rem variables. They are the source scale for semantic sizing tokens and dimension decisions such as width, height, min-width, max-width, min-height and max-height."
    >
        <section
          id="sizing-primitive-size-scale"
          class="ds-sizing-topic"
          aria-labelledby="sizing-primitive-size-scale-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-primitive-size-scale-title"
            title="Primitive size tokens"
            description="The fixed reference scale used to build semantic tokens and width/height decisions across the system."
          />

          <DsSpacingBlock
            name="Primitive size tokens"
            description="The fixed reference scale used to build semantic tokens and width/height decisions across the system."
            rows={primitiveSizeRows}
            showHeader={false}
          />
        </section>
    </DsDocSection>

    <DsDocSection
      id="sizing-semantic-tokens"
      title="Sizing Semantic"
      description="Semantic sizing tokens translate primitive values into intent. Each group separates global size-based tokens from component-based contracts when a repeated use case needs a stable name."
    >
        <section
          id="sizing-semantic-component-padding"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-component-padding-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-component-padding-title"
            title="Component padding"
            description="Inner spacing inside cards, panels, controls and composed components. Padding tokens describe space inside an element, not distance between children or external margins."
          />

          <DsSpacingBlock
            name="Component padding"
            description="Reusable internal padding for cards, panels, controls and composed components."
            rows={componentPaddingRows}
            showHeader={false}
          />
        </section>

        <section
          id="sizing-semantic-section-padding"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-section-padding-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-section-padding-title"
            title="Section padding"
            description="Vertical padding inside page sections and major content zones. These tokens define section rhythm without acting as child gaps or component margins."
          />

          <DsSpacingBlock
            name="Section padding"
            description="Vertical padding used to separate page sections and major content zones."
            rows={sectionPaddingRows}
            showHeader={false}
          />
        </section>

        <section
          id="sizing-semantic-gap"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-gap-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-gap-title"
            title="Gap"
            description="Gap tokens define distance between children on a flex, grid or inline parent. Global gaps describe size only; component-based gaps cover repeated groups such as buttons, tags and form fields."
          />

          <div class="ds-sizing-subsections">
            <section aria-labelledby="sizing-semantic-gap-global-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-gap-global-title"
                title="Global"
                description="Use global gap tokens when the spacing decision is only about size and is not dedicated to one component or use case."
              />

              <DsSpacingBlock
                name="Global gap tokens"
                description="Generic gap values for flex, grid and inline groups."
                rows={globalGapRows}
                showHeader={false}
              />
            </section>

            <section aria-labelledby="sizing-semantic-gap-component-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-gap-component-title"
                title="Component-based"
                description="Use component-based gap tokens for repeated parent-child group patterns that need one shared contract across the system."
              />

              <DsSpacingBlock
                name="Component gap tokens"
                description="Gap values tied to repeated component group patterns."
                rows={componentGapRows}
                showHeader={false}
              />
            </section>
          </div>
        </section>

        <section
          id="sizing-semantic-space"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-space-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-space-title"
            title="Space"
            description="Space tokens define margin and block flow between elements. Global spaces describe reusable margin sizes; component-based spaces cover critical repeated relationships such as eyebrow-to-heading or section-header-to-content."
          />

          <div class="ds-sizing-subsections">
            <section aria-labelledby="sizing-semantic-space-global-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-space-global-title"
                title="Global"
                description="Use global space tokens for margins and vertical flow when the spacing decision is only about size."
              />

              <DsSpacingBlock
                name="Global space tokens"
                description="Generic margin and block-flow values."
                rows={globalSpaceRows}
                showHeader={false}
              />
            </section>

            <section aria-labelledby="sizing-semantic-space-component-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-space-component-title"
                title="Component-based"
                description="Use component-based space tokens for repeated margin relationships that need exact shared control."
              />

              <DsSpacingBlock
                name="Component space tokens"
                description="Margin values tied to repeated layout relationships."
                rows={componentSpaceRows}
                showHeader={false}
              />
            </section>
          </div>
        </section>

        <section
          id="sizing-semantic-radius"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-radius-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-radius-title"
            title="Radius"
            description="Radius tokens describe surface shape. Global radius tokens describe generic corner sizes; component-based radius tokens lock repeated UI surfaces to one shared shape contract."
          />

          <div class="ds-sizing-subsections">
            <section aria-labelledby="sizing-semantic-radius-global-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-radius-global-title"
                title="Global"
                description="Use global radius tokens when the decision is only about corner size and is not dedicated to one component."
              />

              <DsSpacingBlock
                name="Global radius tokens"
                description="Generic corner-radius values."
                rows={globalRadiusRows}
                showHeader={false}
              />
            </section>

            <section aria-labelledby="sizing-semantic-radius-component-title">
              <DsSectionHeaderLevel4
                id="sizing-semantic-radius-component-title"
                title="Component-based"
                description="Use component-based radius tokens for repeated component surfaces that need one shared shape rule."
              />

              <DsSpacingBlock
                name="Component radius tokens"
                description="Radius values tied to repeated component surfaces."
                rows={componentRadiusRows}
                showHeader={false}
              />
            </section>
          </div>
        </section>

        <section
          id="sizing-semantic-border"
          class="ds-sizing-topic"
          aria-labelledby="sizing-semantic-border-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-semantic-border-title"
            title="Border"
            description="Border-width tokens describe stroke thickness. Use default for standard dividers and strong only for deliberate emphasis or focus treatments."
          />

          <DsSpacingBlock
            name="Border"
            description="Shared border widths. Default is the primary layout stroke; strong is reserved for focus states."
            rows={borderRows}
            showHeader={false}
          />
        </section>
    </DsDocSection>

    <DsDocSection
      id="sizing-attributes"
      title="Component Size"
      description="Size attributes are the component sizing API. They connect semantic variables to repeatable component geometry through stable attributes such as data-component-size."
    >
        <section
          id="sizing-size-attributes"
          class="ds-sizing-topic"
          aria-labelledby="sizing-size-attributes-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-size-attributes-title"
            title="Component size attributes"
            description="Buttons, tags, inputs, tabs and labels should use the same size profiles where possible. The attribute maps profile tokens onto internal aliases such as --component-padding-inline, while this table documents the public attribute, source token and final values."
          />

          <DsAttributeBlock groups={sizeAttributeProfiles} />
        </section>
    </DsDocSection>

    <DsDocSection
      id="sizing-agentic-rules"
      title="Agentic Rules"
      description="Rules for future agents and contributors working with sizing tokens, styles and documentation."
    >
        <section
          id="sizing-agentic-rules-list"
          class="ds-sizing-topic"
          aria-labelledby="sizing-agentic-rules-list-title"
        >
          <DsSectionHeaderLevel3
            id="sizing-agentic-rules-list-title"
            title="Agentic sizing rules"
            description="Default decision order for choosing or changing size values."
          />

          <DsDocGrid columns={2}>
            {
              sizingRules.map((rule) => (
                <DsDocCard
                  agenticRuleName={rule.name}
                  eyebrow="Agentic Rule"
                  title={rule.title}
                  text={rule.text}
                />
              ))
            }
          </DsDocGrid>
        </section>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .ds-sizing-subsections {
    display: grid;
    gap: var(--section-padding-small);
  }

  .ds-sizing-topic {
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    padding-block: var(--section-padding-small);
    scroll-margin-top: var(--ds-doc-anchor-offset, 0px);
  }

  .ds-sizing-topic > :global(.ds-section-header-level-3:first-child),
  .ds-sizing-subsections > :global(section > .ds-section-header-level-4:first-child) {
    margin-top: 0;
  }

  .ds-sizing-subsections > :global(section) {
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    padding-top: var(--section-padding-small);
    scroll-margin-top: var(--ds-doc-anchor-offset, 0px);
  }

</style>
