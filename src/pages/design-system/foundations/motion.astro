---
import DesignSystemLayout from "../../../layouts/DesignSystemLayout.astro";
import DsCodeSnippet from "../../../components/_internal/documentation/DsCodeSnippet.astro";
import DsDocSection from "../../../components/_internal/documentation/DsDocSection.astro";
import DsMotionTokenGroups from "../../../components/_internal/documentation/DsMotionTokenGroups.astro";
import {
  motionFoundationGroups,
  motionSemanticGroups,
} from "../../../data/design-system/motionTokens";
import {
  documentationFoundationHeader,
  documentationFoundationToc,
} from "../../../data/documentationFoundationRegistry";
import motionAgenticRules from "../../../../.agentic-rules/06-motion.md?raw";

const foundationHeader = documentationFoundationHeader("motion");
---

<DesignSystemLayout
  title="Motion - Astro Design System"
  pageType="foundation"
  toc={documentationFoundationToc("motion")}
  header={foundationHeader}
>
    <DsDocSection
      id="motion-foundation-tokens"
      title="Motion Foundations"
    >
      <DsMotionTokenGroups groups={motionFoundationGroups} label="foundation tokens" />
    </DsDocSection>

    <DsDocSection
      id="motion-semantic-tokens"
      title="Motion Semantic"
    >
      <DsMotionTokenGroups groups={motionSemanticGroups} label="semantic tokens" />
    </DsDocSection>

    <DsDocSection
      id="motion-reduced-mode"
      title="Reduced Motion"
    >
      <DsCodeSnippet
        label="Reduced Motion contract"
        language="css"
        code={`@media (prefers-reduced-motion: reduce) {
  :root {
    --motion-duration-fast: 0ms;
    --motion-duration-disclosure: 0ms;
    --motion-transition: 0ms var(--motion-ease-standard);
  }
}`}
      />
    </DsDocSection>

    <DsDocSection
      id="motion-agentic-rules"
      title="Agentic Rules"
    >
      <DsCodeSnippet
        filename=".agentic-rules/06-motion.md"
        language="markdown"
        code={motionAgenticRules.trim()}
      />
    </DsDocSection>

</DesignSystemLayout>

<style>
  .ds-motion-rules {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--gap-regular);
    list-style: none;
  }

  .ds-motion-rules li {
    display: grid;
    gap: var(--gap-tiny);
    border-left: var(--border-width-emphasis) solid var(--color-border-accent);
    padding: var(--content-padding-medium);
    background: var(--color-background-surface);
  }

  .ds-motion-rules span {
    color: var(--color-text-secondary);
  }
</style>
