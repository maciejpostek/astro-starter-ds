type ColorRow = {
  token: string;
  value: string;
  lightValue?: string;
  darkValue?: string;
  sampleValue?: string;
  sampleSurfaceValue?: string;
  sampleType?: "fill" | "border" | "text";
  label?: string;
};

const parseModeValue = (value: string) => {
  const splitModeMatch = value.match(/^light:\s*(.+?)\s*\/\s*dark:\s*(.+)$/);
  const sharedModeMatch = value.match(/^light\/dark:\s*(.+)$/);

  if (splitModeMatch) {
    return {
      lightValue: splitModeMatch[1],
      darkValue: splitModeMatch[2],
    };
  }

  if (sharedModeMatch) {
    return {
      lightValue: sharedModeMatch[1],
      darkValue: sharedModeMatch[1],
    };
  }

  return {};
};

const tokenSample = (
  token: string,
  value: string,
  sampleType: ColorRow["sampleType"] = "fill",
  label?: string,
): ColorRow => ({
  token,
  value,
  ...parseModeValue(value),
  sampleType,
  sampleValue: `var(${token})`,
  sampleSurfaceValue: resolveDocumentationColorSampleSurface(token),
  label,
});
const foundationHeader = documentationFoundationHeader("color");

