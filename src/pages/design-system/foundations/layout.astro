---
import DesignSystemLayout from "../../../layouts/DesignSystemLayout.astro";
import DsCodeSnippet from "../../../components/_internal/documentation/DsCodeSnippet.astro";
import DsDocGrid from "../../../components/_internal/documentation/DsDocGrid.astro";
import DsDocSection from "../../../components/_internal/documentation/DsDocSection.astro";
import DsLayoutPreview from "../../../components/_internal/documentation/DsLayoutPreview.astro";
import DsResponsiveStrategyReference from "../../../components/_internal/documentation/DsResponsiveStrategyReference.astro";
import DsTableCell from "../../../components/_internal/documentation/DsTableCell.astro";
import DsTableCopyCell from "../../../components/_internal/documentation/DsTableCopyCell.astro";
import DsTableFrame from "../../../components/_internal/documentation/DsTableFrame.astro";
import DsTableRow from "../../../components/_internal/documentation/DsTableRow.astro";
import DsSectionHeaderLevel3 from "../../../components/_internal/documentation/DsSectionHeaderLevel3.astro";
import {
  documentationFoundationHeader,
  documentationFoundationToc,
} from "../../../data/documentationFoundationRegistry";
import {
  documentationTokenMap,
  getDocumentationResolvedValue,
  getDocumentationTokenValue,
} from "../../../data/documentationTokenRegistry";
import {
  layoutAttributeRows,
  layoutGridAttributeRows,
  layoutGridExamples,
  layoutFoundationGroups,
  layoutSemanticGroups,
  layoutStructureExamples,
  layoutStyleRows,
} from "../../../data/design-system/layoutTokens";
import layoutAgenticRules from "../../../../.agentic-rules/04-layout.md?raw";

const canonicalLayoutToken = (tokenName: string, fallback: string, resolved = false) => {
  const token = documentationTokenMap.get(tokenName);
  if (!token) return fallback;
  return resolved ? getDocumentationResolvedValue(token) : getDocumentationTokenValue(token);
};
const foundationHeader = documentationFoundationHeader("layout");
---

<DesignSystemLayout
  title="Layout - Astro Design System"
  pageType="foundation"
  toc={documentationFoundationToc("layout")}
  header={foundationHeader}
>
    <DsDocSection
      id="layout-primitive-foundations"
      title="Layout Foundations"
    >
      {
        layoutFoundationGroups.map((group) => (
          <section
            id={group.id}
            class="ds-layout-topic"
            aria-labelledby={`${group.id}-title`}
          >
            <DsSectionHeaderLevel3
              id={`${group.id}-title`}
              title={group.title}
            />

            <DsTableFrame
              label={`${group.title} layout foundation tokens`}
              minWidth="84rem"
              columns="minmax(var(--ds-doc-table-token-column-min-width), 24fr) minmax(18rem, 22fr) minmax(16rem, 18fr) minmax(28rem, 36fr)"
              size="tiny"
            >
              <DsTableRow variant="header">
                <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Resolved value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
              </DsTableRow>

              {
                group.rows.map((row) => (
                  <DsTableRow>
                    <DsTableCopyCell role="cell" value={row.token} />
                    <DsTableCell role="cell" tone="secondary">
                      <code>{canonicalLayoutToken(row.token, row.value)}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <code>{canonicalLayoutToken(row.token, row.resolvedValue, true)}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <span>{row.role}</span>
                    </DsTableCell>
                  </DsTableRow>
                ))
              }
            </DsTableFrame>
          </section>
        ))
      }
    </DsDocSection>

    <DsDocSection
      id="layout-semantic-variables"
      title="Layout Semantic"
    >
      {
        layoutSemanticGroups.map((group) => (
          <section
            id={group.id}
            class="ds-layout-topic"
            aria-labelledby={`${group.id}-title`}
          >
            <DsSectionHeaderLevel3
              id={`${group.id}-title`}
              title={group.title}
            />

            <DsTableFrame
              label={`${group.title} layout semantic tokens`}
              minWidth="96rem"
              columns="minmax(var(--ds-doc-table-token-column-min-width), 22fr) minmax(24rem, 26fr) minmax(20rem, 22fr) minmax(30rem, 30fr)"
              size="tiny"
            >
              <DsTableRow variant="header">
                <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Resolved value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
              </DsTableRow>

              {
                group.rows.map((row) => (
                  <DsTableRow>
                    <DsTableCopyCell role="cell" value={row.token} />
                    <DsTableCell role="cell" tone="secondary">
                      <code>{canonicalLayoutToken(row.token, row.value)}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <code>{canonicalLayoutToken(row.token, row.resolvedValue, true)}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <span>{row.role}</span>
                    </DsTableCell>
                  </DsTableRow>
                ))
              }
            </DsTableFrame>
          </section>
        ))
      }
    </DsDocSection>

    <DsDocSection
      id="layout-responsive-strategy"
      title="Responsive strategy"
    >
      <DsResponsiveStrategyReference />
    </DsDocSection>

    <DsDocSection
      id="layout-grid-system"
      title="Grid system"
    >
      <section
        id="layout-grid-visuals"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-visuals-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-visuals-title"
          title="Grid visuals"
        />

        <DsDocGrid columns={2}>
          <DsLayoutPreview variant="grid" label="Site grid: 12 content columns" />
          <DsLayoutPreview variant="breakout" label="Breakout grid: edge tracks + content columns" />
        </DsDocGrid>
      </section>

      <section
        id="layout-grid-attributes"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-attributes-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-attributes-title"
          title="Grid attributes"
        />

        <DsTableFrame
          label="Grid attributes"
          minWidth="138rem"
          columns="minmax(16rem, 14fr) minmax(18rem, 15fr) minmax(28rem, 24fr) minmax(14rem, 11fr) minmax(28rem, 23fr) minmax(34rem, 28fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Selector</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Attribute</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutGridAttributeRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={row.selector} />
                <DsTableCopyCell role="cell" value={row.attribute} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.defaultValue}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>

      <section
        id="layout-grid-examples"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-examples-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-examples-title"
          title="Grid examples"
        />

        {
          layoutGridExamples.map((example) => (
            <DsCodeSnippet
              label={example.label}
              language={example.language}
              code={example.code}
            />
          ))
        }
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-styles"
      title="Styles"
    >
      <section
        id="layout-styles-classes"
        class="ds-layout-topic"
        aria-labelledby="layout-styles-classes-title"
      >
        <DsSectionHeaderLevel3
          id="layout-styles-classes-title"
          title="Layout classes"
        />

        <DsTableFrame
          label="Layout classes"
          minWidth="150rem"
          columns="minmax(14rem, 10fr) minmax(18rem, 14fr) minmax(10rem, 8fr) minmax(56rem, 42fr) minmax(22rem, 16fr) minmax(30rem, 22fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Class</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Display</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutStyleRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={`.${row.className}`} />
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.role}</span>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.display}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-attributes"
      title="Attributes"
    >
      <section
        id="layout-attributes-list"
        class="ds-layout-topic"
        aria-labelledby="layout-attributes-list-title"
      >
        <DsSectionHeaderLevel3
          id="layout-attributes-list-title"
          title="Layout attributes"
        />

        <DsTableFrame
          label="Layout attributes"
          minWidth="132rem"
          columns="minmax(14rem, 13fr) minmax(16rem, 14fr) minmax(28rem, 24fr) minmax(14rem, 12fr) minmax(28rem, 24fr) minmax(32rem, 27fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Class</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Attribute</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutAttributeRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={`.${row.className}`} />
                <DsTableCopyCell role="cell" value={row.attribute} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.defaultValue}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-structure-examples"
      title="Layout structure examples"
    >
      <section
        id="layout-structure-examples-list"
        class="ds-layout-topic"
        aria-labelledby="layout-structure-examples-title"
      >
        <DsSectionHeaderLevel3
          id="layout-structure-examples-title"
          title="Layout structure examples"
        />

        {
          layoutStructureExamples.map((example) => (
            <DsCodeSnippet
              label={example.label}
              language={example.language}
              code={example.code}
            />
          ))
        }
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-agentic-rules"
      title="Agentic Rules"
    >
      <DsCodeSnippet
        filename=".agentic-rules/04-layout.md"
        language="markdown"
        code={layoutAgenticRules.trim()}
      />
    </DsDocSection>
</DesignSystemLayout>

<style>
  .ds-layout-topic {
    display: grid;
    gap: var(--gap-xlarge);
  }

</style>
