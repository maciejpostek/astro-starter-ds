---
import DesignSystemLayout from "../../../../layouts/DesignSystemLayout.astro";
import DsComponentDetail from "../../../../components/_internal/documentation/DsComponentDetail.astro";
import {
  architecture,
  componentsByPage,
  createDocumentationSummary,
  documentationComponentHref,
  documentationFigmaHref,
  resolveDocumentationNavigationMode,
  resolveDocumentationPageMode,
  type ArchitecturePage,
} from "../../../../data/documentationRegistry";
import { loadComponentRule } from "../../../../data/componentRuleLoader";
import { getComponentDocumentationAdapter } from "../../../../data/documentationComponentRegistry";

export function getStaticPaths() {
  return architecture.pages
    .filter(
      (page) =>
        page.categoryKey === "base-components" &&
        page.documentationVisible !== false,
    )
    .map((page) => ({ params: { familyKey: page.pageKey }, props: { page } }));
}

interface Props { page: ArchitecturePage; }
const { page } = Astro.props;
const components = componentsByPage.get(`base-components/${page.pageKey}`) ?? [];
const pageMode = resolveDocumentationPageMode("base-components", page.pageKey);
const navigationMode = resolveDocumentationNavigationMode("base-components", page.pageKey);
const firstComponent = components[0];
const firstComponentHref = firstComponent
  ? documentationComponentHref(firstComponent)
  : undefined;

if (navigationMode === "disclosure") {
  if (!firstComponentHref) throw new Error(`Disclosure family ${page.pageKey} has no public components.`);
  return Astro.redirect(firstComponentHref);
}

const isSingleton = pageMode === "singleton";
const component = isSingleton ? components[0] : undefined;
const componentRule = component?.agenticRule
  ? await loadComponentRule(component.agenticRule)
  : undefined;
const componentAdapter = component
  ? getComponentDocumentationAdapter(component.id)
  : undefined;
const documentationToc = componentAdapter?.toc ?? [];
const componentToc = [
  ...documentationToc,
  ...(!documentationToc.some((item) => item.href === "#dependencies")
    ? [{ label: "Dependencies", href: "#dependencies" }]
    : []),
  ...(componentRule ? [{ label: "Component UX rule", href: "#component-rule" }] : []),
];
const pageToc = component ? componentToc : [];
---

<DesignSystemLayout
  title={component
    ? `${component.name} - Astro Design System`
    : `${page.pageLabel} - Base Components`}
  pageType={component ? "component-detail" : "reading"}
  toc={pageToc}
  header={component
    ? {
        eyebrow: "Base Components",
        title: component.name,
        summary: createDocumentationSummary(
          component.sourcePath
            ? "This canonical Astro component is documented from its implementation, registry identity and UX contract. Use"
            : "This canonical Figma identity intentionally exposes no fabricated Astro API or preview. Use",
          pageToc,
          component.sourcePath
            ? "to inspect its supported presentation, dependencies and usage rules."
            : "to verify the recorded identity, dependencies and implementation boundary.",
        ),
        copyValue: component.name,
        sourcePath: component.sourcePath ?? undefined,
        figmaHref: documentationFigmaHref(component),
      }
    : {
        title: page.pageLabel,
        summary: [],
      }}
>
  {component && (
    <DsComponentDetail
      component={component}
      rule={componentRule}
      adapter={componentAdapter}
    />
  )}
</DesignSystemLayout>
