---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsDocSection from "../../components/design-system/DsDocSection.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";
import ArchitectureExplorer from "../../components/design-system/architecture/ArchitectureExplorer";
import systemMap from "../../../architecture/system-map.json";

const aiNativeTargetDiagramUrl =
  "/architecture/generated/ai-native-target-architecture.svg?v=runtime-v1";
const aiNativeTargetDataUrl =
  "/architecture/views/ai-native-target-architecture.json";
const promptToAstroDiagramUrl =
  "/architecture/generated/prompt-to-astro-page-section.svg?v=prompt-flow-v1";
const targetArchitectureView = systemMap.views.find(
  (view) => view.id === "view.ai-native-target-architecture"
);
const targetStages =
  targetArchitectureView &&
  "presentation" in targetArchitectureView &&
  targetArchitectureView.presentation
    ? targetArchitectureView.presentation.stages
    : [];

const architectureLegend = [
  { type: "prompt", label: "Prompt / input" },
  { type: "actor", label: "Actor" },
  { type: "router", label: "Router" },
  { type: "decision", label: "Decision gate" },
  { type: "process", label: "Process" },
  { type: "source", label: "Source of Truth" },
  { type: "validator", label: "Validator" },
  { type: "approval", label: "Human approval" },
  { type: "output", label: "Output" }
];
---

<BaseLayout title="System Architecture Map - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Architecture"
      title="System Architecture Map"
      variant="hero"
    />

    <DsDocSection
      id="system-architecture-ai-native-target"
      title="AI-Native Runtime V1.0"
      description="Implemented reuse-first runtime. Every normal request follows Classify → Resolve Context → Execute → Validate → Result, while component creation, brand interpretation, Figma, and evals remain conditional side mechanisms."
    >
      <figure
        class="ds-architecture-diagram"
        aria-labelledby="ai-native-target-diagram-caption"
      >
        <div class="ds-architecture-diagram__header">
          <figcaption id="ai-native-target-diagram-caption">
            <span class="caption">Implemented architecture · L0 system and agent flow</span>
            <p>
              The upper lane contains the five real runtime stages. The lower
              lane contains mechanisms that activate only under a specific
              condition or between runs: Creation Gate, Brand Activation,
              Explicit Figma, and the Eval Harness.
            </p>
          </figcaption>

          <a
            class="ds-architecture-diagram__full-size-link"
            href={aiNativeTargetDiagramUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open full-size SVG
          </a>
        </div>

        <ul
          class="ds-architecture-diagram__legend"
          aria-label="Architecture node type legend"
        >
          {architectureLegend.map((item) => (
            <li data-node-type={item.type}>
              <span aria-hidden="true"></span>
              {item.label}
            </li>
          ))}
        </ul>

        <ArchitectureExplorer
          client:visible
          dataUrl={aiNativeTargetDataUrl}
          fallbackSvgUrl={aiNativeTargetDiagramUrl}
        />

        <noscript>
          <ol class="ds-architecture-diagram__fallback-stages">
            {targetStages.map((stage) => (
              <li>
                <strong>{stage.number} · {stage.title}</strong>
                <span>{stage.description}</span>
              </li>
            ))}
          </ol>
          <div class="ds-architecture-diagram__viewport" data-layout="canvas">
            <a
              href={aiNativeTargetDiagramUrl}
              target="_blank"
              rel="noreferrer"
              aria-label="Open the AI-Native Design System V1.0 Runtime diagram at full size"
            >
              <img
                src={aiNativeTargetDiagramUrl}
                width="7686"
                height="5547"
                alt="Implemented AI-Native Design System V1.0 architecture showing five core runtime stages and conditional Creation Gate, Brand Activation, Explicit Figma, and Eval Harness mechanisms."
                loading="eager"
                decoding="async"
              />
            </a>
          </div>
        </noscript>

        <p class="ds-architecture-diagram__references">
          Reference basis:
          <a href="https://developers.openai.com/api/docs/guides/agents/orchestration">OpenAI orchestration</a>,
          <a href="https://developers.openai.com/api/docs/guides/agents/guardrails-approvals">guardrails and human review</a>,
          <a href="https://developers.openai.com/api/docs/guides/agent-evals">agent evals</a>,
          <a href="https://www.anthropic.com/engineering/building-effective-agents">Anthropic effective agents</a>,
          and
          <a href="https://www.anthropic.com/engineering/effective-context-engineering-for-ai-agents">context engineering</a>.
        </p>
      </figure>
    </DsDocSection>

    <DsDocSection
      id="system-architecture-prompt-to-astro"
      title="Prompt → Astro Page or Section"
      description="Implemented reuse-first composition flow from a prompt through focused component lookup, optional approved brand rules, Astro composition, scoped validation, and an accepted or blocked result."
    >
      <figure
        class="ds-architecture-diagram"
        aria-labelledby="prompt-to-astro-diagram-caption"
      >
        <div class="ds-architecture-diagram__header">
          <figcaption id="prompt-to-astro-diagram-caption">
            <span class="caption">Implemented runtime · L1 composition flow</span>
            <p>
              Named components are reused by default. Brand context activates
              only when the composition requires a visual decision, and failed
              validation enters a bounded repair loop before returning a
              terminal result.
            </p>
          </figcaption>

          <a
            class="ds-architecture-diagram__full-size-link"
            href={promptToAstroDiagramUrl}
            target="_blank"
            rel="noreferrer"
          >
            Open full-size SVG
          </a>
        </div>

        <ul
          class="ds-architecture-diagram__legend"
          aria-label="Architecture node type legend"
        >
          {architectureLegend.map((item) => (
            <li data-node-type={item.type}>
              <span aria-hidden="true"></span>
              {item.label}
            </li>
          ))}
        </ul>

        <div class="ds-architecture-diagram__viewport">
          <a
            href={promptToAstroDiagramUrl}
            target="_blank"
            rel="noreferrer"
            aria-label="Open the Prompt to Astro Page or Section architecture diagram at full size"
          >
            <img
              src={promptToAstroDiagramUrl}
              width="5178"
              height="923"
              alt="Reuse-first flow from a prompt through classification, focused context, Astro composition, conditional brand activation, scoped validation, bounded repair, and accepted or blocked output."
              loading="eager"
              decoding="async"
            />
          </a>
        </div>
      </figure>
    </DsDocSection>

    <DsDocSection
      id="system-architecture-figma-mcp-to-astro"
      title="Figma MCP → Astro"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-component-lifecycle"
      title="Component Creation and Repair Lifecycle"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-brand-activation"
      title="Brand Expression and Art Direction Activation"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-astro-figma-sync"
      title="Astro ↔ Figma Synchronization"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-sources-of-truth"
      title="Sources of Truth"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-atomic-dependencies"
      title="Atomic Design Dependencies"
    >
    </DsDocSection>

    <DsDocSection
      id="system-architecture-project-fork"
      title="Project Fork and Duplicated Figma File"
    >
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .ds-architecture-diagram {
    display: grid;
    min-width: 0;
    gap: var(--gap-medium);
    margin: 0;
  }

  .ds-architecture-diagram__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--gap-medium);
  }

  .ds-architecture-diagram figcaption {
    display: grid;
    max-width: var(--container-small);
    gap: var(--gap-small);
  }

  .ds-architecture-diagram figcaption p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-small);
    line-height: var(--line-height-normal);
  }

  .ds-architecture-diagram__full-size-link {
    flex: none;
    padding-block: var(--component-padding-tiny);
    border-bottom: var(--border-width-default) solid var(--color-border-accent);
    color: var(--color-text-accent);
    font-size: var(--font-size-body-small);
    font-weight: var(--font-weight-emphasis);
  }

  .ds-architecture-diagram__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-small) var(--gap-medium);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-compact);
    list-style: none;
  }

  .ds-architecture-diagram__legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-tiny);
  }

  .ds-architecture-diagram__legend span {
    display: inline-block;
    width: var(--size-16);
    height: var(--size-12);
    border: var(--border-width-default) solid var(--color-border-strong);
    background: var(--color-background-subtle);
  }

  .ds-architecture-diagram__legend [data-node-type="prompt"] span,
  .ds-architecture-diagram__legend [data-node-type="output"] span {
    clip-path: polygon(16% 0, 100% 0, 84% 100%, 0 100%);
  }

  .ds-architecture-diagram__legend [data-node-type="actor"] span {
    border-radius: var(--radius-full) var(--radius-full) var(--radius-small) var(--radius-small);
    background: var(--color-status-info-background);
  }

  .ds-architecture-diagram__legend [data-node-type="router"] span,
  .ds-architecture-diagram__legend [data-node-type="validator"] span {
    clip-path: polygon(22% 0, 78% 0, 100% 50%, 78% 100%, 22% 100%, 0 50%);
  }

  .ds-architecture-diagram__legend [data-node-type="decision"] span,
  .ds-architecture-diagram__legend [data-node-type="approval"] span {
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    background: var(--color-status-warning-background);
  }

  .ds-architecture-diagram__legend [data-node-type="process"] span {
    border-radius: var(--radius-small);
    background: var(--color-background-accent);
  }

  .ds-architecture-diagram__legend [data-node-type="source"] span {
    border-radius: 50%;
    background: var(--color-status-success-background);
  }

  .ds-architecture-diagram__legend [data-node-type="output"] span {
    background: var(--color-status-success-background);
  }

  .ds-architecture-diagram__viewport {
    position: relative;
    z-index: 26;
    min-width: 0;
    overflow-x: auto;
    border: var(--border-width-default) solid var(--color-border-subtle);
    background: var(--color-neutral-0);
    overscroll-behavior-inline: contain;
  }

  .ds-architecture-diagram__viewport a {
    display: block;
    width: 100%;
  }

  .ds-architecture-diagram__viewport img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ds-architecture-diagram__viewport[data-layout="canvas"] a {
    width: max(100%, 320rem);
  }

  .ds-architecture-diagram__references {
    max-width: var(--container-small);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-normal);
  }

  .ds-architecture-diagram__references a {
    border-bottom: var(--border-width-default) solid var(--color-border-subtle);
    color: var(--color-text-accent);
  }

  .ds-architecture-diagram__fallback-stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-256)), 1fr));
    gap: var(--gap-small);
    padding: 0;
    list-style: none;
  }

  .ds-architecture-diagram__fallback-stages li {
    display: grid;
    gap: var(--gap-tiny);
    padding: var(--component-padding-small);
    border: var(--border-width-default) solid var(--color-border-subtle);
  }

  .ds-architecture-diagram__fallback-stages span {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-tiny);
    line-height: var(--line-height-normal);
  }

  @media (width < 48rem) {
    .ds-architecture-diagram__header {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
