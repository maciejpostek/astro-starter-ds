---
import DesignSystemLayout from "../../../../layouts/DesignSystemLayout.astro";
import DsFamilyGallery from "../../../../components/_internal/documentation/DsFamilyGallery.astro";
import { architecture, componentsByPage, type ArchitecturePage } from "../../../../data/documentationRegistry";

export function getStaticPaths() {
  return architecture.pages
    .filter((page) => page.categoryKey === "examples-templates")
    .map((page) => ({ params: { familyKey: page.pageKey }, props: { page } }));
}

interface Props { page: ArchitecturePage; }
const { page } = Astro.props;
const components = componentsByPage.get(`examples-templates/${page.pageKey}`) ?? [];
---

<DesignSystemLayout
  title={`${page.pageLabel} - Examples & Templates`}
  pageType="template-gallery"
  toc={[{ label: "Templates", href: "#variants" }]}
  header={{
    eyebrow: "Examples & Templates",
    title: page.pageLabel,
    description: "Production examples and templates appear here only when backed by a canonical Astro source and registry record.",
    status: components.length ? "Available records" : "Empty family",
  }}
>
  <DsFamilyGallery page={page} components={components} />
</DesignSystemLayout>
