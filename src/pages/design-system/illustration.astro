---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsCodeSnippet from "../../components/design-system/DsCodeSnippet.astro";
import DsDocSection from "../../components/design-system/DsDocSection.astro";
import PanelPatternVisualSystem from "../../components/organisms/visual/PanelPatternVisualSystem.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";
import {
  panelPatternPresets,
  type PanelPatternPreset,
  type PanelPatternVariant,
} from "../../data/panel-patterns";

const presetEntries = Object.entries(panelPatternPresets) as [
  PanelPatternVariant,
  PanelPatternPreset,
][];

const contractItems = [
  {
    title: "System-owned",
    text: "Preset data, deterministic geometry, semantic tones, responsive behavior, and accessible image semantics.",
  },
  {
    title: "Parent-owned",
    text: "Available width, placement, surrounding content, and whether a decorative system pattern is appropriate.",
  },
  {
    title: "Project-owned",
    text: "Logos, photography, product screenshots, charts, brand illustration, and their rights or attribution.",
  },
];

const operationalRequirements = [
  {
    title: "Accessibility",
    text: "Every rendered visual exposes role=\"img\" and a concise label. Do not place meaning only in accent color or replace content-bearing media with this decorative system.",
  },
  {
    title: "Responsive behavior",
    text: "The component fills its parent, preserves source geometry, applies the preset mobile scale, and clips the intentional one-pixel overlap used to prevent subpixel seams.",
  },
  {
    title: "Performance",
    text: "Rendering uses deterministic HTML and CSS with no image request, canvas runtime, animation loop, or random layout generation.",
  },
  {
    title: "Token contract",
    text: "Visible panels use only the semantic background tokens for subtle neutral and accent surfaces. Preset data never contains color values.",
  },
];

const extensionSteps = [
  "Start from a documented usage context; do not add a preset only for visual variety.",
  "Copy the closest existing preset and choose a semantic camelCase key with a unique English label.",
  "Keep every row sum equal to sourceWidth and derive sourceHeight from rows, rowHeight, and group gaps.",
  "Use only neutral and accent tones; keep accent canvas share at or below twelve percent.",
  "Render the preset through PanelPatternVisualSystem and add a real documentation fixture.",
  "Run the illustration audit and verify desktop, intermediate, and mobile behavior in the browser.",
  "Add an instance to the Figma illustration page; do not create a parallel master or redraw its internals.",
  "Record permanent evidence in the roadmap before declaring the preset ready.",
];

const agenticRules = [
  "Use the existing four presets when their UX role fits; do not create page-local copies.",
  "Modify preset data in src/data/panel-patterns.ts and keep the renderer generic.",
  "Treat the source, audit, and browser output as canonical; Figma represents the accepted code state.",
  "Keep illustrations deterministic and project-neutral. Never invent a client brand, product screenshot, or business-specific story.",
  "Use project-owned media when the content itself carries evidence or meaning.",
  "Do not implement exploratory props from VISUAL-ART-DIRECTION.md as if they were part of the current public contract.",
];
---

<BaseLayout title="Illustrations - Astro Design System">
  <div class="page">
    <SectionHeader eyebrow="Assets" title="Illustrations" variant="hero" />

    <DsDocSection
      id="illustration-contract"
      title="V1 Contract"
      description="The current illustration system is a focused, code-owned language for deterministic modular panel visuals. It is not a substitute for project-owned media."
    >
      <div class="illustration-card-grid">
        {
          contractItems.map((item) => (
            <article class="illustration-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </DsDocSection>

    <DsDocSection
      id="illustration-presets"
      title="Preset Gallery"
      description="All four shipped presets are rendered through the real public component. The labels below are part of their accessible image contract."
    >
      <div class="illustration-preset-grid">
        {
          presetEntries.map(([variant, preset]) => (
            <article class="illustration-preset">
              <header>
                <h3>{variant}</h3>
                <code>{preset.label}</code>
              </header>
              <div class="illustration-preset__canvas">
                <PanelPatternVisualSystem variant={variant} />
              </div>
            </article>
          ))
        }
      </div>
    </DsDocSection>

    <DsDocSection
      id="illustration-requirements"
      title="Operational Requirements"
      description="A preset is usable only when its semantic, responsive, performance, and token contracts remain intact."
    >
      <div class="illustration-card-grid">
        {
          operationalRequirements.map((item) => (
            <article class="illustration-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </DsDocSection>

    <DsDocSection
      id="illustration-extension"
      title="Extension Workflow"
      description="Extend the data model only when an existing preset cannot serve the intended role."
    >
      <ol class="illustration-steps">
        {extensionSteps.map((step) => <li>{step}</li>)}
      </ol>
      <DsCodeSnippet
        label="Real component API"
        code={`<PanelPatternVisualSystem
  variant="fieldStrategy"
  label="Strategy workflow structure"
/>`}
      />
    </DsDocSection>

    <DsDocSection
      id="illustration-agentic-rules"
      title="Agentic Rules"
      description="Selection and implementation constraints for human and AI contributors."
    >
      <ol class="illustration-rules">
        {
          agenticRules.map((rule) => (
            <li>
              <span>{rule}</span>
            </li>
          ))
        }
      </ol>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    min-width: 0;
  }

  .illustration-card-grid,
  .illustration-preset-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-large);
  }

  .illustration-card,
  .illustration-preset {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: var(--gap-regular);
    border: var(--border-width-default) solid var(--color-border-subtle);
    padding: var(--component-padding-large);
    background: var(--color-background-surface);
  }

  .illustration-card h3,
  .illustration-card p,
  .illustration-preset h3 {
    margin: 0;
  }

  .illustration-card p,
  .illustration-preset code {
    color: var(--color-text-secondary);
  }

  .illustration-preset header {
    display: grid;
    min-width: 0;
    gap: var(--gap-tiny);
  }

  .illustration-preset code {
    overflow-wrap: anywhere;
  }

  .illustration-preset__canvas {
    min-width: 0;
    overflow: hidden;
    padding-block: var(--component-padding-small);
    background: var(--color-background-canvas);
  }

  .illustration-steps,
  .illustration-rules {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--gap-regular);
    list-style: none;
    counter-reset: illustration-step;
  }

  .illustration-steps li,
  .illustration-rules li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--gap-regular);
    border-left: var(--border-width-emphasis) solid var(--color-border-accent);
    padding: var(--component-padding-medium);
    background: var(--color-background-surface);
  }

  .illustration-steps li {
    counter-increment: illustration-step;
  }

  .illustration-steps li::before {
    content: counter(illustration-step, decimal-leading-zero);
    color: var(--color-text-accent);
    font-family: var(--text-style-code-font-family);
  }

  .illustration-rules li::before {
    content: "→";
    color: var(--color-icon-accent);
  }

  @media (width < 64rem) {
    .illustration-card-grid,
    .illustration-preset-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
