---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsFieldCard from "../../components/design-system/DsFieldCard.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";

const fields = [
  { number: "Field 1", title: "Sizing", href: "/design-system/sizing" },
  { number: "Field 2", title: "Color", href: "/design-system/color" },
  { number: "Field 3", title: "Typography", href: "/design-system/typography" },
  { number: "Field 4", title: "Layout", href: "/design-system/layout" },
  { number: "Field 5", title: "Components", href: "/design-system/components" },
  { number: "Roadmap", title: "System roadmap", href: "/design-system/roadmap" }
];
---

<BaseLayout title="Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Design System"
      title="A working source of truth for the interface, tokens and reusable components."
      variant="hero"
    />

    <section class="design-system-fields" aria-label="Design system fields">
      {
        fields.map((field) => (
          <DsFieldCard
            number={field.number}
            title={field.title}
            href={field.href}
          />
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .design-system-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--border-width-default) solid var(--color-border-subtle);
    border-left: var(--border-width-default) solid var(--color-border-subtle);
  }

  @media (width < 48rem) {
    .design-system-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
