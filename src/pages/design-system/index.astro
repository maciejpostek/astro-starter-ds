---
import DesignSystemLayout from "../../layouts/DesignSystemLayout.astro";
import MaterialSymbol from "../../components/assets/icons/MaterialSymbol.astro";
import {
  createDocumentationSummary,
  documentationCategories,
  documentationPageHref,
} from "../../data/documentationRegistry";

---

<DesignSystemLayout
  title="Astro Design System"
  pageType="family-gallery"
  header={{
    eyebrow: "Design system documentation",
    title: "Code-backed foundations, components and website patterns.",
    summary: createDocumentationSummary(
      "Browse the canonical Astro architecture across foundations, assets and reusable UI families. The category cards below lead into each area, while registry status keeps implemented code distinct from the Figma backlog.",
      [],
      "Use the left navigation or search to move directly to a documented record.",
    ),
  }}
>
  <section class="documentation-categories" aria-label="Documentation categories">
    {
      documentationCategories.map((category) => (
        <article>
          <span><MaterialSymbol name={category.icon} size="var(--size-24)" /></span>
          <div>
            <h2 class="heading-h4">{category.displayLabel}</h2>
            <p class="body-small-regular">{category.pages.length} pages</p>
          </div>
          {category.pages[0] && (
            <a href={documentationPageHref(category.categoryKey, category.pages[0].pageKey)}>
              Browse category
            </a>
          )}
        </article>
      ))
    }
  </section>
</DesignSystemLayout>

<style>
  .documentation-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--gap-medium);
  }

  article {
    display: grid;
    min-height: 15rem;
    align-content: space-between;
    gap: var(--gap-xlarge);
    border: var(--border-width-default) solid var(--color-border-subtle);
    background: var(--color-background-surface);
    padding: var(--content-padding-xlarge);
  }

  article > span {
    color: var(--color-icon-accent);
    font-size: var(--font-size-h4);
  }


  p {
    margin-top: var(--gap-small);
    color: var(--color-text-secondary);
  }

  a {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-emphasis);
  }
</style>
