---
import DesignSystemLayout from "../../layouts/DesignSystemLayout.astro";
import { documentationCategories, documentationPageHref } from "../../data/documentationRegistry";
---

<DesignSystemLayout
  title="Astro Design System"
  pageType="family-gallery"
  header={{
    eyebrow: "Design system documentation",
    title: "Code-backed foundations, components and website patterns.",
    description: "Browse the canonical Astro architecture. Registry status makes the boundary between implemented code and the Figma backlog explicit.",
  }}
>
  <section class="documentation-categories" aria-label="Documentation categories">
    {
      documentationCategories.map((category) => (
        <article>
          <span>{category.figmaIcon}</span>
          <div>
            <h2 class="heading-h4">{category.displayLabel}</h2>
            <p class="body-small-regular">{category.pages.length} pages</p>
          </div>
          {category.pages[0] && (
            <a href={documentationPageHref(category.categoryKey, category.pages[0].pageKey)}>
              Browse category
            </a>
          )}
        </article>
      ))
    }
  </section>
</DesignSystemLayout>

<style>
  .documentation-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--gap-medium);
  }

  article {
    display: grid;
    min-height: 15rem;
    align-content: space-between;
    gap: var(--gap-large);
    border: var(--border-width-default) solid var(--color-border-subtle);
    background: var(--color-background-surface);
    padding: var(--component-padding-large);
  }

  article > span {
    color: var(--color-icon-accent);
    font-size: var(--font-size-h4);
  }


  p {
    margin-top: var(--gap-small);
    color: var(--color-text-secondary);
  }

  a {
    color: var(--color-text-accent);
    font-weight: var(--font-weight-emphasis);
  }
</style>
