<BaseLayout title="Color - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Field 1"
      title="Color"
      variant="hero"
    />

    <DsDocSection
      id="colors-primitive-tokens"
      title="Color Primitives"
      description="Primitive color tokens are raw HEX reference values. They define palettes only; components and layouts should normally consume semantic color tokens instead of these primitives directly."
    >
      <section
        id="colors-primitive-base"
        class="ds-color-topic"
        aria-labelledby="colors-primitive-base-title"
      >
        <DsSectionHeaderLevel3
          id="colors-primitive-base-title"
          title="Base utility values"
          description="Shared primitive color utilities used by semantic aliases and accent contrast decisions."
        />

        <DsPaletteBlock
          name="Base utility values"
          description="Shared primitive color utilities."
          flushSampleInline
          rows={baseColorRows}
          showHeader={false}
        />
      </section>

      <section
        id="colors-primitive-neutral"
        class="ds-color-topic"
        aria-labelledby="colors-primitive-neutral-title"
      >
        <DsSectionHeaderLevel3
          id="colors-primitive-neutral-title"
          title="Neutral palette"
          description="Achromatic scale from pure white to near black."
        />

        <DsPaletteBlock
          name="Neutral palette"
          description="Achromatic scale from pure white to near black."
          flushSampleInline
          rows={neutralRows}
          showHeader={false}
        />
      </section>

      <section
        id="colors-primitive-accent"
        class="ds-color-topic"
        aria-labelledby="colors-primitive-accent-title"
      >
        <DsSectionHeaderLevel3
          id="colors-primitive-accent-title"
          title="Accent palette"
          description="Default brand and interaction emphasis scale."
        />

