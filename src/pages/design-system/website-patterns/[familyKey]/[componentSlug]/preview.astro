---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import DsResponsivePreview from "../../../../../components/_internal/documentation/DsResponsivePreview.astro";
import { documentationPreviewAdapters, type DocumentationPreviewAdapter } from "../../../../../data/documentationPreviewRegistry";
import { resolveDocumentationPageMode } from "../../../../../data/documentationRegistry";

export function getStaticPaths() {
  return documentationPreviewAdapters
    .filter(
      (adapter) =>
        adapter.categoryKey === "website-patterns" &&
        resolveDocumentationPageMode(adapter.categoryKey, adapter.pageKey) === "multi",
    )
    .map((adapter) => ({
      params: { familyKey: adapter.pageKey, componentSlug: adapter.componentId },
      props: { adapter },
    }));
}

interface Props { adapter: DocumentationPreviewAdapter; }
const { adapter } = Astro.props;
---

<BaseLayout title={`${adapter.componentId} - Responsive preview`} showGridVisualizer={false} showComponentInfo={false} mainClass="main--flush">
  <DsResponsivePreview
    title={adapter.componentId}
    backHref={adapter.backHref}
    renderer={adapter.component}
    rendererProps={adapter.props}
    axes={adapter.axes}
    scope={`responsive-route-${adapter.id}`}
  />
</BaseLayout>
