---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsCodeSnippet from "../../components/design-system/DsCodeSnippet.astro";
import DsDocCard from "../../components/design-system/DsDocCard.astro";
import DsDocGrid from "../../components/design-system/DsDocGrid.astro";
import DsDocSection from "../../components/design-system/DsDocSection.astro";
import DsLayoutPreview from "../../components/design-system/DsLayoutPreview.astro";
import DsTableCell from "../../components/design-system/DsTableCell.astro";
import DsTableCopyCell from "../../components/design-system/DsTableCopyCell.astro";
import DsTableFrame from "../../components/design-system/DsTableFrame.astro";
import DsTableRow from "../../components/design-system/DsTableRow.astro";
import DsSectionHeaderLevel3 from "../../components/design-system-documentation/DsSectionHeaderLevel3.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";
import {
  layoutAgenticRules,
  layoutAttributeRows,
  layoutGridAttributeRows,
  layoutGridExamples,
  layoutFoundationGroups,
  layoutSemanticGroups,
  layoutStructureExamples,
  layoutStyleRows,
} from "../../data/design-system/layoutTokens";
---

<BaseLayout title="Layout - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Field 4"
      title="Layout"
      variant="hero"
    />

    <DsDocSection
      id="layout-primitive-foundations"
      title="Layout Foundations"
      description="Layout foundation tokens define the responsive references and role-bearing control points for the layout system: viewport range, breakpoints, site padding limits and container limits. Semantic layout tokens and layout classes should consume these values instead of hardcoding local measurements."
    >
      {
        layoutFoundationGroups.map((group) => (
          <section
            id={group.id}
            class="ds-layout-topic"
            aria-labelledby={`${group.id}-title`}
          >
            <DsSectionHeaderLevel3
              id={`${group.id}-title`}
              title={group.title}
              description={group.description}
            />

            <DsTableFrame
              label={`${group.title} layout foundation tokens`}
              minWidth="74rem"
              columns="minmax(18rem, 0.24fr) minmax(18rem, 0.22fr) minmax(16rem, 0.18fr) minmax(28rem, 0.36fr)"
              size="tiny"
            >
              <DsTableRow variant="header">
                <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Resolved value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
              </DsTableRow>

              {
                group.rows.map((row) => (
                  <DsTableRow>
                    <DsTableCopyCell role="cell" value={row.token} />
                    <DsTableCell role="cell" tone="secondary">
                      <code>{row.value}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <code>{row.resolvedValue}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <span>{row.role}</span>
                    </DsTableCell>
                  </DsTableRow>
                ))
              }
            </DsTableFrame>
          </section>
        ))
      }
    </DsDocSection>

    <DsDocSection
      id="layout-semantic-variables"
      title="Layout Semantic"
      description="Semantic layout variables translate foundation viewport, padding and container values into reusable layout contracts. They are value contracts consumed by layout classes and data attributes, not the final public API by themselves."
    >
      {
        layoutSemanticGroups.map((group) => (
          <section
            id={group.id}
            class="ds-layout-topic"
            aria-labelledby={`${group.id}-title`}
          >
            <DsSectionHeaderLevel3
              id={`${group.id}-title`}
              title={group.title}
              description={group.description}
            />

            <DsTableFrame
              label={`${group.title} layout semantic tokens`}
              minWidth="86rem"
              columns="minmax(18rem, 0.22fr) minmax(24rem, 0.26fr) minmax(20rem, 0.22fr) minmax(30rem, 0.3fr)"
              size="tiny"
            >
              <DsTableRow variant="header">
                <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Resolved value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
              </DsTableRow>

              {
                group.rows.map((row) => (
                  <DsTableRow>
                    <DsTableCopyCell role="cell" value={row.token} />
                    <DsTableCell role="cell" tone="secondary">
                      <code>{row.value}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <code>{row.resolvedValue}</code>
                    </DsTableCell>
                    <DsTableCell role="cell" tone="secondary">
                      <span>{row.role}</span>
                    </DsTableCell>
                  </DsTableRow>
                ))
              }
            </DsTableFrame>
          </section>
        ))
      }
    </DsDocSection>

    <DsDocSection
      id="layout-grid-system"
      title="Grid system"
      description="The grid system defines site composition, explicit columns, auto-fit wrapping and breakout layouts. Use .l-grid as the structural class, then select the grid behavior with data attributes."
    >
      <section
        id="layout-grid-visuals"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-visuals-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-visuals-title"
          title="Grid visuals"
          description="The site grid uses responsive 12/8/4 columns. Breakout grids add edge tracks before and after the content columns for full-width media or composition."
        />

        <DsDocGrid columns={2}>
          <DsLayoutPreview variant="grid" label="Site grid: 12 content columns" />
          <DsLayoutPreview variant="breakout" label="Breakout grid: edge tracks + content columns" />
        </DsDocGrid>
      </section>

      <section
        id="layout-grid-attributes"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-attributes-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-attributes-title"
          title="Grid attributes"
          description="Grid-specific attributes control grid mode, explicit columns, auto-fit minimum widths, gaps and child column spans."
        />

        <DsTableFrame
          label="Grid attributes"
          minWidth="112rem"
          columns="minmax(16rem, 0.14fr) minmax(18rem, 0.15fr) minmax(28rem, 0.24fr) minmax(14rem, 0.11fr) minmax(28rem, 0.23fr) minmax(34rem, 0.28fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Selector</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Attribute</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutGridAttributeRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={row.selector} />
                <DsTableCopyCell role="cell" value={row.attribute} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.defaultValue}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>

      <section
        id="layout-grid-examples"
        class="ds-layout-topic"
        aria-labelledby="layout-grid-examples-title"
      >
        <DsSectionHeaderLevel3
          id="layout-grid-examples-title"
          title="Grid examples"
          description="Copyable patterns for the three most important grid modes: site composition, auto-fit card grids and breakout grids."
        />

        {
          layoutGridExamples.map((example) => (
            <DsCodeSnippet label={example.label} code={example.code} />
          ))
        }
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-styles"
      title="Styles"
      description="Layout style classes are the public role-based interface for page composition. Classes define what a layout object is; attributes define its variant."
    >
      <section
        id="layout-styles-classes"
        class="ds-layout-topic"
        aria-labelledby="layout-styles-classes-title"
      >
        <DsSectionHeaderLevel3
          id="layout-styles-classes-title"
          title="Layout classes"
          description="Base layout objects for sections, containers, grids and grouped child flows."
        />

        <DsTableFrame
          label="Layout classes"
          minWidth="132rem"
          columns="minmax(14rem, 0.1fr) minmax(18rem, 0.14fr) minmax(10rem, 0.08fr) minmax(56rem, 0.42fr) minmax(22rem, 0.16fr) minmax(30rem, 0.22fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Class</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Display</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutStyleRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={`.${row.className}`} />
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.role}</span>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.display}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-attributes"
      title="Attributes"
      description="Layout attributes are the variant API for layout objects. Use them to change section padding, container width, grid columns, gaps and alignment without creating additional utility classes."
    >
      <section
        id="layout-attributes-list"
        class="ds-layout-topic"
        aria-labelledby="layout-attributes-list-title"
      >
        <DsSectionHeaderLevel3
          id="layout-attributes-list-title"
          title="Layout attributes"
          description="Variant controls for public layout classes. The class defines the role; the attribute defines the selected layout behavior."
        />

        <DsTableFrame
          label="Layout attributes"
          minWidth="108rem"
          columns="minmax(14rem, 0.13fr) minmax(16rem, 0.14fr) minmax(28rem, 0.24fr) minmax(14rem, 0.12fr) minmax(28rem, 0.24fr) minmax(32rem, 0.27fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Class</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Attribute</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Values</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Default</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value contracts</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Usage</DsTableCell>
          </DsTableRow>

          {
            layoutAttributeRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={`.${row.className}`} />
                <DsTableCopyCell role="cell" value={row.attribute} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.values}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.defaultValue}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.valueContracts}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.usage}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>
    </DsDocSection>

    <DsDocSection
      id="layout-agentic-rules"
      title="Agentic Rules"
      description="Agentic layout rules describe how AI should compose sections, containers, grids and child-flow groups using classes, attributes and semantic layout variables."
    >
      <section
        id="layout-agentic-rules-list"
        class="ds-layout-topic"
        aria-labelledby="layout-agentic-rules-list-title"
      >
        <DsSectionHeaderLevel3
          id="layout-agentic-rules-list-title"
          title="Agentic layout rules"
          description="Operational rules for class-and-attribute layout composition."
        />

        <DsDocGrid columns={2}>
          {
            layoutAgenticRules.map((rule) => (
              <DsDocCard
                agenticRuleName={rule.name}
                eyebrow="Agentic Rule"
                title={rule.title}
                text={rule.text}
              />
            ))
          }
        </DsDocGrid>
      </section>

      <section
        id="layout-structure-examples"
        class="ds-layout-topic"
        aria-labelledby="layout-structure-examples-title"
      >
        <DsSectionHeaderLevel3
          id="layout-structure-examples-title"
          title="Layout structure examples"
          description="Copyable markup patterns that show where classes and data attributes belong in semantic layout structure."
        />

        {
          layoutStructureExamples.map((example) => (
            <DsCodeSnippet label={example.label} code={example.code} />
          ))
        }
      </section>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .ds-layout-topic {
    display: grid;
    gap: var(--gap-xlarge);
  }

  .ds-layout-topic + .ds-layout-topic {
    padding-top: var(--section-padding-small);
    border-top: var(--border-width-default) solid var(--color-border-subtle);
  }
</style>
