---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsDocCard from "../../components/_internal/documentation/DsDocCard.astro";
import DsDocGrid from "../../components/_internal/documentation/DsDocGrid.astro";
import DsDocSection from "../../components/_internal/documentation/DsDocSection.astro";
import DsSemanticTypographyBlock from "../../components/_internal/documentation/DsSemanticTypographyBlock.astro";
import DsTableCell from "../../components/_internal/documentation/DsTableCell.astro";
import DsTableCopyCell from "../../components/_internal/documentation/DsTableCopyCell.astro";
import DsTableFrame from "../../components/_internal/documentation/DsTableFrame.astro";
import DsTableRow from "../../components/_internal/documentation/DsTableRow.astro";
import DsTypographyFoundationBlock from "../../components/_internal/documentation/DsTypographyFoundationBlock.astro";
import DsSectionHeaderLevel3 from "../../components/_internal/documentation/DsSectionHeaderLevel3.astro";
import DsSectionHeaderLevel4 from "../../components/_internal/documentation/DsSectionHeaderLevel4.astro";
import SectionHeader from "../../components/_internal/documentation/SectionHeader.astro";

import {
  bodySizeRows,
  fontFamilyRows,
  fontStyleRows,
  fontWeightRows,
  headingSizeRows,
  letterSpacingRows,
  lineHeightRows,
  overflowWrapRows,
  semanticTypographyRows,
  textWrapRows,
  transformRows,
  typographyAgenticRules,
  utilityTypographyRows,
  whiteSpaceRows,
  wordBreakRows,
} from "../../data/design-system/typographyTokens";
---

<BaseLayout title="Typography - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Field 3"
      title="Typography"
      variant="hero"
    />

    <DsDocSection
      id="typography-primitive-foundations"
      title="Typography Foundations"
      description="Typography foundation tokens define reference values and role-bearing control points for font families, weights, sizes, line heights, letter spacing and reusable text transforms. They build semantic text styles and are not the default markup API."
    >
      <section
        id="typography-foundations-font-families"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-font-families-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-font-families-title"
          title="Font families"
          description="Foundation font-family tokens keep heading, body and mono roles independent so future font changes do not require rewriting component CSS."
        />

        <DsTypographyFoundationBlock
          name="Font families"
          description="Primary family roles used by semantic text styles."
          rows={fontFamilyRows}
          showHeader={false}
        />
      </section>

      <section
        id="typography-foundations-sizes"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-sizes-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-sizes-title"
          title="Font sizes"
          description="Foundation size tokens define the H1–H6 heading scale separately from body reading sizes."
        />

        <div class="ds-typography-subsections">
          <section aria-labelledby="typography-foundations-heading-sizes-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-heading-sizes-title"
              title="Heading sizes"
              description="Raw H1–H6 scale values used by semantic heading styles."
            />

            <DsTypographyFoundationBlock
              name="Heading sizes"
              description="Raw H1–H6 heading scale values."
              rows={headingSizeRows}
              showMinMax
              showHeader={false}
            />
          </section>

          <section aria-labelledby="typography-foundations-body-sizes-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-body-sizes-title"
              title="Body sizes"
              description="Reading and compact interface text sizes."
            />

            <DsTypographyFoundationBlock
              name="Body sizes"
              description="Reading and compact interface text sizes."
              rows={bodySizeRows}
              showMinMax
              showHeader={false}
            />
          </section>
        </div>
      </section>

      <section
        id="typography-foundations-line-heights"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-line-heights-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-line-heights-title"
          title="Line heights"
          description="Reusable vertical rhythm values independent of one specific text style."
        />

        <DsTypographyFoundationBlock
          name="Line heights"
          description="Reusable vertical rhythm values."
          rows={lineHeightRows}
          showHeader={false}
        />
      </section>

      <section
        id="typography-foundations-letter-spacings"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-letter-spacings-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-letter-spacings-title"
          title="Letter spacing"
          description="Reusable tracking values for prominent headings, body copy and compact utility text."
        />

        <DsTypographyFoundationBlock
          name="Letter spacing"
          description="Reusable tracking values."
          rows={letterSpacingRows}
          showHeader={false}
        />
      </section>

      <section
        id="typography-foundations-text-wrap"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-text-wrap-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-text-wrap-title"
          title="Text wrap"
          description="Foundation wrapping tokens expose CSS text wrapping and breaking behavior for semantic text styles, headings and constrained UI."
        />

        <div class="ds-typography-subsections">
          <section aria-labelledby="typography-foundations-text-wrap-mode-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-text-wrap-mode-title"
              title="Text wrap"
              description="Values for the CSS text-wrap property."
            />

            <DsTypographyFoundationBlock
              name="Text wrap"
              description="Text wrapping behavior."
              rows={textWrapRows}
              showHeader={false}
            />
          </section>

          <section aria-labelledby="typography-foundations-overflow-wrap-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-overflow-wrap-title"
              title="Overflow wrap"
              description="Values for breaking long words and strings when text overflows."
            />

            <DsTypographyFoundationBlock
              name="Overflow wrap"
              description="Long string overflow behavior."
              rows={overflowWrapRows}
              showHeader={false}
            />
          </section>

          <section aria-labelledby="typography-foundations-word-break-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-word-break-title"
              title="Word break"
              description="Values for controlling word-level breaking behavior."
            />

            <DsTypographyFoundationBlock
              name="Word break"
              description="Word-level breaking behavior."
              rows={wordBreakRows}
              showHeader={false}
            />
          </section>

          <section aria-labelledby="typography-foundations-white-space-title">
            <DsSectionHeaderLevel4
              id="typography-foundations-white-space-title"
              title="White space"
              description="Values for preserving, collapsing and wrapping whitespace."
            />

            <DsTypographyFoundationBlock
              name="White space"
              description="Whitespace handling behavior."
              rows={whiteSpaceRows}
              showHeader={false}
            />
          </section>
        </div>
      </section>

      <section
        id="typography-foundations-weights"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-weights-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-weights-title"
          title="Weights"
          description="Role-based font-weight values that can change without renaming semantic text styles."
        />

        <DsTypographyFoundationBlock
          name="Weights"
          description="Role-based weight values."
          rows={fontWeightRows}
          showHeader={false}
        />
      </section>

      <section
        id="typography-foundations-font-styles"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-font-styles-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-font-styles-title"
          title="Font styles"
          description="Reusable font-style values for semantic emphasis and predictable resets."
        />

        <DsTypographyFoundationBlock
          name="Font styles"
          description="Reusable font-style values."
          rows={fontStyleRows}
          showHeader={false}
        />
      </section>

      <section
        id="typography-foundations-transform"
        class="ds-typography-topic"
        aria-labelledby="typography-foundations-transform-title"
      >
        <DsSectionHeaderLevel3
          id="typography-foundations-transform-title"
          title="Text transforms"
          description="Reusable text-transform values for compact utility, labels and metadata text."
        />

        <DsTypographyFoundationBlock
          name="Text transforms"
          description="Reusable transform values."
          rows={transformRows}
          showHeader={false}
        />
      </section>
    </DsDocSection>

    <DsDocSection
      id="typography-semantic"
      title="Typography Semantic"
      description="Semantic typography styles define global text contracts used through classes. They combine typography foundation values into reusable heading and body styles."
    >
      <section
        id="typography-semantic-global-styles"
        class="ds-typography-topic"
        aria-labelledby="typography-semantic-global-styles-title"
      >
        <DsSectionHeaderLevel3
          id="typography-semantic-global-styles-title"
          title="Global semantic styles"
          description="Use these classes as the public typography interface. Reusable components keep their own local typography styles instead of adding component-based typography tokens."
        />

        <DsSemanticTypographyBlock rows={semanticTypographyRows} />
      </section>
    </DsDocSection>

    <DsDocSection
      id="typography-styles"
      title="Styles"
      description="Typography styles are the public CSS interface. Global text styles cover headings and body text, while utility classes stay limited to casing, font-style and wrapping behavior."
    >
      <section
        id="typography-styles-utility"
        class="ds-typography-topic"
        aria-labelledby="typography-styles-utility-title"
      >
        <DsSectionHeaderLevel3
          id="typography-styles-utility-title"
          title="Utility typography styles"
          description="Small typography escape hatches for font-style, text-transform and wrapping. Do not use utility classes for font size, heading scale or body text hierarchy."
        />

        <DsTableFrame
          label="Utility typography styles"
          minWidth="88rem"
          columns="minmax(18rem, 0.22fr) minmax(14rem, 0.16fr) minmax(18rem, 0.2fr) minmax(12rem, 0.12fr) minmax(28rem, 0.3fr)"
          size="tiny"
        >
          <DsTableRow variant="header">
            <DsTableCell role="columnheader" variant="header">Class</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Property</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
            <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
          </DsTableRow>

          {
            utilityTypographyRows.map((row) => (
              <DsTableRow>
                <DsTableCopyCell role="cell" value={`.${row.className}`} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.property}</code>
                </DsTableCell>
                <DsTableCopyCell role="cell" value={row.token} />
                <DsTableCell role="cell" tone="secondary">
                  <code>{row.value}</code>
                </DsTableCell>
                <DsTableCell role="cell" tone="secondary">
                  <span>{row.role}</span>
                </DsTableCell>
              </DsTableRow>
            ))
          }
        </DsTableFrame>
      </section>
    </DsDocSection>

    <DsDocSection
      id="typography-agentic-rules"
      title="Agentic Rules"
      description="Agentic typography rules describe how AI should use typography classes, variables and utilities when generating or editing UI."
    >
      <section
        id="typography-agentic-rules-list"
        class="ds-typography-topic"
        aria-labelledby="typography-agentic-rules-list-title"
      >
        <DsSectionHeaderLevel3
          id="typography-agentic-rules-list-title"
          title="Agentic typography rules"
          description="Operational rules for class-first typography, semantic variables and controlled utility usage."
        />

        <DsDocGrid columns={2}>
          {
            typographyAgenticRules.map((rule) => (
              <DsDocCard
                agenticRuleName={rule.name}
                eyebrow="Agentic Rule"
                title={rule.title}
                text={rule.text}
              />
            ))
          }
        </DsDocGrid>
      </section>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .ds-typography-topic,
  .ds-typography-subsections {
    display: grid;
    gap: var(--gap-xlarge);
  }

  .ds-typography-topic + .ds-typography-topic {
    padding-top: var(--section-padding-small);
    border-top: var(--border-width-default) solid var(--color-border-subtle);
  }
</style>
