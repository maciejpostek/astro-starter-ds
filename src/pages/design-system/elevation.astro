---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DsDocSection from "../../components/_internal/documentation/DsDocSection.astro";
import DsTableCell from "../../components/_internal/documentation/DsTableCell.astro";
import DsTableCopyCell from "../../components/_internal/documentation/DsTableCopyCell.astro";
import DsTableFrame from "../../components/_internal/documentation/DsTableFrame.astro";
import DsTableRow from "../../components/_internal/documentation/DsTableRow.astro";
import DsSectionHeaderLevel3 from "../../components/_internal/documentation/DsSectionHeaderLevel3.astro";
import SectionHeader from "../../components/_internal/documentation/SectionHeader.astro";
import {
  elevationAgenticRules,
  elevationTokenGroups,
} from "../../data/design-system/elevationTokens";
---

<BaseLayout title="Elevation - Astro Design System">
  <div class="page">
    <SectionHeader eyebrow="Field 6" title="Elevation" variant="hero" />

    <DsDocSection
      id="elevation-visual-roles"
      title="Elevation Roles"
      description="Elevation communicates a surface relationship. The examples use the semantic contracts that reusable components consume."
    >
      <div class="ds-elevation-preview-grid">
        <article class="ds-elevation-preview" data-elevation="raised">
          <h3>Raised</h3>
          <p>Low separation from the parent surface.</p>
        </article>
        <article class="ds-elevation-preview" data-elevation="floating">
          <h3>Floating</h3>
          <p>Temporary controls such as menus and popovers.</p>
        </article>
        <article class="ds-elevation-preview" data-elevation="overlay">
          <h3>Overlay</h3>
          <p>High-priority content above the page canvas.</p>
        </article>
      </div>
    </DsDocSection>

    {
      elevationTokenGroups.map((group, index) => (
        <DsDocSection
          id={group.id}
          title={group.title}
          description={group.description}
        >
          <section
            class="ds-elevation-topic"
            aria-labelledby={`${group.id}-details-title`}
          >
            <DsSectionHeaderLevel3
              id={`${group.id}-details-title`}
              title={index === 0 ? "Reference values" : index === 1 ? "Reusable roles" : "Owned contracts"}
              description="Every row maps to a canonical CSS Variable in elevation-foundations.css."
            />
            <DsTableFrame
              label={`${group.title} elevation tokens`}
              minWidth="72rem"
              columns="minmax(22rem, 0.28fr) minmax(24rem, 0.3fr) minmax(34rem, 0.42fr)"
              size="tiny"
            >
              <DsTableRow variant="header">
                <DsTableCell role="columnheader" variant="header">Token</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Value</DsTableCell>
                <DsTableCell role="columnheader" variant="header">Role</DsTableCell>
              </DsTableRow>
              {group.rows.map((row) => (
                <DsTableRow>
                  <DsTableCopyCell role="cell" value={row.token} />
                  <DsTableCell role="cell" tone="secondary"><code>{row.value}</code></DsTableCell>
                  <DsTableCell role="cell" tone="secondary"><span>{row.role}</span></DsTableCell>
                </DsTableRow>
              ))}
            </DsTableFrame>
          </section>
        </DsDocSection>
      ))
    }

    <DsDocSection
      id="elevation-agentic-rules"
      title="Agentic Rules"
      description="Operational rules for selecting and extending elevation without confusing it with rings, borders, or decorative glow."
    >
      <ol class="ds-elevation-rules">
        {elevationAgenticRules.map((rule) => (
          <li>
            <strong>{rule.title}</strong>
            <span>{rule.text}</span>
          </li>
        ))}
      </ol>
    </DsDocSection>
  </div>
</BaseLayout>

<style>
  .page,
  .ds-elevation-topic {
    display: grid;
    min-width: 0;
  }

  .ds-elevation-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-large);
    padding: var(--component-padding-large);
    background: var(--color-background-muted);
  }

  .ds-elevation-preview {
    display: grid;
    min-height: var(--size-160);
    align-content: center;
    gap: var(--gap-small);
    background: var(--color-background-canvas);
    padding: var(--component-padding-large);
  }

  .ds-elevation-preview[data-elevation="raised"] {
    box-shadow: var(--elevation-surface-raised);
  }

  .ds-elevation-preview[data-elevation="floating"] {
    box-shadow: var(--elevation-surface-floating);
  }

  .ds-elevation-preview[data-elevation="overlay"] {
    box-shadow: var(--elevation-surface-overlay);
  }

  .ds-elevation-preview h3,
  .ds-elevation-preview p {
    margin: 0;
  }

  .ds-elevation-preview p,
  .ds-elevation-rules span {
    color: var(--color-text-secondary);
  }

  .ds-elevation-rules {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--gap-regular);
    list-style: none;
  }

  .ds-elevation-rules li {
    display: grid;
    gap: var(--gap-tiny);
    border-left: var(--border-width-emphasis) solid var(--color-border-accent);
    padding: var(--component-padding-medium);
    background: var(--color-background-surface);
  }

  @media (width < 64rem) {
    .ds-elevation-preview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
