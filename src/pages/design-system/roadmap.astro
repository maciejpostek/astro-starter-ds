---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/_internal/documentation/SectionHeader.astro";
import architecture from "../../data/design-system/componentArchitecture.json";

const figmaOnly = architecture.components.filter(
  (record) => record.syncStatus === "figma-only"
);
const intentional = architecture.components.filter(
  (record) => record.syncStatus === "intentional-difference"
);
const mapped = architecture.components.filter(
  (record) => record.syncStatus === "mapped"
);
---

<BaseLayout title="Component Readiness - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Component Readiness"
      title="Figma backlog and Astro implementation state"
      variant="hero"
    />

    <section class="metrics">
      <article><span>Figma only</span><strong>{figmaOnly.length}</strong></article>
      <article><span>Mapped</span><strong>{mapped.length}</strong></article>
      <article><span>Intentional differences</span><strong>{intentional.length}</strong></article>
    </section>

    <section class="inventory">
      <h2>Canonical records</h2>
      <table>
        <thead><tr><th>Name</th><th>Page</th><th>Role</th><th>Status</th><th>Astro source</th></tr></thead>
        <tbody>
          {architecture.components.map((record) => (
            <tr>
              <th scope="row">{record.name}</th>
              <td>{record.pageLabel}</td>
              <td><code>{record.role}</code></td>
              <td><code>{record.syncStatus}</code></td>
              <td><code>{record.sourcePath ?? "—"}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</BaseLayout>

<style>
  .page { display:grid; gap:var(--section-padding-small); }
  .metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--gap-small); }
  .metrics article, .inventory { border:var(--border-width-default) solid var(--color-border-subtle); padding:var(--component-padding-large); }
  .metrics article { display:grid; gap:var(--gap-small); }
  .metrics span { color:var(--color-text-secondary); }
  .metrics strong { font-size:var(--font-size-h4); }
  .inventory { display:grid; gap:var(--gap-large); overflow:auto; }
  table { width:100%; border-collapse:collapse; }
  th, td { border-bottom:var(--border-width-default) solid var(--color-border-subtle); padding:var(--component-padding-small); text-align:left; vertical-align:top; }
  @media (width < 64rem) { .metrics { grid-template-columns:1fr; } }
</style>
