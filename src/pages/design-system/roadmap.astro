---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/molecules/text/SectionHeader.astro";
import DsDocCard from "../../components/design-system/DsDocCard.astro";
import DsDocGrid from "../../components/design-system/DsDocGrid.astro";
import DsDocSection from "../../components/design-system/DsDocSection.astro";
import DsComponentReadiness from "../../components/design-system/DsComponentReadiness.astro";
import componentArchitecture from "../../data/design-system/componentArchitecture.json";

const publicLayers = new Set(["atom", "molecule", "organism", "template"]);
const records = componentArchitecture.components.filter((record) =>
  publicLayers.has(record.layer)
);
const readyCount = records.filter((record) => record.status === "ready").length;
const reviewedCount = records.filter(
  (record) => record.readiness.visual === "approved"
).length;
const validatedCount = records.filter(
  (record) => record.readiness.validation === "passed"
).length;
---

<BaseLayout title="Component Readiness - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Component Readiness"
      title="Current implementation, visual review, and validation state."
      variant="hero"
    />

    <DsDocSection
      id="component-readiness-overview"
      title="Readiness overview"
      description="This lightweight projection is generated from the component registry. It records current state only; Git owns history and completed planning checkpoints."
    >
      <DsDocGrid columns={3}>
        <DsDocCard
          eyebrow="Implementation"
          title={`${readyCount} / ${records.length} ready`}
          text="Ready means the current Astro implementation and documented API are available for reuse."
        />
        <DsDocCard
          eyebrow="Visual review"
          title={`${reviewedCount} approved`}
          text="Starter, modified, review, and approved states distinguish system defaults from project visual approval."
        />
        <DsDocCard
          eyebrow="Validation"
          title={`${validatedCount} passed`}
          text="Validation tracks the current result only and does not store release history."
        />
      </DsDocGrid>
    </DsDocSection>

    <DsDocSection
      id="component-readiness-inventory"
      title="Component inventory"
      description="Filter the reusable public inventory by family, implementation status, visual adaptation, or validation result."
    >
      <DsComponentReadiness records={records} />
    </DsDocSection>
  </div>
</BaseLayout>
