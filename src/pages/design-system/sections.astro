<BaseLayout title="Website Sections - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Compositions"
      title="Website Sections"
      variant="hero"
    />

    <DsDocSection
      id="website-sections-architecture"
      title="Architecture"
      description="Website sections are code-first organisms grouped into twelve practical authoring families. They sit between reusable components and complete page templates."
    >
      <ol class="architecture-rules">
        {architectureRules.map((rule) => <li>{rule}</li>)}
      </ol>
    </DsDocSection>

    <DsDocSection
      id="website-sections-families"
      title="Family Catalog"
      description="The taxonomy is complete even when a family has no released sections yet. Planned entries remain visible so the roadmap and documentation share one structure."
    >
      <div class="family-grid">
        {
          sectionFamilies.map((family, index) => (
            <article class="family-card" data-family-status={family.status}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3 id={`website-sections-family-${family.id}-title`}>
                  {family.title}
                </h3>
                <p>{family.scope}</p>
              </div>
              <code>{family.status}</code>
            </article>
          ))
        }
      </div>
    </DsDocSection>

    <DsDocSection
      id="website-sections-global-shell"
      title="Global Shell"
      description="Persistent or high-level page chrome composed from the existing Navigation and Actions families. Global Shell placement does not transfer ownership of child interaction behavior."
    >
      <DsComponentSpec
        id="website-sections-global-shell-announcement-bar"
        title="AnnouncementBarSection"
        sourcePath="src/components/organisms/sections/global-shell/AnnouncementBarSection.astro"
        layer="organism"
        family="sections / global-shell"
        role="Place one temporary, non-critical announcement in the global marketing shell while reusing the complete NavBanner contract."
        useWhen={["A page template needs an explicit announcement slot before or adjacent to primary navigation.", "One short update may include one real related destination and optional session dismissal."]}
        avoidWhen={["The page can use NavBanner directly without a section-level placement contract.", "The message is blocking, legal consent, form validation, persistent application state, or requires multiple actions or media."]}
        contract={["title is required and non-empty", "description is optional", "href is optional and real when present", "actionLabel is required when href exists", "dismissible delegates to NavBanner", "variant=\"neutral | accent\"", "sectionId is optional and non-empty when provided", "ariaLabel names the section landmark", "native section attributes are forwarded"]}
        constraints={["The section composes NavBanner and never copies its IconButton or dismissal runtime.", "NavBanner owns role=status, data-banner-state, and nav-banner-dismiss.", "The outer section always uses public full-width layout with no section padding.", "Status is semantic behavior, not a third visual variant.", "No actions or media slots are exposed."]}
        realApiExample={'<AnnouncementBarSection title="Design system update" description="Review the latest validated contracts." href="/design-system/roadmap" actionLabel="View roadmap" variant="accent" />'}
        agenticRulePath=".agentic-rules/components/sections.md"
        figmaNodeId="623:45"
      >
        <div slot="preview" class="announcement-doc-fixtures">
          <article data-content-scenario="default">
            <h4>Default</h4>
            <AnnouncementBarSection
              title="Design system update"
              description="Review the latest validated component and section contracts."
              href="/design-system/roadmap"
              actionLabel="View readiness"
              variant="accent"
            />
          </article>
          <article data-content-scenario="short-content">
            <h4>Short content</h4>
            <AnnouncementBarSection
              title="Documentation updated"
              variant="neutral"
              dismissible={false}
            />
          </article>
          <article data-content-scenario="long-content">
            <h4>Long content</h4>
            <AnnouncementBarSection
              title="Framework delivery checkpoint"
              description="The current readiness view records implementation, visual review, and validation state directly from the component registry."
              href="/design-system/roadmap"
              actionLabel="Review readiness"
              variant="neutral"
            />
          </article>
          <article data-content-scenario="missing-optional-content">
            <h4>Missing optional content</h4>
            <AnnouncementBarSection
              title="New framework checkpoint"
              variant="accent"
              dismissible={false}
            />
          </article>
        </div>
      </DsComponentSpec>

      <DsComponentSpec
        id="website-sections-global-shell-marketing-navigation"
        title="MarketingNavigationSection"
        sourcePath="src/components/organisms/sections/global-shell/MarketingNavigationSection.astro"
        layer="organism"
        family="sections / global-shell"
        role="Place one canonical responsive MarketingNavbar in a page-template global navigation slot without duplicating navigation internals."
        useWhen={["A page template needs an explicit reusable marketing-navigation section slot.", "Desktop and mobile destinations share one structured information architecture."]}
        avoidWhen={["A custom shell can use MarketingNavbar directly without a section-level placement identity.", "The interface is an authenticated application shell, local navigation, or requires separate desktop and mobile information architectures."]}
        contract={["content contains the navigation id, direct items, brand fallback, optional action, optional MegaMenu data, and mobile presentation", "variant=\"simple | centered | mega-enabled\"", "mega-enabled maps to the canonical MarketingNavbar mega-menu variant", "sectionId is optional and non-empty when provided", "ariaLabel names the outer section", "optional brand slot forwards project-owned artwork", "compatible native section attributes are forwarded"]}
        constraints={["The section adds placement and section identity only; MarketingNavbar owns links, CTA, disclosures, focus, IDs, and breakpoints.", "No actions or media slots are exposed.", "Do not maintain a separate mobile destination list.", "Code and project context own destinations, current-route data, and brand artwork.", "Use MarketingNavbar directly when no page-template section contract is needed."]}
        realApiExample={'<MarketingNavigationSection content={primaryNavigation} variant="mega-enabled" sectionId="primary-navigation-section" />'}
        agenticRulePath=".agentic-rules/components/sections.md"
        figmaNodeId="659:173"
      >
        <div slot="preview" class="marketing-navigation-doc-fixtures">
          <article data-content-scenario="default">
            <h4>Default</h4>
            <MarketingNavigationSection
              content={defaultMarketingNavigation}
              variant="mega-enabled"
              preview
            >
              <span slot="brand">Framework</span>
            </MarketingNavigationSection>
          </article>
          <article data-content-scenario="short-content">
            <h4>Short content</h4>
            <MarketingNavigationSection
              content={shortMarketingNavigation}
              variant="centered"
              preview
            />
          </article>
          <article data-content-scenario="long-content">
            <h4>Long content</h4>
            <MarketingNavigationSection
              content={longMarketingNavigation}
              variant="simple"
              preview
            />
          </article>
          <article data-content-scenario="missing-optional-content">
            <h4>Missing optional content</h4>
            <MarketingNavigationSection
              content={minimalMarketingNavigation}
              variant="simple"
              preview
            />
          </article>
        </div>
      </DsComponentSpec>

      <DsComponentSpec
        id="website-sections-global-shell-subnavigation"
        title="SubnavigationSection"
        sourcePath="src/components/organisms/sections/global-shell/SubnavigationSection.astro"
        layer="organism"
        family="sections / global-shell"
        role="Place one canonical sibling-page Subnavigation below a primary shell without duplicating navigation links or responsive behavior."
        useWhen={["A page family needs stable sibling URL destinations immediately below its primary navigation.", "A page template needs a named subnavigation slot shared across related pages."]}
        avoidWhen={["A custom page can use Subnavigation directly without section-level placement identity.", "Content changes in place without URL navigation, or the interface needs actions, filters, or icon-first application navigation."]}
        contract={["content contains a selector-safe navigation id, at least two unique real destinations, and an optional landmark label", "variant=\"underline | pills\"", "sectionId is optional and non-empty when provided", "ariaLabel names the outer section", "componentName derives the nested navigation inspector identity", "compatible native section attributes are forwarded"]}
        constraints={["The section composes exactly one canonical Subnavigation and does not recreate its anchors, list, current state, or scrolling.", "No actions, media, default, or item slots are exposed.", "Underline and Pills remain URL navigation; Pills never gains role=tab.", "Subnavigation owns validation, aria-current, visual treatment, and narrow-width horizontal overflow.", "Use Subnavigation directly when no page-template section contract is needed."]}
        realApiExample={'<SubnavigationSection sectionId="product-subnavigation" content={productNavigation} variant="underline" />'}
        agenticRulePath=".agentic-rules/components/sections.md"
        figmaNodeId="667:199"
      >
        <div slot="preview" class="subnavigation-doc-fixtures">
          <article data-content-scenario="default">
            <h4>Default</h4>
            <SubnavigationSection
              content={defaultSubnavigation}
              variant="underline"
            />
          </article>
          <article data-content-scenario="short-content">
            <h4>Short content</h4>
            <SubnavigationSection
              content={shortSubnavigation}
              variant="pills"
            />
          </article>
          <article data-content-scenario="long-content">
            <h4>Long content</h4>
            <SubnavigationSection
              content={longSubnavigation}
              variant="underline"
            />
          </article>
          <article data-content-scenario="missing-optional-content">
            <h4>Missing optional content</h4>
            <SubnavigationSection
              content={minimalSubnavigation}
              variant="pills"
            />
          </article>
        </div>
      </DsComponentSpec>

      <DsComponentSpec
        id="website-sections-global-shell-footer"
        title="FooterSection"
        sourcePath="src/components/organisms/sections/global-shell/FooterSection.astro"
        layer="organism"
        family="sections / global-shell"
        role="Place one canonical Footer as the page contentinfo root while adding Global Shell section identity without an extra semantic wrapper."
