---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/_internal/documentation/SectionHeader.astro";
import MaterialSymbolLibrary from "../../components/_internal/documentation/MaterialSymbolLibrary.astro";
import architecture from "../../data/design-system/componentArchitecture.json";

const visibleCategoryKeys = new Set([
  "assets",
  "base-components",
  "website-patterns",
  "examples-templates",
  "workspace"
]);
const categoryPages = architecture.categories
  .filter((category) => visibleCategoryKeys.has(category.categoryKey))
  .map((category) => ({
    ...category,
    pages: architecture.pages.filter((page) => page.categoryKey === category.categoryKey)
  }));
const recordsByPage = new Map(
  architecture.pages.map((page) => [
    page.pageKey,
    architecture.components.filter((component) => component.pageKey === page.pageKey)
  ])
);
---

<BaseLayout title="Components - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Figma–Astro"
      title="Family-first component architecture"
      variant="hero"
    />

    <section class="architecture-summary">
      <p>
        Public Astro folders are intentionally empty. Existing Figma masters are
        the design backlog and remain <code>figma-only</code> until a canonical
        node is implemented and validated.
      </p>
      <dl>
        <div><dt>Categories</dt><dd>{architecture.categories.length}</dd></div>
        <div><dt>Child pages</dt><dd>{architecture.pages.length}</dd></div>
        <div><dt>Figma records</dt><dd>{architecture.components.length}</dd></div>
        <div><dt>Variables checkpoint</dt><dd>{architecture.figma.variablesCheckpoint}</dd></div>
      </dl>
    </section>

    {
      categoryPages.map((category) => (
        <section class="category" aria-labelledby={`category-${category.categoryKey}`}>
          <h2 id={`category-${category.categoryKey}`}>{category.label}</h2>
          <div class="page-grid">
            {category.pages.map((page) => {
              const records = recordsByPage.get(page.pageKey) ?? [];
              return (
                <article>
                  <header>
                    <h3>{page.pageLabel}</h3>
                    <code>{page.sourceDirectory}</code>
                  </header>
                  <p>{records.length} registered Figma master identities</p>
                  {records.length > 0 && (
                    <ul>
                      {records.map((record) => (
                        <li>
                          <span>{record.name}</span>
                          <code>{record.syncStatus}</code>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))
    }

    <section class="category" aria-labelledby="material-symbols-title">
      <h2 id="material-symbols-title">Curated Material Symbols</h2>
      <MaterialSymbolLibrary />
    </section>
  </div>
</BaseLayout>

<style>
  .page { display:grid; gap:var(--section-padding-small); }
  .architecture-summary, .category { border:var(--border-width-default) solid var(--color-border-subtle); padding:var(--component-padding-large); }
  .architecture-summary { display:grid; gap:var(--gap-large); }
  .architecture-summary p { max-width:72ch; color:var(--color-text-secondary); }
  dl { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--gap-small); }
  dl div { border:var(--border-width-default) solid var(--color-border-subtle); padding:var(--component-padding-medium); }
  dt { color:var(--color-text-secondary); font-size:var(--font-size-body-small); }
  dd { margin:var(--gap-small) 0 0; font-size:var(--font-size-h5); font-weight:var(--font-weight-emphasis); }
  .category { display:grid; gap:var(--gap-large); }
  .category > h2 { margin:0; }
  .page-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--gap-small); }
  article { display:grid; align-content:start; gap:var(--gap-medium); border:var(--border-width-default) solid var(--color-border-subtle); padding:var(--component-padding-medium); }
  article header { display:grid; gap:var(--gap-small); }
  article h3, article p { margin:0; }
  article header code { overflow-wrap:anywhere; color:var(--color-text-tertiary); }
  article ul { display:grid; gap:var(--gap-tiny); margin:0; padding:0; list-style:none; }
  article li { display:flex; justify-content:space-between; gap:var(--gap-small); border-top:var(--border-width-default) solid var(--color-border-subtle); padding-top:var(--gap-small); }
  @media (width < 64rem) { dl, .page-grid { grid-template-columns:1fr; } }
</style>
