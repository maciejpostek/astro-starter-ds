<BaseLayout title="Components - Astro Design System">
  <div class="page">
    <SectionHeader
      eyebrow="Design System"
      title="Components"
      variant="hero"
    />

    <DsDocSection
      id="components-actions"
      title="Actions"
    >
      <DsComponentSpec
        id="components-actions-button-primary"
        title="Primary Button"
        sourcePath="src/components/atoms/actions/Button.astro"
        layer="atom"
        family="actions"
        sizeOptions={buttonSizeOptions}
        defaultSize="large"
        stateOptions={buttonStateOptions}
        defaultState="default"
        componentSummary={buttonPrimarySummary}
        description="Highest-emphasis text action for one local decision context."
        role="Advance the primary path with a visible, action-led label."
        useWhen={["The action is the main next step.", "The action submits or advances a primary workflow."]}
        avoidWhen={["The action is only supportive or exploratory.", "Another primary action already owns the same local decision context."]}
        contract={["variant=\"primary\"", "size=\"small | medium | large\"", "href for navigation; type for UI actions", "named icon slot for a contextual Lucide icon"]}
        constraints={["Use one primary action per local decision area.", "Keep native button and anchor semantics.", "Consume Component Size and button color tokens."]}
        realApiExample={'<Button href="/contact">Discuss a project</Button>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="190:131"
      >
        <Button slot="preview">Send message<Send slot="icon" /></Button>
      </DsComponentSpec>

      <DsComponentSpec
        id="components-actions-button-secondary"
        title="Secondary Button"
        sourcePath="src/components/atoms/actions/Button.astro"
        layer="atom"
        family="actions"
        sizeOptions={buttonSizeOptions}
        defaultSize="large"
        stateOptions={buttonStateOptions}
        defaultState="default"
        componentSummary={buttonSecondarySummary}
        description="Supporting text action for an alternative or lower-emphasis path."
        role="Offer a clear alternative without competing with the primary action."
        useWhen={["The action supports a nearby primary action.", "The action cancels, resets, compares, or explores."]}
        avoidWhen={["The action must dominate the local context.", "The action is a low-emphasis inline or card link."]}
        contract={["variant=\"secondary\"", "size=\"small | medium | large\"", "href for navigation; type for UI actions"]}
        constraints={["Pair with Primary through ButtonGroup when actions belong together.", "Keep the same semantic element rules as Button.Primary."]}
        realApiExample={'<Button variant="secondary" href="/process">Explore process</Button>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="190:131"
      >
        <Button slot="preview" variant="secondary">Secondary action</Button>
      </DsComponentSpec>

      <DsComponentSpec
        id="components-actions-button-link"
        title="Link Button"
        sourcePath="src/components/atoms/actions/Button.astro"
        layer="atom"
        family="actions"
        sizeOptions={buttonSizeOptions}
        defaultSize="large"
        stateOptions={buttonLinkStateOptions}
        defaultState="default"
        componentSummary={buttonLinkSummary}
        description="Low-emphasis text action for progressive disclosure and repeated content."
        role="Expose a supporting path without adding a strong visual container."
        useWhen={["The action appears inside a card or repeated item.", "The surrounding content already provides the main visual hierarchy."]}
        avoidWhen={["The action is the main hero or conversion CTA.", "The action is icon-only."]}
        contract={["variant=\"link\"", "showIcon for optional icon visibility", "named icon slot for a contextual Lucide icon"]}
        constraints={["Link has no minimum control height or visible border.", "Keep labels specific; avoid generic More or Click here copy."]}
        realApiExample={'<Button variant="link" href="/details">View details</Button>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="190:131"
      >
        <Button slot="preview" variant="link">Link action</Button>
      </DsComponentSpec>

      <DsComponentSpec
        id="components-actions-icon-button-primary"
        title="Primary Icon Button"
        sourcePath="src/components/atoms/actions/IconButton.astro"
        layer="atom"
        family="actions"
        sizeOptions={buttonSizeOptions}
        defaultSize="large"
        stateOptions={buttonStateOptions}
        defaultState="default"
        componentSummary={buttonIconPrimarySummary}
        description="Highest-emphasis icon-only action for a compact, well-understood context."
        role="Provide one dominant compact action when visible text would be redundant."
        useWhen={["The surrounding interface makes the icon meaning unambiguous.", "A compact control is the primary local action."]}
        avoidWhen={["A visible label would reduce ambiguity.", "Several icon-only actions would compete at primary emphasis."]}
        contract={["label is required and maps to aria-label", "variant=\"primary\"", "default slot contains a Lucide icon", "size=\"small | medium | large\""]}
        constraints={["Keep a square 1:1 control.", "Do not rely on title as the accessible name.", "Use Button when the icon is not universally understood."]}
        realApiExample={'<IconButton variant="primary" label="Open item"><ArrowRightDown /></IconButton>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="193:110"
      >
        <IconButton slot="preview" variant="primary" label="Open action">
          <ArrowRightDown />
        </IconButton>
      </DsComponentSpec>

      <DsComponentSpec
        id="components-actions-icon-button-secondary"
        title="Secondary Icon Button"
        sourcePath="src/components/atoms/actions/IconButton.astro"
        layer="atom"
        family="actions"
        sizeOptions={buttonSizeOptions}
        defaultSize="large"
        stateOptions={buttonStateOptions}
        defaultState="default"
        componentSummary={buttonIconSecondarySummary}
        description="Supporting icon-only action for utility controls and local navigation."
        role="Provide a compact secondary or utility action with an explicit accessible name."
        useWhen={["The action closes, previews, steps, or navigates inside a local component.", "The surrounding content explains the control context."]}
        avoidWhen={["The action changes critical data and needs explicit wording.", "The icon meaning depends on hidden product knowledge."]}
        contract={["label is required and maps to aria-label", "variant=\"secondary\"", "default slot contains a Lucide icon", "size=\"small | medium | large\""]}
        constraints={["Use descriptive labels such as Previous slide or Close dialog.", "Pair symmetric previous and next controls at the same emphasis."]}
        realApiExample={'<IconButton variant="secondary" label="Next slide"><ArrowRightDown /></IconButton>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="193:110"
      >
        <IconButton slot="preview" variant="secondary" label="Open action">
          <ArrowRightDown />
        </IconButton>
      </DsComponentSpec>

      <DsComponentSpec
        id="components-actions-button-group"
        title="Button Group"
        sourcePath="src/components/molecules/actions/ButtonGroup.astro"
        layer="molecule"
        family="actions"
        componentSummary={buttonGroupSummary}
        description="Responsive composition wrapper for related Button and IconButton controls."
        role="Keep related actions together with shared spacing and wrapping behavior."
        useWhen={["Two or more actions belong to the same decision context.", "A primary and secondary action form one group."]}
        avoidWhen={["Actions belong to separate repeated items.", "A layout primitive already owns the broader composition."]}
        contract={["default slot accepts Button and IconButton children", "class forwards an optional class name", "no Count prop in Astro"]}
        constraints={["Figma Count=1|2|3 is a documentation adapter only.", "Astro accepts any practical child count and wraps responsively."]}
        realApiExample={'<ButtonGroup>\\n  <Button>Continue</Button>\\n  <Button variant="secondary">Cancel</Button>\\n</ButtonGroup>'}
        agenticRulePath=".agentic-rules/components/button.md"
        figmaNodeId="205:47"
      >
        <ButtonGroup slot="preview">
          <Button>Primary action</Button>
          <Button variant="secondary">Secondary action</Button>
        </ButtonGroup>
      </DsComponentSpec>
      <DsComponentSpec
        id="components-actions-switch-button"
        title="SwitchButton"
        sourcePath="src/components/atoms/actions/SwitchButton.astro"
