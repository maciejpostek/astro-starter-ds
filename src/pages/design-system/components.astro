      <DsDocGrid columns={2}>
        {
          componentArchitecture.layers.map((layer) => (
            <DsDocCard
              eyebrow={layer.folder}
              title={layer.title}
              text={layer.definition}
            >
              <ul class="components-doc-list">
                {layer.examples.map((example) => <li>{example}</li>)}
              </ul>
            </DsDocCard>
          ))
        }
      </DsDocGrid>
    </DsDocSection>

    <DsDocSection
      id="components-families"
      title="Families"
      description="Families group components by developer workflow. The same family can appear under atoms, molecules and organisms when real components exist at those layers."
    >
      <DsDocGrid columns={2}>
        {
          componentArchitecture.families.map((family) => (
            <DsDocCard
              eyebrow={family.allowedLayers.join(" / ")}
              title={family.title}
              text={family.description}
            />
          ))
        }
      </DsDocGrid>
    </DsDocSection>

    <DsDocSection
      id="components-agentic-rules"
      title="Agentic rules"
      description="These rules keep component source structure, documentation grouping and future component registries aligned."
    >
      <DsDocGrid columns={2}>
        {
          componentArchitecture.rules.map((rule, index) => (
            <DsDocCard
              eyebrow={`Rule ${String(index + 1).padStart(2, "0")}`}
              title={rule}
            />
          ))
        }
      </DsDocGrid>

      <DsDocGrid columns={2}>
        <DsDocCard
          eyebrow="Template"
          title=".agentic-rules/components/_component-rule-template.md"
          text="Reusable structure for future per-component UX, accessibility, content, composition and implementation rules."
        />
        <DsDocCard
          eyebrow="Active component rule"
          title=".agentic-rules/components/button.md"
          text="Decision manual for Button.Primary, Button.Secondary and Button.Link usage."
        />
      </DsDocGrid>

      <DsCodeSnippet
        label="Component record"
        code={componentRecordShape}
      />
    </DsDocSection>
  </div>
</BaseLayout>

