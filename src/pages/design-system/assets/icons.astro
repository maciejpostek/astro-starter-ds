---
import DesignSystemLayout from "../../../layouts/DesignSystemLayout.astro";
import MaterialSymbolLibrary from "../../../components/_internal/documentation/MaterialSymbolLibrary.astro";
import DsSectionHeaderLevel2 from "../../../components/_internal/documentation/DsSectionHeaderLevel2.astro";
---

<DesignSystemLayout
  title="Icons - Astro Design System"
  pageType="asset-gallery"
  toc={[
    { label: "Icon profile", href: "#icon-profile" },
    { label: "Icon catalog", href: "#icon-catalog" },
  ]}
  header={{
    eyebrow: "Assets",
    title: "Icons",
    description: "Canonical Material Symbols available through the typed Astro and React renderers. Copy the snake_case name used by the component API.",
    status: "intentional-difference",
  }}
>
  <section id="icon-profile" aria-labelledby="icon-profile-title" data-ds-doc-section>
    <DsSectionHeaderLevel2
      id="icon-profile-title"
      title="Material Symbols profile"
      description="Canonical rendering parameters shared by the Astro icon APIs."
    />
    <p id="component-material-symbol" class="body-base-regular">The code implementation uses one typed renderer while Figma stores individual curated icon masters.</p>
    <p id="component-social-icons" class="body-base-regular">Social icon masters remain Figma-only until a canonical Astro asset API is approved.</p>
  </section>
  <section id="icon-catalog" aria-labelledby="icon-catalog-title" data-ds-doc-section>
    <DsSectionHeaderLevel2
      id="icon-catalog-title"
      title="Icon catalog"
      description="Search, inspect and copy the canonical snake_case names available to components."
    />
    <MaterialSymbolLibrary />
  </section>
</DesignSystemLayout>

<style>
  section + section { margin-top: var(--section-padding-small); }
  section > p { margin-bottom: var(--component-padding-large); color: var(--color-text-secondary); }
</style>
