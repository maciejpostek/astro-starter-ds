{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference-manifest.schema.json",
  "title": "Art Direction Reference Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "projectId",
    "references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "not-configured",
        "draft",
        "review",
        "approved",
        "deprecated"
      ]
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "source",
        "appliesTo",
        "adopt",
        "avoid",
        "notes",
        "rights",
        "approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "figma-node",
            "local-image",
            "screenshot",
            "website",
            "motion-prototype",
            "brand-asset"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adopt": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        },
        "rights": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "enum": [
            "candidate",
            "approved",
            "rejected"
          ]
        }
      }
    }
  }
}
