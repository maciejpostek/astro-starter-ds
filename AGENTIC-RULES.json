{
  "version": "1.1.0",
  "name": "AI-Native Design System V1.1 Role-Aware Router",
  "description": "Compact role-aware router. Classify once, preserve constraints, resolve a flow-specific bounded Context Pack, reuse by default, validate the affected scope, and return an accepted or blocked result.",
  "taskContractSchema": "architecture/agent-task.schema.json",
  "runtime": {
    "routeCommand": "npm run agent:route -- --prompt=<request>",
    "contextCommand": "npm run agent:context -- <component|token|compose|brand> <targets>",
    "auditCommand": "npm run audit:agent-runtime",
    "flow": [
      "classify",
      "resolve-context",
      "execute",
      "validate",
      "result"
    ],
    "singleAgent": true,
    "additionalModelRouter": false,
    "deterministicGateCommand": "npm run audit:runtime:v1.1"
  },
  "sources": {
    "componentIndex": "src/data/design-system/componentArchitecture.json",
    "componentSourceRoot": "src/components",
    "tokenSourceRoot": "src/styles/tokens",
    "categoryRuleRoot": ".agentic-rules",
    "brandContract": "project-context/brand-foundations/brand-expression/contract.json",
    "projectContext": "project-context/README.md",
    "frameworkStrategy": "DESIGN-SYSTEM-FRAMEWORK.md",
    "figmaRouter": "Figma2Astro Agentic Rules/README.md",
    "architectureModel": "architecture/system-map.json"
  },
  "defaults": {
    "reuseFirst": true,
    "allowNewComponents": false,
    "figma": "explicit-only",
    "browserValidation": "visual-runtime-changes-only",
    "historyOwner": "git",
    "terminalStates": [
      "accepted",
      "blocked"
    ]
  },
  "creationGate": {
    "default": "blocked",
    "requires": "An explicit request for a new reusable or design-system component.",
    "pageOrSectionCreationIsNotComponentAuthorization": true,
    "existingComponentOutcome": "reuse-or-explicit-extend",
    "missingComponentOutcome": "blocked-with-alternatives-and-suggested-prompt",
    "primaryTargetOnly": true,
    "dependenciesDoNotBlockWhenPresent": true,
    "approvedNameRequired": true
  },
  "contextBudgets": {
    "tiny": 4096,
    "small": 12288,
    "medium": 40960,
    "large": 102400
  },
  "profiles": {
    "exact-edit": {
      "budget": "tiny",
      "reads": [
        "exact target definitions",
        "referenced aliases"
      ],
      "skips": [
        "component registry",
        "family rules",
        "brand contract",
        "art direction",
        "Figma",
        "full build"
      ],
      "validation": "token",
      "maxRepairAttempts": 1
    },
    "reuse": {
      "budget": "small",
      "reads": [
        "one component context record",
        "component source",
        "target file"
      ],
      "skips": [
        "family rules",
        "brand contract",
        "art direction",
        "Figma"
      ],
      "validation": "component-use",
      "maxRepairAttempts": 1
    },
    "compose": {
      "budget": "medium",
      "reads": [
        "named component records",
        "direct dependencies",
        "compact layout contract",
        "matching approved brand rules when applicable",
        "target file"
      ],
      "skips": [
        "full component registry",
        "full sections rule",
        "creation rules",
        "Figma"
      ],
      "validation": "page-composition",
      "maxRepairAttempts": 2
    },
    "repair": {
      "budget": "small",
      "reads": [
        "component source",
        "direct dependencies",
        "matching family rule"
      ],
      "skips": [
        "unrelated families",
        "Figma"
      ],
      "validation": "component-repair",
      "maxRepairAttempts": 2
    },
    "extend": {
      "budget": "large",
      "reads": [
        "component source and API",
        "matching family and category rules",
        "affected tokens and documentation"
      ],
      "skips": [
        "unrelated families",
        "Figma"
      ],
      "validation": "component-contract",
      "maxRepairAttempts": 2
    },
    "create": {
      "budget": "large",
      "reads": [
        "phase 1: gap evidence, creation rules, dependencies, Brand Contract status",
        "phase 2: selected family rule and declared registry/Guides projections"
      ],
      "skips": [
        "Figma unless explicitly requested"
      ],
      "validation": "component-creation",
      "maxRepairAttempts": 2
    }
  },
  "brandActivation": {
    "skip": [
      "exact token edit",
      "named existing component reuse"
    ],
    "approvedOnly": [
      "composition with named components",
      "extension that applies existing visual rules"
    ],
    "required": [
      "open-ended composition",
      "new visual component",
      "new or changed visual direction"
    ],
    "unapprovedOutcome": "blocked-for-creative-interpretation",
    "humanApproval": "required-for-new-direction-or-propagation"
  },
  "validationRouting": {
    "token": [
      "affected foundation audit"
    ],
    "component-use": [
      "targeted component API or Astro check"
    ],
    "page-composition": [
      "Astro check or build",
      "browser validation when visual or responsive behavior changed"
    ],
    "component-repair": [
      "matching family audit"
    ],
    "component-contract": [
      "component registry audit",
      "matching family audit",
      "build"
    ],
    "component-creation": [
      "component registry audit",
      "agent runtime audit",
      "matching family audit",
      "documentation validation",
      "build"
    ]
  },
  "resultContract": {
    "fields": [
      "status",
      "intent",
      "reused",
      "createdComponents",
      "changedFiles",
      "validation",
      "missingInput"
    ],
    "trackedRunHistory": false
  },
  "targetSemantics": {
    "roles": [
      "primary",
      "dependency",
      "context"
    ],
    "negations": "constraints.prohibitedCreations",
    "targetFile": "validated repository-relative existing file"
  },
  "materializedSourceBudgets": {
    "exact-edit": 16384,
    "reuse": 65536,
    "compose": 262144,
    "repair": 196608,
    "extend": 524288,
    "create": 786432
  },
  "contextPack": {
    "version": "1.1.0",
    "fields": [
      "requiredReads",
      "readPlan",
      "declaredSourceBytes",
      "sourceLimitBytes",
      "phase",
      "nextStep"
    ],
    "createPhases": [
      "create-planning",
      "create-family-resolution"
    ]
  }
}
