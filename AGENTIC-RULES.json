{
  "version": "0.1.0",
  "name": "Astro Design System Agentic Rules Router",
  "description": "Entry router for AI agents working inside the Astro design system. Read this file before design-system, UI, component, layout, token or documentation changes.",
  "required_entrypoint": true,
  "architecture": {
    "overview_path": "AGENTIC-RULES.md",
    "framework_strategy_path": "DESIGN-SYSTEM-FRAMEWORK.md",
    "figma_to_astro_rules_path": "Figma2Astro Agentic Rules/README.md",
    "css_naming_path": "CSS-NAMING-CONVENTIONS.md",
    "roadmap_path": "src/data/design-system-roadmap.json",
    "roadmap_audit_path": "scripts/audit-design-system-roadmap.mjs",
    "foundation_audit_path": "scripts/audit-design-system-foundations.mjs",
    "actions_audit_path": "scripts/audit-actions-family.mjs",
    "forms_core_audit_path": "scripts/audit-forms-core-family.mjs",
    "data_display_audit_path": "scripts/audit-data-display-family.mjs",
    "visual_audit_path": "scripts/audit-visual-family.mjs",
    "project_context_path": "project-context/README.md",
    "art_direction_knowledge_path": "art-direction/README.md",
    "brand_expression_contract_path": "project-context/brand-foundations/brand-expression/contract.md",
    "brand_expression_rule_path": ".agentic-rules/08-brand-expression.md",
    "brand_expression_audit_path": "scripts/audit-brand-expression.mjs"
  },
  "core_model": {
    "class": "type_or_role",
    "data_attributes": "variant_size_state_tone_status_mode",
    "css_variables": "values_and_design_decisions",
    "astro_components": "primary_ui_authoring_interface",
    "documentation": "human_and_ai_operational_context"
  },
  "workflow": [
    "Read AGENTIC-RULES.json first.",
    "Read AGENTIC-RULES.md when the task changes design-system architecture, reusable components, global styles, tokens or documentation patterns.",
    "Read DESIGN-SYSTEM-FRAMEWORK.md when making strategic or structural decisions.",
    "Read currentFocus and the selected item in src/data/design-system-roadmap.json before starting design-system implementation.",
    "Do not advance beyond a roadmap checkpoint that requires user acceptance.",
    "Before brand, content, information-architecture or page-composition work, read project-context/README.md and the relevant populated context folders.",
    "If required project context is empty, report the missing input instead of inventing a brand, audience, offer or business model.",
    "Before brand-sensitive visual design, read art-direction/README.md, .agentic-rules/08-brand-expression.md and the project Brand Expression Contract.",
    "Treat a Brand Expression Contract that is not approved as an explicit visual-direction input gap.",
    "For a new or substantially changed visual direction, calibrate representative components and obtain human visual approval before system-wide propagation.",
    "For Figma MCP design generation, Astro implementation or reconciliation tasks, read Figma2Astro Agentic Rules/README.md and the relevant numbered mapping rule.",
    "Identify touched categories: sizing, colors, typography, layout, motion, elevation, components or documentation.",
    "Read the full rule pack only for touched categories unless the task is global or architectural.",
    "Use existing tokens, components and documentation components before creating new ones.",
    "Update code and design-system documentation together when token or component contracts change.",
    "Update src/data/design-system-roadmap.json when a design-system area changes status.",
    "Run npm run audit:foundations after changing foundation tokens, styles, documentation or Figma mapping contracts.",
    "Run npm run audit:actions after changing Button, IconButton, ButtonGroup, SwitchButton, their documentation, or their Figma mapping contract.",
    "Run npm run audit:forms-core after changing Input, Label, Checkbox, Radio, their documentation, or their Figma mapping contract.",
    "Run npm run audit:data-display after changing Tag, AvailableLabel, TimezoneLabel, TrustBadge, Alert, ComparisonTable, their documentation, or their Figma mapping contract.",
    "Run npm run audit:roadmap after roadmap scope, dependencies, checks or status changes.",
    "Run npm run build after structural changes; skip build for narrow documentation or copy-only changes."
  ],
  "always_required_rules": [
    {
      "id": "framework",
      "title": "Framework Rules",
      "path": ".agentic-rules/00-framework.md",
      "status": "active",
      "required_for": [
        "global architecture",
        "reusable components",
        "design-system documentation",
        "new UI patterns",
        "agentic workflow changes"
      ]
    }
  ],
  "category_rules": [
    {
      "id": "sizing",
      "title": "Agentic Sizing Rules",
      "path": ".agentic-rules/01-sizing.md",
      "status": "active",
      "read_when": [
        "spacing",
        "gap",
        "space",
        "padding",
        "radius",
        "border width",
        "component size",
        "dimension",
        "layout density"
      ],
      "summary": [
        "Use sizing primitives as raw values.",
        "Use semantic global tokens for generic repeated sizes.",
        "Use component-based tokens for stable repeated component contracts.",
        "Use data attributes for sizing variants."
      ]
    },
    {
      "id": "colors",
      "title": "Agentic Color Rules",
      "path": ".agentic-rules/02-colors.md",
      "status": "active",
      "read_when": [
        "color",
        "background",
        "text color",
        "border color",
        "icon color",
        "status",
        "tone",
        "theme",
        "component color contract"
      ],
      "summary": [
        "Use primitive colors only as raw reference palettes.",
        "Use global semantic tokens for generic UI roles.",
        "Use component-based color tokens for reusable components with their own contract.",
        "Do not create broad color utility classes by default."
      ]
    },
    {
      "id": "typography",
      "title": "Agentic Typography Rules",
      "path": ".agentic-rules/03-typography.md",
      "status": "active",
      "read_when": [
        "font",
        "type scale",
        "heading",
        "body text",
        "label",
        "eyebrow",
        "line height",
        "font weight",
        "text style"
      ],
      "summary": [
        "Use typography classes as the public text style interface.",
        "Keep HTML heading tags semantic and visually neutral.",
        "Use semantic typography variables inside text style classes.",
        "Use utility typography classes only for font-style, casing and wrapping."
      ]
    },
    {
      "id": "layout",
      "title": "Agentic Layout Rules",
      "path": ".agentic-rules/04-layout.md",
      "status": "active",
      "read_when": [
        "grid",
        "section layout",
        "page layout",
        "container",
        "columns",
        "responsive layout",
        "composition"
      ],
      "summary": [
        "Use documented layout primitives and grid rules.",
        "Avoid one-off local layout structures when a reusable layout primitive exists."
      ]
    },
    {
      "id": "components",
      "title": "Agentic Component Rules",
      "path": ".agentic-rules/05-components.md",
      "status": "active",
      "read_when": [
        "Astro component",
        "component API",
        "props",
        "data attributes",
        "component state",
        "component variant",
        "component documentation",
        "component folder architecture",
        "atomic design",
        "component family"
      ],
      "summary": [
        "Source folders use Atomic Design first and component family second.",
        "Components documentation uses family-first grouping for developer workflow.",
        "Props should render predictable classes, data attributes and token-backed styles.",
        "Do not use global, shared, common or misc as catch-all component families."
      ]
    },
    {
      "id": "motion",
      "title": "Agentic Motion Rules",
      "path": ".agentic-rules/06-motion.md",
      "status": "active",
      "read_when": [
        "motion",
        "transition",
        "animation",
        "duration",
        "delay",
        "easing",
        "keyframes",
        "reduced motion"
      ],
      "summary": [
        "Use foundation, semantic and component-level timing contracts.",
        "Every reusable duration and delay must define a Reduced Motion value.",
        "Runtime motion remains code-owned while Figma mirrors values and modes."
      ]
    },
    {
      "id": "elevation",
      "title": "Agentic Elevation Rules",
      "path": ".agentic-rules/07-elevation.md",
      "status": "active",
      "read_when": [
        "elevation",
        "shadow",
        "raised surface",
        "floating surface",
        "popover",
        "overlay",
        "toast"
      ],
      "summary": [
        "Select elevation by surface relationship.",
        "Keep focus rings, borders, status rings and colored halos outside elevation.",
        "Use semantic roles or stable component aliases instead of copied shadows."
      ]
    },
    {
      "id": "brand-expression",
      "title": "Brand Expression Agentic Rules",
      "path": ".agentic-rules/08-brand-expression.md",
      "status": "active",
      "read_when": [
        "art direction",
        "brand expression",
        "visual language",
        "visual redesign",
        "visual polish",
        "creative direction",
        "design reference",
        "moodboard",
        "brand-sensitive component",
        "Figma visual exploration",
        "Swiss International Style"
      ],
      "summary": [
        "Separate universal design knowledge from approved project-specific visual direction.",
        "Do not implement subjective adjectives without observable rules, references, counterexamples and human approval.",
        "Use Figma or browser pilots for calibration, then encode approved shared decisions in CSS Variables and Astro.",
        "Technical parity does not replace the human visual-quality gate."
      ]
    }
  ],
  "decision_checklist": [
    {
      "id": "scope",
      "question": "Which design-system categories does this change touch?"
    },
    {
      "id": "source_of_truth",
      "question": "Is the change represented in code tokens/components first, with docs reflecting code?"
    },
    {
      "id": "reuse",
      "question": "Can an existing token, component, attribute or documentation component solve this?"
    },
    {
      "id": "api",
      "question": "Should this be a component prop, data attribute, semantic token or component-based token?"
    },
    {
      "id": "classes",
      "question": "Is this class describing type/role, not variant/value?"
    },
    {
      "id": "attributes",
      "question": "Are variants, states, tone, status, sizing or mode expressed through data attributes?"
    },
    {
      "id": "documentation",
      "question": "Does the design-system page document the changed code contract?"
    },
    {
      "id": "brand_expression",
      "question": "Is this visual decision supported by an approved Brand Expression Contract and approved references?"
    },
    {
      "id": "visual_approval",
      "question": "Does the affected propagation scope have recorded human visual approval?"
    },
    {
      "id": "component_agentic_rule",
      "question": "If this touches a reusable component, does .agentic-rules/components/<component-name>.md need an update?"
    },
    {
      "id": "roadmap",
      "question": "Does src/data/design-system-roadmap.json need a status update?"
    }
  ],
  "component_rules": {
    "template_path": ".agentic-rules/components/_component-rule-template.md",
    "directory": ".agentic-rules/components",
    "rules": [
      {
        "id": "button",
